---
import '../styles/system-ui.css';
export interface Props {
  title?: string;
}
const { title = '대한불교밀교종 종단관리시스템' } = Astro.props;
---
<!doctype html>
<html lang="ko" class="auth-boot">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/favicon.png" id="site-favicon" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <script is:inline src="/system-session.js?v=99-auth-20261015"></script>
  <script is:inline>
    document.documentElement.dataset.authHint = window.MilgyoSession.peek() ? 'session' : 'login';
  </script>
</head>
<body>
  <slot />
  <script is:inline>
    (() => {
      const ensureAppointmentAwardsMenu = () => {
        document.querySelectorAll('.sidebar-group').forEach((group) => {
          const heading = group.querySelector('.sidebar-group__title');
          if (heading?.textContent?.trim() !== '증명서·신청서 발급·대장') return;
          if (group.querySelector('a[href="/appointment-awards"]')) return;

          const link = document.createElement('a');
          link.className = 'sidebar-link sidebar-external-link';
          link.href = '/appointment-awards';
          link.textContent = '임명장·표창장 발급·대장';

          const foreignForms = group.querySelector('a[href="/foreign-applications"]');
          if (foreignForms) group.insertBefore(link, foreignForms);
          else group.appendChild(link);
        });
      };

      ensureAppointmentAwardsMenu();
    })();
  </script>
  <script is:inline src="/milgyo-date-input.js?v=90"></script>
  <style is:global>
    :root {
      --gov-navy: #37649b;
      --gov-navy-dark: #244d80;
      --gov-accent: #315f9f;
      --gov-bg: #e9edf3;
      --gov-border: #cbd3df;
      --gov-text: #23262b;
      --gov-muted: #6a7180;
      --gov-gold: #b08d3f;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: var(--gov-bg);
      color: var(--gov-text);
      font-family: "Pretendard", "Malgun Gothic", -apple-system, BlinkMacSystemFont, sans-serif;
    }
    html.auth-boot[data-auth-hint="session"] .login-screen { display: none !important; }
    html.auth-boot[data-auth-hint="login"] .app-shell { display: none !important; }
    button { font-family: inherit; cursor: pointer; }
    :focus-visible { outline: 3px solid rgba(49,95,159,.35); outline-offset: 2px; }
    input, select, textarea { font-family: inherit; }
  </style>
</body>
</html>
