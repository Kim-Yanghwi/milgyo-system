      let formType='거주숙소제공확인서';
      let recordId='';
      let recordNo='';
      let recordStatus='저장';
      let page=1,pages=1,currentRows=[];
      let organizationSealSource='/organization-seal-official.png';
      const signatureSealSources=new Map(signatureSealOptions.map((item)=>[item.key,item.src]));
      let sealAssetsPromise=null;

      const api=async(url,payload)=>{
        try{
          const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:session.token,...payload})});
          const data=await response.json().catch(()=>({ok:false,message:'서버 응답을 확인할 수 없습니다.'}));
          if(!data.ok&&response.status===401){localStorage.removeItem('milgyo-system-session');location.replace('/');}
          return data;
        }catch(error){console.error('foreign forms request failed',error);return{ok:false,message:'서버에 연결할 수 없습니다.'};}
      };
      const setStatus=(message,kind='')=>{const el=$('[data-form-status]');if(!el)return;el.textContent=message||'';el.dataset.kind=kind;};
      const today=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,10);
      const blobToDataUrl=(blob)=>new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result||''));reader.onerror=()=>reject(reader.error);reader.readAsDataURL(blob);});
      const toEmbeddedImage=async(src)=>{
        if(!src||String(src).startsWith('data:image/'))return src;
        try{const response=await fetch(src,{cache:'force-cache'});if(!response.ok)return src;return await blobToDataUrl(await response.blob());}catch{return src;}
      };
      const ensureSealAssets=()=>{
        if(sealAssetsPromise)return sealAssetsPromise;
        sealAssetsPromise=(async()=>{
          // V91.11: 출입국 서식의 종단 직인은 public의 교체 파일만 사용한다.
          // 종단설정 DB의 seal_image로 덮어쓰지 않으며, 버전 쿼리로 이전 이미지 캐시를 피한다.
          organizationSealSource=await toEmbeddedImage('/organization-seal-official.png?v=20260901-v9111');
          await Promise.all(signatureSealOptions.map(async(item)=>{signatureSealSources.set(item.key,await toEmbeddedImage(item.src));}));
        })();
        return sealAssetsPromise;
      };
      const signatureSealByKey=new Map(signatureSealOptions.map((item)=>[item.key,item]));
      const signatureWithSeal=(value,sealKey,label='(\uC11C\uBA85)',english='(Signature)')=>{
        const text=String(value??'').trim();
        if(!text)return '';
        const stamp=signatureSealByKey.get(String(sealKey||''));
        const stampSrc=stamp?(signatureSealSources.get(stamp.key)||stamp.src):'';
        const stampHtml=stamp?`<img class="signature-stamp-image" src="${esc(stampSrc)}" alt="${esc(stamp.label)}" />`:'';
        return `<span class="applicant-signature-seal"><span class="signature-name-slot"><strong>${esc(text)}</strong></span><span class="signature-stamp-position${stamp?'':' signature-stamp-position--empty'}">${stampHtml}<span class="seal-target-label">${esc(label)}</span>${english?`<small>${esc(english)}</small>`:''}</span></span>`;
      };
      const organizationSealMark=()=>`<span class="official-seal-position"><img class="official-seal-image" src="${esc(organizationSealSource)}" alt="Organization official seal" /><span class="seal-target-label">(\uC9C1\uC778)</span><small>(Official Seal)</small></span>`;
      const normalizeDateLikeValue=(value)=>{
        const text=String(value??'').trim();
        if(!text)return '';
        const match=/^(\d{4}-\d{2}-\d{2})(?:\s*\([^)]*\)|0)?$/.exec(text);
        return match?match[1]:text;
      };
      const normalizeFieldValue=(field,value)=>{
        if(field?.type==='date')return normalizeDateLikeValue(value);
        if(Array.isArray(value))return value.map((item)=>String(item??'').trim());
        return value??'';
      };
      const copiedSnapshot=(snapshot,type)=>{
        const copy=JSON.parse(JSON.stringify(snapshot||{}));
        for(const field of schemas[type]||[]){
          if(!field?.name)continue;
          copy[field.name]=normalizeFieldValue(field,copy[field.name]);
        }
        if(type==='거주숙소제공확인서') copy.confirmationDate=today();
        else copy.applicationDate=today();
        return copy;
      };

      const fieldHtml=(field)=>{
        const req=field.required?' required':'';
        const span=field.wide?' form-field--wide':field.span?` form-field--span-${field.span}`:'';
        const extraClass=field.className?` ${field.className}`:'';
        const marker=field.required?' <b>*</b>':'';
        const classes=`form-field${span}${extraClass}`;
        if(field.type==='textarea')return `<div class="${classes}"><label>${esc(field.label)}${marker}</label><textarea name="${esc(field.name)}" rows="${Number(field.rows||3)}"${req}></textarea></div>`;
        if(field.type==='select')return `<div class="${classes}"><label>${esc(field.label)}${marker}</label><select name="${esc(field.name)}"${req}><option value="">선택</option>${field.options.map(o=>`<option value="${esc(o)}">${esc(o)}</option>`).join('')}</select></div>`;
        if(field.type==='date')return `<div class="${classes}"><label>${esc(field.label)}${marker}</label><input name="${esc(field.name)}" type="date" data-no-weekday data-no-date8 lang="en-CA"${req}/></div>`;
        if(field.type==='signatureSeal')return `<div class="${classes} signature-seal-field"><span class="field-label">${esc(field.label)}</span><p class="signature-seal-helper">기본값은 미적용이며, 필요할 때만 서명용 도장을 선택합니다.</p><details class="signature-seal-disclosure" data-signature-seal-disclosure><summary>서명용 도장 선택 열기</summary><div class="signature-seal-picker" role="radiogroup" aria-label="${esc(field.label)}"><label class="signature-seal-choice signature-seal-choice--none"><input type="radio" name="${esc(field.name)}" value="" checked/><span class="signature-seal-choice__body"><span class="signature-seal-choice__title">미적용 / None</span><small>서명용 도장을 넣지 않음</small></span></label>${signatureSealOptions.map(option=>`<label class="signature-seal-choice"><input type="radio" name="${esc(field.name)}" value="${esc(option.key)}"/><span class="signature-seal-choice__body"><img src="${esc(option.src)}" alt="${esc(option.label)}"/><span class="signature-seal-choice__title">${esc(option.label)}</span></span></label>`).join('')}</div></details></div>`;
        if(field.type==='checks')return `<div class="${classes}"><span class="field-label">${esc(field.label)}${marker}</span><div class="check-grid${field.checksClass?` ${field.checksClass}`:''}">${field.options.map(o=>`<label class="check-option"><input type="checkbox" name="${esc(field.name)}" value="${esc(o)}"/><span>${esc(o)}</span></label>`).join('')}</div></div>`;
        return `<div class="${classes}"><label>${esc(field.label)}${marker}</label><input name="${esc(field.name)}" type="${esc(field.type||'text')}"${req}/></div>`;
      };
      const sectionHeading=(title)=>{
        const match=/^(\d+\.)\s*(.*)$/.exec(String(title||''));
        if(!match)return `<h3 class="foreign-section-title"><span>${esc(title)}</span></h3>`;
        return `<h3 class="foreign-section-title"><span class="foreign-section-number">${esc(match[1])}</span><span>${esc(match[2])}</span></h3>`;
      };
      const renderForm=(values={})=>{
        const host=$('[data-form-host]');
        const groups=[];let current=null;
        for(const field of schemas[formType]){
          if(field.section){current={title:field.section,fields:[],columns:Number(field.columns)||2,className:field.className||''};groups.push(current);continue;}
          if(!current){current={title:'',fields:[],columns:2,className:''};groups.push(current);}
          current.fields.push(field);
        }
        host.innerHTML=`<div class="foreign-form-sections">${groups.map((group,index)=>`<section class="foreign-input-section${group.className?` ${group.className}`:''}" data-section-index="${index}" data-columns="${group.columns||2}">${group.title?sectionHeading(group.title):''}<div class="form-grid foreign-form-grid foreign-form-grid--cols-${group.columns||2}">${group.fields.map(fieldHtml).join('')}</div></section>`).join('')}</div>`;
        for(const [name,value] of Object.entries(values||{})){
          const inputs=$$(`[name="${CSS.escape(name)}"]`,host);
          if(!inputs.length)continue;
          const field=(schemas[formType]||[]).find((item)=>item?.name===name);
          const normalizedValue=normalizeFieldValue(field,value);
          if(inputs[0].type==='checkbox'){
            const values=Array.isArray(normalizedValue)?normalizedValue:[normalizedValue];
            inputs.forEach(input=>input.checked=values.includes(input.value));
          }else if(inputs[0].type==='radio'){
            inputs.forEach(input=>input.checked=String(input.value)===String(normalizedValue??''));
          }else inputs[0].value=normalizedValue??'';
        }
        if(!values?.confirmationDate&&formType==='거주숙소제공확인서') $('[name="confirmationDate"]',host).value=today();
        if(!values?.applicationDate&&formType!=='거주숙소제공확인서') $('[name="applicationDate"]',host).value=today();
        $$('[data-signature-seal-disclosure]',host).forEach((details)=>{
          const checked=$$('input[type="radio"]:checked',details).find((input)=>String(input.value||'').trim());
          details.open=Boolean(checked);
        });
        window.__MILGYO_SYNC_DATE_INPUTS__?.(host);
      };
      const getValues=()=>{
        const form=$('[data-foreign-form]');
        const data={};
        for(const field of schemas[formType]){
          if(!field.name)continue;
          if(field.type==='checks')data[field.name]=$$(`[name="${CSS.escape(field.name)}"]:checked`,form).map(el=>el.value);
          else data[field.name]=normalizeFieldValue(field,form.elements.namedItem(field.name)?.value??'');
        }
        return data;
      };
      const validateForm=()=>true;
      const updateRecordBanner=()=>{
        const banner=$('[data-record-banner]');
        banner.hidden=!recordId;
        $('[data-record-number]').textContent=recordNo||'-';
        $('[data-record-status]').textContent=recordStatus||'저장';
      };
      const resetRecord=()=>{
        recordId='';recordNo='';recordStatus='저장';updateRecordBanner();setStatus('');
        renderForm({});
      };
      const selectType=(nextType,values={})=>{
        formType=nextType;
        $$('[data-form-type]').forEach(btn=>btn.classList.toggle('active',btn.dataset.formType===formType));
        resetRecord();
        renderForm(values);
      };

      const mark=(selected,option)=>{
        const list=Array.isArray(selected)?selected:[selected];
        return list.some(value=>String(value||'').includes(option))?'☑':'☐';
      };
      const val=(values,key,fallback='')=>esc(String(values?.[key]??fallback));
      const valBr=(values,key)=>val(values,key).replace(/\n/g,'<br>');
      const dateParts=(value)=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value||''));return m?{y:m[1],m:String(Number(m[2])),d:String(Number(m[3]))}:{y:'',m:'',d:''}};
      const residenceDocument=(values)=>{
        const start=dateParts(values.residenceStartDate),confirm=dateParts(values.confirmationDate);
        return `<section class="official-page official-page--residence">
          <div class="official-title"><h1>거주/숙소제공 확인서</h1><h2>(Confirmation of Residence/Accommodation)</h2></div>
          <table class="paper-table residence-table"><colgroup><col style="width:23%"><col style="width:27%"><col style="width:24%"><col style="width:26%"></colgroup>
            <tr class="paper-section-row"><th colspan="4">1. 거주/숙소를 제공 받는 외국인 ( Foreign Tenant / Recipient )</th></tr>
            <tr><th>국 적<br><small>(Nationality)</small></th><td>${val(values,'nationality')}</td><th>외국인등록(거소)번호<br><small>(Alien/Domestic Residence<br>Registration No.)</small></th><td>${val(values,'foreignResidentNo')}</td></tr>
            <tr><th>성 명<br><small>(Full Name)</small></th><td>${val(values,'residentFullName')}</td><th class="paper-subcell"><div class="paper-subrow">전화번호<br><small>(Telephone No.)</small></div><div class="paper-subrow">휴대전화<br><small>(Cell phone No.)</small></div></th><td class="paper-subcell"><div class="paper-subrow paper-input-value">${val(values,'residentTelephone')}</div><div class="paper-subrow paper-input-value">${val(values,'residentCellPhone')}</div></td></tr>
            <tr><th>주 소<br><small>(Address)</small></th><td colspan="3" class="paper-value-large">${valBr(values,'residenceAddress')}</td></tr>
            <tr class="paper-spacer"><td colspan="4"></td></tr>
            <tr class="paper-section-row"><th colspan="4">2. 거주/숙소 제공자 ( Landlord / Provider )</th></tr>
            <tr><th>국 적<br><small>(Nationality)</small></th><td>${val(values,'providerNationality')}</td><th>주민/외국인등록번호<br><small>(Resident/Alien Registration No.)</small></th><td>${val(values,'providerRegistrationNo')}</td></tr>
            <tr><th>성 명<br><small>(Full Name)</small></th><td colspan="3">${val(values,'providerName')}</td></tr>
            <tr><th>외국인과의 관계<br><small>(Relationship)</small></th><td colspan="3" class="paper-options">${mark(values.relationship,'친척')} 친 척 (Relative)&nbsp;&nbsp;&nbsp; ${mark(values.relationship,'고용주')} 고 용 주 (Employer)&nbsp;&nbsp;&nbsp; ${mark(values.relationship,'기타')} 기 타 (Other) <span class="paper-inline-value">${val(values,'relationshipOther')}</span></td></tr>
            <tr><th>소유형태<br><small>(Ownership Type)</small></th><td colspan="3" class="paper-options">${mark(values.ownership,'자가')} 자 가 (Own)&nbsp;&nbsp;&nbsp; ${mark(values.ownership,'임대')} 임 대 (Rent)&nbsp;&nbsp;&nbsp; ${mark(values.ownership,'기타')} 기 타 (Other) <span class="paper-inline-value">${val(values,'ownershipOther')}</span></td></tr>
            <tr><th>주거형태<br><small>(Residence Type)</small></th><td colspan="3" class="paper-options residence-options">${mark(values.residenceType,'개인주택')} 개인주택 등 (Private Residence, etc.)&nbsp;&nbsp; ${mark(values.residenceType,'기숙사')} 기 숙 사 (Dormitory)<br>${mark(values.residenceType,'숙박시설')} 숙 박 시 설 (Accommodation)&nbsp;&nbsp; ${mark(values.residenceType,'기타')} 기 타 (Other) <span class="paper-inline-value">${val(values,'residenceTypeOther')}</span></td></tr>
            <tr><th>거주/숙소 제공일<br><small>(Starting Date)</small></th><td colspan="3" class="paper-centered">${start.y}년(Year)&nbsp;&nbsp;&nbsp; ${start.m}월(Month)&nbsp;&nbsp;&nbsp; ${start.d}일(Date)</td></tr>
            <tr><td colspan="4" class="residence-confirmation">위와 같이 거주/숙소를 제공하였음을 확인합니다.<br><small>(I, the undersigned, confirm the provision of accommodation to the abovementioned foreigner.)</small><div class="confirmation-date">${confirm.y}년(Year)&nbsp;&nbsp; ${confirm.m}월(Month)&nbsp;&nbsp; ${confirm.d}일(Date)</div><div class="signature-lines"><div class="signature-entry-row"><span class="signature-entry-caption">성&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;명 (Name) :</span>${signatureWithSeal(values?.confirmationName,values?.confirmationSignatureSeal,'(\uC11C\uBA85)','(Signature)')}</div><div class="signature-entry-row signature-entry-row--company"><span class="signature-entry-caption">업체명 (Company Name) :</span><span class="organization-name-slot"><b>${val(values,'companyName')}</b></span>${organizationSealMark()}</div></div><strong class="office-destination">출입국관리사무소(출장소)장&nbsp;&nbsp;&nbsp; 귀하</strong></td></tr>
