        a.href=url;a.download=`${safe}.html`;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
        await eventForRecord('download');loadLedger();setStatus('작성본을 HTML 파일로 다운로드했습니다. 인쇄 메뉴에서 PDF로도 저장할 수 있습니다.','ok');
      });

      const fmtDate=(value)=>{
        if(!value)return '-';
        const d=new Date(value);
        if(Number.isNaN(d.getTime()))return normalizeDateLikeValue(value)||String(value);
        const parts=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(d).filter(part=>part.type!=='literal').map(part=>[part.type,part.value]));
        return `${parts.year}. ${parts.month}. ${parts.day}. ${parts.hour}:${parts.minute}`;
      };
      const loadLedger=async(targetPage=page)=>{
        const result=await api('/api/foreign-forms/query',{
