        if(!result.ok){body.innerHTML=`<tr><td colspan="10">${esc(result.message||'목록을 불러오지 못했습니다.')}</td></tr>`;return;}
        currentRows=result.rows||[];page=result.pagination.page;pages=result.pagination.pages;
        body.innerHTML=currentRows.length?currentRows.map(row=>`<tr>
          <td>${esc(row.record_no)}</td><td>${esc(fmtDate(row.created_at))}</td><td>${esc(typeShort[row.form_type]||row.form_type)}</td>
          <td>${esc(row.subject_name||'-')}</td><td>${esc(row.nationality||'-')}</td><td>${esc(row.created_by_name||'-')}</td>
          <td>${Number(row.print_count||0)}회</td><td>${Number(row.download_count||0)}회</td>
          <td><span class="status-pill ${row.status==='취소'?'status-pill--cancel':''}">${esc(row.status)}</span></td>
          <td class="manage-cell"><button type="button" class="btn btn-outline btn-sm" data-copy-record="${esc(row.id)}" title="입력값만 복사하여 새 작성으로 시작합니다.">값 불러오기</button><button type="button" class="btn btn-outline btn-sm" data-open-record="${esc(row.id)}" title="이 작성 이력 자체를 열어 수정합니다.">열기</button>${row.status!=='취소'?`<button type="button" class="btn btn-outline btn-sm" data-cancel-record="${esc(row.id)}">취소</button>`:''}</td>
        </tr>`).join(''):`<tr><td colspan="10">저장된 작성 이력이 없습니다.</td></tr>`;
        renderPagination();
      };
      const renderPagination=()=>{
        const host=$('[data-ledger-pagination]');host.innerHTML='';
        const make=(label,target,disabled=false,active=false)=>{const b=document.createElement('button');b.type='button';b.className=`btn btn-outline btn-sm${active?' active':''}`;b.textContent=label;b.disabled=disabled;b.addEventListener('click',()=>loadLedger(target));return b;};
        host.append(make('이전',Math.max(1,page-1),page<=1));
        const start=Math.max(1,page-2),end=Math.min(pages,start+4);
        for(let p=start;p<=end;p++)host.append(make(String(p),p,false,p===page));
        host.append(make('다음',Math.min(pages,page+1),page>=pages));
      };
      const applyRecordToForm=(row,asNew=false)=>{
        formType=row.form_type;
        $$('[data-form-type]').forEach(btn=>btn.classList.toggle('active',btn.dataset.formType===formType));
        if(asNew){
          recordId='';recordNo='';recordStatus='저장';updateRecordBanner();
          renderForm(copiedSnapshot(row.snapshot||{},formType));
          setStatus(`기록번호 ${row.record_no||'-'}의 입력값을 새 작성으로 불러왔습니다. 저장 시 새 기록번호가 생성됩니다.`,'ok');
        }else{
          recordId=row.id;recordNo=row.record_no;recordStatus=row.status;
          renderForm(row.snapshot||{});updateRecordBanner();setStatus('저장된 작성 이력을 불러왔습니다.','ok');
        }
        window.scrollTo({top:0,behavior:'smooth'});
      };
      const loadRecordDetail=async(id,asNew=false)=>{
        const result=await api('/api/foreign-forms/query',{mode:'detail',id});
        if(!result.ok){$('[data-ledger-message]').textContent=result.message||'기록을 불러오지 못했습니다.';return false;}
        applyRecordToForm(result.row,asNew);
        return true;
      };
      $('[data-ledger-body]').addEventListener('click',async(e)=>{
        const copy=e.target.closest('[data-copy-record]');
        if(copy){await loadRecordDetail(copy.dataset.copyRecord,true);return;}
        const open=e.target.closest('[data-open-record]');
        if(open){await loadRecordDetail(open.dataset.openRecord,false);return;}
        const cancel=e.target.closest('[data-cancel-record]');
        if(cancel){
          if(!confirm('이 작성 이력을 취소 상태로 변경하시겠습니까? 원본 데이터는 감사 이력을 위해 삭제되지 않습니다.'))return;
          const result=await api('/api/foreign-forms/action',{action:'cancel',id:cancel.dataset.cancelRecord});
          $('[data-ledger-message]').textContent=result.message||'';if(result.ok)loadLedger();
        }
      });
      $('[data-ledger-search]').addEventListener('click',()=>loadLedger(1));
      $('[data-ledger-size]').addEventListener('change',()=>loadLedger(1));
      $('[data-ledger-query]').addEventListener('keydown',(e)=>{if(e.key==='Enter'){e.preventDefault();loadLedger(1);}});
      $('[data-ledger-export]').addEventListener('click',()=>{
        if(!currentRows.length)return;
        const headers=['기록번호','작성일','서식','대상자','국적','작성자','출력횟수','다운로드횟수','상태'];
        const rows=currentRows.map(r=>[r.record_no,r.created_at,typeShort[r.form_type]||r.form_type,r.subject_name,r.nationality,r.created_by_name,r.print_count,r.download_count,r.status]);
        const csvSafe=(value)=>{const text=String(value??'');return /^[\s]*[=+\-@]/.test(text)?`'${text}`:text;};
        const csv=[headers,...rows].map(row=>row.map(v=>`"${csvSafe(v).replaceAll('\"','\"\"')}"`).join(',')).join('\r\n');
        const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='출입국신청서_작성대장.csv';a.click();URL.revokeObjectURL(url);
      });
      $('[data-form-host]').addEventListener('change',(event)=>{
        const input=event.target.closest('input[type="radio"]');
        if(!input)return;
        const details=input.closest('[data-signature-seal-disclosure]');
        if(details)details.open=Boolean(String(input.value||'').trim());
      });

      window.__MILGYO_SYNC_DATE_INPUTS__?.(document);
      ensureSealAssets();
      renderForm({});
      loadLedger(1);
    })();
  </script>
