---
import ManagementLayout from '../layouts/ManagementLayout.astro';
---
<ManagementLayout title="외국인 신청서·신고서 작성·대장" active="foreignForms">
  <div data-foreign-forms-version="2026-08-30-v91-foreign-applications-reconstruction" hidden></div>
  <div class="page-heading">
    <div>
      <p class="page-heading__kicker">FOREIGNER APPLICATION FORMS</p>
      <h1>외국인 신청서·신고서 작성·대장</h1>
      <p>외국인 관련 신청서와 신고서를 화면에서 작성하고, 작성본 다운로드·인쇄 및 이력을 관리합니다.</p>
    </div>
  </div>

  <section class="surface foreign-form-panel">
    <div class="section-title foreign-form-title">
      <div>
        <h2>신청서·신고서 작성</h2>
        <p>서식을 선택한 뒤 입력하면 미리보기, 다운로드, 출력과 이력저장이 가능합니다.</p>
      </div>
      <button type="button" class="btn btn-outline" data-new-form>새로 작성</button>
    </div>

    <div class="foreign-form-selector" role="tablist" aria-label="외국인 신청서 종류">
      <button type="button" class="form-type-card active" data-form-type="거주숙소제공확인서">
        <strong>거주/숙소제공확인서</strong>
        <span>Confirmation of Residence/Accommodation</span>
      </button>
      <button type="button" class="form-type-card" data-form-type="통합신청서신고서">
        <strong>통합신청서(신고서)</strong>
        <span>APPLICATION FORM (REPORT FORM)</span>
      </button>
      <button type="button" class="form-type-card" data-form-type="사증발급인정신청서">
        <strong>사증발급인정신청서</strong>
        <span>APPLICATION FOR CERTIFICATE OF VISA ELIGIBILITY</span>
      </button>
    </div>

    <div class="official-form-downloads" aria-label="원본 HWPX 서식">
      <strong>원본 HWPX 서식</strong>
      <a class="btn btn-outline" download href="/forms/거주숙소제공확인서(한글-영문).hwpx">거주/숙소제공확인서</a>
      <a class="btn btn-outline" download href="/forms/[별지 제34호서식] 통합신청서 (신고서) APPLICATION FORM (REPORT FORM)(출입국관리법 시행규칙).hwpx">통합신청서(신고서)</a>
      <a class="btn btn-outline" download href="/forms/[별지 제21호서식] 사증발급인정신청서 APPLICATION FOR CERTIFICATE OF VISA ELIGIBILITY(출입국관리법 시행규칙).hwpx">사증발급인정신청서</a>
    </div>

    <div class="record-banner" data-record-banner hidden>
      <span>작성 이력</span><strong data-record-number>-</strong><em data-record-status>저장</em>
    </div>

    <form data-foreign-form>
      <div data-form-host></div>
      <div class="status-message" data-form-status aria-live="polite"></div>
      <div class="form-actions foreign-actions">
        <button type="button" class="btn btn-outline" data-preview>미리보기</button>
        <button type="button" class="btn btn-outline" data-download>작성본 다운로드</button>
        <button type="button" class="btn btn-outline" data-print>인쇄 / PDF 저장</button>
        <button type="submit" class="btn btn-primary" data-save>이력 저장</button>
      </div>
    </form>
  </section>

  <section class="surface foreign-ledger">
    <div class="section-title ledger-section-title">
      <div><h2>신청서·신고서 작성대장</h2><p>작성자와 서식 종류, 대상자, 출력·다운로드 이력을 확인합니다.</p></div>
      <div class="toolbar foreign-ledger-filters">
        <select data-ledger-type>
          <option value="">전체 서식</option>
          <option value="거주숙소제공확인서">거주/숙소제공확인서</option>
          <option value="통합신청서신고서">통합신청서(신고서)</option>
          <option value="사증발급인정신청서">사증발급인정신청서</option>
        </select>
        <select data-ledger-status><option value="">전체 상태</option><option value="저장">저장</option><option value="취소">취소</option></select>
        <div class="filter-date-range"><input type="date" data-ledger-from aria-label="조회 시작일"/><span>~</span><input type="date" data-ledger-to aria-label="조회 종료일"/></div>
        <input type="search" data-ledger-query placeholder="기록번호·성명·국적·작성자 검색"/>
        <select data-ledger-size><option value="10">10개</option><option value="20" selected>20개</option><option value="50">50개</option></select>
        <button type="button" class="btn btn-outline" data-ledger-search>조회</button>
        <button type="button" class="btn btn-outline" data-ledger-export>CSV</button>
      </div>
    </div>
    <div class="status-message" data-ledger-message aria-live="polite"></div>
    <div class="data-wrap">
      <table class="data-table foreign-ledger-table">
        <thead><tr><th>기록번호</th><th>작성일</th><th>서식</th><th>대상자</th><th>국적</th><th>작성자</th><th>출력</th><th>다운로드</th><th>상태</th><th>관리</th></tr></thead>
        <tbody data-ledger-body><tr><td colspan="10">불러오는 중입니다.</td></tr></tbody>
      </table>
    </div>
    <div class="pagination" data-ledger-pagination></div>
  </section>

  <div class="modal-overlay" data-preview-modal hidden>
    <section class="modal foreign-preview-modal" role="dialog" aria-modal="true" aria-labelledby="foreign-preview-title">
      <header class="modal__header"><h2 id="foreign-preview-title">작성본 미리보기</h2><button type="button" class="modal__close" data-close-preview aria-label="닫기">×</button></header>
      <div class="modal__body"><div data-preview-container></div></div>
      <footer class="modal__actions"><button type="button" class="btn btn-outline" data-close-preview>닫기</button><button type="button" class="btn btn-primary" data-print-preview>인쇄 / PDF 저장</button></footer>
    </section>
  </div>

  <script is:inline>
