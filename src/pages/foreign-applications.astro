      const printCss=`@page{size:A4 portrait;margin:0}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111;font-family:Arial,"Noto Sans KR","Malgun Gothic",sans-serif}.official-document-stack{background:#fff}.official-page{position:relative;width:210mm;min-height:297mm;padding:12mm 18mm 9mm;margin:0 auto;background:#fff;break-after:page;page-break-after:always}.official-page:last-child{break-after:auto;page-break-after:auto}.official-title{text-align:center;margin:2mm 0 4mm}.official-title h1{font-size:19pt;margin:0;font-weight:800;letter-spacing:.04em}.official-title h2{font-size:12pt;margin:1mm 0 0;font-weight:700}.official-title.compact h1{font-size:17pt}.official-title.compact h2{font-size:11pt}.paper-table{width:100%;border-collapse:collapse;table-layout:fixed}.paper-table th,.paper-table td{border:0.65pt solid #111;padding:2.2mm 2mm;vertical-align:middle!important;font-size:8.5pt;line-height:1.25;word-break:keep-all;overflow-wrap:anywhere}.paper-table th{font-weight:600;text-align:center}.paper-table td{text-align:center}.paper-table small{font-size:7.2pt;line-height:1.15}.paper-section-row th,.visa-section th{background:#e5e5e5;text-align:left;font-size:9.5pt;font-weight:800;padding:2mm}.paper-spacer td{height:2.2mm;padding:0;border-left:.65pt solid #111;border-right:.65pt solid #111}.paper-subcell{padding:0!important;vertical-align:middle!important;text-align:center!important}.paper-subrow{display:flex;align-items:center;justify-content:center;min-height:8mm;padding:1mm 1.4mm;text-align:center}.paper-subrow+.paper-subrow{border-top:.65pt solid #111}.paper-input-value{font-weight:500}.paper-value-large{height:12mm;text-align:center!important;vertical-align:middle!important}.paper-options{line-height:1.55;text-align:center!important}.paper-inline-value{display:inline-flex;align-items:center;justify-content:center;min-width:22mm;border-bottom:.45pt solid #555;margin-left:3mm;text-align:center}.paper-centered{text-align:center}.residence-confirmation{text-align:center;padding:5mm 4mm!important;line-height:1.7!important}.confirmation-date{margin:4mm 0 3mm}.signature-lines{display:grid;justify-content:center;gap:1.2mm;text-align:center;padding-right:0;line-height:1.2}.signature-entry-row{display:grid;grid-template-columns:42mm 48mm 36mm;column-gap:2mm;align-items:center;justify-content:center;min-height:15mm;white-space:nowrap}.signature-entry-row--company{min-height:21mm}.signature-entry-caption{display:block;min-width:0;width:auto;text-align:right;margin-right:0}.applicant-signature-seal{display:inline-flex;align-items:center;justify-content:flex-start;gap:2mm;min-height:15mm;vertical-align:middle;white-space:nowrap}.signature-entry-row>.applicant-signature-seal{grid-column:2/4;display:grid;grid-template-columns:48mm 36mm;column-gap:2mm;align-items:center;justify-content:start}.signature-name-slot{display:inline-flex;align-items:center;justify-content:center;min-width:26mm;max-width:38mm;min-height:15mm;text-align:center;white-space:nowrap}.signature-lines .signature-name-slot{min-width:0;max-width:none;width:48mm}.signature-name-slot strong{display:inline-block;font-weight:700;line-height:1.2}.signature-stamp-position{position:relative;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;width:18mm;min-width:18mm;height:15mm;line-height:1.05;vertical-align:middle}.signature-stamp-image{position:absolute;left:50%;top:50%;width:12mm;height:12mm;object-fit:contain;transform:translate(-50%,-50%);z-index:2;pointer-events:none;opacity:.88}.signature-stamp-position .seal-target-label{position:relative;z-index:1;font-size:8pt;font-weight:700}.signature-stamp-position small{position:relative;z-index:1;font-size:6.4pt;margin-top:.7mm}.signature-stamp-position--empty{height:15mm}.organization-name-slot{display:inline-flex;align-items:center;justify-content:center;min-width:0;max-width:none;width:48mm;min-height:21mm;text-align:center;white-space:nowrap}.organization-name-slot b{display:inline-block;line-height:1.2}.official-seal-position{position:relative;left:-4mm;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;width:30mm;min-width:30mm;height:30mm;line-height:1.05;vertical-align:middle;margin-left:0}.official-seal-image{position:absolute;left:50%;top:50%;width:35mm;height:35mm;object-fit:contain;transform:translate(-50%,-50%);z-index:2;pointer-events:none;opacity:1;filter:saturate(1.8) contrast(1.3) brightness(.9)}.official-seal-position .seal-target-label{position:relative;z-index:3;font-size:8pt;font-weight:700;color:#111}.official-seal-position small{position:relative;z-index:3;font-size:6.4pt;margin-top:.7mm;color:#111}.integrated-table .applicant-signature-seal{gap:.6mm;max-width:100%}.integrated-table .signature-name-slot{min-width:20mm;max-width:23mm}.integrated-table .signature-stamp-position{width:13mm;min-width:13mm;height:12mm}.integrated-table .signature-stamp-image{width:10mm;height:10mm}.integrated-table .signature-stamp-position .seal-target-label{font-size:6.5pt}.integrated-table .signature-stamp-position small{font-size:5.4pt;margin-top:.3mm}.office-destination{display:block;margin-top:4mm;font-size:10pt}.residence-notes{font-size:7.2pt!important;line-height:1.45!important;text-align:left!important;vertical-align:top!important}.paper-spec{text-align:right;font-size:6.5pt;margin-top:1mm}.form-lawline{font-size:7.3pt;margin-bottom:2mm}.form-lawline span{float:right}.form-instruction{font-size:7.2pt;margin:0 0 1.5mm}.integrated-table th,.integrated-table td{font-size:6.8pt;padding:1.1mm 1.2mm;line-height:1.1}.integrated-table th{width:auto}.integrated-application-head th{text-align:left;font-size:8pt}.photo-box{text-align:center;vertical-align:top!important;width:25mm}.fine-print{font-size:6.3pt!important;line-height:1.2!important;text-align:left!important}.paper-grey th{background:#d7d7d7;font-weight:800}.paper-footer-note{font-size:6.3pt;border-bottom:.65pt solid #111;padding:1mm 0}.visa-instructions{border-top:.7pt solid #111;border-bottom:.7pt solid #111;padding:2mm 0;margin-bottom:2mm;font-size:7.2pt;line-height:1.35}.visa-table th,.visa-table td{font-size:7.4pt;padding:1.6mm 1.6mm;line-height:1.2}.visa-photo{height:32mm}.visa-declaration{text-align:center;line-height:1.55!important;padding:5mm!important}.visa-notice-title{font-size:11pt;margin:2mm 0 3mm}.visa-notice-list{font-size:8pt;line-height:1.45;padding-left:6mm;margin:0 0 5mm}.visa-notice-list li{margin-bottom:3mm}.visa-notice-list small{font-size:7pt}.visa-purpose{line-height:1.7!important;text-align:center!important;word-spacing:1.2mm}@media print{.official-page{box-shadow:none;margin:0}.official-page:last-child{break-after:auto}}`;
      const documentHtml=(values,withShell=true)=>{
        const inner=`<div class="official-document-stack">${documentBody(values)}</div>`;
        if(!withShell)return inner;
        return `<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>${esc(typeShort[formType])}</title><style>${printCss}</style></head><body>${inner}</body></html>`;
      };
      const eventForRecord=async(event)=>{
        if(!recordId)return;
        await api('/api/foreign-forms/action',{action:'event',id:recordId,event});
      };
      const saveCurrent=async(silent=false)=>{
        if(!validateForm())return false;
        if(!silent)setStatus('저장 중입니다...');
        const result=await api('/api/foreign-forms/action',{action:'save',id:recordId||undefined,formType,snapshot:getValues()});
        if(!result.ok){setStatus(result.message||'저장에 실패했습니다.','error');return false;}
        recordId=result.row.id||recordId;recordNo=result.row.record_no||recordNo;recordStatus=result.row.status||recordStatus;
        updateRecordBanner();
        if(!silent)setStatus(result.message||'저장했습니다.','ok');
        loadLedger();
        return true;
      };
      const openPrint=async(values)=>{
        const popup=window.open('','_blank');
        if(!popup){setStatus('팝업이 차단되었습니다. 브라우저에서 팝업을 허용해 주세요.','error');return;}
        try{popup.opener=null;}catch{}
        popup.document.open();popup.document.write('<!doctype html><meta charset="utf-8"><p style="font-family:sans-serif;padding:24px">작성 이력을 저장하고 출력본을 준비하고 있습니다...</p>');popup.document.close();
        if(!(await saveCurrent(true))){popup.close();return;}
        await ensureSealAssets();
        values=getValues();
        popup.document.open();popup.document.write(documentHtml(values,true));popup.document.close();
        await eventForRecord('print');loadLedger();
        setTimeout(()=>{popup.focus();popup.print();},250);
      };

      $('[data-foreign-form]').addEventListener('submit',async(e)=>{
        e.preventDefault();
        await saveCurrent(false);
