          {name:'organizationPhone',label:'전화번호 / Telephone No.'},
          {section:'7. 방문정보 / DETAILS OF VISIT'},
          {name:'visitPurposes',label:'입국목적 / Purpose of Visit to Korea',type:'checks',wide:true,options:['관광/통과 / Tourism/Transit','행사참석 / Meeting, Conference','의료관광 / Medical Tourism','단기상용 / Business Trip','유학/연수 / Study/Training','취업활동 / Work','무역/투자/주재 / Trade/Investment/Intra-Corporate Transferee','가족 또는 친지방문 / Visiting Family/Relatives/Friends','결혼이민 / Marriage Migrant','외교/공무 / Diplomatic/Official','기타 / Other']},
          {name:'visitPurposeOther',label:'입국목적 기타 / Purpose - Other'},
          {name:'occupationCode',label:'한국표준직업분류코드 / Occupation Code'},
          {name:'industryCode',label:'한국표준산업분류코드 / Industry Code'},
          {name:'intendedStayPeriod',label:'체류예정기간 / Intended Period of Stay'},
          {name:'intendedEntryDate',label:'입국예정일 / Intended Date of Entry',type:'date'},
          {name:'addressInKorea',label:'체류예정지(호텔 포함) / Address in Korea',type:'textarea',wide:true},
          {name:'contactInKorea',label:'한국 내 연락처 / Contact No. in Korea'},
          {name:'visitedKorea5Years',label:'과거 5년간 한국 방문 여부 / Travelled to Korea in last 5 years',type:'select',options:['아니오 / No','예 / Yes']},
          {name:'koreaVisitCount',label:'한국 방문 횟수 / Number of trips',type:'number'},
          {name:'recentKoreaVisitPurpose',label:'최근 방문목적 / Purpose of Recent Visit'},
          {name:'otherCountries5Years',label:'한국 외 과거 5년 여행 국가 상세 / Other Countries Visited',type:'textarea',wide:true},
          {name:'familyInKorea',label:'국내 체류 가족 상세 / Family Member(s) Staying in Korea',type:'textarea',wide:true},
          {name:'accompanyingFamily',label:'동반입국 가족 상세 / Accompanying Family Member(s)',type:'textarea',wide:true},
          {section:'8. 서류 작성 시 도움 여부 / ASSISTANCE WITH THIS FORM'},
          {name:'assistanceUsed',label:'다른 사람의 도움을 받았는지 여부 / Received Assistance',type:'select',options:['아니오 / No','예 / Yes']},
          {name:'assistantName',label:'도움 제공자 성명 / Full Name'},
          {name:'assistantDob',label:'도움 제공자 생년월일 / Date of Birth',type:'date'},
          {name:'assistantPhone',label:'도움 제공자 연락처 / Phone No.'},
          {name:'assistantRelationship',label:'신청인과의 관계 / Relationship'},
          {section:'9. 초청 정보 / DETAILS OF INVITATION'},
          {name:'invitationExists',label:'초청인/초청회사 여부 / Inviting Person or Organization',type:'select',options:['아니오 / No','예 / Yes']},
          {name:'inviterName',label:'초청인/초청회사명 / Name of inviting person/organization'},
          {name:'inviterIdentityNo',label:'생년월일/사업자등록번호 / Date of Birth / Business Registration No.'},
          {name:'inviterRelationship',label:'신청인과의 관계 / Relationship'},
          {name:'inviterAddress',label:'주소 / Address',type:'textarea',wide:true},
          {name:'inviterPhone',label:'전화번호 / Phone No.'},
          {name:'applicationDate',label:'신청일자 / DATE OF APPLICATION',type:'date',required:true},
          {name:'inviterSignatureName',label:'신청인(초청인) 성명 / NAME OF APPLICANT(INVITING PERSON)',required:true},
          {name:'adminInfoConsent',label:'행정정보 공동이용 동의 / Consent for sharing administrative information',type:'select',options:['동의 / Agree','미동의 / Disagree']},
          {name:'consentApplicantName',label:'동의 신청인 성명 / NAME OF APPLICANT'},
        ],
      };

      let formType='거주숙소제공확인서';
      let recordId='';
      let recordNo='';
      let recordStatus='저장';
      let page=1,pages=1,currentRows=[];

      const api=async(url,payload)=>{
        try{
          const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:session.token,...payload})});
          const data=await response.json().catch(()=>({ok:false,message:'서버 응답을 확인할 수 없습니다.'}));
          if(!data.ok&&response.status===401){localStorage.removeItem('milgyo-system-session');location.replace('/');}
          return data;
        }catch(error){console.error('foreign forms request failed',error);return{ok:false,message:'서버에 연결할 수 없습니다.'};}
      };
      const setStatus=(message,kind='')=>{const el=$('[data-form-status]');if(!el)return;el.textContent=message||'';el.dataset.kind=kind;};
      const today=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,10);

      const fieldHtml=(field)=>{
        if(field.section)return `<h3 class="foreign-section-title">${esc(field.section)}</h3>`;
        const req=field.required?' required':'';
        const wide=field.wide?' form-field--wide':'';
        if(field.type==='textarea')return `<div class="form-field${wide}"><label>${esc(field.label)}${field.required?' <b>*</b>':''}</label><textarea name="${esc(field.name)}" rows="3"${req}></textarea></div>`;
        if(field.type==='select')return `<div class="form-field${wide}"><label>${esc(field.label)}${field.required?' <b>*</b>':''}</label><select name="${esc(field.name)}"${req}><option value="">선택</option>${field.options.map(o=>`<option value="${esc(o)}">${esc(o)}</option>`).join('')}</select></div>`;
        if(field.type==='checks')return `<div class="form-field${wide}"><span class="field-label">${esc(field.label)}</span><div class="check-grid">${field.options.map(o=>`<label><input type="checkbox" name="${esc(field.name)}" value="${esc(o)}"/> ${esc(o)}</label>`).join('')}</div></div>`;
        return `<div class="form-field${wide}"><label>${esc(field.label)}${field.required?' <b>*</b>':''}</label><input name="${esc(field.name)}" type="${esc(field.type||'text')}"${req}/></div>`;
      };
      const renderForm=(values={})=>{
        const host=$('[data-form-host]');
        host.innerHTML=`<div class="form-grid foreign-form-grid">${schemas[formType].map(fieldHtml).join('')}</div>`;
        for(const [name,value] of Object.entries(values||{})){
          const inputs=$$(`[name="${CSS.escape(name)}"]`,host);
          if(!inputs.length)continue;
          if(inputs[0].type==='checkbox'){
            const values=Array.isArray(value)?value:[value];
            inputs.forEach(input=>input.checked=values.includes(input.value));
          }else inputs[0].value=value??'';
        }
        if(!values?.confirmationDate&&formType==='거주숙소제공확인서') $('[name="confirmationDate"]',host).value=today();
        if(!values?.applicationDate&&formType!=='거주숙소제공확인서') $('[name="applicationDate"]',host).value=today();
        window.__MILGYO_SYNC_MANAGED_DATES__?.(host);
      };
      const getValues=()=>{
        const form=$('[data-foreign-form]');
        const data={};
        for(const field of schemas[formType]){
          if(!field.name)continue;
          if(field.type==='checks')data[field.name]=$$(`[name="${CSS.escape(field.name)}"]:checked`,form).map(el=>el.value);
          else data[field.name]=form.elements.namedItem(field.name)?.value??'';
        }
        return data;
      };
      const validateForm=()=>{
        const form=$('[data-foreign-form]');
        if(!form.reportValidity())return false;
        return true;
      };
      const updateRecordBanner=()=>{
        const banner=$('[data-record-banner]');
        banner.hidden=!recordId;
        $('[data-record-number]').textContent=recordNo||'-';
        $('[data-record-status]').textContent=recordStatus||'저장';
      };
      const resetRecord=()=>{
        recordId='';recordNo='';recordStatus='저장';updateRecordBanner();setStatus('');
        renderForm({});
      };
      const selectType=(nextType,values={})=>{
        formType=nextType;
        $$('[data-form-type]').forEach(btn=>btn.classList.toggle('active',btn.dataset.formType===formType));
        resetRecord();
        renderForm(values);
      };

      const printableSections=(values)=>{
        const sections=[];let current={title:'',rows:[]};sections.push(current);
        for(const field of schemas[formType]){
          if(field.section){current={title:field.section,rows:[]};sections.push(current);continue;}
          let value=values[field.name];
          if(Array.isArray(value))value=value.length?`☑ ${value.join('\n☑ ')}`:'';
          current.rows.push({label:field.label,value:value||''});
        }
        return sections.filter(s=>s.rows.length);
      };
      const documentHtml=(values,withShell=true)=>{
        const sections=printableSections(values);
        const inner=`<article class="official-document">
          <header><h1>${esc(typeTitles[formType])}</h1>${recordNo?`<p class="record-no">관리번호 ${esc(recordNo)}</p>`:''}</header>
          ${sections.map(section=>`<section>${section.title?`<h2>${esc(section.title)}</h2>`:''}<table>${section.rows.map(row=>`<tr><th>${esc(row.label)}</th><td>${esc(String(row.value||'')).replace(/\n/g,'<br>')}</td></tr>`).join('')}</table></section>`).join('')}
          <p class="print-note">본 문서는 종단관리시스템에서 작성·출력한 웹 작성본입니다. 제출 전 관할 출입국·외국인관서의 최신 서식 및 필수 첨부서류를 확인하십시오.</p>
        </article>`;
        if(!withShell)return inner;
        return `<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>${esc(typeShort[formType])}</title><style>
          @page{size:A4;margin:12mm}*{box-sizing:border-box}body{font-family:Arial,"Noto Sans KR",sans-serif;color:#111;margin:0}.official-document{max-width:186mm;margin:0 auto}.official-document header{text-align:center;margin-bottom:14px}.official-document h1{font-size:19px;margin:0 0 6px;line-height:1.35}.record-no{font-size:11px;text-align:right}.official-document h2{font-size:13px;background:#f1f3f5;border:1px solid #222;border-bottom:0;padding:6px;margin:10px 0 0}.official-document table{width:100%;border-collapse:collapse;table-layout:fixed}.official-document th,.official-document td{border:1px solid #222;padding:6px;vertical-align:top;font-size:11px;line-height:1.45}.official-document th{width:39%;background:#fafafa;text-align:left}.print-note{font-size:9px;color:#555;margin-top:10px}</style></head><body>${inner}</body></html>`;
      };
      const eventForRecord=async(event)=>{
        if(!recordId)return;
        await api('/api/foreign-forms/action',{action:'event',id:recordId,event});
      };
      const saveCurrent=async(silent=false)=>{
        if(!validateForm())return false;
        if(!silent)setStatus('저장 중입니다...');
        const result=await api('/api/foreign-forms/action',{action:'save',id:recordId||undefined,formType,snapshot:getValues()});
        if(!result.ok){setStatus(result.message||'저장에 실패했습니다.','error');return false;}
        recordId=result.row.id||recordId;recordNo=result.row.record_no||recordNo;recordStatus=result.row.status||recordStatus;
        updateRecordBanner();
        if(!silent)setStatus(result.message||'저장했습니다.','ok');
        loadLedger();
        return true;
      };
      const openPrint=async(values)=>{
        const popup=window.open('','_blank');
        if(!popup){setStatus('팝업이 차단되었습니다. 브라우저에서 팝업을 허용해 주세요.','error');return;}
        try{popup.opener=null;}catch{}
        popup.document.open();popup.document.write('<!doctype html><meta charset="utf-8"><p style="font-family:sans-serif;padding:24px">작성 이력을 저장하고 출력본을 준비하고 있습니다...</p>');popup.document.close();
        if(!(await saveCurrent(true))){popup.close();return;}
        values=getValues();
        popup.document.open();popup.document.write(documentHtml(values,true));popup.document.close();
        await eventForRecord('print');loadLedger();
        setTimeout(()=>{popup.focus();popup.print();},250);
      };

      $('[data-foreign-form]').addEventListener('submit',async(e)=>{
        e.preventDefault();
        await saveCurrent(false);
      });

      $$('[data-form-type]').forEach(btn=>btn.addEventListener('click',()=>selectType(btn.dataset.formType)));
      $('[data-new-form]').addEventListener('click',()=>resetRecord());
      $('[data-preview]').addEventListener('click',()=>{
        if(!validateForm())return;
        $('[data-preview-container]').innerHTML=documentHtml(getValues(),false);
        $('[data-preview-modal]').hidden=false;
      });
      $$('[data-close-preview]').forEach(btn=>btn.addEventListener('click',()=>{ $('[data-preview-modal]').hidden=true; }));
      $('[data-print-preview]').addEventListener('click',()=>openPrint(getValues()));
      $('[data-print]').addEventListener('click',()=>{if(validateForm())openPrint(getValues());});
      $('[data-download]').addEventListener('click',async()=>{
        if(!(await saveCurrent(true)))return;
        const blob=new Blob([documentHtml(getValues(),true)],{type:'text/html;charset=utf-8'});
        const url=URL.createObjectURL(blob);const a=document.createElement('a');
        const safe=(recordNo||typeShort[formType]).replace(/[\\/:*?"<>|]/g,'_');
        a.href=url;a.download=`${safe}.html`;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
        await eventForRecord('download');loadLedger();setStatus('작성본을 HTML 파일로 다운로드했습니다. 인쇄 메뉴에서 PDF로도 저장할 수 있습니다.','ok');
      });

      const fmtDate=(value)=>{if(!value)return'-';const d=new Date(value);return Number.isNaN(d.getTime())?String(value):d.toLocaleString('ko-KR',{timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});};
      const loadLedger=async(targetPage=page)=>{
        const result=await api('/api/foreign-forms/query',{
          mode:'list',page:targetPage,size:Number($('[data-ledger-size]').value)||20,
          formType:$('[data-ledger-type]').value,status:$('[data-ledger-status]').value,
          from:$('[data-ledger-from]').value,to:$('[data-ledger-to]').value,query:$('[data-ledger-query]').value
        });
        const body=$('[data-ledger-body]');
        if(!result.ok){body.innerHTML=`<tr><td colspan="10">${esc(result.message||'목록을 불러오지 못했습니다.')}</td></tr>`;return;}
        currentRows=result.rows||[];page=result.pagination.page;pages=result.pagination.pages;
        body.innerHTML=currentRows.length?currentRows.map(row=>`<tr>
          <td>${esc(row.record_no)}</td><td>${esc(fmtDate(row.created_at))}</td><td>${esc(typeShort[row.form_type]||row.form_type)}</td>
          <td>${esc(row.subject_name||'-')}</td><td>${esc(row.nationality||'-')}</td><td>${esc(row.created_by_name||'-')}</td>
          <td>${Number(row.print_count||0)}회</td><td>${Number(row.download_count||0)}회</td>
          <td><span class="status-pill ${row.status==='취소'?'status-pill--cancel':''}">${esc(row.status)}</span></td>
          <td class="manage-cell"><button type="button" class="btn btn-outline btn-sm" data-open-record="${esc(row.id)}">열기</button>${row.status!=='취소'?`<button type="button" class="btn btn-outline btn-sm" data-cancel-record="${esc(row.id)}">취소</button>`:''}</td>
        </tr>`).join(''):`<tr><td colspan="10">저장된 작성 이력이 없습니다.</td></tr>`;
        renderPagination();
      };
      const renderPagination=()=>{
        const host=$('[data-ledger-pagination]');host.innerHTML='';
        const make=(label,target,disabled=false,active=false)=>{const b=document.createElement('button');b.type='button';b.className=`btn btn-outline btn-sm${active?' active':''}`;b.textContent=label;b.disabled=disabled;b.addEventListener('click',()=>loadLedger(target));return b;};
        host.append(make('이전',Math.max(1,page-1),page<=1));
        const start=Math.max(1,page-2),end=Math.min(pages,start+4);
        for(let p=start;p<=end;p++)host.append(make(String(p),p,false,p===page));
        host.append(make('다음',Math.min(pages,page+1),page>=pages));
      };
      $('[data-ledger-body]').addEventListener('click',async(e)=>{
        const open=e.target.closest('[data-open-record]');
        if(open){
          const result=await api('/api/foreign-forms/query',{mode:'detail',id:open.dataset.openRecord});
          if(!result.ok){$('[data-ledger-message]').textContent=result.message||'기록을 불러오지 못했습니다.';return;}
          const row=result.row;formType=row.form_type;recordId=row.id;recordNo=row.record_no;recordStatus=row.status;
          $$('[data-form-type]').forEach(btn=>btn.classList.toggle('active',btn.dataset.formType===formType));
          renderForm(row.snapshot||{});updateRecordBanner();window.scrollTo({top:0,behavior:'smooth'});setStatus('저장된 작성 이력을 불러왔습니다.','ok');return;
        }
        const cancel=e.target.closest('[data-cancel-record]');
        if(cancel){
          if(!confirm('이 작성 이력을 취소 상태로 변경하시겠습니까? 원본 데이터는 감사 이력을 위해 삭제되지 않습니다.'))return;
          const result=await api('/api/foreign-forms/action',{action:'cancel',id:cancel.dataset.cancelRecord});
          $('[data-ledger-message]').textContent=result.message||'';if(result.ok)loadLedger();
        }
      });
      $('[data-ledger-search]').addEventListener('click',()=>loadLedger(1));
      $('[data-ledger-size]').addEventListener('change',()=>loadLedger(1));
      $('[data-ledger-query]').addEventListener('keydown',(e)=>{if(e.key==='Enter'){e.preventDefault();loadLedger(1);}});
      $('[data-ledger-export]').addEventListener('click',()=>{
        if(!currentRows.length)return;
        const headers=['기록번호','작성일','서식','대상자','국적','작성자','출력횟수','다운로드횟수','상태'];
        const rows=currentRows.map(r=>[r.record_no,r.created_at,typeShort[r.form_type]||r.form_type,r.subject_name,r.nationality,r.created_by_name,r.print_count,r.download_count,r.status]);
        const csvSafe=(value)=>{const text=String(value??'');return /^[\s]*[=+\-@]/.test(text)?`'${text}`:text;};
        const csv=[headers,...rows].map(row=>row.map(v=>`"${csvSafe(v).replaceAll('\"','\"\"')}"`).join(',')).join('\r\n');
        const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='외국인신청서_작성대장.csv';a.click();URL.revokeObjectURL(url);
      });

      renderForm({});
      loadLedger(1);
    })();
  </script>

