        if(!state.users.length)u=await api('/api/users/list',{});
        state={...state,...d,year:Number(d.year||state.year)};
        if(u)state.users=u.rows||[];
        renderYearOptions(d.fiscalYears||[]);
        populateAccounts();populateDepartments();populateDimensions();
        if(!$('[data-journal-lines]').children.length){addJournalLine({accountCode:'5400',department:me.department||''});addJournalLine({accountCode:'1120',department:me.department||''});}
        renderSummary();renderRecent(d.recentResolutions);setPermissions();renderIntegration(d.integration);populateUsers();renderAccounts();renderMonths(d.closings||[]);
        $('[data-app]').hidden=false;
      }catch(e){
        if(e.status===403){alert(e.message);location.replace('/');return;}
        notice(e.message,'error');
      }};
      $('[data-global-year]').addEventListener('change',async(e)=>{state.year=Number(e.target.value);await loadInit();showTab($('.acc-nav.active').dataset.tab)});
      const retryIntegrationButton=$('[data-retry-integration]');
      if(retryIntegrationButton)retryIntegrationButton.addEventListener('click',async()=>{
        retryIntegrationButton.disabled=true;
        try{const d=await api('/api/accounting/action',{action:'retry-integration'});notice(d.message||'회계 연계를 재처리했습니다.');await loadInit();}
        catch(e){notice(e.message,'error')}finally{retryIntegrationButton.disabled=false}
      });

      $$('.money-input').forEach((input)=>{input.addEventListener('blur',()=>{const n=moneyValue(input.value);if(input.value.trim())input.value=n.toLocaleString('ko-KR')});});

      const loadBudgets=async()=>{try{const d=await api('/api/accounting/query',{action:'budgets',year:state.year});state.budgetRows=d.rows||[];const body=$('[data-budget-rows]');body.innerHTML=state.budgetRows.length?state.budgetRows.map((r)=>{const revised=Number(r.revised_amount||0),executed=Number(r.executed_amount||0),balance=revised-executed,rate=revised?executed/revised*100:0;return `<tr><td class="cell-center">${esc(r.book_type_name||r.book_type_code)}</td><td class="cell-center">${esc(r.entity_name||'-')}</td><td class="cell-center">${esc(r.fund_name||'-')}</td><td class="cell-center">${esc(r.department||'-')}</td><td class="cell-center">${esc(r.project||'-')}</td><td class="cell-center">${esc(r.account_code)} ${esc(r.account_name)}</td><td class="cell-number">${won(r.original_amount)}</td><td class="cell-number">${won(Number(r.supplementary_amount)+Number(r.transfer_in)-Number(r.transfer_out))}</td><td class="cell-number">${won(revised)}</td><td class="cell-number">${won(executed)}</td><td class="cell-number ${balance<0?'negative':''}">${won(balance)}</td><td class="cell-center">${rate.toFixed(1)}%</td></tr>`}).join(''):'<tr><td colspan="12" class="empty">편성된 예산이 없습니다.</td></tr>'}catch(e){notice(e.message,'error')}};
      $('[data-form="budget-form"]').addEventListener('submit',async(e)=>{e.preventDefault();const f=e.currentTarget;try{await api('/api/accounting/action',{action:'save-budget',year:state.year,bookTypeCode:f.bookTypeCode.value,entityId:f.entityId.value,fundId:f.fundId.value,department:f.department.value,project:f.project.value,accountCode:f.accountCode.value,originalAmount:f.originalAmount.value,supplementaryAmount:f.supplementaryAmount.value,transferIn:f.transferIn.value,transferOut:f.transferOut.value,memo:f.memo.value});notice('예산을 저장했습니다.');f.hidden=true;loadBudgets()}catch(err){notice(err.message,'error')}});

      const loadResolutions=async()=>{try{const d=await api('/api/accounting/query',{action:'resolutions',year:state.year,status:$('[data-resolution-status]').value,query:$('[data-resolution-search]').value});const rows=d.rows||[];$('[data-resolution-rows]').innerHTML=rows.length?rows.map((r)=>`<tr><td class="cell-center">${esc(r.resolution_no)}</td><td class="cell-center">${typeLabel(r.resolution_type)}</td><td class="cell-center">${esc(r.resolution_date)}</td><td class="cell-center">${esc(r.title)}<small>${esc(r.counterparty||'')}</small></td><td class="cell-center">${esc(r.account_code)} ${esc(r.account_name||'')}</td><td class="cell-number">${won(r.amount)}</td><td class="cell-center">${esc(r.document_id||'-')}</td><td class="cell-center"><span class="status status-${esc(r.status)}">${statusLabel(r.status)}</span></td><td class="cell-center"><button type="button" class="mini-btn" data-open-resolution-attachments="${esc(r.id)}" data-resolution-title="${esc(r.title)}">첨부관리</button></td></tr>`).join(''):'<tr><td colspan="9" class="empty">결의서가 없습니다.</td></tr>';$$('[data-open-resolution-attachments]').forEach((button)=>button.addEventListener('click',()=>openResolutionAttachmentModal(button.dataset.openResolutionAttachments,button.dataset.resolutionTitle||'')));}catch(e){notice(e.message,'error')}};
      $('[data-load-resolutions]').addEventListener('click',loadResolutions);
      const resolutionForm=$('[data-form="resolution-form"]');resolutionForm.elements.resolutionDate.value=today();resolutionForm.elements.department.value=me.department||'';
      resolutionForm.addEventListener('submit',async(e)=>{
        e.preventDefault();
        const f=e.currentTarget;
        const selected=(el)=>Array.from(el.selectedOptions).map((option)=>option.value);
        const submitButton=f.querySelector('button[type="submit"]');
        const queuedFiles=[...resolutionPendingFiles];
        const resolutionTitle=f.title.value;
        submitButton.disabled=true;
        try{
          const d=await api('/api/accounting/action',{
            action:'create-resolution',
            resolutionType:f.resolutionType.value,
            resolutionDate:f.resolutionDate.value,
            title:f.title.value,
            amount:f.amount.value,
            taxAmount:f.taxAmount.value,
            counterparty:f.counterparty.value,
            department:f.department.value,
            project:f.project.value,
            accountCode:f.accountCode.value,
            settlementAccountCode:f.settlementAccountCode.value,
            bookTypeCode:f.bookTypeCode.value,
            entityId:f.entityId.value,
            fundId:f.fundId.value,
            paymentMethod:f.paymentMethod.value,
            memo:f.memo.value,
            cooperatorUserIds:selected(f.cooperatorUserIds),
            reviewerUserIds:selected(f.reviewerUserIds),
            approverUserId:f.approverUserId.value,
            allowOverBudget:f.allowOverBudget?.checked,
          });

          let uploaded=0;
          let uploadError=null;
          for(const file of queuedFiles){
            try{
              await uploadAccountingAttachment('resolution',d.id,file);
              uploaded+=1;
            }catch(error){
              uploadError=error;
              break;
            }
          }

          resolutionPendingFiles=[];
          syncAttachmentQueues();
          f.reset();
          f.resolutionDate.value=today();
          f.department.value=me.department||'';
          f.hidden=true;
          updateResolutionAccount();
          await loadInit();
          populateDimensions();
          await loadResolutions();

          if(uploadError){
            notice(`결의서는 정상 등록되었습니다. 첨부파일 ${uploaded}건 등록 후 오류가 발생했습니다: ${uploadError.message}`,'error');
            await openResolutionAttachmentModal(d.id,resolutionTitle||d.resolutionNo||'');
            return;
          }

          notice(queuedFiles.length?`${d.message} 첨부파일 ${uploaded}건을 등록했습니다.`:d.message);
          if(uploaded)await openResolutionAttachmentModal(d.id,resolutionTitle||d.resolutionNo||'');
        }catch(err){
          notice(err.message,'error');
        }finally{
          submitButton.disabled=false;
        }
      });

      const addJournalLine=(values={})=>{const row=document.createElement('div');row.className='journal-line';row.innerHTML=`<select data-line-account aria-label="계정과목">${accountOptions(()=>true)}</select><input data-line-debit class="money-input" inputmode="decimal" placeholder="차변" aria-label="차변"><input data-line-credit class="money-input" inputmode="decimal" placeholder="대변" aria-label="대변"><select data-line-department aria-label="부서">${departmentOptions()}</select><input data-line-project placeholder="사업" aria-label="사업"><input data-line-counterparty placeholder="거래처" aria-label="거래처"><button type="button" class="icon-btn" title="삭제" aria-label="분개행 삭제">×</button>`;row.querySelector('[data-line-account]').value=values.accountCode||'';row.querySelector('[data-line-debit]').value=values.debit||'';row.querySelector('[data-line-credit]').value=values.credit||'';row.querySelector('[data-line-department]').value=values.department||'';row.querySelector('[data-line-project]').value=values.project||'';row.querySelector('[data-line-counterparty]').value=values.counterparty||'';row.querySelector('.icon-btn').onclick=()=>{row.remove();syncJournalTotal()};row.querySelectorAll('input').forEach((i)=>i.addEventListener('input',syncJournalTotal));$('[data-journal-lines]').append(row);};
      const syncJournalTotal=()=>{let d=0,c=0;$$('[data-journal-lines] .journal-line').forEach((r)=>{d+=moneyValue(r.querySelector('[data-line-debit]').value);c+=moneyValue(r.querySelector('[data-line-credit]').value)});$('[data-debit-total]').textContent=won(d);$('[data-credit-total]').textContent=won(c);const b=$('[data-journal-balance]');b.textContent=d===c&&d>0?'일치':`차이 ${won(d-c)}`;b.classList.toggle('negative',d!==c)};
      $('[data-add-journal-line]').addEventListener('click',()=>addJournalLine({department:me.department||''}));
      $('[data-form="journal-form"]').elements.journalDate.value=today();
      $('[data-form="journal-form"]').addEventListener('submit',async(e)=>{e.preventDefault();const f=e.currentTarget;const lines=$$('[data-journal-lines] .journal-line').map((r)=>({accountCode:r.querySelector('[data-line-account]').value,debit:r.querySelector('[data-line-debit]').value,credit:r.querySelector('[data-line-credit]').value,department:r.querySelector('[data-line-department]').value,project:r.querySelector('[data-line-project]').value,counterparty:r.querySelector('[data-line-counterparty]').value}));try{const d=await api('/api/accounting/action',{action:'create-manual-journal',journalDate:f.journalDate.value,description:f.description.value,bookTypeCode:f.bookTypeCode.value,entityId:f.entityId.value,fundId:f.fundId.value,lines});notice(`${d.journalNo} 전표를 등록했습니다.`);f.hidden=true;f.reset();f.journalDate.value=today();populateDimensions();$('[data-journal-lines]').innerHTML='';addJournalLine({accountCode:'5400',department:me.department||''});addJournalLine({accountCode:'1120',department:me.department||''});await loadInit();loadJournals()}catch(err){notice(err.message,'error')}});
      const loadJournals=async()=>{try{const d=await api('/api/accounting/query',{action:'journals',year:state.year,query:$('[data-journal-search]').value});$('[data-journal-rows]').innerHTML=(d.rows||[]).length?d.rows.map((r)=>`<tr><td class="cell-center">${esc(r.journal_no)}</td><td class="cell-center">${esc(r.journal_date)}</td><td class="cell-center">${esc(r.source_type==='resolution'?'결의자동':r.source_type==='reversal'?'역분개':'수동')}</td><td class="cell-center">${esc(r.description)}</td><td class="cell-number">${won(r.debit_total)}</td><td class="cell-number">${won(r.credit_total)}</td><td class="cell-center">${esc(r.document_id||'-')}</td><td class="cell-center">${statusLabel(r.status)}</td><td class="cell-center">${state.permissions.manager&&r.status==='posted'?`<button class="mini-btn" data-reverse="${esc(r.id)}">취소</button>`:''}</td></tr>`).join(''):'<tr><td colspan="9" class="empty">전표가 없습니다.</td></tr>';$$('[data-reverse]').forEach((b)=>b.onclick=async()=>{if(!confirm('원전표를 삭제하지 않고 반대 분개로 취소하시겠습니까?'))return;try{const x=await api('/api/accounting/action',{action:'reverse-journal',id:b.dataset.reverse});notice(x.message);loadJournals();loadInit()}catch(err){notice(err.message,'error')}})}catch(e){notice(e.message,'error')}};
      $('[data-load-journals]').addEventListener('click',loadJournals);

      const loadLedger=async()=>{
        const code=$('[data-ledger-account]').value;
        if(!code){
          state.ledgerRows=[];
          $('[data-ledger-rows]').innerHTML='<tr><td colspan="8" class="empty">계정과목을 선택하면 거래내역이 표시됩니다.</td></tr>';
          return;
        }
        try{
          const d=await api('/api/accounting/query',{action:'ledger',year:state.year,accountCode:code});
          state.ledgerRows=d.rows||[];
          $('[data-ledger-rows]').innerHTML=state.ledgerRows.length?state.ledgerRows.map((r)=>`<tr><td>${esc(r.journal_date)}</td><td>${esc(r.journal_no)}</td><td>${esc(r.description)}</td><td>${esc(r.counterparty||'-')}</td><td>${esc([r.department,r.project].filter(Boolean).join(' / ')||'-')}</td><td class="num">${won(r.debit)}</td><td class="num">${won(r.credit)}</td><td class="num">${won(r.running_balance)}</td></tr>`).join(''):'<tr><td colspan="8" class="empty">선택한 계정과목의 거래내역이 없습니다.</td></tr>';
        }catch(e){notice(e.message,'error')}
      };
      $('[data-ledger-account]').addEventListener('change',(e)=>{
        $('[data-load-ledger]').disabled=!e.currentTarget.value;
        if(!e.currentTarget.value){
          state.ledgerRows=[];
          $('[data-ledger-rows]').innerHTML='<tr><td colspan="8" class="empty">계정과목을 선택하면 거래내역이 표시됩니다.</td></tr>';
        }
      });
      $('[data-load-ledger]').addEventListener('click',loadLedger);
      const loadTrial=async()=>{try{const d=await api('/api/accounting/query',{action:'trial-balance',year:state.year});const rows=d.rows||[];$('[data-trial-rows]').innerHTML=rows.map((r)=>`<tr><td class="cell-center">${esc(r.code)}</td><td class="cell-center">${esc(r.name)}</td><td class="cell-center">${typeLabel(r.account_type)}</td><td class="cell-number">${won(r.debit)}</td><td class="cell-number">${won(r.credit)}</td><td class="cell-number">${won(r.balance)}</td></tr>`).join('');$('[data-trial-debit]').textContent=won(rows.reduce((s,r)=>s+Number(r.debit),0));$('[data-trial-credit]').textContent=won(rows.reduce((s,r)=>s+Number(r.credit),0))}catch(e){notice(e.message,'error')}};
      $('[data-load-trial]').addEventListener('click',loadTrial);

      const renderMonths=(closedRows)=>{const map=new Map(closedRows.map((r)=>[Number(r.period_month),r]));$('[data-month-grid]').innerHTML=Array.from({length:12},(_,i)=>i+1).map((m)=>{const row=map.get(m),closed=!!row;const attachment=closed?`<button class="mini-btn" data-generic-attachments data-reference-type="closing" data-reference-id="${esc(row.id)}" data-reference-title="${state.year}년 ${m}월 결산·마감" data-file-category="report">첨부관리</button>`:'-';return `<tr class="${closed?'month-row--closed':''}"><td class="cell-center"><strong>${m}월</strong></td><td class="cell-center"><span class="month-status ${closed?'month-status--closed':'month-status--open'}">${closed?'마감':'진행 중'}</span></td><td class="cell-center">${attachment}</td><td class="cell-center">${state.permissions.manager?`<button class="mini-btn" data-period-action="${closed?'reopen-period':'close-period'}" data-month="${m}">${closed?'마감해제':'마감'}</button>`:'-'}</td></tr>`}).join('');$$('[data-period-action]').forEach((b)=>b.onclick=async()=>{const msg=b.dataset.periodAction==='close-period'?`${state.year}년 ${b.dataset.month}월을 마감하시겠습니까?`:'마감을 해제하시겠습니까?';if(!confirm(msg))return;try{const d=await api('/api/accounting/action',{action:b.dataset.periodAction,year:state.year,month:Number(b.dataset.month)});notice(d.message);loadClosing()}catch(e){notice(e.message,'error')}})};
      const loadClosing=async()=>{try{const [c,s]=await Promise.all([api('/api/accounting/query',{action:'closings',year:state.year}),api('/api/accounting/query',{action:'statement',year:state.year})]);renderMonths(c.rows||[]);state.statementRows=s.rows||[];$('[data-statement-rows]').innerHTML=state.statementRows.filter((r)=>Number(r.balance)!==0).map((r)=>`<tr><td>${typeLabel(r.account_type)}</td><td>${esc(r.code)}</td><td class="left">${esc(r.name)}</td><td class="num">${won(r.balance)}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">결산 내역이 없습니다.</td></tr>'}catch(e){notice(e.message,'error')}};

      const renderAccounts=()=>{$('[data-account-rows]').innerHTML=state.accounts.map((a)=>`<tr><td class="cell-center">${esc(a.code)}</td><td class="cell-center">${esc(a.name)}</td><td class="cell-center">${typeLabel(a.account_type)}</td><td class="cell-center">${typeLabel(a.normal_side)}</td><td class="cell-center">${esc(a.parent_code||'-')}</td><td class="cell-center">${a.system_account?'기본':'사용자'}</td></tr>`).join('')};
      $('[data-form="account-form"]').addEventListener('submit',async(e)=>{e.preventDefault();const f=e.currentTarget;try{await api('/api/accounting/action',{action:'save-account',code:f.code.value,name:f.name.value,accountType:f.accountType.value,normalSide:f.normalSide.value,parentCode:f.parentCode.value});notice('계정과목을 저장했습니다.');f.hidden=true;f.reset();await loadInit()}catch(err){notice(err.message,'error')}});

      const csv=(name,headers,rows)=>{const quote=(v)=>`"${String(v??'').replace(/"/g,'""')}"`;const content='\uFEFF'+[headers,...rows].map((r)=>r.map(quote).join(',')).join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type:'text/csv;charset=utf-8'}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
      $$('[data-export]').forEach((b)=>b.onclick=()=>{if(b.dataset.export==='budget')csv(`예산집행_${state.year}.csv`,['부서','사업','계정','현예산','집행','잔액'],state.budgetRows.map((r)=>[r.department,r.project,`${r.account_code} ${r.account_name}`,r.revised_amount,r.executed_amount,Number(r.revised_amount)-Number(r.executed_amount)]));if(b.dataset.export==='ledger')csv(`계정원장_${state.year}.csv`,['일자','전표번호','적요','거래처','차변','대변','잔액'],state.ledgerRows.map((r)=>[r.journal_date,r.journal_no,r.description,r.counterparty,r.debit,r.credit,r.running_balance]));if(b.dataset.export==='statement')csv(`수입지출결산_${state.year}.csv`,['구분','코드','계정과목','금액'],state.statementRows.map((r)=>[typeLabel(r.account_type),r.code,r.name,r.balance]));});

      loadInit();
    })();
  </script>

  <script src="/accounting-generic-attachments.js" defer></script>

  <style>
    .accounting-app{min-height:100vh;background:#eef2f7;color:#20252c}
    .acc-topbar{height:58px;background:linear-gradient(180deg,#315f9f 0%,#244d7c 100%);display:flex;align-items:center;justify-content:space-between;padding:0 1rem;color:#fff;box-shadow:0 2px 8px #17335433}
    .acc-brand{display:flex;align-items:center;gap:.5rem;min-width:0;color:#fff;text-decoration:none;white-space:nowrap}
    .acc-brand__logo{width:26px;height:26px;object-fit:contain;flex:0 0 26px}
    .acc-brand__title{min-width:0;display:inline-flex;align-items:center;gap:.48rem;overflow:hidden;white-space:nowrap}
    .acc-brand__wordmark{display:block;width:158px;height:auto;max-height:25px;object-fit:contain;filter:brightness(0) invert(1);flex:0 0 auto}
    .acc-brand__system-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:"Noto Serif KR","Nanum Myeongjo",Batang,serif;font-size:.98rem;font-weight:700;letter-spacing:.025em}
    .acc-topbar__right{display:flex;align-items:center;gap:.7rem;font-size:.85rem}
    .acc-shell{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:calc(100vh - 58px)}
    .acc-sidebar{background:#fff;border-right:1px solid #d4dce7;padding:18px 14px;display:flex;flex-direction:column}
    .acc-year-box{padding:12px;background:#f4f7fb;border:1px solid #d7dfeb;border-radius:8px;margin-bottom:14px}
    .acc-year-box label{display:block;font-size:12px;color:#667085;margin-bottom:6px}
    .acc-year-box select{width:100%}
    .acc-sidebar nav{display:grid;gap:4px}
    .acc-nav{display:flex;align-items:center;width:100%;text-decoration:none;border:0;background:transparent;text-align:left;padding:.58rem .65rem;border-radius:2px;font-family:inherit;font-size:.9rem;font-weight:400;line-height:1.35;color:#202733}
    .acc-nav:hover{background:#f2f4f7}.acc-nav.active{background:#e8effe;color:#315f9f;font-weight:700}.acc-special-link{display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;margin-top:10px;padding:.68rem .75rem;border:1px solid #b9c8dc;border-radius:4px;background:#fff;color:#243a58;font-family:inherit;font-size:.9rem;font-weight:700;line-height:1.3;text-decoration:none;box-shadow:0 1px 2px #1f3e6610}.acc-special-link:hover{background:#f5f8fc;border-color:#8fa8c7;color:#1f4f88}
    .acc-sidebar__note{margin-top:auto;padding:12px 6px;font-size:10px;line-height:1.55;letter-spacing:-.035em;color:#687386;border-top:1px solid #e2e8f0}
    .acc-sidebar__note span{display:block;white-space:nowrap}
    .acc-main{padding:22px;min-width:0}.tab-panel{display:none}.tab-panel.active{display:block}
