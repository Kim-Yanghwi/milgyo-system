---
import GovLayout from '../layouts/GovLayout.astro';
---
<GovLayout title="세무·신고자료 | 대한불교밀교종">
  <div class="tax-app" data-app data-accounting-tax-ui-version="2026-08-09-v68" hidden>
    <header class="topbar">
      <a href="/accounting-tax/" class="brand" aria-label="세무·신고자료 홈">
        <img src="/logo.png" alt="대한불교밀교종 로고" />
        <span><img src="/brand-wordmark.png" alt="대한불교밀교종" /><b>세무·신고자료</b></span>
      </a>
      <div class="top-actions">
        <span data-user-label></span>
        <a href="/" class="btn btn-outline">전자문서</a>
        <a href="/accounting/" class="btn btn-outline">기본 회계</a>
        <a href="/accounting-special/" class="btn btn-outline">특화회계</a>
        <button class="btn btn-outline" type="button" data-logout>로그아웃</button>
      </div>
    </header>

    <div class="shell">
      <aside class="sidebar">
        <div class="scope-box">
          <label>회계연도<select data-year></select></label>
          <label>회계조직<select data-scope-entity></select></label>
        </div>
        <nav>
          <button class="nav active" data-tab="overview">세무 현황·사전검증</button>
          <button class="nav" data-tab="profile">세무 기본정보</button>
          <button class="nav" data-tab="vat">부가가치세 보조장부</button>
          <button class="nav" data-tab="withholding">원천징수 보조장부</button>
          <button class="nav" data-tab="package">세무사 제출 패키지</button>
        </nav>
        <p class="side-note">이 화면은 신고자료 준비를 돕는 보조장부입니다. 최종 신고구분과 세율은 세무대리인 확인 후 확정해 주세요.</p>
      </aside>

      <main class="main">
        <div class="notice" data-notice hidden></div>

        <section class="panel active" data-panel="overview">
          <div class="heading"><div><p>TAX &amp; FILING</p><h1>세무 현황·제출 전 사전검증</h1><span>세무기본정보, 부가가치세, 원천징수와 회계자료 무결성을 한 번에 확인합니다.</span></div><button class="btn btn-outline" type="button" data-refresh-overview>다시 점검</button></div>
          <div class="summary-grid">
            <button type="button" data-jump="profile"><span>세무기본정보</span><strong data-summary-profile>미확정</strong><small>단체 지위·신고기준 확인</small></button>
            <button type="button" data-jump="vat"><span>부가가치세 자료</span><strong data-summary-vat>0건</strong><small data-summary-vat-detail>매입·매출 0원</small></button>
            <button type="button" data-jump="withholding"><span>원천징수 자료</span><strong data-summary-withholding>0건</strong><small data-summary-withholding-detail>미신고 0건</small></button>
            <button type="button" data-jump="package"><span>제출 패키지</span><strong data-summary-exports>0회</strong><small>생성 이력</small></button>
          </div>
          <div class="card validation-card">
            <div class="card-head"><div><h2>자동검증 결과</h2><p>오류는 제출 패키지 생성을 차단하며, 경고는 담당자 검토가 필요합니다.</p></div><div class="validation-totals"><span class="badge error" data-error-count>오류 0</span><span class="badge warning" data-warning-count>경고 0</span></div></div>
            <div class="table-wrap"><table><thead><tr><th>수준</th><th>검증항목</th><th>건수</th><th>조치 안내</th></tr></thead><tbody data-validation-rows></tbody></table></div>
          </div>
          <div class="card guide">
            <h2>권장 업무 순서</h2>
            <div class="guide-grid"><button data-jump="profile"><b>1. 기준 확정</b><span>단체 지위·기부금단체·부가가치세·원천징수 기준을 확인합니다.</span></button><button data-jump="vat"><b>2. 세금 보조장부</b><span>회계자료 연계 후 세액·공제 여부를 검토합니다.</span></button><button data-jump="withholding"><b>3. 지급·신고 상태</b><span>지급대상자와 원천징수액, 신고·납부기한을 관리합니다.</span></button><button data-jump="package"><b>4. 제출자료 생성</b><span>검증 후 CSV·무결성 명세를 생성합니다.</span></button></div>
          </div>
        </section>

        <section class="panel" data-panel="profile">
          <div class="heading"><div><p>TAX PROFILE</p><h1>세무 기본정보</h1><span>회계조직별 세무상 지위와 신고기준을 연도 단위로 기록합니다.</span></div><span class="status-pill" data-profile-status>미등록</span></div>
          <form class="card manager-only" data-profile-form>
            <input type="hidden" name="entityId" />
            <div class="form-grid four">
              <label>법인·단체명<input name="legalName" required /></label>
              <label>단체 유형<select name="organizationType" required><option value="religious_organization">종교단체</option><option value="nonprofit_corporation">비영리법인</option><option value="public_interest_corporation">공익법인</option><option value="other">기타</option></select></label>
              <label>관할 세무서<input name="taxOfficeName" /></label>
              <label>고유번호·사업자등록번호<input name="registrationNo" placeholder="확정 시 필수" /></label>
              <label>법인등록번호<input name="corporateRegistrationNo" /></label>
              <label>기부금단체 자격<select name="qualifiedDonationStatus" required><option value="not_confirmed">확인 전</option><option value="qualified">적격</option><option value="not_qualified">비적격</option><option value="expired">기간 만료</option></select></label>
              <label>자격 시작일<input name="qualifiedFrom" type="date" /></label>
              <label>자격 종료일<input name="qualifiedTo" type="date" /></label>
              <label>부가가치세 유형<select name="vatBusinessType" required><option value="not_confirmed">확인 전</option><option value="exempt">면세사업자</option><option value="general">일반과세자</option><option value="simplified">간이과세자</option><option value="mixed">과·면세 겸영</option><option value="not_applicable">해당 없음</option></select></label>
              <label>부가가치세 신고주기<select name="vatReportingCycle" required><option value="not_confirmed">확인 전</option><option value="quarterly">분기</option><option value="semiannual">반기</option><option value="annual">연간</option><option value="not_applicable">해당 없음</option></select></label>
              <label>종교인소득 처리기준<select name="religiousIncomeMethod" required><option value="not_set">확인 전</option><option value="religious_income">종교인소득</option><option value="earned_income">근로소득</option><option value="mixed">대상별 구분</option><option value="not_applicable">해당 없음</option></select></label>
              <label>세무대리인<input name="taxAgentName" /></label>
              <label>세무대리인 연락처<input name="taxAgentContact" /></label>
              <label>세무대리인 전자우편<input name="taxAgentEmail" type="email" /></label>
              <div class="check-stack span-2 profile-checks"><label class="check"><input name="publicInterestStatus" type="checkbox" /> 공익법인 해당</label><label class="check"><input name="revenueBusinessEnabled" type="checkbox" /> 수익사업 운영</label><label class="check"><input name="withholdingEnabled" type="checkbox" /> 원천징수 대상 지급 있음</label><label class="check"><input name="electronicDonationRequired" type="checkbox" /> 전자기부금영수증 의무·운영 대상</label></div>
              <label class="span-2 profile-note">확정본 변경 사유<textarea name="revisionReason" rows="3" placeholder="이미 확정된 자료를 개정할 때 필수입니다. 기존 확정본은 이력으로 보존됩니다."></textarea></label>
              <label class="span-2 profile-note">검토 메모<textarea name="memo" rows="3" placeholder="세무대리인 확인사항, 적용 근거와 예외를 기록해 주세요."></textarea></label>
            </div>
            <div class="caution"><b>확정 전 확인</b><span>단체의 정확한 법적 지위, 기부금단체 자격, 수익사업 여부와 신고주기는 실제 등록증·지정서류 및 세무대리인 판단을 기준으로 입력해야 합니다.</span></div>
            <div class="form-actions"><button class="btn btn-outline" type="submit" value="draft" name="mode">임시저장</button><button class="btn btn-primary" type="submit" value="confirmed" name="mode">확정 저장</button></div>
          </form>
          <div class="card audit-profile" data-profile-view hidden><div class="card-head"><h2>확정된 기본정보</h2></div><dl data-profile-view-list></dl></div>
        </section>

        <section class="panel" data-panel="vat">
          <div class="heading"><div><p>VAT LEDGER</p><h1>부가가치세 보조장부</h1><span>매입·매출 원자료를 연결하고 합계금액·공급가액·세액·공제 여부를 검토합니다.</span></div></div>
          <form class="card manager-only" data-vat-form>
            <input type="hidden" name="id" /><input type="hidden" name="supersedesId" />
            <div class="card-head"><div><h2>부가가치세 자료 등록·수정</h2><p>합계금액은 공급가액과 세액의 합계와 정확히 일치해야 합니다.</p></div><button class="btn btn-outline" type="button" data-reset-vat>새로 입력</button></div>
            <div class="form-grid four">
              <label>거래일<input name="transactionDate" type="date" required /></label>
              <label>매입·매출<select name="direction" required><option value="purchase">매입</option><option value="sale">매출</option></select></label>
              <label>원자료 유형<select name="sourceType"><option value="manual">직접 입력</option><option value="resolution">결의서</option><option value="card_transaction">법인카드</option><option value="import_transaction">가져온 금융거래</option><option value="donation">기부금</option><option value="journal">전표</option></select></label>
              <label>연결 원자료<select name="sourceId" data-vat-source><option value="">원자료 없음</option></select></label>
              <label>거래처<input name="counterpartyName" /></label>
              <label>거래처 사업자등록번호<input name="counterpartyBusinessNo" inputmode="numeric" maxlength="12" /></label>
              <label>증빙 유형<select name="evidenceType"><option value="tax_invoice">세금계산서</option><option value="invoice">계산서</option><option value="card">신용카드 매출전표</option><option value="cash_receipt">현금영수증</option><option value="receipt">영수증</option><option value="other">기타</option><option value="none">증빙 없음</option></select></label>
              <label>증빙번호<input name="evidenceNo" /></label>
              <label>과세 유형<select name="taxType"><option value="taxable">과세</option><option value="zero_rated">영세율</option><option value="exempt">면세</option><option value="non_taxable">비과세</option></select></label>
              <label>공급가액<input name="supplyAmount" class="money" inputmode="numeric" required /></label>
              <label>부가가치세<input name="vatAmount" class="money" inputmode="numeric" required /></label>
              <label>합계금액<input name="totalAmount" class="money" inputmode="numeric" required /></label>
              <label>매입세액 공제여부<select name="deductionStatus"><option value="pending">검토대기</option><option value="deductible">공제</option><option value="non_deductible">불공제</option><option value="not_applicable">해당 없음</option></select></label>
              <label class="span-2">불공제 사유<input name="nonDeductibleReason" /></label>
              <label>신고기간<input name="filingPeriod" placeholder="자동계산 또는 2026-Q1" /></label>
              <label class="check check-field"><input name="autoCalculate" type="checkbox" checked /> 공급가액 기준 부가가치세 10% 자동계산</label>
              <label>회계구분<select name="bookTypeCode" data-book-select></select></label>
              <label>회계조직<select name="entityId" data-entity-select></select></label>
              <label>재원<select name="fundId" data-fund-select></select></label>
              <label class="span-2">메모<input name="memo" /></label>
            </div>
            <p class="tax-help">하나의 원자료에 과세·면세 등이 섞인 경우 금액을 나누어 여러 행으로 등록할 수 있습니다. 활성 행의 합계는 원자료 금액을 초과할 수 없습니다. 확정본은 수정할 수 없으며, 취소·역분개 후 정정본으로 이어집니다.</p>
            <div class="form-actions"><button class="btn btn-outline" type="submit" value="draft" name="mode">임시저장</button><button class="btn btn-primary" type="submit" value="confirmed" name="mode">확정 저장</button></div>
          </form>
          <div class="card">
            <div class="card-head list-head"><div><h2>부가가치세 내역</h2><p data-vat-list-summary>0건</p></div><div class="filters"><input data-vat-query placeholder="거래처·증빙번호 검색" /><select data-vat-direction><option value="">매입·매출 전체</option><option value="purchase">매입</option><option value="sale">매출</option></select><select data-vat-status><option value="">상태 전체</option><option value="draft">임시저장</option><option value="confirmed">확정</option><option value="cancelled">취소</option></select><input data-vat-period placeholder="신고기간" /><button class="btn btn-outline" type="button" data-load-vat>조회</button><button class="btn btn-outline" type="button" data-export-vat>전체 CSV</button></div></div>
            <div class="table-wrap"><table><thead><tr><th>일자</th><th>구분</th><th>거래처</th><th>증빙</th><th>합계</th><th>공급가액</th><th>세액</th><th>공제</th><th>신고기간</th><th>상태</th><th>관리</th></tr></thead><tbody data-vat-rows></tbody></table></div>
          </div>
        </section>

        <section class="panel" data-panel="withholding">
          <div class="heading"><div><p>WITHHOLDING LEDGER</p><h1>원천징수 보조장부</h1><span>지급대상자, 소득구분, 세액과 신고·납부상태를 월별로 관리합니다.</span></div></div>
          <div class="two-cards manager-only">
            <form class="card" data-payee-form><input type="hidden" name="id" /><div class="card-head"><div><h2>지급대상자</h2><p>개인 식별번호 원문은 저장할 수 없습니다.</p></div><button class="btn btn-outline" type="button" data-reset-payee>새로 입력</button></div><div class="form-grid two"><label>유형<select name="payeeType"><option value="employee">임직원</option><option value="religious_worker">종교인</option><option value="lecturer">강사</option><option value="freelancer">프리랜서</option><option value="vendor">거래처</option><option value="other">기타</option></select></label><label>성명·상호<input name="name" required /></label><label>식별번호(마스킹)<input name="identifierMasked" placeholder="예: 900101-1******" /></label><label>사업자등록번호<input name="businessNo" /></label><label>거주구분<select name="residentStatus"><option value="resident">거주자</option><option value="nonresident">비거주자</option><option value="corporation">법인</option><option value="not_applicable">해당 없음</option></select></label><label>연락처<input name="contact" /></label><label class="check"><input name="active" type="checkbox" checked /> 사용</label><label>메모<input name="memo" /></label></div><div class="form-actions"><button class="btn btn-primary" type="submit">지급대상자 저장</button></div></form>
            <div class="card payee-list-card"><div class="card-head payee-list-head"><h2>지급대상자 목록</h2><input data-payee-query placeholder="성명·번호 검색" aria-label="지급대상자 성명·번호 검색" /></div><div class="table-wrap compact"><table><thead><tr><th>번호</th><th>유형</th><th>성명</th><th>거주</th><th>관리</th></tr></thead><tbody data-payee-rows></tbody></table></div></div>
          </div>
          <form class="card manager-only" data-withholding-form>
            <input type="hidden" name="id" /><input type="hidden" name="supersedesId" /><input type="hidden" name="filingStatus" value="unfiled" />
            <div class="card-head"><div><h2>원천징수 내역 등록·수정</h2><p>일반적으로 자동 산정 가능한 세액은 계산하고, 자동계산을 해제하면 직접 수정할 수 있습니다.</p></div><button class="btn btn-outline" type="button" data-reset-withholding>새로 입력</button></div>
            <div class="form-grid four">
              <label>지급일<input name="paymentDate" type="date" required /></label>
              <label>지급대상자<select name="payeeId" data-payee-select required></select></label>
              <label>소득구분<select name="incomeType"><option value="earned">근로소득</option><option value="religious">종교인소득</option><option value="business">사업소득</option><option value="other_income">기타소득</option><option value="retirement">퇴직소득</option><option value="nonresident">비거주자소득</option><option value="other">기타</option></select></label>
              <label>종교인소득 처리<select name="religiousIncomeMethod"><option value="not_applicable">해당 없음</option><option value="religious_income">종교인소득</option><option value="earned_income">근로소득</option></select></label>
              <label>연결 지출결의<select name="sourceResolutionId" data-resolution-source><option value="">연결 안 함</option></select></label>
              <label>총지급액<input name="grossAmount" class="money" inputmode="numeric" required /></label>
              <label>비과세액<input name="taxExemptAmount" class="money" value="0" /></label>
              <label>필요경비<input name="necessaryExpense" class="money" value="0" /></label>
              <label>과세대상액<input name="taxableAmount" class="money" value="0" /></label>
              <label>소득세<input name="incomeTax" class="money" value="0" /></label>
              <label>지방소득세<input name="localIncomeTax" class="money" value="0" /></label>
              <label>기타공제<input name="otherDeduction" class="money" value="0" /></label>
              <label>실지급액<input name="netAmount" class="money" value="0" readonly /></label>
              <label>귀속·신고월<input name="filingMonth" type="text" inputmode="numeric" maxlength="7" pattern="[0-9]{6}|[0-9]{4}-(0[1-9]|1[0-2])" placeholder="예: 202608" data-month-input required /></label>
              <label>신고·납부기한<input name="filingDueDate" type="date" /></label>
              <label class="check check-field"><input name="autoTaxable" type="checkbox" checked /> 과세대상액 자동계산</label>
              <label class="check check-field"><input name="autoWithholdingTax" type="checkbox" /> 세액 자동계산</label>
              <label>회계구분<select name="bookTypeCode" data-book-select></select></label>
              <label>회계조직<select name="entityId" data-entity-select></select></label>
              <label>재원<select name="fundId" data-fund-select></select></label>
              <label class="span-2">결의 연결 확인 메모<input name="sourceVerificationNote" placeholder="지급대상자 또는 지급일이 결의와 다를 때 차이의 근거를 입력해 주세요." /></label>
              <label class="span-2">메모<input name="memo" /></label>
            </div>
            <p class="tax-help withholding-tax-guide" data-withholding-tax-note>사업소득과 일반 기타소득은 현재 입력값을 기준으로 세액 자동계산을 지원합니다. 간이세액표·근속연수·조세조약 등 추가정보가 필요한 소득은 직접 입력합니다.</p>
            <div class="form-actions"><button class="btn btn-primary" type="submit">원천징수 내역 저장</button></div>
            <p class="tax-help">신고·납부기한은 지급월 다음 달 10일을 기본 제안합니다. 토·일요일·공휴일에 따른 기한 연장은 자동 반영하지 않으므로 실제 신고 전 확인해 주세요.</p>
          </form>
          <div class="card">
            <div class="card-head list-head"><div><h2>원천징수 내역</h2><p data-withholding-list-summary>0건</p></div><div class="filters"><input data-withholding-query placeholder="지급번호·성명 검색" /><select data-withholding-status><option value="">상태 전체</option><option value="unfiled">미신고</option><option value="filed">신고완료</option><option value="paid">납부완료</option><option value="cancelled">취소</option></select><input data-withholding-month type="text" inputmode="numeric" maxlength="7" placeholder="연도·월 (예: 202608)" data-month-input /><button class="btn btn-outline" type="button" data-load-withholding>조회</button><button class="btn btn-outline" type="button" data-export-withholding>전체 CSV</button></div></div>
            <div class="filters manager-only tax-payment-controls"><label class="tax-payment-date-label">실제 원천세 납부일 <input data-tax-payment-date type="date" /></label><label>원천세 출금계정 <select data-tax-payment-bank></select></label><small>납부 버튼은 소득세·지방소득세 예수금과 출금계정 전표를 함께 생성합니다.</small></div>
            <div class="table-wrap"><table><thead><tr><th>지급번호</th><th>지급일</th><th>대상자</th><th>소득구분</th><th>총지급액</th><th>소득세</th><th>지방세</th><th>실지급액</th><th>신고월</th><th>기한</th><th>상태</th><th>관리</th></tr></thead><tbody data-withholding-rows></tbody></table></div>
          </div>
        </section>

        <section class="panel" data-panel="package">
          <div class="heading"><div><p>TAX ACCOUNTANT PACKAGE</p><h1>세무사 제출 패키지</h1><span>등록 시점의 스냅샷 경계로 자료를 비동기 생성하고, 완성 ZIP을 보관해 다시 내려받을 수 있습니다.</span></div></div>
          <form class="card" data-package-form>
            <div class="card-head"><div><h2>제출 범위</h2><p>화면 표시 한도와 무관하게 전체 자료를 키셋 방식으로 분할·스트리밍하며, 생성 중 원자료 변경을 발견하면 실패 처리합니다.</p></div></div>
            <div class="form-grid four"><label>기간 시작<input name="periodStart" type="date" required /></label><label>기간 종료<input name="periodEnd" type="date" required /></label><label>회계구분<select name="bookTypeCode" data-package-book></select></label><label>회계조직<select name="entityId" data-package-entity></select></label><label>재원<select name="fundId" data-package-fund></select></label></div>
            <div class="caution package-guide"><b>세무사 전달용 자료 안내</b><span>선택한 기간의 회계자료를 항목별 CSV 파일로 정리해 하나의 ZIP 파일로 만듭니다. 세무대리인은 이 자료로 장부와 신고 대상 금액을 검토할 수 있습니다. 홈택스에 바로 제출하는 전자신고 파일은 아니므로, 실제 신고파일은 세무대리인이 최신 신고서식에 맞춰 작성해야 합니다. ZIP에는 회계자료, 자동검증 결과, 증빙파일 연결목록과 위·변조 확인값(SHA-256)이 포함되며 증빙 원본은 포함되지 않습니다.</span></div>
            <p class="tax-help" data-package-progress hidden></p>
            <div class="form-actions"><button class="btn btn-primary" type="submit" data-generate-package>세무사 검토자료 만들기</button></div>
          </form>
          <div class="card"><div class="card-head"><div><h2>생성 이력</h2><p>상태·스냅샷·범위·건수·차대변·검증 결과·ZIP 해시와 보관파일을 기록합니다.</p></div><button class="btn btn-outline" type="button" data-load-history>새로고침</button></div><div class="table-wrap"><table><thead><tr><th>생성번호</th><th>상태</th><th>대상기간</th><th>범위</th><th>파일</th><th>행 수</th><th>차변/대변</th><th>검증</th><th>SHA-256</th><th>생성자</th><th>생성일시</th><th>파일</th></tr></thead><tbody data-history-rows></tbody></table></div></div>
        </section>
      </main>
    </div>
  </div>

  <script is:inline>
    (()=>{
      'use strict';
      const STORAGE_KEY='milgyo-system-session';
      const session=(()=>{try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||'null')}catch{return null}})();
      if(!session?.token||!session?.user){location.replace('/');return;}
      const token=session.token,me=session.user;
      const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>Array.from(r.querySelectorAll(s));
      const formField=(form,name)=>{const control=form.elements.namedItem(name);if(!control||typeof control.value==='undefined')throw new Error(`입력항목을 찾을 수 없습니다: ${name}`);return control};
      const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const today=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,10);
      const won=(v)=>`${Number(v||0).toLocaleString('ko-KR')}원`;
      const number=(v)=>{const n=Number(String(v??'').replace(/[^0-9.-]/g,''));return Number.isFinite(n)?Math.round(n):0};
      const labels={confirmed:'확정',draft:'임시저장',cancelled:'취소',not_confirmed:'확인 전',purchase:'매입',sale:'매출',taxable:'과세',zero_rated:'영세율',exempt:'면세',non_taxable:'비과세',pending:'검토대기',deductible:'공제',non_deductible:'불공제',not_applicable:'해당 없음',tax_invoice:'세금계산서',invoice:'계산서',card:'카드매출전표',cash_receipt:'현금영수증',receipt:'영수증',other:'기타',none:'증빙 없음',manual:'직접입력',resolution:'결의서',card_transaction:'법인카드',import_transaction:'가져온 거래',donation:'기부금',journal:'전표',employee:'임직원',religious_worker:'종교인',lecturer:'강사',freelancer:'프리랜서',vendor:'거래처',resident:'거주자',nonresident:'비거주자',corporation:'법인',earned:'근로소득',religious:'종교인소득',business:'사업소득',other_income:'기타소득',retirement:'퇴직소득',unfiled:'미신고',filed:'신고완료',paid:'납부완료',religious_income:'종교인소득',earned_income:'근로소득',mixed:'대상별 구분',queued:'대기',processing:'생성 중',ready:'완료',failed:'실패'};
      const label=(v)=>labels[v]||v||'-';
      let state={year:Number(today().slice(0,4)),scopeEntity:'ENTITY-HQ',books:[],entities:[],funds:[],accounts:[],payees:[],permissions:{},summary:{},validation:[],vatRows:[],withholdingRows:[],history:[],sourceCandidates:[],resolutionCandidates:[],profile:null};
      const api=async(path,body={})=>{const response=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token,...body})});const text=await response.text();let data;try{data=JSON.parse(text)}catch{data={ok:false,message:`서버 응답 오류(HTTP ${response.status})`}}if(!response.ok||!data.ok)throw Object.assign(new Error(data.message||'요청 처리에 실패했습니다.'),{status:response.status,data});return data};
      const notice=(message,type='ok',timeout=6000)=>{const el=$('[data-notice]');el.textContent=message;el.className=`notice ${type}`;el.hidden=false;clearTimeout(notice.timer);notice.timer=setTimeout(()=>el.hidden=true,timeout)};
      const csv=(name,headers,rows)=>{const q=(v)=>{const raw=String(v??''),safe=typeof v==='string'&&/^[\t\r\n ]*[=+\-@]/.test(raw)?`'${raw}`:raw;return `"${safe.replace(/"/g,'""')}"`};const blob=new Blob(['\uFEFF'+[headers,...rows].map((row)=>row.map(q).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
      const formatMoneyInputs=(root=document)=>root.querySelectorAll('input.money').forEach((input)=>{if(input.dataset.moneyBound)return;input.dataset.moneyBound='1';input.addEventListener('blur',()=>{if(input.value.trim())input.value=number(input.value).toLocaleString('ko-KR')})});
      const weekdayLabel=(value)=>{const match=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value||''));if(!match)return '';const date=new Date(Date.UTC(Number(match[1]),Number(match[2])-1,Number(match[3])));return `(${['일','월','화','수','목','금','토'][date.getUTCDay()]})`};
      const setupDateInput=(input)=>{if(!(input instanceof HTMLInputElement)||input.type!=='date'||input.hasAttribute('data-no-weekday'))return;input.lang='en-CA';let wrap=input.closest('.date-with-weekday');if(!wrap){wrap=document.createElement('div');wrap.className='date-with-weekday';input.before(wrap);wrap.append(input)}let out=wrap.querySelector('.date-weekday');if(!out){out=document.createElement('span');out.className='date-weekday';out.setAttribute('aria-live','polite');wrap.append(out)}const sync=()=>{const text=weekdayLabel(String(input.value||''));out.textContent=text;out.hidden=!text};if(!input.dataset.weekdayBound){input.dataset.weekdayBound='1';input.addEventListener('input',sync);input.addEventListener('change',sync)}sync()};
      const syncDateInputs=(root=document)=>{if(root instanceof HTMLInputElement&&root.type==='date')setupDateInput(root);root.querySelectorAll?.('input[type="date"]').forEach(setupDateInput)};
      const normalizeMonthValue=(value)=>{const raw=String(value||'').trim();if(/^\d{4}-(?:0[1-9]|1[0-2])$/.test(raw))return raw;const digits=raw.replace(/\D/g,'');if(/^\d{6}$/.test(digits)){const month=Number(digits.slice(4,6));if(month>=1&&month<=12)return `${digits.slice(0,4)}-${digits.slice(4,6)}`}return raw};
      const setupMonthInput=(input)=>{if(!(input instanceof HTMLInputElement)||!input.hasAttribute('data-month-input'))return;if(input.dataset.monthBound)return;input.dataset.monthBound='1';input.inputMode='numeric';const normalize=()=>{const value=normalizeMonthValue(input.value);if(value!==input.value&&/^\d{4}-(?:0[1-9]|1[0-2])$/.test(value))input.value=value;input.setCustomValidity(!input.value||/^\d{4}-(?:0[1-9]|1[0-2])$/.test(normalizeMonthValue(input.value))?'':'연도와 월을 YYYY-MM 또는 숫자 6자리로 입력해 주세요. 예: 2026-08 또는 202608')};input.addEventListener('input',()=>input.setCustomValidity(''));input.addEventListener('blur',normalize);input.addEventListener('change',normalize)};
      const syncMonthInputs=(root=document)=>{if(root instanceof HTMLInputElement&&root.hasAttribute('data-month-input'))setupMonthInput(root);root.querySelectorAll?.('input[data-month-input]').forEach(setupMonthInput)};
      const options=(rows,valueKey,labelFn,blank='')=>`${blank?`<option value="">${esc(blank)}</option>`:''}${rows.map((row)=>`<option value="${esc(row[valueKey])}">${esc(labelFn(row))}</option>`).join('')}`;
      const populateMasters=()=>{
        const book=options(state.books,'code',(r)=>r.name),entity=options(state.entities,'id',(r)=>`${r.entity_code} · ${r.name}`),fund=options(state.funds,'id',(r)=>`${r.fund_code} · ${r.name}`,'재원 미지정');
        $$('[data-book-select]').forEach((el)=>{const v=el.value;el.innerHTML=book;el.value=v||'general'});$$('[data-entity-select]').forEach((el)=>{el.innerHTML=entity;el.value=state.scopeEntity||'ENTITY-HQ';el.disabled=true});$$('[data-fund-select]').forEach((el)=>{const v=el.value;el.innerHTML=fund;el.value=v||''});
        $('[data-package-book]').innerHTML=`<option value="">전체 회계구분</option>${book}`;$('[data-package-entity]').innerHTML=`<option value="">전체 회계조직</option>${entity}`;$('[data-package-fund]').innerHTML=`<option value="">전체 재원</option>${options(state.funds,'id',(r)=>`${r.fund_code} · ${r.name}`)}`;
        $('[data-package-entity]').value=state.scopeEntity||'';
        const payee=options(state.payees,'id',(r)=>`${r.payee_no} · ${r.name}`,'지급대상자 선택');$$('[data-payee-select]').forEach((el)=>{const v=el.value;el.innerHTML=payee;if(v)el.value=v});
        const bankAccounts=state.accounts.filter((a)=>a.active&&a.account_type==='asset'&&a.normal_side==='debit'&&!['1000','1100'].includes(a.code));const bank=$('[data-tax-payment-bank]');if(bank){const v=bank.value;bank.innerHTML=options(bankAccounts,'code',(a)=>`${a.code} ${a.name}`,'출금계정 선택');bank.value=bankAccounts.some((a)=>a.code===v)?v:bankAccounts.some((a)=>a.code==='1120')?'1120':''}
      };
      const renderYears=()=>{const years=new Set((state.fiscalYears||[]).map((r)=>Number(r.year)));for(let y=2026;y<=Math.max(2030,Number(today().slice(0,4)));y++)years.add(y);$('[data-year]').innerHTML=[...years].sort((a,b)=>a-b).map((y)=>`<option value="${y}">${y} 회계연도</option>`).join('');$('[data-year]').value=String(state.year)};
      const renderScopeEntities=()=>{const el=$('[data-scope-entity]');el.innerHTML=options(state.entities,'id',(r)=>`${r.entity_code} · ${r.name}`);el.value=state.scopeEntity;if(!el.value){state.scopeEntity=state.entities[0]?.id||'ENTITY-HQ';el.value=state.scopeEntity}};
      const renderValidation=()=>{const rows=state.validation||[],errors=rows.filter((r)=>r.severity==='error').length,warnings=rows.filter((r)=>r.severity==='warning').length;$('[data-error-count]').textContent=`오류 ${errors}`;$('[data-warning-count]').textContent=`경고 ${warnings}`;$('[data-validation-rows]').innerHTML=rows.length?rows.map((r)=>{const code=r.code?` <span class="validation-code">(${esc(r.code)})</span>`:'';return `<tr><td><span class="badge ${esc(r.severity)}">${r.severity==='error'?'오류':r.severity==='warning'?'경고':'안내'}</span></td><td><b>${esc(r.title)}</b></td><td class="num">${Number(r.count||0).toLocaleString('ko-KR')}</td><td>${esc(r.detail)}${code}</td></tr>`}).join(''):'<tr><td colspan="4" class="empty">검증 결과가 없습니다.</td></tr>'};
      const renderSummary=()=>{const s=state.summary||{},w=s.withholding||{};$('[data-summary-profile]').textContent=s.profile?.profile_status==='confirmed'?'확정':'미확정';$('[data-summary-vat]').textContent=`${Number(s.record_count||0).toLocaleString('ko-KR')}건`;$('[data-summary-vat-detail]').textContent=`매입 ${won(s.purchase_supply)} · 매출 ${won(s.sale_supply)}`;$('[data-summary-withholding]').textContent=`${Number(w.record_count||0).toLocaleString('ko-KR')}건`;$('[data-summary-withholding-detail]').textContent=`미신고 ${Number(w.unfiled_count||0).toLocaleString('ko-KR')}건 · 세액 ${won(Number(w.income_tax||0)+Number(w.local_income_tax||0))}`;$('[data-summary-exports]').textContent=`${Number(s.export_count||0).toLocaleString('ko-KR')}회`};
      const applyPermissions=()=>{$$('.manager-only').forEach((el)=>el.hidden=!state.permissions.manager);$('[data-profile-view]').hidden=!!state.permissions.manager;if(!state.permissions.canViewAll){$$('[data-tab="vat"],[data-tab="withholding"],[data-tab="package"]').forEach((el)=>el.hidden=true)}};
      const showTab=async(tab)=>{$$('.nav').forEach((el)=>el.classList.toggle('active',el.dataset.tab===tab));$$('.panel').forEach((el)=>el.classList.toggle('active',el.dataset.panel===tab));try{if(tab==='profile')await loadProfile();if(tab==='vat')await loadVat();if(tab==='withholding')await Promise.all([loadPayees(),loadWithholding(),loadResolutionCandidates()]);if(tab==='package')await loadHistory()}catch(error){notice(error.message,'error')}};
      const renderProfile=()=>{const form=$('[data-profile-form]'),r=state.profile||{},entity=state.entities.find((x)=>x.id===state.scopeEntity);form.entityId.value=state.scopeEntity;['legalName','organizationType','registrationNo','corporateRegistrationNo','taxOfficeName','qualifiedDonationStatus','qualifiedFrom','qualifiedTo','vatBusinessType','vatReportingCycle','religiousIncomeMethod','taxAgentName','taxAgentContact','taxAgentEmail','memo'].forEach((name)=>{if(form.elements[name])form.elements[name].value=r[name.replace(/[A-Z]/g,(m)=>`_${m.toLowerCase()}`)]??r[name]??''});form.revisionReason.value='';form.revisionReason.required=r.profile_status==='confirmed';form.legalName.value=r.legal_name||entity?.name||'대한불교밀교종';form.organizationType.value=r.organization_type||'religious_organization';form.qualifiedDonationStatus.value=r.qualified_donation_status||'not_confirmed';form.vatBusinessType.value=r.vat_business_type||'not_confirmed';form.vatReportingCycle.value=r.vat_reporting_cycle||'not_confirmed';form.religiousIncomeMethod.value=r.religious_income_method||'not_set';form.publicInterestStatus.checked=!!Number(r.public_interest_status||0);form.revenueBusinessEnabled.checked=!!Number(r.revenue_business_enabled||0);form.withholdingEnabled.checked=!!Number(r.withholding_enabled||0);form.electronicDonationRequired.checked=!!Number(r.electronic_donation_required||0);$('[data-profile-status]').textContent=r.profile_status?`${label(r.profile_status)} · ${Number(r.revision_no||1)}차`:'미등록';$('[data-profile-status]').className=`status-pill ${r.profile_status||''}`;const list=$('[data-profile-view-list]');list.innerHTML=[['법인·단체명',r.legal_name],['회계조직',r.entity_name||entity?.name],['단체유형',r.organization_type],['등록번호',r.registration_no],['기부금단체 자격',r.qualified_donation_status],['부가가치세',r.vat_business_type],['신고주기',r.vat_reporting_cycle],['원천징수',Number(r.withholding_enabled)?'대상':'해당 없음'],['종교인소득 처리',r.religious_income_method],['세무대리인',r.tax_agent_name],['개정번호',`${Number(r.revision_no||1)}차`]].map(([k,v])=>`<div><dt>${esc(k)}</dt><dd>${esc(label(v))}</dd></div>`).join('');syncDateInputs(form)};
