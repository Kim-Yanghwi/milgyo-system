    const decideBudget=async(id,decision)=>{const memo=prompt(decision==='approve'?'승인 메모(선택)':'반려 사유를 입력해 주세요.')||'';if(decision==='reject'&&!memo)return;try{const result=await api('/api/accounting-operations/action',{action:'decide-budget-change',id,decision,memo});notice(result.message);await Promise.all([loadBudgets(),loadInit()])}catch(error){notice(error.message,'error')}};

    const populateVendors=()=>{$$('[data-vendor-select]').forEach((el)=>{const current=el.value;el.innerHTML=options(state.vendors,'id',(r)=>`${r.vendor_code} ${r.name}`,'거래처 선택');if(state.vendors.some((v)=>v.id===current))el.value=current})};
    const loadVendors=async()=>{try{const data=await api('/api/accounting-operations/query',{action:'vendors',query:$('[data-vendor-query]').value});state.vendors=data.rows||[];populateVendors();$('[data-vendor-rows]').innerHTML=state.vendors.length?state.vendors.map((r)=>`<tr><td>${esc(r.vendor_code)}</td><td><b>${esc(r.name)}</b><small>${esc(r.phone||r.email||'')}</small></td><td>${esc(r.business_no||'-')}</td><td>${esc(r.representative||'-')}<small>${esc(r.contact_name||'')}</small></td><td>${esc(r.bank_name||'-')}<small>${esc(r.bank_account_masked||'')}</small></td><td>${r.active_contracts}건</td><td>${r.pending_bank_changes?'<span class="badge pending">승인대기</span>':'-'}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">거래처가 없습니다.</td></tr>';$('[data-bank-change-rows]').innerHTML=data.bankChanges.length?data.bankChanges.map((r)=>`<tr><td>${esc(r.vendor_name)}</td><td>${esc(r.old_bank_name||'-')}<small>${esc(r.old_account_masked||'')}</small></td><td>${esc(r.new_bank_name)}<small>${esc(r.new_account_masked)}</small></td><td>${esc(r.reason)}</td><td>${esc(r.requested_by_name)}</td><td>${label(r.status)}</td><td>${r.status==='pending'?`<div class="actions"><button class="mini" data-bank-decide="approve" data-id="${r.id}">승인</button><button class="mini danger" data-bank-decide="reject" data-id="${r.id}">반려</button></div>`:'-'}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">계좌변경 요청이 없습니다.</td></tr>';$$('[data-bank-decide]').forEach((b)=>b.onclick=()=>decideBank(b.dataset.id,b.dataset.bankDecide))}catch(error){notice(error.message,'error')}};
    $('[data-load-vendors]').onclick=loadVendors;
    $('[data-vendor-form]').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget;try{const result=await api('/api/accounting-operations/action',{action:'save-vendor',name:f.name.value,businessNo:f.businessNo.value,representative:f.representative.value,contactName:f.contactName.value,phone:f.phone.value,email:f.email.value,bankName:f.bankName.value,bankAccountNumber:f.bankAccountNumber.value,bankAccountHolder:f.bankAccountHolder.value,conflictChecked:f.conflictChecked.checked,conflictNote:f.conflictNote.value});notice(`${result.vendorCode} 거래처를 저장했습니다.`);f.reset();await loadVendors()}catch(error){notice(error.message,'error')}};
    $('[data-bank-change-form]').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget;try{const result=await api('/api/accounting-operations/action',{action:'request-vendor-bank-change',vendorId:f.vendorId.value,bankName:f.bankName.value,bankAccountNumber:f.bankAccountNumber.value,bankAccountHolder:f.bankAccountHolder.value,reason:f.reason.value});notice(result.message);f.reset();await loadVendors()}catch(error){notice(error.message,'error')}};
    const decideBank=async(id,decision)=>{const memo=prompt(decision==='approve'?'승인 메모(선택)':'반려 사유')||'';if(decision==='reject'&&!memo)return;try{const result=await api('/api/accounting-operations/action',{action:'decide-vendor-bank-change',id,decision,memo});notice(result.message);await loadVendors()}catch(error){notice(error.message,'error')}};

    $('[data-contract-form]').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget;try{const result=await api('/api/accounting-operations/action',{action:'save-contract',vendorId:f.vendorId.value,title:f.title.value,amount:f.amount.value,contractDate:f.contractDate.value,startDate:f.startDate.value,endDate:f.endDate.value,procurementMethod:f.procurementMethod.value,department:f.department.value,project:f.project.value,accountCode:f.accountCode.value,entityId:f.entityId.value,fundId:f.fundId.value,soleSourceReason:f.soleSourceReason.value,multiQuoteChecked:f.multiQuoteChecked.checked,conflictChecked:f.conflictChecked.checked,inspectionRequired:f.inspectionRequired.checked,memo:f.memo.value});notice(`${result.contractNo} 계약을 저장했습니다.`);f.reset();await Promise.all([loadContracts(),loadBudgets()])}catch(error){notice(error.message,'error')}};
    const loadContracts=async()=>{try{const data=await api('/api/accounting-operations/query',{action:'contracts',year:state.year,status:$('[data-contract-status]').value,query:$('[data-contract-query]').value});state.contracts=data.rows||[];$('[data-contract-rows]').innerHTML=state.contracts.length?state.contracts.map((r)=>`<tr><td>${esc(r.contract_no)}</td><td class="left"><b>${esc(r.vendor_name)}</b><small>${esc(r.title)}</small></td><td>${esc(r.start_date)} ~ ${esc(r.end_date)}${Number(r.days_to_end)<=45&&r.status==='active'?`<small class="negative">${r.days_to_end}일 남음</small>`:''}</td><td class="num">${won(r.contract_amount)}</td><td class="num">${won(r.paid_amount)}</td><td class="num">${won(Number(r.contract_amount)-Number(r.paid_amount))}</td><td>${label(r.procurement_method)}</td><td>${label(r.status)}</td><td><button class="mini" data-contract-detail="${r.id}">지급관리</button></td></tr>`).join(''):'<tr><td colspan="9" class="empty">계약이 없습니다.</td></tr>';$$('[data-contract-detail]').forEach((b)=>b.onclick=()=>openContract(b.dataset.contractDetail))}catch(error){notice(error.message,'error')}};
    $('[data-load-contracts]').onclick=loadContracts;
    const openContract=async id=>{try{const data=await api('/api/accounting-operations/query',{action:'contract-detail',id});state.activeContract=data;$('[data-contract-dialog-title]').textContent=data.contract.contract_no;$('[data-contract-dialog-subtitle]').textContent=`${data.contract.vendor_name} · ${data.contract.title} · ${won(data.contract.contract_amount)}`;$('[data-payment-form] [name="contractId"]').value=id;const resolutionOptions=options(data.resolutions,'id',(r)=>`${r.resolution_no} · ${r.title} · ${Number(r.amount).toLocaleString()}원`,'지출결의 선택');$('[data-payment-rows]').innerHTML=data.payments.length?data.payments.map((p)=>`<tr><td>${p.payment_seq}</td><td>${esc(p.payment_name)}</td><td>${esc(p.due_date||'-')}</td><td class="num">${won(p.amount)}</td><td>${esc(p.resolution_no||'-')}<small>${esc(p.journal_no||'')}</small></td><td>${label(p.status)}</td><td>${!p.resolution_id?`<select data-payment-resolution="${p.id}">${resolutionOptions}</select><button class="mini" data-link-payment="${p.id}">연결</button>`:'-'}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">지급일정을 추가해 주세요.</td></tr>';$$('[data-link-payment]').forEach((b)=>b.onclick=async()=>{const resolutionId=$(`[data-payment-resolution="${b.dataset.linkPayment}"]`).value;if(!resolutionId)return;try{const result=await api('/api/accounting-operations/action',{action:'link-contract-payment',paymentId:b.dataset.linkPayment,resolutionId});notice(result.message);await openContract(id);await loadContracts()}catch(error){notice(error.message,'error')}});$('[data-contract-dialog]').showModal()}catch(error){notice(error.message,'error')}};
    $('[data-close-contract-dialog]').onclick=()=>$('[data-contract-dialog]').close();
    $('[data-payment-form]').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget;try{const result=await api('/api/accounting-operations/action',{action:'save-contract-payment',contractId:f.contractId.value,paymentName:f.paymentName.value,dueDate:f.dueDate.value,amount:f.amount.value,inspectionDate:f.inspectionDate.value,memo:f.memo.value});notice(result.message);f.reset();f.contractId.value=state.activeContract.contract.id;await openContract(state.activeContract.contract.id)}catch(error){notice(error.message,'error')}};

    const loadDonations=async()=>{try{const data=await api('/api/accounting-operations/query',{action:'donation-export-candidates',year:state.year});$('[data-donation-rows]').innerHTML=data.rows.length?data.rows.map((r)=>`<tr><td><input type="checkbox" data-donation-id="${r.id}" /></td><td>${esc(r.donation_no)}</td><td>${esc(r.donation_date)}</td><td>${esc(r.donor_name)}<small>${esc(r.identifier_masked||'식별번호 미입력')}</small></td><td>${esc(r.phone||'-')}</td><td class="num">${won(r.amount)}</td><td>${esc(r.receipt_donation_code||'41')}</td><td>${label(r.receipt_status)}</td></tr>`).join(''):'<tr><td colspan="8" class="empty">일괄처리할 기부내역이 없습니다.</td></tr>';$('[data-export-batch-rows]').innerHTML=data.batches.length?data.batches.map((b)=>`<tr><td>${esc(b.export_no)}</td><td>${b.item_count}</td><td>${b.success_count}</td><td>${b.error_count}</td><td>${label(b.status)}</td><td><button class="mini" data-download-export="${b.id}">Excel</button></td></tr>`).join(''):'<tr><td colspan="6" class="empty">처리이력이 없습니다.</td></tr>';$('[data-export-batch-select]').innerHTML=options(data.batches,'id',(r)=>`${r.export_no} · ${r.item_count}건`,'일괄처리 선택');$$('[data-download-export]').forEach((b)=>b.onclick=()=>downloadDonationWorkbook(b.dataset.downloadExport))}catch(error){notice(error.message,'error')}};
    $('[data-check-all-donations]').onchange=e=>$$('[data-donation-id]').forEach((box)=>box.checked=e.target.checked);
    const donationWorkbook=async data=>{const ExcelJS=await getExcelJS(),workbook=new ExcelJS.Workbook();workbook.creator='대한불교밀교종 종단관리시스템';const sheet=workbook.addWorksheet('전자기부금영수증 작업자료');const headers=['자료구분','기부자구분','성명·상호','식별번호(사용자 입력)','휴대전화','기부일자','기부금코드','기부내용','기부금액','기부금단체 고유번호','기부금단체명','내부관리번호'];sheet.addRow(headers);data.rows.forEach((r)=>sheet.addRow(['발급',r.donor_type==='organization'?'법인·단체':'개인',r.donor_name,'',r.phone||'',r.donation_date,r.receipt_donation_code||'41',r.receipt_description||'기부금',Number(r.amount||0),r.receipt_org_registration_no||r.entity_registration_no||'',r.receipt_org_name||r.entity_name||'',r.donation_no]));sheet.views=[{state:'frozen',ySplit:1}];sheet.getRow(1).font={bold:true,color:{argb:'FFFFFFFF'}};sheet.getRow(1).fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF315F9F'}};sheet.columns.forEach((column,index)=>{column.width=[12,14,18,24,16,14,12,24,16,24,24,22][index]||16});sheet.getColumn(9).numFmt='#,##0';const guide=workbook.addWorksheet('작성안내');guide.addRows([['구분','안내'],['중요','이 파일은 시스템 작업용입니다. 홈택스에서 제공하는 최신 Excel 서식의 열 제목·순서와 대조한 뒤 업로드하세요.'],['식별번호','식별번호 원문은 서버에 저장되지 않아 빈칸으로 생성됩니다. 안전한 업무환경에서만 작성하세요.'],['내부관리번호','결과파일을 다시 가져올 때 기부번호를 내부관리번호로 사용합니다.']]);guide.getRow(1).font={bold:true};return workbook.xlsx.writeBuffer()};
    const downloadDonationWorkbook=async id=>{try{const data=await api('/api/accounting-operations/query',{action:'donation-export-detail',id});download(new Blob([await donationWorkbook(data)],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}),`${data.batch.export_no}_홈택스작업파일.xlsx`)}catch(error){notice(error.message,'error')}};
    $('[data-create-donation-export]').onclick=async()=>{const donationIds=$$('[data-donation-id]:checked').map((box)=>box.dataset.donationId);if(!donationIds.length)return notice('일괄처리할 기부내역을 선택해 주세요.','error');try{const result=await api('/api/accounting-operations/action',{action:'create-donation-export',year:state.year,donationIds});notice(result.message);await downloadDonationWorkbook(result.id);await loadDonations()}catch(error){notice(error.message,'error')}};
    const headerIndex=(headers,names)=>headers.findIndex((header)=>names.some((name)=>normalize(header).includes(normalize(name))));
    $('[data-result-form]').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,file=f.file.files?.[0];if(!file)return;try{const matrix=await readMatrix(file),headers=matrix[0].map(String),idx={donationNo:headerIndex(headers,['내부관리번호','기부번호','관리번호']),status:headerIndex(headers,['처리결과','결과','상태']),externalReceiptNo:headerIndex(headers,['홈택스발급번호','발급번호','영수증번호']),message:headerIndex(headers,['오류내용','오류사유','메시지','비고'])};if(idx.donationNo<0||idx.status<0)throw new Error('결과파일에서 내부관리번호(기부번호)와 처리결과 열을 찾을 수 없습니다.');const rows=matrix.slice(1).map((row)=>({donationNo:String(row[idx.donationNo]??''),status:String(row[idx.status]??''),externalReceiptNo:idx.externalReceiptNo<0?'':String(row[idx.externalReceiptNo]??''),message:idx.message<0?'':String(row[idx.message]??'')})).filter((r)=>r.donationNo&&r.status);const result=await api('/api/accounting-operations/action',{action:'apply-donation-results',batchId:f.batchId.value,filename:file.name,rows});notice(result.message,result.errors?'error':'ok');f.reset();await loadDonations()}catch(error){notice(error.message,'error')}};

    $('[data-logout]').onclick=async()=>{try{await fetch('/api/auth/logout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:session.token})})}catch{}localStorage.removeItem('milgyo-system-session');location.replace('/')};
    $('[data-recon-form] [name="month"]').value=today().slice(0,7);
    loadInit();
  </script>

