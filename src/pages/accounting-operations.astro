    const csvMatrix=(text)=>{const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const char=text[i];if(char==='"'){if(quoted&&text[i+1]==='"'){cell+='"';i++}else quoted=!quoted}else if(char===','&&!quoted){row.push(cell);cell=''}else if((char==='\n'||char==='\r')&&!quoted){if(char==='\r'&&text[i+1]==='\n')i++;row.push(cell);if(row.some((v)=>String(v).trim()))rows.push(row);row=[];cell=''}else cell+=char}row.push(cell);if(row.some((v)=>String(v).trim()))rows.push(row);return rows};
    const readMatrix=async(file)=>{if(file.name.toLowerCase().endsWith('.csv'))return csvMatrix(await file.text());const ExcelJS=await getExcelJS(),workbook=new ExcelJS.Workbook();await workbook.xlsx.load(await file.arrayBuffer());const sheet=workbook.worksheets[0],rows=[];sheet.eachRow({includeEmpty:false},(row)=>rows.push(row.values.slice(1).map((value)=>value instanceof Date?value:value?.result??value?.text??value??'')));return rows};
    const synonyms={transactionDate:['거래일','거래일자','이용일','승인일','일자','date'],postedDate:['기장일','매입일','처리일'],direction:['구분','입출금','거래구분'],description:['적요','거래내용','내용','사용내역'],counterparty:['거래처','상대','가맹점','보낸분','받는분'],amount:['거래금액','금액','이용금액','승인금액'],amountIn:['입금액','입금'],amountOut:['출금액','출금'],taxAmount:['부가세','세액'],balance:['잔액'],approvalNo:['승인번호','거래번호'],sequence:['순번','번호']};
    const normalize=(value)=>String(value??'').toLowerCase().replace(/\s|[-_.()]/g,'');
    const autoColumn=(headers,names)=>{const targets=names.map(normalize);const index=headers.findIndex((header)=>targets.some((target)=>normalize(header).includes(target)||target.includes(normalize(header))));return index<0?'':String(index)};
    const mappingLabels={transactionDate:'거래일자(필수)',postedDate:'기장·처리일',direction:'입출금 구분',description:'적요',counterparty:'거래처·가맹점',amount:'단일 금액',amountIn:'입금액',amountOut:'출금액',taxAmount:'부가세',balance:'잔액',approvalNo:'승인번호',sequence:'순번'};
