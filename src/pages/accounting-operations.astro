    @media(max-width:1200px){.form-grid.five,.form-grid.four,.mapping-grid,.summary-grid,.guide-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:850px){.topbar{flex-wrap:wrap}.top-actions{width:100%;flex-wrap:wrap}.shell{display:block}.sidebar{border-right:0;border-bottom:1px solid #d4dce7}.sidebar nav{grid-template-columns:repeat(2,1fr)}.side-note{display:none}.main{padding:12px}.two-cols,.form-grid.two,.form-grid.three,.form-grid.four,.form-grid.five,.mapping-grid,.summary-grid,.guide-grid{grid-template-columns:1fr}.span-2,.span-3{grid-column:auto}.brand span img{width:130px}}
