    const dateText=(value)=>{if(value instanceof Date)return value.toISOString().slice(0,10);const text=String(value??'').trim().replace(/[./]/g,'-');const match=/^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(text);return match?`${match[1]}-${match[2].padStart(2,'0')}-${match[3].padStart(2,'0')}`:text.slice(0,10)};
    $('[data-run-import]').onclick=async()=>{const f=$('[data-import-form]'),map=Object.fromEntries($$('[data-map]').map((el)=>[el.dataset.map,el.value===''?null:Number(el.value)]));if(map.transactionDate==null||(![map.amount,map.amountIn,map.amountOut].some((v)=>v!=null)))return notice('거래일자와 금액 열을 연결해 주세요.','error');const get=(row,key)=>map[key]==null?'':row[map[key]];const rows=state.fileMatrix.slice(1).map((row,index)=>{const amountIn=Math.abs(money(get(row,'amountIn'))),amountOut=Math.abs(money(get(row,'amountOut'))),single=money(get(row,'amount'));let direction=f.sourceType.value==='card'?'out':amountIn?'in':amountOut?'out':/입금|수입|credit|\+/.test(String(get(row,'direction')).toLowerCase())?'in':single<0?'out':'out';const amount=amountIn||amountOut||Math.abs(single);return {transactionDate:dateText(get(row,'transactionDate')),postedDate:dateText(get(row,'postedDate')),direction,description:String(get(row,'description')||''),counterparty:String(get(row,'counterparty')||''),amount,taxAmount:money(get(row,'taxAmount')),balance:get(row,'balance'),approvalNo:String(get(row,'approvalNo')||''),sequence:String(get(row,'sequence')||index+1)}}).filter((r)=>r.transactionDate&&r.amount);try{const result=await api('/api/accounting-operations/action',{action:'import-transactions',sourceType:f.sourceType.value,sourceAccountId:f.sourceAccountId.value,periodStart:f.periodStart.value,periodEnd:f.periodEnd.value,statementBalance:f.statementBalance.value,filename:state.fileName,rows});notice(result.message);await api('/api/accounting-operations/action',{action:'auto-match',batchId:result.id});await Promise.all([loadTransactions(),loadInit()])}catch(error){notice(error.message,'error')}};

