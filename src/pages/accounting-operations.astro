r}.summary-grid span,.summary-grid small{display:block;color:#6b7280;font-size:12px}.summary-grid strong{display:block;margin:8px 0;font-size:22px;color:#1f4f88}.guide-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.guide-grid article{padding:14px;background:#f8fafc;border-radius:7px}.guide-grid b,.guide-grid span{display:block}.guide-grid span{margin-top:7px;color:#667085;font-size:12px;line-height:1.5}.card{padding:16px;margin-bottom:16px}.card h2{margin:0 0 12px;font-size:17px}.card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.card-head h2,.card-head p{margin:0}.two-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}.form-grid{display:grid;gap:10px}.form-grid.two{grid-template-columns:repeat(2,1fr)}.form-grid.three{grid-template-columns:repeat(3,1fr)}.form-grid.four{grid-template-columns:repeat(4,1fr)}.form-grid.five{grid-template-columns:repeat(5,1fr)}.span-2{grid-column:span 2}.span-3{grid-column:span 3}label{display:block;font-size:12px;font-weight:700;color:#465162}input,select,textarea{width:100%;box-sizing:border-box;border:1px solid #c8d1df;border-radius:5px;padding:9px 10px;margin:6px 0 10px;background:#fff;color:#20252c;min-height:38px}textarea{min-height:68px;resize:vertical}.check{display:flex!important;align-items:center;gap:7px}.check input{width:auto;margin:0}.btn{border:1px solid transparent;border-radius:5px;padding:9px 13px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.btn-primary{background:#315f9f;color:#fff}.btn-outline{background:#fff;color:#304b70;border-color:#bfcada}.form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.filters{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.filters input,.filters select{width:auto;min-width:150px;margin:0}.table-wrap{overflow:auto;border:1px solid #9eafc3;border-radius:6px}.table-wrap table{width:100%;border-collapse:collapse;font-size:12px;min-width:800px}.table-wrap th,.table-wrap td{border:1px solid #9eafc3;padding:8px;text-align:center;vertical-align:middle}.table-wrap th{background:#eaf1f8}.table-wrap td.left{text-align:left}.table-wrap small{display:block;color:#667085;margin-top:4px}.num{text-align:right!important;font-variant-numeric:tabular-nums}.negative{color:#b42318!important}.empty{height:68px;color:#7b8492}.actions{display:flex;justify-content:center;gap:4px;flex-wrap:wrap}.mini{border:1px solid #aebbd0;background:#fff;color:#315f9f;border-radius:4px;padding:5px 7px;font-size:11px;font-weight:700;cursor:pointer}.mini.danger{color:#a92e2e;border-color:#e5b7b7}.badge{display:inline-flex;padding:3px 7px;border-radius:999px;background:#edf0f4}.badge.matched,.badge.completed,.badge.approved{background:#e3f4e3;color:#1e6f2b}.badge.suggested,.badge.pending{background:#fff3d6;color:#835800}.badge.unmatched{background:#fbe4e4;color:#a12626}.mapping-box{border:1px dashed #9fb0c6;background:#f8fbff;border-radius:8px;padding:12px;margin-top:10px}.mapping-box h3{margin:0 0 10px;font-size:14px}.mapping-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.warning{display:flex;gap:12px;padding:13px 15px;margin-bottom:16px;border-left:4px solid #c28b28;background:#fff8e8;color:#6d501d;font-size:12px;line-height:1.5}.warning b{white-space:nowrap}.notice{position:fixed;top:74px;right:20px;z-index:100;max-width:480px;padding:13px 16px;border-radius:7px;background:#e7f4ea;color:#236b36;box-shadow:0 5px 20px #0002}.notice.error{background:#fee9e9;color:#a12b2b}dialog{border:0;border-radius:12px;padding:0;box-shadow:0 20px 70px #0004}dialog::backdrop{background:#11182766}.dialog-card{width:min(720px,calc(100vw - 40px));max-height:85vh;overflow:auto;padding:18px}.dialog-card.wide{width:min(1050px,calc(100vw - 40px))}.icon-btn{border:0;background:transparent;font-size:24px;cursor:pointer}.candidate{display:flex;gap:10px;padding:11px;border:1px solid #d5deea;border-