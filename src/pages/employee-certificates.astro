---
import ManagementLayout from '../layouts/ManagementLayout.astro';
---
<ManagementLayout title="임·직원 재직증명서" active="employment" showCurrentUser={false}>
  <div data-employment-certificate-version="2026-08-05-v61" hidden></div>
  <div class="page-heading">
    <div><p class="page-heading__kicker">EMPLOYMENT CERTIFICATE</p><h1>임·직원 재직증명서</h1><p>임·직원의 인적·재직사항을 확인하여 재직증명서를 발급하고 발급대장을 관리합니다.</p></div>
  </div>

  <section class="surface certificate-issue-panel">
    <div class="section-title"><div><h2>재직증명서 발급</h2><p>발급 시점의 정보를 증명서 발급대장에 보존합니다.</p></div><span class="privacy-note">생년월일·주민등록번호는 발급대장에서 마스킹됩니다.</span></div>
    <form data-issue-form>
      <div class="form-grid certificate-form-grid">
        <div class="form-field form-field--full"><label for="employee-user">임·직원 선택</label><select id="employee-user" name="employeeUserId" data-employee-select required></select></div>
        <div class="form-field"><label for="employee-name">성명(한글)</label><input id="employee-name" data-employee-name readonly /></div>
        <div class="form-field"><label for="employee-hanja">성명(한자·선택)</label><input id="employee-hanja" name="nameHanja" maxlength="60" /></div>
        <div class="form-field"><label for="employee-identity">생년월일 또는 주민등록번호</label><input id="employee-identity" name="birthOrRegistration" maxlength="30" placeholder="예: 1980-01-01 또는 800101-1234567" required /></div>
        <div class="form-field"><label for="employee-start">재직 시작일</label><input id="employee-start" name="employmentStartDate" type="date" required /></div>
        <div class="form-field form-field--full"><label for="employee-address">주소</label><input id="employee-address" name="address" maxlength="500" required /></div>
        <div class="form-field"><label for="employee-department">소속</label><input id="employee-department" name="department" maxlength="100" required /></div>
        <div class="form-field"><label for="employee-position">직위 또는 직급</label><input id="employee-position" name="positionGrade" maxlength="100" required /></div>
        <div class="form-field"><label for="certificate-issue-date">발급일</label><input id="certificate-issue-date" name="issueDate" type="date" required /></div>
        <div class="form-field"><label for="certificate-purpose">용도</label><input id="certificate-purpose" name="purpose" maxlength="300" placeholder="예: 금융기관 제출용" required /></div>
        <div class="form-field"><label for="certificate-manager">담당자</label><input id="certificate-manager" name="managerName" maxlength="60" /></div>
        <div class="form-field"><label for="certificate-contact">연락처</label><input id="certificate-contact" name="contact" maxlength="80" placeholder="예: 054-000-0000" /></div>
        <div class="form-field"><label for="certificate-signatory-title">발급명의 직함</label><select id="certificate-signatory-title" name="signatoryTitle" required><option value="이사장">이사장</option><option value="이사장 직무대리">이사장 직무대리</option></select></div>
        <div class="form-field"><label for="certificate-signatory-user">발급명의 성명</label><select id="certificate-signatory-user" name="signatoryUserId" data-signatory-select required></select></div>
      </div>
      <div class="status-message" data-issue-status aria-live="polite"></div>
      <div class="form-actions"><button type="button" class="btn btn-outline" data-preview>입력내용 미리보기</button><button type="submit" class="btn btn-primary" data-issue-button>재직증명서 발급</button></div>
    </form>
  </section>

  <section class="surface certificate-ledger">
    <div class="section-title"><div><h2>증명서 발급대장</h2><p>발급번호, 발급일, 대상자, 용도와 취소 여부를 확인합니다.</p></div><div class="toolbar ledger-filters"><select data-ledger-status><option value="">전체 상태</option><option value="발급">발급</option><option value="취소">취소</option></select><input type="search" data-ledger-query placeholder="발급번호·성명·소속·용도 검색" /><select data-ledger-size><option value="10">10개</option><option value="20" selected>20개</option><option value="50">50개</option></select><button type="button" class="btn btn-outline" data-ledger-search>조회</button><button type="button" class="btn btn-outline" data-ledger-export>CSV</button></div></div>
    <div class="status-message" data-ledger-status-message aria-live="polite"></div>
    <div class="data-wrap"><table class="data-table certificate-table"><thead><tr><th>발급번호</th><th>발급일</th><th>성명</th><th>생년월일·주민번호</th><th>소속</th><th>직위·직급</th><th>용도</th><th>상태</th><th>관리</th></tr></thead><tbody data-ledger-body><tr><td colspan="9">불러오는 중입니다.</td></tr></tbody></table></div>
    <div class="pagination" data-ledger-pagination></div>
  </section>

  <div class="modal-overlay" data-preview-modal hidden>
    <section class="modal certificate-preview-modal">
      <header class="modal__header"><h2>재직증명서 미리보기</h2><button type="button" class="modal__close" data-close-preview>×</button></header>
      <div class="modal__body"><div data-preview-container></div><div class="modal__actions"><button type="button" class="btn btn-outline" data-close-preview>닫기</button><button type="button" class="btn btn-primary" data-print-preview>인쇄</button></div></div>
    </section>
  </div>

  <script is:inline>
    (()=>{
      const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>Array.from(r.querySelectorAll(s));
      const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const session=(()=>{try{return JSON.parse(localStorage.getItem('milgyo-system-session')||'null')}catch{return null}})();if(!session?.token)return;
      let users=[],page=1,pages=1,currentRows=[],canManage=false,lastPreview=null;
      const api=async(url,payload)=>{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:session.token,...payload})});const d=await r.json();if(!d.ok&&r.status===401){localStorage.removeItem('milgyo-system-session');location.replace('/');throw new Error(d.message||'로그인이 필요합니다.')}return d;};
      const today=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,10);
      const parseDateParts=v=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(v||'');return m?{year:Number(m[1]),month:Number(m[2]),day:Number(m[3])}:null};
      const koreanDate=v=>{const d=parseDateParts(v);return d?`${d.year}년 ${d.month}월 ${d.day}일`:v||''};
      const employmentPeriodInfo=(startDate,issueDate)=>{const start=parseDateParts(startDate);const end=parseDateParts(issueDate);if(!start||!end){return {startDateText:koreanDate(startDate)||'-',issueDateText:koreanDate(issueDate)||'-',durationText:''};}let totalMonths=(end.year-start.year)*12+(end.month-start.month);if(end.day<start.day)totalMonths-=1;if(totalMonths<0)totalMonths=0;const years=Math.floor(totalMonths/12);const months=totalMonths%12;return {startDateText:`${start.year}년 ${start.month}월 ${start.day}일`,issueDateText:`${end.year}년 ${end.month}월 ${end.day}일`,durationText:`( ${years}년 ${months}월 )`};};
      const setMessage=(sel,msg,type='')=>{const el=$(sel);el.textContent=msg||'';el.className=`status-message ${type}`};
      const selectedUser=()=>users.find(u=>String(u.id)===String($('[data-employee-select]').value));
      const fillUser=()=>{const u=selectedUser()||{};$('[data-employee-name]').value=u.name||'';$('[name=nameHanja]').value=u.name_hanja||'';$('[name=birthOrRegistration]').value=u.birth_or_registration||'';$('[name=address]').value=u.address||'';$('[name=employmentStartDate]').value=u.employment_start_date||'';$('[name=department]').value=u.department||'';$('[name=positionGrade]').value=[u.position,u.grade].filter(Boolean).join(' / ');requestAnimationFrame(()=>window.__MILGYO_SYNC_MANAGEMENT_DATES__?.($('[data-issue-form]')));};
      const formRecord=(certificateNo='미리보기')=>{const f=new FormData($('[data-issue-form]'));const signatory=users.find(u=>String(u.id)===String(f.get('signatoryUserId')));return {certificate_no:certificateNo,employee_name_ko:$('[data-employee-name]').value,employee_name_hanja:f.get('nameHanja'),birth_or_registration:f.get('birthOrRegistration'),address:f.get('address'),department:f.get('department'),position_grade:f.get('positionGrade'),employment_start_date:f.get('employmentStartDate'),purpose:f.get('purpose'),issue_date:f.get('issueDate'),manager_name:f.get('managerName')||session.user.name,contact:f.get('contact'),signatory_title:f.get('signatoryTitle')||'이사장',signatory_user_id:f.get('signatoryUserId'),signatory_name:signatory?.name||session.user.name,status:'발급'};};
      const displayCertificateNo=(value)=>{const text=String(value||'').trim();if(!text||text==='미리보기')return '미리보기';return text.replace(/^재직[-\s]*/,'');};
      const displaySignatoryName=(value)=>{const text=String(value||'').trim();return /^[가-힣]{2,5}$/.test(text)?Array.from(text).join(' '):text.replace(/\s+/g,' ');};
      const certificateCoreCss=`
        .employment-certificate-preview-root,.employment-certificate-preview-root *{box-sizing:border-box}
        .employment-certificate-preview-root{background:#dfe4ea;padding:1rem}
        .employment-certificate-paper{width:794px;min-height:1123px;margin:0 auto;background:#fff;padding:78px 64px 74px;color:#111;font-family:"Nanum Myeongjo","Noto Serif KR","Malgun Myeongjo",Batang,serif}
        .employment-certificate-title{display:table;margin:0 auto 56px;padding:0 20px 8px;border-bottom:4px double #111;font-size:34px;line-height:1.1;font-weight:700;letter-spacing:.42em;text-indent:.42em;white-space:nowrap}
        .employment-certificate-head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;column-gap:8px;margin:0 0 10px 6px}
        .employment-certificate-number{padding-top:24px;font-size:16px;line-height:1.5;white-space:nowrap}
        .employment-certificate-number strong{display:inline-block;min-width:78px;text-align:center;font-weight:400}
        .employment-certificate-meta{display:flex;flex-direction:column;gap:6px;min-width:0;width:max-content;margin-right:0;font-size:15.5px;line-height:1.45;white-space:nowrap;justify-self:end}
        .employment-certificate-meta-row{display:grid;grid-template-columns:60px minmax(0,1fr);align-items:baseline;column-gap:4px;width:100%}
        .employment-certificate-meta-label{font-weight:600;text-align:left}
        .employment-certificate-meta-value{min-width:0;letter-spacing:.02em;white-space:nowrap;text-align:left}
        .employment-certificate-table{width:100%;border-collapse:collapse;table-layout:fixed;border:1.6px solid #222;font-size:17px}
        .employment-certificate-table th,.employment-certificate-table td{border:1.3px solid #222;padding:10px 8px;text-align:center;vertical-align:middle;line-height:1.5;font-weight:400;word-break:keep-all;overflow-wrap:anywhere}
        .employment-certificate-table th{font-weight:600}
        .employment-certificate-table .employment-section-label{font-size:18px;line-height:1.85;letter-spacing:.18em}
        .employment-certificate-table .employment-value{padding:12px 14px;text-align:center}
        .employment-certificate-table .employment-address{padding:12px 16px;text-align:center}
        .employment-certificate-table .employment-period{padding:10px 14px;line-height:1.65}
        .employment-certificate-period-grid{display:grid;grid-template-columns:165px 74px;row-gap:6px;column-gap:0;align-items:center;justify-content:center;max-width:239px;margin:0 auto}
        .employment-certificate-period-date{text-align:right;padding-right:8px}
        .employment-certificate-period-label{text-align:left;white-space:nowrap;padding-left:0}
        .employment-certificate-period-note{margin-left:6px;white-space:nowrap}
        .employment-certificate-purpose{text-align:center;padding:12px 14px!important}
        .employment-certificate-purpose-note{display:block;margin-top:6px;text-align:right;font-size:14px}
        .employment-certificate-statement{text-align:center;margin:48px 0 40px;font-size:18px;letter-spacing:0;word-spacing:0}
        .employment-certificate-date{text-align:center;margin:0 0 34px;font-size:17px}
        .employment-certificate-issuer{width:100%;margin:0 auto;padding-bottom:78px;text-align:center;font-size:22px;line-height:1.5;font-weight:600}
        .employment-certificate-issuer-block{position:relative;display:inline-grid;grid-auto-rows:auto;justify-items:end;min-width:0;width:max-content;max-width:100%;margin:0 auto;text-align:right;padding-right:0}.employment-certificate-issuer-line{position:relative;z-index:2;display:block;white-space:nowrap;letter-spacing:0}
        .employment-certificate-issuer-line + .employment-certificate-issuer-line{margin-top:4px}
        .employment-certificate-seal{position:absolute;z-index:1;right:-62px;top:2px;width:98px;height:98px;object-fit:contain;pointer-events:none;opacity:1;mix-blend-mode:normal;filter:none;background:transparent}
        .employment-certificate-print-action{width:794px;margin:12px auto 24px;text-align:right}
        .employment-certificate-print-action button{padding:7px 18px}
        @media print{
          .employment-certificate-preview-root{background:#fff;padding:0}
          .employment-certificate-print-action{display:none}
          .employment-certificate-paper{margin:0}
          @page{size:A4;margin:0}
        }
      `;
      const certificateMarkup=(r)=>{const period=employmentPeriodInfo(r.employment_start_date,r.issue_date);const signatoryTitle=String(r.signatory_title||'이사장').trim();const signatoryName=displaySignatoryName(r.signatory_name||'김양휘');return `<div class="employment-certificate-preview-root"><article class="employment-certificate-paper">
        <div class="employment-certificate-title">재 직 증 명 서</div>
        <div class="employment-certificate-head">
          <div class="employment-certificate-number">제 <strong>${esc(displayCertificateNo(r.certificate_no))}</strong> 호</div>
          <div class="employment-certificate-meta">
            <div class="employment-certificate-meta-row"><span class="employment-certificate-meta-label">담당자 :</span><span class="employment-certificate-meta-value">${esc(r.manager_name||'-')}</span></div>
            <div class="employment-certificate-meta-row"><span class="employment-certificate-meta-label">연락처 :</span><span class="employment-certificate-meta-value">${esc(r.contact||'-')}</span></div>
          </div>
        </div>
        <table class="employment-certificate-table">
          <colgroup>
            <col style="width:10%"><col style="width:10.5%"><col style="width:10%"><col style="width:27.5%"><col style="width:14.5%"><col style="width:27.5%">
          </colgroup>
          <tbody>
            <tr>
              <th rowspan="3" class="employment-section-label">인 적<br/>사 항</th>
              <th rowspan="2">성 명</th>
              <th>한 글</th>
              <td class="employment-value">${esc(r.employee_name_ko||'-')}</td>
              <th rowspan="2">생년월일<br/>또는<br/>주민등록<br/>번 호</th>
              <td rowspan="2" class="employment-value">${esc(r.birth_or_registration||'-')}</td>
            </tr>
            <tr>
              <th>한 자</th>
              <td class="employment-value">${esc(r.employee_name_hanja||'-')}</td>
            </tr>
            <tr>
              <th colspan="2">주 소</th>
              <td colspan="3" class="employment-address">${esc(r.address||'-')}</td>
            </tr>
            <tr>
              <th rowspan="3" class="employment-section-label">재 직<br/>사 항</th>
              <th colspan="2">소 속</th>
              <td colspan="3" class="employment-value">${esc(r.department||'-')}</td>
            </tr>
            <tr>
              <th colspan="2">직위 또는 직급</th>
              <td colspan="3" class="employment-value">${esc(r.position_grade||'-')}</td>
            </tr>
            <tr>
              <th colspan="2">기 간</th>
              <td colspan="3" class="employment-period">
                <div class="employment-certificate-period-grid">
                  <div class="employment-certificate-period-date">${esc(period.startDateText)}</div>
                  <div class="employment-certificate-period-label">부터</div>
                  <div class="employment-certificate-period-date">${esc(period.issueDateText)}</div>
                  <div class="employment-certificate-period-label">현재<span class="employment-certificate-period-note">${esc(period.durationText)}</span></div>
                </div>
              </td>
            </tr>
            <tr>
              <th class="employment-section-label">용 도</th>
              <td colspan="5" class="employment-certificate-purpose">${esc(r.purpose||'-')}<span class="employment-certificate-purpose-note">(타 용도로는 사용할 수 없음)</span></td>
            </tr>
          </tbody>
        </table>
        <p class="employment-certificate-statement">위와 같이 재직을 증명합니다.</p>
        <p class="employment-certificate-date">${esc(koreanDate(r.issue_date))}</p>
        <div class="employment-certificate-issuer">
          <div class="employment-certificate-issuer-block">
            <div class="employment-certificate-issuer-line">(사) 대한불교밀교종</div>
            <div class="employment-certificate-issuer-line">${esc(signatoryTitle)} ${esc(signatoryName)}</div>
            <img class="employment-certificate-seal" src="/organization-seal.png" alt="대한불교밀교종 직인" />
          </div>
        </div>
      </article></div>`;};
      const certificatePreviewHtml=(r)=>`<style>${certificateCoreCss}</style>${certificateMarkup(r)}`;
      const certificatePrintHtml=(r)=>`<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>${esc(r.certificate_no)} 재직증명서</title><style>body{margin:0;background:#fff;color:#111;font-family:"Nanum Myeongjo","Noto Serif KR","Malgun Myeongjo",Batang,serif}${certificateCoreCss}</style></head><body>${certificateMarkup(r)}<div class="employment-certificate-print-action"><button onclick="window.print()">인쇄</button></div></body></html>`;
      const openPreview=(r)=>{lastPreview=r;$('[data-preview-container]').innerHTML=certificatePreviewHtml(r);$('[data-preview-modal]').hidden=false;};
      const closePreview=()=>{$('[data-preview-modal]').hidden=true};$$('[data-close-preview]').forEach(b=>b.addEventListener('click',closePreview));
      const printRecord=r=>{const w=window.open('','_blank','width=980,height=1080');if(!w){alert('팝업 차단을 해제해 주세요.');return;}w.document.write(certificatePrintHtml(r));w.document.close();};
      $('[data-preview]').addEventListener('click',()=>{if(!$('[data-issue-form]').reportValidity())return;openPreview(formRecord())});$('[data-print-preview]').addEventListener('click',()=>{if(lastPreview)printRecord(lastPreview)});
      const loadOptions=async()=>{const d=await api('/api/employment/query',{operation:'options'});if(!d.ok){setMessage('[data-issue-status]',d.message,'error');return;}users=d.users||[];canManage=!!d.canManage;if(!d.canIssue){$('[data-issue-button]').hidden=true;$('[data-preview]').hidden=true;$$('[data-issue-form] input,[data-issue-form] select').forEach(el=>el.disabled=true);setMessage('[data-issue-status]','재직증명서는 관리자 계정에서 발급할 수 있습니다.','');}const select=$('[data-employee-select]');select.innerHTML=users.map(u=>`<option value="${esc(u.id)}">${esc(u.name)} · ${esc(u.department||'소속 미지정')} · ${esc(u.position||u.grade||'직위 미지정')}</option>`).join('');const signatorySelect=$('[data-signatory-select]');signatorySelect.innerHTML=users.map(u=>`<option value="${esc(u.id)}">${esc(u.name)} · ${esc(u.position||u.grade||'직책 미지정')}</option>`).join('');if(!users.length){select.innerHTML='<option value="">발급 가능한 임·직원이 없습니다.</option>';signatorySelect.innerHTML='<option value="">선택 가능한 계정이 없습니다.</option>';$('[data-issue-button]').disabled=true;}else{const preferred=users.find(u=>String(u.position||'').trim()==='이사장')||users.find(u=>String(u.position||'').trim()==='이사장 직무대리')||users.find(u=>String(u.id)===String(session.user.id))||users[0];signatorySelect.value=String(preferred.id);if(['이사장','이사장 직무대리'].includes(String(preferred.position||'').trim()))$('[name=signatoryTitle]').value=String(preferred.position).trim();}fillUser();loadLedger();};
      $('[data-employee-select]').addEventListener('change',fillUser);$('[name=issueDate]').value=today();$('[name=managerName]').value=session.user.name||'';requestAnimationFrame(()=>window.__MILGYO_SYNC_MANAGEMENT_DATES__?.($('[data-issue-form]')));
      $('[data-issue-form]').addEventListener('submit',async e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;setMessage('[data-issue-status]','발급 중입니다...');const f=new FormData(e.currentTarget);const d=await api('/api/employment/action',{operation:'issue',employeeUserId:f.get('employeeUserId'),nameHanja:f.get('nameHanja'),birthOrRegistration:f.get('birthOrRegistration'),address:f.get('address'),employmentStartDate:f.get('employmentStartDate'),department:f.get('department'),positionGrade:f.get('positionGrade'),purpose:f.get('purpose'),issueDate:f.get('issueDate'),managerName:f.get('managerName'),contact:f.get('contact'),signatoryTitle:f.get('signatoryTitle'),signatoryUserId:f.get('signatoryUserId')});if(!d.ok){setMessage('[data-issue-status]',d.message,'error');return;}setMessage('[data-issue-status]',d.message,'ok');printRecord(d.row);page=1;await loadLedger();});
      const loadLedger=async()=>{setMessage('[data-ledger-status-message]','불러오는 중입니다...');const d=await api('/api/employment/query',{query:$('[data-ledger-query]').value.trim(),status:$('[data-ledger-status]').value,page,pageSize:Number($('[data-ledger-size]').value)});if(!d.ok){setMessage('[data-ledger-status-message]',d.message,'error');return;}currentRows=d.rows||[];pages=d.pages||1;canManage=!!d.canManage;const body=$('[data-ledger-body]');body.innerHTML=currentRows.length?currentRows.map(r=>`<tr><td>${esc(r.certificate_no)}</td><td>${esc(r.issue_date)}</td><td>${esc(r.employee_name_ko)}</td><td>${esc(r.birth_or_registration_masked||'-')}</td><td>${esc(r.department)}</td><td>${esc(r.position_grade)}</td><td class="text-left">${esc(r.purpose)}</td><td><span class="badge badge--${esc(r.status)}">${esc(r.status)}</span></td><td><div class="row-actions"><button type="button" class="btn btn-outline btn-sm" data-print-id="${esc(r.id)}">출력</button>${canManage&&r.status==='발급'?`<button type="button" class="btn btn-outline btn-sm danger" data-cancel-id="${esc(r.id)}">취소</button>`:''}</div></td></tr>`).join(''):'<tr><td colspan="9">발급내역이 없습니다.</td></tr>';$$('[data-print-id]',body).forEach(b=>b.addEventListener('click',async()=>{const d=await api('/api/employment/query',{operation:'detail',id:b.dataset.printId});if(!d.ok){alert(d.message);return;}printRecord(d.row)}));$$('[data-cancel-id]',body).forEach(b=>b.addEventListener('click',async()=>{const reason=prompt('취소 사유를 입력해 주세요.');if(!reason)return;const d=await api('/api/employment/action',{operation:'cancel',id:b.dataset.cancelId,reason});if(!d.ok){alert(d.message);return;}loadLedger()}));renderPagination();setMessage('[data-ledger-status-message]',`총 ${Number(d.total||0).toLocaleString('ko-KR')}건`);};
      const renderPagination=()=>{const box=$('[data-ledger-pagination]');const s=Math.max(1,page-2),e=Math.min(pages,page+2);let h=`<button data-page="${Math.max(1,page-1)}" ${page===1?'disabled':''}>‹</button>`;for(let i=s;i<=e;i++)h+=`<button data-page="${i}" class="${i===page?'active':''}">${i}</button>`;h+=`<button data-page="${Math.min(pages,page+1)}" ${page===pages?'disabled':''}>›</button>`;box.innerHTML=h;$$('[data-page]',box).forEach(b=>b.addEventListener('click',()=>{page=Number(b.dataset.page);loadLedger()}));};
      $('[data-ledger-search]').addEventListener('click',()=>{page=1;loadLedger()});$('[data-ledger-query]').addEventListener('keydown',e=>{if(e.key==='Enter'){page=1;loadLedger()}});$$('[data-ledger-status],[data-ledger-size]').forEach(el=>el.addEventListener('change',()=>{page=1;loadLedger()}));
      const csv=()=>{const q=v=>`"${String(v??'').replace(/"/g,'""')}"`;const rows=[['발급번호','발급일','성명','소속','직위·직급','용도','상태'],...currentRows.map(r=>[r.certificate_no,r.issue_date,r.employee_name_ko,r.department,r.position_grade,r.purpose,r.status])];const blob=new Blob(['\ufeff'+rows.map(r=>r.map(q).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`재직증명서_발급대장_${today()}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};$('[data-ledger-export]').addEventListener('click',csv);
      loadOptions();
    })();
  </script>

  <style>
    .certificate-issue-panel{margin-bottom:1rem}.section-title{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:1rem}.section-title h2{margin:0;font-size:1.12rem}.section-title p{margin:.2rem 0 0;color:var(--gov-muted);font-size:.8rem}.privacy-note{font-size:.76rem;color:#6e520a;background:#fff8e6;border:1px solid #ead49a;padding:.4rem .55rem;border-radius:5px}.certificate-form-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.certificate-form-grid .form-field--full{grid-column:1/-1}.form-actions{display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem;padding-top:.8rem;border-top:1px solid var(--gov-border)}.ledger-filters input{min-width:260px}.certificate-table th:last-child,.certificate-table td:last-child{width:125px}.row-actions{display:flex;justify-content:center;gap:.4rem}.danger{color:#a12626;border-color:#dfb4b4}.certificate-preview-modal{width:min(980px,calc(100vw - 2rem))}.certificate-preview-modal [data-preview-container]{overflow:auto;background:#dfe4ea;padding:1rem}.certificate-preview-modal .employment-certificate-paper{transform-origin:top center}@media(max-width:1100px){.certificate-form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.certificate-form-grid{grid-template-columns:1fr}.section-title{align-items:flex-start;flex-direction:column}.ledger-filters input{min-width:0;width:100%}.certificate-preview-modal .employment-certificate-paper{transform:scale(.72);margin-bottom:-314px}}
  </style>
</ManagementLayout>
