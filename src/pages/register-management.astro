---
import ManagementLayout from '../layouts/ManagementLayout.astro';
---
<ManagementLayout title="대장관리기능" active="registers">
  <div data-register-management-version="2026-08-01-v57" hidden></div>
  <div class="page-heading">
    <div><p class="page-heading__kicker">REGISTER MANAGEMENT</p><h1>대장관리기능</h1><p>공고대장, 관인날인 기록부, 인영관리 기록부를 신청·조회·처리합니다.</p></div>
    <button type="button" class="btn btn-primary" data-open-request>+ 신청</button>
  </div>

  <section class="surface register-surface">
    <div class="register-type-tabs" role="tablist" aria-label="대장 유형">
      <button type="button" class="register-type-tab active" data-register-type="공고대장">공고대장</button>
      <button type="button" class="register-type-tab" data-register-type="관인날인기록부">관인날인 기록부</button>
      <button type="button" class="register-type-tab" data-register-type="인영관리기록부">인영관리 기록부</button>
    </div>
    <div class="toolbar toolbar--between register-list-toolbar">
      <div class="scope-tabs">
        <button type="button" class="scope-tab active" data-scope="all">전체목록</button>
        <button type="button" class="scope-tab" data-scope="mine">나의목록</button>
      </div>
      <div class="toolbar register-filters">
        <select data-status-filter aria-label="처리상태"><option value="">전체 상태</option><option>신청</option><option>검토중</option><option>완료</option><option>반려</option><option>취소</option></select>
        <input type="date" data-date-from aria-label="시작일" />
        <span>~</span>
        <input type="date" data-date-to aria-label="종료일" />
        <input type="search" data-query placeholder="신청번호·건명·신청자 검색" />
        <select data-page-size aria-label="페이지당 건수"><option value="10">10개</option><option value="20" selected>20개</option><option value="50">50개</option></select>
        <button type="button" class="btn btn-outline" data-search>조회</button>
        <button type="button" class="btn btn-outline" data-export>CSV</button><button type="button" class="btn btn-outline" data-print-list>인쇄</button>
      </div>
    </div>
    <div class="status-message" data-status aria-live="polite"></div>
    <div class="data-wrap"><table class="data-table register-table" data-register-table><colgroup data-table-cols></colgroup><thead data-table-head></thead><tbody data-table-body><tr><td colspan="9">불러오는 중입니다.</td></tr></tbody></table></div>
    <div class="pagination" data-pagination></div>
  </section>

  <div class="modal-overlay" data-request-modal hidden>
    <section class="modal">
      <header class="modal__header"><h2 data-request-title>대장 신청</h2><button type="button" class="modal__close" data-close-request aria-label="닫기">×</button></header>
      <form class="modal__body" data-request-form>
        <div class="form-grid">
          <div class="form-field"><label for="r-type">대장 유형</label><select id="r-type" name="type" data-form-type><option>공고대장</option><option>관인날인기록부</option><option>인영관리기록부</option></select></div>
          <div class="form-field"><label for="r-date">신청일</label><input id="r-date" name="requestDate" type="date" data-weekday required /></div>
        </div>

        <fieldset class="register-fieldset" data-fields="공고대장">
          <legend>공고대장 신청</legend>
          <div class="form-grid">
            <div class="form-field"><label for="notice-date">공고일</label><input id="notice-date" name="noticeDate" type="date" data-weekday /></div>
            <div class="form-field"><label for="notice-number">공고번호(선택)</label><input id="notice-number" name="noticeNumber" maxlength="60" placeholder="예: 대한불교밀교종 공고 제2026-1호" /></div>
            <div class="form-field form-field--full"><label for="notice-title">공고명</label><input id="notice-title" name="noticeTitle" maxlength="200" required /></div>
            <div class="form-field form-field--full"><label for="notice-body">공고내용</label><textarea id="notice-body" name="noticeBody" rows="6"></textarea></div>
            <div class="form-field form-field--full"><label for="notice-remarks">비고</label><textarea id="notice-remarks" name="noticeRemarks" rows="2"></textarea></div>
          </div>
        </fieldset>

        <fieldset class="register-fieldset" data-fields="관인날인기록부" hidden>
          <legend>관인날인 기록부 신청</legend>
          <div class="form-grid">
            <div class="form-field form-field--full"><label for="seal-subject">건명</label><input id="seal-subject" name="sealSubject" maxlength="200" /></div>
            <div class="form-field"><label for="seal-count">날인매수</label><input id="seal-count" name="sealCount" type="number" min="1" max="9999" /></div>
            <div class="form-field"><label for="seal-type">관인종류</label><select id="seal-type" name="sealType"><option value="법인인감">법인인감</option><option value="사용인감">사용인감</option><option value="직인">직인</option><option value="기타">기타</option></select></div>
            <div class="form-field form-field--full"><label for="seal-basis">관련근거</label><input id="seal-basis" name="relatedBasis" maxlength="300" placeholder="관련 문서번호 또는 근거" /></div>
            <div class="form-field form-field--full"><label for="seal-purpose">사용목적</label><textarea id="seal-purpose" name="sealPurpose" rows="4"></textarea></div>
            <div class="form-field form-field--full"><label for="seal-remarks">비고</label><textarea id="seal-remarks" name="sealRemarks" rows="2"></textarea></div>
          </div>
        </fieldset>

        <fieldset class="register-fieldset" data-fields="인영관리기록부" hidden>
          <legend>인영관리 기록부 신청</legend>
          <div class="form-grid">
            <div class="form-field form-field--full"><label for="imprint-reference">근거문서</label><input id="imprint-reference" name="referenceDocument" maxlength="200" placeholder="예: 밀교종-2026-001" /></div>
            <div class="form-field form-field--full"><label for="imprint-purpose">사용목적</label><textarea id="imprint-purpose" name="imprintPurpose" rows="3"></textarea></div>
            <div class="form-field form-field--full"><label for="recipient-organization">사용기관·업체명</label><input id="recipient-organization" name="recipientOrganization" maxlength="200" /></div>
            <div class="form-field"><label for="representative-name">사용기관 대표자명</label><input id="representative-name" name="representativeName" maxlength="100" /></div>
            <div class="form-field"><label for="business-number">사용기관 사업자번호</label><input id="business-number" name="businessNumber" maxlength="40" placeholder="예: 105-235-78521" /></div>
            <div class="form-field"><label for="usage-method">사용방법</label><select id="usage-method" name="usageMethod"><option value="인쇄물">인쇄물</option><option value="전자문서">전자문서</option><option value="온라인 게시">온라인 게시</option><option value="기타">기타</option></select></div>
            <div class="form-field"><label for="usage-count">사용개수</label><input id="usage-count" name="usageCount" type="number" min="1" max="999999" /></div>
            <div class="form-field"><label for="usage-start">사용기간 시작</label><input id="usage-start" name="usageStartDate" type="date" data-weekday /></div>
            <div class="form-field"><label for="usage-end">사용기간 종료</label><input id="usage-end" name="usageEndDate" type="date" data-weekday /></div>
            <div class="form-field"><label for="usage-completion">사용완료일(사후입력 가능)</label><input id="usage-completion" name="usageCompletionDate" type="date" data-weekday /></div>
            <div class="form-field"><label for="imprint-contact">신청자 연락처</label><input id="imprint-contact" name="imprintContact" maxlength="80" /></div>
            <div class="form-field form-field--full pledge-field"><label><input type="checkbox" name="pledgeAccepted" required /> 본인은 인영을 신청 목적 외 용도로 사용하지 않으며, 본 건으로 인한 사고 발생 시 책임을 감수할 것을 확인합니다.</label></div>
            <div class="form-field form-field--full"><label for="imprint-remarks">비고</label><textarea id="imprint-remarks" name="imprintRemarks" rows="2"></textarea></div>
          </div>
        </fieldset>

        <section class="attachment-box">
          <div><strong>첨부파일</strong><p class="hint">파일당 4MB 이하, 최대 10개입니다. 실행파일·스크립트 파일은 등록할 수 없습니다.</p></div>
          <input type="file" data-files multiple accept=".pdf,.hwp,.hwpx,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png" />
          <div class="pending-files" data-pending-files>선택된 파일이 없습니다.</div>
        </section>
        <div class="status-message" data-form-status aria-live="polite"></div>
        <div class="modal__actions"><button type="button" class="btn btn-outline" data-close-request>취소</button><button type="submit" class="btn btn-primary">신청 등록</button></div>
      </form>
    </section>
  </div>

  <div class="modal-overlay" data-detail-modal hidden>
    <section class="modal register-detail-modal">
      <header class="modal__header"><h2>대장 신청 상세</h2><button type="button" class="modal__close" data-close-detail aria-label="닫기">×</button></header>
      <div class="modal__body register-detail-modal__body">
        <section class="detail-section detail-section--summary">
          <h3>기본정보</h3>
          <div class="detail-grid" data-detail-grid></div>
        </section>
        <section class="detail-section"><h3>신청내용</h3><div class="detail-content" data-detail-content></div></section>
        <section class="detail-section"><h3>첨부파일</h3><div class="attachment-list" data-attachment-list></div></section>
        <section class="admin-processing" data-admin-processing hidden>
          <h3>관리자 처리</h3>
          <div class="form-grid"><div class="form-field"><label for="process-status">처리상태</label><select id="process-status" data-process-status><option>신청</option><option>검토중</option><option>완료</option><option>반려</option></select></div><div class="form-field form-field--full"><label for="process-memo">처리의견</label><textarea id="process-memo" data-process-memo></textarea></div></div>
          <div class="modal__actions"><button type="button" class="btn btn-primary" data-save-status>처리상태 저장</button></div>
        </section>
        <div class="modal__actions register-detail-footer"><button type="button" class="btn btn-outline" data-cancel-request hidden>신청 취소</button><button type="button" class="btn btn-outline" data-close-detail>닫기</button></div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
      const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[char]));
      const session = (() => {
        try { return JSON.parse(localStorage.getItem('milgyo-system-session') || 'null'); }
        catch { return null; }
      })();
      if (!session?.token) return;

      let currentType = '공고대장';
      let scope = 'all';
      let page = 1;
      let pages = 1;
      let currentDetail = null;
      let canManage = false;
      let pendingFiles = [];
      let listRequestSequence = 0;
      let detailRequestSequence = 0;
      let listAbortController = null;
      let detailAbortController = null;
      const listCache = new Map();

      const api = async (url, payload, options = {}) => {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: session.token, ...payload }),
          signal: options.signal,
        });
        const data = await response.json();
        if (!data.ok && response.status === 401) {
          localStorage.removeItem('milgyo-system-session');
          location.replace('/');
          throw new Error(data.message || '로그인이 필요합니다.');
        }
        return data;
      };

      const today = () => new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
      const formatBytes = (size) => {
        const value = Number(size || 0);
        if (value < 1024) return `${value}B`;
        if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)}KB`;
        return `${(value / 1024 / 1024).toFixed(1)}MB`;
      };
      const setStatus = (message, type = '') => {
        const element = $('[data-status]');
        element.textContent = message || '';
        element.className = `status-message ${type}`;
      };
      const displayValue = (value) => {
        if (value === true) return '동의';
        if (value === false) return '미동의';
        if (value === null || value === undefined || value === '') return '-';
        return String(value);
      };
      const formatDepartmentLabel = (value) => {
        let text = String(value || '').trim();
        if (!text) return '-';
        text = text.replace(/\s*[–—]\s*/g, ' - ');
        const match = /^(.+?)\s*\(([^()]+)\)\s*$/.exec(text);
        if (match) text = `${match[1].trim()} - ${match[2].trim()}`;
        const parts = text.split(/\s+-\s+/).map((part) => part.trim()).filter(Boolean);
        let primary = parts[0] || '';
        let secondary = parts.slice(1).join(' - ');
        const map = (name) => name === '재정·회계' ? '재정국' : name === '준법·윤리' ? '준법윤리국' : name === '대외협력·사회공헌' ? '국제교류국' : name === '문화·홍보' ? '문화홍보국' : name;
        if (primary === '사무국') primary = '사무처';
        if (secondary) secondary = map(secondary);
        if (!secondary && ['재정국','준법윤리국','국제교류국','문화홍보국','사회공헌국'].includes(map(primary))) { secondary = map(primary); primary = '사무처'; }
        return secondary ? `${primary}(${secondary})` : primary;
      };

      const labels = {
        공고대장: {
          noticeDate: '공고일', noticeNumber: '공고번호', noticeTitle: '공고명',
          noticeBody: '공고내용', remarks: '비고',
        },
        관인날인기록부: {
          subject: '건명', sealCount: '날인매수', relatedBasis: '관련근거',
          sealType: '관인종류', purpose: '사용목적', remarks: '비고',
        },
        인영관리기록부: {
          referenceDocument: '근거번호', purpose: '사용목적',
          recipientOrganization: '사용기관·업체명', representativeName: '사용기관 대표자명',
          businessNumber: '사용기관 사업자번호', usageMethod: '사용방법',
          usageStartDate: '사용기간 시작', usageEndDate: '사용기간 종료',
          usageCompletionDate: '사용완료일', usageCount: '사용수량',
          contact: '신청자 연락처', pledgeAccepted: '준수사항 서약', remarks: '비고',
        },
      };

      const headers = {
        공고대장: ['신청일', '신청번호', '공고일', '공고명', '신청자', '첨부', '상태', '관리'],
        관인날인기록부: ['신청일', '신청번호', '건명', '부서', '신청자', '날인매수', '관련근거', '상태', '관리'],
        인영관리기록부: ['신청일', '신청번호', '부서', '신청자', '사용목적', '사용기관', '근거문서', '상태', '관리'],
      };

      const columnWidths = {
        공고대장: ['9%', '12%', '9%', '36%', '10%', '7%', '7%', '10%'],
        관인날인기록부: ['9%', '11%', '30%', '9%', '8%', '7%', '13%', '6%', '7%'],
        인영관리기록부: ['9%', '11%', '8%', '8%', '25%', '15%', '12%', '6%', '6%'],
      };

      const rowCells = (row, type = currentType) => {
        const content = row.content || {};
        if (type === '공고대장') {
          return [
            row.request_date, row.request_no, content.noticeDate || '-', row.title,
            row.applicant_name, `${row.attachment_count || 0}건`, row.status, '상세',
          ];
        }
        if (type === '관인날인기록부') {
          return [
            row.request_date, row.request_no, row.title, formatDepartmentLabel(row.applicant_department),
            row.applicant_name, content.sealCount || '-', content.relatedBasis || '-', row.status, '상세',
          ];
        }
        return [
          row.request_date, row.request_no, formatDepartmentLabel(row.applicant_department), row.applicant_name,
          content.purpose || '-', content.recipientOrganization || '-',
          content.referenceDocument || '-', row.status, '상세',
        ];
      };

      const renderHead = (type = currentType) => {
        const table = $('[data-register-table]');
        table.dataset.registerType = type;
        $('[data-table-cols]').innerHTML = columnWidths[type]
          .map((width) => `<col style="width:${width}">`).join('');
        $('[data-table-head]').innerHTML = `<tr>${headers[type]
          .map((header) => `<th scope="col">${esc(header)}</th>`).join('')}</tr>`;
      };

      const cellClass = (type, index) => {
        const lastIndex = headers[type].length - 1;
        const statusIndex = lastIndex - 1;
        const applicantIndex = type === '인영관리기록부' ? 3 : 4;
        const wideTextIndex = type === '공고대장' ? 3 : type === '관인날인기록부' ? 2 : 4;
        const classes = [];
        if (index === applicantIndex) classes.push('register-cell--applicant');
        if (index === wideTextIndex) classes.push('register-cell--wide-text');
        if (index === statusIndex) classes.push('register-cell--status');
        if (index === lastIndex) classes.push('register-cell--manage');
        return classes.join(' ');
      };

      const renderRows = (rows, type = currentType) => {
        const body = $('[data-table-body]');
        if (!rows.length) {
          body.innerHTML = `<tr><td colspan="${headers[type].length}">등록된 자료가 없습니다.</td></tr>`;
          return;
        }
        body.innerHTML = rows.map((row) => {
          const cells = rowCells(row, type);
          return `<tr>${cells.map((value, index) => {
            const className = cellClass(type, index);
            if (index === headers[type].length - 2) {
              return `<td class="${className}"><span class="badge badge--${esc(value)}">${esc(value)}</span></td>`;
            }
            if (index === headers[type].length - 1) {
              return `<td class="${className}"><button type="button" class="btn btn-outline btn-sm" data-detail-id="${esc(row.id)}">상세</button></td>`;
            }
            return `<td class="${className}">${esc(displayValue(value))}</td>`;
          }).join('')}</tr>`;
        }).join('');
        $$('[data-detail-id]', body).forEach((button) => {
          button.addEventListener('click', () => openDetail(button.dataset.detailId));
        });
      };

      const currentListPayload = (type) => ({
        type,
        scope,
        status: $('[data-status-filter]').value,
        query: $('[data-query]').value.trim(),
        dateFrom: $('[data-date-from]').value,
        dateTo: $('[data-date-to]').value,
        page,
        pageSize: Number($('[data-page-size]').value),
      });

      const renderPagination = () => {
        const box = $('[data-pagination]');
        const start = Math.max(1, page - 2);
        const end = Math.min(pages, page + 2);
        let html = `<button data-page="${Math.max(1, page - 1)}" ${page === 1 ? 'disabled' : ''}>‹</button>`;
        for (let number = start; number <= end; number += 1) {
          html += `<button data-page="${number}" class="${number === page ? 'active' : ''}">${number}</button>`;
        }
        html += `<button data-page="${Math.min(pages, page + 1)}" ${page === pages ? 'disabled' : ''}>›</button>`;
        box.innerHTML = html;
        $$('[data-page]', box).forEach((button) => {
          button.addEventListener('click', () => {
            page = Number(button.dataset.page);
            load();
          });
        });
      };

      const load = async () => {
        const requestedType = currentType;
        const requestSequence = ++listRequestSequence;
        const table = $('[data-register-table]');
        const payload = currentListPayload(requestedType);
        const cacheKey = JSON.stringify(payload);
        const cached = listCache.get(cacheKey);

        listAbortController?.abort();
        listAbortController = new AbortController();
        renderHead(requestedType);
        table.classList.add('is-loading');
        table.setAttribute('aria-busy', 'true');

        if (cached && Date.now() - cached.savedAt < 30_000) {
          pages = cached.pages;
          renderRows(cached.rows, requestedType);
          renderPagination();
          setStatus(`총 ${Number(cached.total || 0).toLocaleString('ko-KR')}건 · 최신 정보 확인 중`);
        } else {
          $('[data-table-body]').innerHTML = `<tr><td colspan="${headers[requestedType].length}">불러오는 중입니다.</td></tr>`;
          $('[data-pagination]').innerHTML = '';
          setStatus('불러오는 중입니다...');
        }

        try {
          const data = await api('/api/registers/query', payload, { signal: listAbortController.signal });
          if (requestSequence !== listRequestSequence || requestedType !== currentType) return;
          if (!data.ok) {
            setStatus(data.message, 'error');
            return;
          }
          canManage = !!data.canManage;
          pages = data.pages || 1;
          const rows = data.rows || [];
          renderRows(rows, requestedType);
          renderPagination();
          listCache.set(cacheKey, {
            rows,
            total: data.total || 0,
            pages,
            savedAt: Date.now(),
          });
          setStatus(`총 ${Number(data.total || 0).toLocaleString('ko-KR')}건`);
        } catch (error) {
          if (error?.name !== 'AbortError') {
            console.error('register list load failed', error);
            if (!cached) setStatus('대장 목록을 불러오지 못했습니다. 잠시 후 다시 조회해 주세요.', 'error');
          }
        } finally {
          if (requestSequence === listRequestSequence) {
            table.classList.remove('is-loading');
            table.removeAttribute('aria-busy');
          }
        }
      };

      const setType = (type) => {
        if (!headers[type]) return;
        currentType = type;
        page = 1;
        detailAbortController?.abort();
        if (!$('[data-detail-modal]').hidden) closeDetail();
        $$('[data-register-type]').forEach((button) => {
          button.classList.toggle('active', button.dataset.registerType === type);
        });
        renderHead(type);
        $('[data-table-body]').innerHTML = `<tr><td colspan="${headers[type].length}">불러오는 중입니다.</td></tr>`;
        $('[data-pagination]').innerHTML = '';
        load();
      };

      $$('[data-register-type]').forEach((button) => {
        button.addEventListener('click', () => setType(button.dataset.registerType));
      });
      $$('[data-scope]').forEach((button) => {
        button.addEventListener('click', () => {
          scope = button.dataset.scope;
          page = 1;
          $$('[data-scope]').forEach((item) => item.classList.toggle('active', item === button));
          load();
        });
      });
      $('[data-search]').addEventListener('click', () => { page = 1; load(); });
      $('[data-query]').addEventListener('keydown', (event) => {
        if (event.key === 'Enter') { page = 1; load(); }
      });
      $$('[data-status-filter],[data-page-size]').forEach((element) => {
        element.addEventListener('change', () => { page = 1; load(); });
      });

      const showFields = (type) => {
        $$('[data-fields]').forEach((fieldset) => { fieldset.hidden = fieldset.dataset.fields !== type; });
        const requiredMap = {
          공고대장: ['noticeTitle'],
          관인날인기록부: ['sealSubject', 'sealCount', 'sealPurpose'],
          인영관리기록부: ['imprintPurpose', 'recipientOrganization', 'representativeName', 'businessNumber', 'usageCount', 'imprintContact', 'pledgeAccepted'],
        };
        $$('[data-request-form] input,[data-request-form] textarea').forEach((element) => {
          if (element.name && !['requestDate'].includes(element.name)) element.required = false;
        });
        (requiredMap[type] || []).forEach((name) => {
          const element = $(`[name="${name}"]`);
          if (element) element.required = true;
        });
      };

      const syncManagedDates = (root = document) => window.__MILGYO_SYNC_MANAGED_DATES__?.(root);
      const openRequest = () => {
        const form = $('[data-request-form]');
        form.reset();
        $('[data-form-type]').value = currentType;
        $('[name=requestDate]').value = today();
        $('[name=noticeDate]').value = today();
        pendingFiles = [];
        renderPending();
        showFields(currentType);
        syncManagedDates(form);
        $('[data-form-status]').textContent = '';
        $('[data-request-modal]').hidden = false;
      };
      const closeRequest = () => { $('[data-request-modal]').hidden = true; };
      $('[data-open-request]').addEventListener('click', openRequest);
      $$('[data-close-request]').forEach((button) => button.addEventListener('click', closeRequest));
      $('[data-form-type]').addEventListener('change', (event) => {
        showFields(event.target.value);
        syncManagedDates($('[data-request-form]'));
      });
      $('[data-files]').addEventListener('change', (event) => {
        pendingFiles = Array.from(event.target.files || []);
        renderPending();
      });
      const renderPending = () => {
        $('[data-pending-files]').innerHTML = pendingFiles.length
          ? pendingFiles.map((file, index) => `<span>${esc(file.name)} <small>${formatBytes(file.size)}</small><button type="button" data-remove-file="${index}">×</button></span>`).join('')
          : '선택된 파일이 없습니다.';
        $$('[data-remove-file]').forEach((button) => {
          button.addEventListener('click', () => {
            pendingFiles.splice(Number(button.dataset.removeFile), 1);
            renderPending();
          });
        });
      };
      const fileBase64 = (file) => new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || '').split(',')[1] || '');
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });

      $('[data-request-form]').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const type = $('[data-form-type]').value;
        const formData = new FormData(form);
        const content = type === '공고대장'
          ? {
              noticeDate: formData.get('noticeDate'), noticeNumber: formData.get('noticeNumber'),
              noticeTitle: formData.get('noticeTitle'), noticeBody: formData.get('noticeBody'),
              remarks: formData.get('noticeRemarks'),
            }
          : type === '관인날인기록부'
            ? {
                subject: formData.get('sealSubject'), sealCount: formData.get('sealCount'),
                relatedBasis: formData.get('relatedBasis'), sealType: formData.get('sealType'),
                purpose: formData.get('sealPurpose'), remarks: formData.get('sealRemarks'),
              }
            : {
                referenceDocument: formData.get('referenceDocument'), purpose: formData.get('imprintPurpose'),
                recipientOrganization: formData.get('recipientOrganization'), representativeName: formData.get('representativeName'),
                businessNumber: formData.get('businessNumber'), usageMethod: formData.get('usageMethod'),
                usageStartDate: formData.get('usageStartDate'), usageEndDate: formData.get('usageEndDate'),
                usageCompletionDate: formData.get('usageCompletionDate'), usageCount: formData.get('usageCount'),
                contact: formData.get('imprintContact'), pledgeAccepted: formData.get('pledgeAccepted') === 'on',
                remarks: formData.get('imprintRemarks'),
              };
        const message = $('[data-form-status]');
        message.textContent = '등록 중입니다...';
        const data = await api('/api/registers/action', {
          operation: 'create', type, requestDate: formData.get('requestDate'), content,
        });
        if (!data.ok) {
          message.textContent = data.message;
          message.className = 'status-message error';
          return;
        }
        for (const file of pendingFiles) {
          if (file.size > 4 * 1024 * 1024) {
            message.textContent = `${file.name}: 4MB를 초과하여 등록하지 못했습니다.`;
            message.className = 'status-message error';
            return;
          }
          const upload = await api('/api/registers/upload-attachment', {
            registerId: data.id,
            fileName: file.name,
            mimeType: file.type || 'application/octet-stream',
            dataBase64: await fileBase64(file),
          });
          if (!upload.ok) {
            message.textContent = `신청은 등록되었으나 ${file.name} 첨부 실패: ${upload.message}`;
            message.className = 'status-message error';
            listCache.clear();
            page = 1;
            load();
            return;
          }
        }
        closeRequest();
        currentType = type;
        $$('[data-register-type]').forEach((button) => {
          button.classList.toggle('active', button.dataset.registerType === type);
        });
        listCache.clear();
        page = 1;
        await load();
        setStatus(data.message, 'ok');
      });

      const detailRows = (row) => [
        [
          { label: '신청번호', value: row.request_no },
          { label: '대장유형', value: row.record_type },
        ],
        [
          { label: '신청일', value: row.request_date },
          { label: '신청자', value: row.applicant_name },
        ],
        [
          { label: '부서', value: formatDepartmentLabel(row.applicant_department) },
          { label: '상태', value: row.status },
        ],
        [
          { label: '처리자', value: row.processed_by || '-' },
          { label: '처리일시', value: row.processed_at ? new Date(row.processed_at).toLocaleString('ko-KR') : '-' },
        ],
        [
          { label: '처리의견', value: row.processing_memo || '-', full: true },
        ],
      ];

      const contentRows = (type, content = {}) => {
        if (type === '공고대장') {
          return [
            [
              { label: '공고일', value: content.noticeDate || '-' },
              { label: '공고번호', value: content.noticeNumber || '-' },
            ],
            [{ label: '공고명', value: content.noticeTitle || '-', full: true }],
            [{ label: '공고내용', value: content.noticeBody || '-', full: true, multiline: true }],
            [{ label: '비고', value: content.remarks || '-', full: true, multiline: true }],
          ];
        }
        if (type === '관인날인기록부') {
          return [
            [{ label: '건명', value: content.subject || '-', full: true }],
            [
              { label: '날인매수', value: content.sealCount || '-' },
              { label: '관인종류', value: content.sealType || '-' },
            ],
            [{ label: '관련근거', value: content.relatedBasis || '-', full: true }],
            [{ label: '사용목적', value: content.purpose || '-', full: true, multiline: true }],
            [{ label: '비고', value: content.remarks || '-', full: true, multiline: true }],
          ];
        }
        return [
          [{ label: '근거문서', value: content.referenceDocument || '-', full: true }],
          [{ label: '사용목적', value: content.purpose || '-', full: true, multiline: true }],
          [{ label: '사용기관·업체명', value: content.recipientOrganization || '-', full: true }],
          [
            { label: '사용기관 대표자명', value: content.representativeName || '-' },
            { label: '사업자번호', value: content.businessNumber || '-' },
          ],
          [
            { label: '사용방법', value: content.usageMethod || '-' },
            { label: '사용개수', value: content.usageCount || '-' },
          ],
          [
            { label: '사용기간 시작', value: content.usageStartDate || '-' },
            { label: '사용기간 종료', value: content.usageEndDate || '-' },
          ],
          [
            { label: '사용완료일', value: content.usageCompletionDate || '-' },
            { label: '신청자 연락처', value: content.contact || '-' },
          ],
          [{ label: '준수사항 서약', value: content.pledgeAccepted ? '확인' : '미확인', full: true }],
          [{ label: '비고', value: content.remarks || '-', full: true, multiline: true }],
        ];
      };

      const structuredDetailTable = (rows, className = '') => `<table class="register-detail-table ${className}">
        <colgroup><col class="register-detail-label-col"><col class="register-detail-value-col"><col class="register-detail-label-col"><col class="register-detail-value-col"></colgroup>
        <tbody>${rows.map((row) => {
          const first = row[0];
          if (first?.full || row.length === 1) {
            const valueClass = first?.multiline ? ' register-detail-value--multiline' : '';
            return `<tr><th scope="row">${esc(first?.label || '-')}</th><td colspan="3" class="register-detail-value${valueClass}">${esc(displayValue(first?.value))}</td></tr>`;
          }
          const second = row[1] || { label: '-', value: '-' };
          return `<tr><th scope="row">${esc(first.label)}</th><td class="register-detail-value">${esc(displayValue(first.value))}</td><th scope="row">${esc(second.label)}</th><td class="register-detail-value">${esc(displayValue(second.value))}</td></tr>`;
        }).join('')}</tbody></table>`;

      const renderAttachments = (attachments, row, id) => {
        const list = $('[data-attachment-list]');
        if (!attachments.length) {
          list.innerHTML = '<table class="register-attachment-table"><thead><tr><th>파일명</th><th>용량</th><th>관리</th></tr></thead><tbody><tr><td colspan="3" class="attachment-empty-cell">첨부파일이 없습니다.</td></tr></tbody></table>';
          return;
        }
        list.innerHTML = `<table class="register-attachment-table"><thead><tr><th>파일명</th><th>용량</th><th>관리</th></tr></thead><tbody>${attachments.map((attachment) => {
          const deletable = (canManage || String(row.applicant_user_id) === String(session.user.id))
            && !['완료', '반려', '취소'].includes(row.status);
          return `<tr><td>${esc(attachment.file_name)}</td><td>${esc(formatBytes(attachment.size_bytes))}</td><td><div class="row-actions"><button type="button" class="btn btn-outline btn-sm" data-download="${esc(attachment.id)}">다운로드</button>${deletable ? `<button type="button" class="btn btn-outline btn-sm danger" data-delete-attachment="${esc(attachment.id)}">삭제</button>` : ''}</div></td></tr>`;
        }).join('')}</tbody></table>`;
        $$('[data-download]', list).forEach((button) => {
          button.addEventListener('click', () => downloadAttachment(button.dataset.download));
        });
        $$('[data-delete-attachment]', list).forEach((button) => {
          button.addEventListener('click', async () => {
            if (!confirm('첨부파일을 삭제하시겠습니까?')) return;
            const result = await api('/api/registers/delete-attachment', { attachmentId: button.dataset.deleteAttachment });
            if (!result.ok) { alert(result.message); return; }
            listCache.clear();
            openDetail(id);
          });
        });
      };

      const openDetail = async (id) => {
        const requestSequence = ++detailRequestSequence;
        detailAbortController?.abort();
        detailAbortController = new AbortController();
        currentDetail = null;
        $('[data-detail-grid]').innerHTML = '<div class="detail-loading">상세정보를 불러오는 중입니다.</div>';
        $('[data-detail-content]').innerHTML = '<div class="detail-loading">신청내용을 불러오는 중입니다.</div>';
        $('[data-attachment-list]').innerHTML = '<div class="detail-loading">첨부파일을 불러오는 중입니다.</div>';
        $('[data-admin-processing]').hidden = true;
        $('[data-cancel-request]').hidden = true;
        $('[data-detail-modal]').hidden = false;
        try {
          const data = await api('/api/registers/query', { operation: 'detail', id }, { signal: detailAbortController.signal });
          if (requestSequence !== detailRequestSequence) return;
          if (!data.ok) {
            closeDetail();
            setStatus(data.message, 'error');
            return;
          }
          currentDetail = data.row;
          canManage = !!data.canManage;
          $('[data-detail-grid]').innerHTML = structuredDetailTable(detailRows(data.row), 'register-detail-summary');
          $('[data-detail-content]').innerHTML = structuredDetailTable(
            contentRows(data.row.record_type, data.row.content || {}),
            `register-detail-content-table register-detail-content-table--${data.row.record_type}`,
          );
          renderAttachments(data.attachments || [], data.row, id);
          $('[data-admin-processing]').hidden = !canManage;
          $('[data-process-status]').value = data.row.status === '취소' ? '신청' : data.row.status;
          $('[data-process-memo]').value = data.row.processing_memo || '';
          const cancelButton = $('[data-cancel-request]');
          cancelButton.hidden = !((String(data.row.applicant_user_id) === String(session.user.id) || canManage)
            && ['신청', '검토중'].includes(data.row.status));
        } catch (error) {
          if (error?.name !== 'AbortError') {
            console.error('register detail load failed', error);
            closeDetail();
            setStatus('상세정보를 불러오지 못했습니다.', 'error');
          }
        }
      };

      const closeDetail = () => {
        detailAbortController?.abort();
        $('[data-detail-modal]').hidden = true;
        currentDetail = null;
      };
      $$('[data-close-detail]').forEach((button) => button.addEventListener('click', closeDetail));

      const downloadAttachment = async (id) => {
        const data = await api('/api/registers/attachment-data', { attachmentId: id });
        if (!data.ok) { alert(data.message); return; }
        const bytes = Uint8Array.from(atob(data.dataBase64), (char) => char.charCodeAt(0));
        const url = URL.createObjectURL(new Blob([bytes], { type: data.mimeType || 'application/octet-stream' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = data.fileName;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      };

      $('[data-save-status]').addEventListener('click', async () => {
        if (!currentDetail) return;
        const data = await api('/api/registers/action', {
          operation: 'updateStatus',
          id: currentDetail.id,
          status: $('[data-process-status]').value,
          memo: $('[data-process-memo]').value,
        });
        if (!data.ok) { alert(data.message); return; }
        listCache.clear();
        closeDetail();
        load();
        setStatus(data.message, 'ok');
      });

      $('[data-cancel-request]').addEventListener('click', async () => {
        if (!currentDetail || !confirm('이 신청을 취소하시겠습니까?')) return;
        const data = await api('/api/registers/action', {
          operation: 'cancel', id: currentDetail.id, memo: '신청자 취소',
        });
        if (!data.ok) { alert(data.message); return; }
        listCache.clear();
        closeDetail();
        load();
        setStatus(data.message, 'ok');
      });

      const csv = (filename, rows) => {
        const quote = (value) => `"${String(value ?? '').replace(/"/g, '""')}"`;
        const text = '\ufeff' + rows.map((row) => row.map(quote).join(',')).join('\r\n');
        const url = URL.createObjectURL(new Blob([text], { type: 'text/csv;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      };

      $('[data-export]').addEventListener('click', async () => {
        const data = await api('/api/registers/query', {
          type: currentType,
          scope,
          status: $('[data-status-filter]').value,
          query: $('[data-query]').value.trim(),
          dateFrom: $('[data-date-from]').value,
          dateTo: $('[data-date-to]').value,
          page: 1,
          pageSize: 100,
        });
        if (!data.ok) { setStatus(data.message, 'error'); return; }
        csv(`${currentType}_${today()}.csv`, [
          headers[currentType].slice(0, -1),
          ...data.rows.map((row) => rowCells(row, currentType).slice(0, -1)),
        ]);
      });

      $('[data-print-list]').addEventListener('click', () => {
        const table = $('.register-table').outerHTML;
        const printWindow = window.open('', '_blank', 'width=1200,height=900');
        if (!printWindow) { alert('팝업 차단을 해제해 주세요.'); return; }
        printWindow.document.write(`<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>${esc(currentType)} 인쇄</title><style>body{font-family:"Malgun Gothic",sans-serif;margin:28px}h1{text-align:center;font-size:24px;margin-bottom:22px}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px}th,td{border:1px solid #333;padding:7px;text-align:center;vertical-align:middle;word-break:keep-all;overflow-wrap:anywhere}th{background:#eef3f8}.btn{display:none}@media print{@page{size:A4 landscape;margin:10mm}button{display:none}}</style></head><body><h1>${esc(currentType)} - ${scope === 'mine' ? '나의목록' : '전체목록'}</h1>${table}<p style="text-align:right"><button onclick="window.print()">인쇄</button></p></body></html>`);
        printWindow.document.close();
      });

      window.addEventListener('milgyo:managed-dates-ready', () => syncManagedDates(document), { once: true });
      api('/api/registers/query', { operation: 'options' }).then((data) => {
        if (data.ok) {
          canManage = !!data.canManage;
          if (!data.canWrite) $('[data-open-request]').hidden = true;
          syncManagedDates(document);
          renderHead(currentType);
          load();
        } else {
          setStatus(data.message, 'error');
        }
      });
    })();
  </script>

  <style is:global>
    .register-type-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin-bottom:1rem}
    .register-type-tab{border:1px solid var(--gov-border);background:#f7f9fc;padding:.8rem;font-weight:700;transition:background-color .12s ease,color .12s ease,border-color .12s ease}
    .register-type-tab.active{background:var(--gov-accent);color:#fff;border-color:var(--gov-accent)}
    .scope-tabs{display:flex;gap:.25rem}
    .scope-tab{border:0;border-bottom:3px solid transparent;background:transparent;padding:.55rem .9rem;font-weight:700}
    .scope-tab.active{color:var(--gov-accent);border-bottom-color:var(--gov-accent)}
    .register-list-toolbar{margin-bottom:.8rem;gap:1rem}
    .register-filters input[type=search]{min-width:240px}
    .register-filters .managed-date-with-weekday{min-width:190px}
    .register-fieldset .managed-date-with-weekday{width:100%}

    .register-table{width:100%;table-layout:fixed}
    .register-table th,.register-table td{text-align:center!important;vertical-align:middle;white-space:normal;word-break:keep-all;overflow-wrap:anywhere}
    .register-table tbody{transition:opacity .12s ease}
    .register-table.is-loading tbody{opacity:.55}
    .register-table .register-cell--applicant{font-weight:600;text-align:center!important}
    .register-table .register-cell--wide-text{line-height:1.45}
    .register-table .register-cell--status,.register-table .register-cell--manage{padding-left:.25rem;padding-right:.25rem}
    .register-table .register-cell--manage .btn{min-width:48px;white-space:nowrap}

    .register-fieldset{border:1px solid var(--gov-border);border-radius:8px;margin:1rem 0 0;padding:1rem}
    .register-fieldset legend{font-weight:800;color:var(--gov-navy-dark);padding:0 .35rem}
    .attachment-box{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.6rem 1rem;align-items:center;border:1px solid #d7e1ef;background:#f7faff;border-radius:8px;padding:.9rem;margin-top:1rem}
    .pending-files{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.45rem;color:var(--gov-muted);font-size:.8rem}
