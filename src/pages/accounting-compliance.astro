ta-vehicle-log-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'add-vehicle-log',...body(e.currentTarget)});notice(data.message);const id=e.currentTarget.elements.vehicleId.value;e.currentTarget.reset();e.currentTarget.elements.vehicleId.value=id;await openVehicle(id);await loadVehicles()}catch(err){notice(err.message,'error')}});

