  <script is:inline>
    (()=>{
      'use strict';
      const STORAGE_KEY='milgyo-system-session';
      const session=(()=>{try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||'null')}catch{return null}})();
      if(!session?.token||!session?.user){location.replace('/');return;}
      const token=session.token,me=session.user;
      const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>Array.from(r.querySelectorAll(s));
      const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const won=(v)=>`${Number(v||0).toLocaleString('ko-KR')}원`;
      const money=(v)=>{const n=Number(String(v??'').replace(/[^0-9.-]/g,''));return Number.isFinite(n)?Math.round(n):0};
      const today=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,10);
      const nowDateTimeDisplay=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,16).replace('T',' ');
      const currentYear=Number(today().slice(0,4));
      let state={year:currentYear,permissions:{},summary:{},books:[],entities:[],funds:[],contracts:[],organizationDepartments:[],organizationUsers:[],revenueBusinesses:[],procurements:[],reserves:[],vehicles:[]};
      let loadedTabs=new Set(['overview']);
      const api=async(path,body)=>{const res=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...body,token})});const text=await res.text();let data;try{data=JSON.parse(text)}catch{data={ok:false,message:`서버 응답 오류(HTTP ${res.status})`}}if(!data.ok)throw new Error(data.message||'처리 중 오류가 발생했습니다.');return data};
      const notice=(message,type='ok')=>{const el=$('[data-notice]');el.textContent=message;el.className=`notice ${type}`;el.hidden=false;clearTimeout(notice.timer);notice.timer=setTimeout(()=>el.hidden=true,5200)};
      const body=(form)=>{if(!commitSmartDateTimes(form)){form.reportValidity();throw new Error('날짜·시간 입력 형식을 확인해 주세요.');}const o={};new FormData(form).forEach((v,k)=>o[k]=v);$$('input[type="checkbox"]',form).forEach((el)=>o[el.name]=el.checked);$$('[data-smart-datetime]',form).forEach((el)=>{const parsed=normalizeDateTime(el.value,true);if(parsed.valid)o[el.name]=parsed.value});return o};
      const setMoneyFormatting=(root=document)=>{$$('.money',root).forEach((el)=>{if(el.dataset.moneyBound)return;el.dataset.moneyBound='1';el.addEventListener('input',()=>{const raw=el.value.replace(/[^0-9-]/g,'');if(!raw||raw==='-')return;el.value=Number(raw).toLocaleString('ko-KR')});});};
      const fill=(form,row,map={})=>{for(const [key,value] of Object.entries(row||{})){const name=map[key]||key.replace(/_([a-z])/g,(_,c)=>c.toUpperCase());const el=form.elements.namedItem(name);if(!el)continue;if(el.type==='checkbox')el.checked=!!Number(value);else{const next=value??'';if(el instanceof HTMLSelectElement&&next&&!Array.from(el.options).some((option)=>option.value===String(next)))el.add(new Option(String(next),String(next)));el.value=next;}}setMoneyFormatting(form);syncComplianceDates(form);syncSmartDateTimes(form)};
      const statusLabel=(v)=>({review:'검토',approved:'승인',active:'운영중',stopped:'중단',contracted:'계약',completed:'완료',withdrawn:'철회',open:'조치중',resolved:'종결',returned:'반납',disposed:'처분',transferred:'승계완료'}[v]||v||'-');
      const approvalLabel=(v)=>({secretary_general:'사무총장 전결',chairman:'이사장 승인',board:'이사회 의결',general_meeting:'총회·주무관청'}[v]||v||'-');
      const typeLabel=(v)=>({new:'신설',change:'변경',stop:'중단',owned:'구입·보유',lease:'리스',rental:'임차·렌트',bid:'입찰보증',performance:'계약이행',advance:'선금보증',defect:'하자보수',use:'사용',reversal:'환입'}[v]||v||'-');
      const weekdayLabel=(value)=>{const m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(value||''));if(!m)return '';const y=Number(m[1]),mo=Number(m[2]),d=Number(m[3]),dt=new Date(Date.UTC(y,mo-1,d));if(dt.getUTCFullYear()!==y||dt.getUTCMonth()!==mo-1||dt.getUTCDate()!==d)return '';return `(${['일','월','화','수','목','금','토'][dt.getUTCDay()]})`};
      const dateSyncers=new WeakMap();
      const setupComplianceDate=(input)=>{if(!(input instanceof HTMLInputElement)||input.type!=='date'||input.dataset.complianceDateBound)return;input.dataset.complianceDateBound='1';let wrap=input.closest('.compliance-date-with-weekday');if(!wrap){wrap=document.createElement('div');wrap.className='compliance-date-with-weekday';input.before(wrap);wrap.append(input)}let weekday=wrap.querySelector('.compliance-date-weekday');if(!weekday){weekday=document.createElement('span');weekday.className='compliance-date-weekday';weekday.setAttribute('aria-live','polite');wrap.append(weekday)}const sync=()=>{weekday.textContent=weekdayLabel(input.value);weekday.hidden=!weekday.textContent};dateSyncers.set(input,sync);input.addEventListener('input',sync);input.addEventListener('change',sync);sync()};
      const syncComplianceDates=(root=document)=>{if(root instanceof HTMLInputElement&&root.type==='date')setupComplianceDate(root);root.querySelectorAll?.('input[type="date"]').forEach((input)=>{setupComplianceDate(input);dateSyncers.get(input)?.()})};
      const smartDateTimeCommitters=new WeakMap();
      const normalizeDateTime=(raw,strict=false)=>{const value=String(raw||'').trim();if(!value)return{valid:true,value:'',display:''};const digits=value.replace(/\D/g,'');let y,mo,d,h,mi;if(/^\d{12}$/.test(digits)){y=+digits.slice(0,4);mo=+digits.slice(4,6);d=+digits.slice(6,8);h=+digits.slice(8,10);mi=+digits.slice(10,12)}else{const m=/^(\d{4})[-./]?(\d{1,2})[-./]?(\d{1,2})(?:[ T](\d{1,2}):?(\d{1,2}))$/.exec(value);if(!m)return{valid:!strict,value,display:value};y=+m[1];mo=+m[2];d=+m[3];h=+m[4];mi=+m[5]}const dt=new Date(Date.UTC(y,mo-1,d,h,mi));const valid=dt.getUTCFullYear()===y&&dt.getUTCMonth()===mo-1&&dt.getUTCDate()===d&&h>=0&&h<=23&&mi>=0&&mi<=59;if(!valid)return{valid:false,value,display:value};const date=`${String(y).padStart(4,'0')}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}`,time=`${String(h).padStart(2,'0')}:${String(mi).padStart(2,'0')}`;return{valid:true,value:`${date}T${time}`,display:`${date} ${time}`}};
      const setupSmartDateTime=(input)=>{if(!(input instanceof HTMLInputElement)||!input.matches('[data-smart-datetime]')||input.dataset.smartDateTimeBound)return;input.dataset.smartDateTimeBound='1';const initial=normalizeDateTime(input.value,false);if(initial.valid&&initial.display)input.value=initial.display;let wrap=input.closest('.smart-datetime');if(!wrap){wrap=document.createElement('div');wrap.className='smart-datetime';input.before(wrap);wrap.append(input)}const picker=document.createElement('input');picker.type='datetime-local';picker.className='smart-datetime-picker';picker.tabIndex=-1;picker.setAttribute('aria-label','달력과 시간에서 선택');if(initial.valid&&initial.value)picker.value=initial.value;picker.removeAttribute('name');wrap.append(picker);const weekday=document.createElement('span');weekday.className='compliance-date-weekday';weekday.setAttribute('aria-live','polite');wrap.append(weekday);const sync=()=>{const parsed=normalizeDateTime(input.value,false);weekday.textContent=parsed.valid?weekdayLabel(parsed.value):'';weekday.hidden=!weekday.textContent;if(parsed.valid&&parsed.value)picker.value=parsed.value};const commit=()=>{const parsed=normalizeDateTime(input.value,true);if(parsed.valid){input.value=parsed.display;input.setCustomValidity('');if(parsed.value)picker.value=parsed.value;sync();return true}input.setCustomValidity('발견일시는 YYYYMMDDHHMM 또는 YYYY-MM-DD HH:MM 형식으로 입력해 주세요.');weekday.textContent='';weekday.hidden=true;return false};smartDateTimeCommitters.set(input,commit);input.addEventListener('input',()=>{input.setCustomValidity('');sync()});input.addEventListener('change',commit);input.addEventListener('blur',commit);picker.addEventListener('change',()=>{const parsed=normalizeDateTime(picker.value,true);input.value=parsed.display;commit();input.focus()});sync()};
      const syncSmartDateTimes=(root=document)=>{if(root instanceof HTMLInputElement&&root.matches('[data-smart-datetime]'))setupSmartDateTime(root);root.querySelectorAll?.('[data-smart-datetime]').forEach((input)=>{setupSmartDateTime(input);const parsed=normalizeDateTime(input.value,false);const wrap=input.closest('.smart-datetime');const weekday=wrap?.querySelector('.compliance-date-weekday');if(weekday){weekday.textContent=parsed.valid?weekdayLabel(parsed.value):'';weekday.hidden=!weekday.textContent}})};
      const commitSmartDateTimes=(root=document)=>{let ok=true;root.querySelectorAll?.('[data-smart-datetime]').forEach((input)=>{if(!smartDateTimeCommitters.get(input)?.())ok=false});return ok};
      const revenueApprovalPreview=()=>{const f=$('[data-revenue-form]');if(!f)return;const reasons=[];if(f.majorPurposeImpact.checked)reasons.push('목적·주요 사업범위 중대영향');if(f.basicPropertyImpact.checked)reasons.push('기본재산·중대한 시설투자');if(f.borrowingGuaranteeImpact.checked)reasons.push('장기·대규모 차입·보증');if(f.majorFinancialBurden.checked)reasons.push('중대한 재정부담');const preferential=f.businessType.value==='preferential_purchase';const routineEligible=f.routineAnnualPlan.checked&&f.actionType.value==='new'&&!preferential;const level=reasons.length?'general_meeting':routineEligible?'chairman':'board';$('[data-revenue-approval]').value=approvalLabel(level);$('[data-revenue-approval-reason]').textContent=reasons.length?`총회 승인 검토: ${reasons.join(' / ')}`:preferential&&f.routineAnnualPlan.checked?'우선구매 인증·지정은 이사회 의결 대상입니다.':f.routineAnnualPlan.checked&&f.actionType.value!=='new'?'변경·중단은 반복·통상 예외 없이 이사회 의결 대상입니다.':routineEligible?'연간 사업계획·예산 내 반복·통상 시행: 이사장 승인':'신설·중요 변경·중단 기본: 이사회 의결';};
      const attachButton=(type,id,title,category='general')=>`<button type="button" class="btn btn-mini" data-generic-attachments data-reference-type="${esc(type)}" data-reference-id="${esc(id)}" data-reference-title="${esc(title)}" data-file-category="${esc(category)}">첨부</button>`;
      const empty=(cols,msg='자료가 없습니다.')=>`<tr><td colspan="${cols}" class="empty">${msg}</td></tr>`;
      const validTabs=new Set(['overview','revenue','procurement','reserve','check','vehicle']);
      const tabFromUrl=()=>{const name=new URLSearchParams(location.search).get('tab');return validTabs.has(name)?name:'overview'};
      const setTab=(name,{historyMode='push',scroll=true}={})=>{if(!validTabs.has(name))name='overview';$$('.nav').forEach((b)=>b.classList.toggle('active',b.dataset.tab===name));$$('.panel').forEach((p)=>p.classList.toggle('active',p.dataset.panel===name));const url=new URL(location.href);if(name==='overview')url.searchParams.delete('tab');else url.searchParams.set('tab',name);if(historyMode==='push'&&url.href!==location.href)history.pushState({complianceTab:name},'',url);else if(historyMode==='replace')history.replaceState({complianceTab:name},'',url);loadTab(name).catch((e)=>notice(e.message,'error'));if(scroll)window.scrollTo({top:0,behavior:'auto'});if(name==='vehicle'&&new URLSearchParams(location.search).get('view')==='ledger')setTimeout(()=>document.querySelector('[data-vehicle-rows]')?.closest('.card')?.scrollIntoView({block:'start'}),40)};
      $$('.nav').forEach((b)=>b.addEventListener('click',()=>setTab(b.dataset.tab)));$$('[data-jump]').forEach((b)=>b.addEventListener('click',()=>setTab(b.dataset.jump)));
      window.addEventListener('popstate',()=>setTab(tabFromUrl(),{historyMode:'none',scroll:false}));
      $('[data-logout]').addEventListener('click',()=>{localStorage.removeItem(STORAGE_KEY);location.replace('/')});
      const updateSummary=()=>{const s=state.summary||{};$('[data-summary-revenue]').textContent=`${Number(s.revenue_businesses||0)}건`;$('[data-summary-procurement]').textContent=`${Number(s.procurements||0)}건`;$('[data-summary-reserve]').textContent=won(s.reserve_balance);$('[data-summary-check]').textContent=`${Number(s.checks||0)+Number(s.incidents||0)}건`;$('[data-summary-vehicle]').textContent=`${Number(s.vehicles||0)}대`;$('[data-summary-guarantee]').textContent=`${Number(s.expiring_guarantees||0)}건`;};
      const renderMasterOptions=()=>{
        $('[data-fund-select]').innerHTML=state.funds.map((x)=>`<option value="${esc(x.id)}" ${x.id==='FUND-RESERVE'?'selected':''}>${esc(x.name)}</option>`).join('');
        const contracts='<option value="">선택 안 함</option>'+state.contracts.map((x)=>`<option value="${esc(x.id)}">${esc(x.contract_no)} · ${esc(x.title)} · ${esc(x.book_type_name||x.book_type_code||'')}</option>`).join('');const contractSelect=$('[data-contract-select]');if(contractSelect)contractSelect.innerHTML=contracts;
        const departmentSelect=$('[data-org-department-select]');if(departmentSelect)departmentSelect.innerHTML='<option value="">담당부서 선택</option>'+state.organizationDepartments.map((x)=>`<option value="${esc(x.value)}">${esc(x.label)}</option>`).join('');
        const managerSelect=$('[data-org-manager-select]');
        const renderRevenueManagers=(selected='')=>{if(!managerSelect)return;const department=departmentSelect?.value||'';const users=state.organizationUsers.filter((x)=>!department||x.department===department||x.department.startsWith(`${department} - `));managerSelect.innerHTML='<option value="">담당자 선택</option>'+users.map((x)=>`<option value="${esc(x.name)}">${esc(x.name)}${x.position?' · '+esc(x.position):''}${x.departmentLabel?' · '+esc(x.departmentLabel):''}</option>`).join('');if(selected&&!Array.from(managerSelect.options).some((option)=>option.value===String(selected)))managerSelect.add(new Option(String(selected),String(selected)));managerSelect.value=selected||'';};
        renderRevenueManagers();
        if(departmentSelect&&!departmentSelect.dataset.managerFilterBound){departmentSelect.dataset.managerFilterBound='1';departmentSelect.addEventListener('change',()=>renderRevenueManagers(''));}
        window.__MILGYO_RENDER_REVENUE_MANAGERS__=renderRevenueManagers;
        const responsibleSelect=$('[data-procurement-responsible-select]');if(responsibleSelect)responsibleSelect.innerHTML='<option value="">책임자 선택</option>'+state.organizationUsers.map((x)=>`<option value="${esc(x.id)}">${esc(x.name)}${x.position?' · '+esc(x.position):''}${x.departmentLabel?' · '+esc(x.departmentLabel):''}</option>`).join('');
      };
      const init=async()=>{const data=await api('/api/accounting-compliance/query',{action:'init',year:state.year});state={...state,...data,permissions:data.permissions||{},summary:data.summary||{}};loadedTabs=new Set(['overview']);$('[data-user-label]').textContent=`${me.name}${me.position?' · '+me.position:''}`;document.body.classList.toggle('read-only',!state.permissions.manager);$$('.manager-only').forEach((el)=>el.hidden=!state.permissions.manager);const yearSel=$('[data-year]');yearSel.innerHTML=(data.fiscalYears?.length?data.fiscalYears.map((x)=>x.year):[currentYear-1,currentYear,currentYear+1]).map((y)=>`<option value="${y}" ${Number(y)===state.year?'selected':''}>${y} 회계연도</option>`).join('');$('[data-prior-income]').textContent=won(data.priorYearIncome);$('[data-procurement-limit]').textContent=won(data.annualProcurementLimit);$('[data-procurement-total]').textContent=won(data.annualProcurementTotal);renderMasterOptions();updateSummary();$('[data-app]').hidden=false;setMoneyFormatting();revenueApprovalPreview();};
      $('[data-year]').addEventListener('change',async(e)=>{state.year=Number(e.target.value);await init();setTab($('.nav.active')?.dataset.tab||'overview',{historyMode:'replace',scroll:false})});
      const loadTab=async(name,{force=false}={})=>{const key=`${state.year}:${name}`;if(!force&&loadedTabs.has(key))return;if(name==='revenue')await loadRevenue();if(name==='procurement'){const revenueKey=`${state.year}:revenue`;if(!loadedTabs.has(revenueKey)){await loadRevenue();loadedTabs.add(revenueKey)}await loadProcurement()}if(name==='reserve')await loadReserves();if(name==='check')await Promise.all([loadChecks(),loadIncidents(),previewCheck().catch(()=>{})]);if(name==='vehicle')await loadVehicles();if(name!=='overview')loadedTabs.add(key);};

      const loadRevenue=async()=>{const data=await api('/api/accounting-compliance/query',{action:'revenue-businesses',year:state.year});state.revenueBusinesses=data.rows||[];$('[data-revenue-rows]').innerHTML=state.revenueBusinesses.length?state.revenueBusinesses.map((r)=>`<tr><td>${esc(r.business_no)}</td><td><button class="text-link" data-edit-revenue="${esc(r.id)}">${esc(r.title)}</button></td><td>${esc(typeLabel(r.action_type))}</td><td>${esc(r.start_date||'-')} ~ ${esc(r.end_date||'-')}</td><td class="num">${won(r.expected_income)}</td><td class="num">${won(r.expected_expense)}</td><td>${esc(approvalLabel(r.approval_level))}${r.approval_reasons?`<br><small>${esc(r.approval_reasons)}</small>`:''}</td><td>${esc(statusLabel(r.status))}</td><td>${attachButton('revenue_business',r.id,r.business_no,'report')}</td></tr>`).join(''):empty(9);$('[data-revenue-select]').innerHTML='<option value="">선택 안 함</option>'+state.revenueBusinesses.map((r)=>`<option value="${esc(r.id)}">${esc(r.business_no)} · ${esc(r.title)}</option>`).join('');$$('[data-edit-revenue]').forEach((b)=>b.addEventListener('click',()=>{const row=state.revenueBusinesses.find((r)=>r.id===b.dataset.editRevenue);if(row){fill($('[data-revenue-form]'),row);window.__MILGYO_RENDER_REVENUE_MANAGERS__?.(row.manager_name||'');revenueApprovalPreview()}window.scrollTo({top:0,behavior:'smooth'})}));};
      $$('[data-revenue-form] input[type="checkbox"]').forEach((el)=>el.addEventListener('change',revenueApprovalPreview));$('[data-revenue-form] [name="actionType"]').addEventListener('change',revenueApprovalPreview);$('[data-revenue-form] [name="businessType"]').addEventListener('change',revenueApprovalPreview);
      $('[data-load-revenue]').addEventListener('click',()=>loadRevenue().catch((e)=>notice(e.message,'error')));$('[data-revenue-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'save-revenue-business',year:state.year,...body(e.currentTarget)});notice(`${data.message} 승인단계: ${approvalLabel(data.approvalLevel)}`);e.currentTarget.reset();e.currentTarget.elements.id.value='';window.__MILGYO_RENDER_REVENUE_MANAGERS__?.('');revenueApprovalPreview();await Promise.all([loadRevenue(),initSummaryOnly()])}catch(err){notice(err.message,'error')}});

      const loadProcurement=async()=>{const data=await api('/api/accounting-compliance/query',{action:'procurements',year:state.year});state.procurements=data.rows||[];$('[data-prior-income]').textContent=won(data.priorYearIncome);$('[data-procurement-limit]').textContent=won(data.annualLimit);$('[data-procurement-total]').textContent=won(data.annualTotal);$('[data-procurement-rows]').innerHTML=state.procurements.length?state.procurements.map((r)=>`<tr><td>${esc(r.review_no)}</td><td><button class="text-link" data-view-procurement="${esc(r.id)}">${esc(r.agency)}<br><small>${esc(r.title)}</small></button></td><td class="num">${won(r.estimated_price)}</td><td class="num">${won(r.actual_contract_amount||r.planned_bid_amount)}</td><td>${esc(approvalLabel(r.approval_level))}${r.approval_reasons?`<br><small>${esc(r.approval_reasons)}</small>`:''}${r.approval_level==='chairman'?`<br><small>${r.next_board_reported?'다음 이사회 보고완료':'다음 이사회 보고대기'}</small>`:''}</td><td>${esc(r.responsible_name||'-')}</td><td>${esc(r.contract_no||'-')}</td><td>${Number(r.guarantee_count||0)}건</td><td>${esc(statusLabel(r.status))}</td><td>${attachButton('procurement_review',r.id,r.review_no,'contract')}</td></tr>`).join(''):empty(10);$$('[data-view-procurement]').forEach((b)=>b.addEventListener('click',()=>openProcurement(b.dataset.viewProcurement)));};
      const previewProcurement=async()=>{const form=$('[data-procurement-form]');const data=await api('/api/accounting-compliance/query',{action:'procurement-preview',year:state.year,...body(form)});$('[data-preview-cost]').textContent=won(data.totalCost);$('[data-preview-profit]').textContent=won(data.expectedProfit);$('[data-preview-profit-rate]').textContent=`${data.expectedProfitRate}%`;$('[data-preview-approval]').textContent=approvalLabel(data.approval.approvalLevel);$('[data-preview-reasons]').textContent=data.approval.reasons.length?data.approval.reasons.join(' / '):'연간 사업계획·예산 범위 내 통상 처리';$('[data-preview-annual]').textContent=`${won(data.approval.annualAfter)} / 한도 ${won(data.approval.annualLimit)}`;$('[data-preview-profit-warning]').textContent=data.profitWarning||'';$('[data-preview-profit-warning]').className=data.profitWarning?'negative':'';};
      $('[data-preview-procurement]').addEventListener('click',()=>previewProcurement().catch((e)=>notice(e.message,'error')));$$('.preview-trigger').forEach((el)=>el.addEventListener('change',()=>previewProcurement().catch(()=>{})));$('[data-load-procurement]').addEventListener('click',()=>loadProcurement().catch((e)=>notice(e.message,'error')));$('[data-procurement-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'save-procurement',year:state.year,...body(e.currentTarget)});notice(`${data.message} 승인단계: ${approvalLabel(data.approval.approvalLevel)}`);e.currentTarget.reset();e.currentTarget.elements.id.value='';await Promise.all([loadProcurement(),initSummaryOnly()]);await previewProcurement()}catch(err){notice(err.message,'error')}});
      const openProcurement=async(id)=>{const data=await api('/api/accounting-compliance/query',{action:'procurement-detail',id});fill($('[data-procurement-form]'),data.row);$('[data-guarantee-form]').elements.procurementReviewId.value=id;$('[data-procurement-detail-area]').hidden=false;$('[data-guarantee-rows]').innerHTML=(data.guarantees||[]).length?data.guarantees.map((g)=>`<tr><td>${esc(g.guarantee_no)}</td><td>${esc(typeLabel(g.guarantee_type))}</td><td>${esc(g.provider)}</td><td>${won(g.amount)}</td><td>${esc(g.start_date||'-')} ~ ${esc(g.end_date||'-')}</td><td>${g.recovered?'회수·종료':'관리중'}</td></tr>`).join(''):empty(6);await previewProcurement();window.scrollTo({top:0,behavior:'smooth'});};
      $('[data-guarantee-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'save-guarantee',...body(e.currentTarget)});notice(data.message);const id=e.currentTarget.elements.procurementReviewId.value;e.currentTarget.reset();e.currentTarget.elements.procurementReviewId.value=id;await openProcurement(id);await initSummaryOnly()}catch(err){notice(err.message,'error')}});

      const loadReserves=async()=>{const data=await api('/api/accounting-compliance/query',{action:'reserves',year:state.year});state.reserves=data.rows||[];$('[data-reserve-rows]').innerHTML=state.reserves.length?state.reserves.map((r)=>{const used=Number(r.used_amount||0),rev=Number(r.reversed_amount||0),balance=Number(r.set_amount||0)-used-rev;return `<tr><td>${esc(r.reserve_no)}</td><td>${esc(r.set_date)}</td><td>${won(r.set_amount)}</td><td>${won(used)}</td><td>${won(rev)}</td><td>${won(balance)}</td><td>${esc(r.use_deadline||'-')}</td><td>${esc(r.tax_review_status||'-')}</td><td>${attachButton('purpose_reserve',r.id,r.reserve_no,'report')}</td></tr>`}).join(''):empty(9);$('[data-reserve-select]').innerHTML='<option value="">선택</option>'+state.reserves.map((r)=>`<option value="${esc(r.id)}">${esc(r.reserve_no)} · 잔액 ${won(Number(r.set_amount||0)-Number(r.used_amount||0)-Number(r.reversed_amount||0))}</option>`).join('');};
      $('[data-load-reserves]').addEventListener('click',()=>loadReserves().catch((e)=>notice(e.message,'error')));$('[data-reserve-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'save-reserve',year:state.year,...body(e.currentTarget)});notice(data.message);e.currentTarget.reset();e.currentTarget.elements.id.value='';e.currentTarget.elements.setDate.value=today();syncComplianceDates(e.currentTarget);await Promise.all([loadReserves(),initSummaryOnly()])}catch(err){notice(err.message,'error')}});$('[data-reserve-tx-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'add-reserve-transaction',...body(e.currentTarget)});notice(data.message);const reserve=e.currentTarget.elements.reserveId.value;e.currentTarget.reset();e.currentTarget.elements.reserveId.value=reserve;e.currentTarget.elements.transactionDate.value=today();syncComplianceDates(e.currentTarget);await Promise.all([loadReserves(),initSummaryOnly()])}catch(err){notice(err.message,'error')}});

      const showSnapshot=(s)=>{$('[data-snap-income]').textContent=won(s.periodIncome);$('[data-snap-expense]').textContent=won(s.periodExpense);$('[data-snap-donation]').textContent=won(s.donationIncome);$('[data-snap-taxprofile]').textContent=Number(s.revenueBusinessTaxProfileRisk||0)>0?'확인필요':'정상';$('[data-snap-balance]').textContent=won(s.accountBalance);$('[data-snap-unmatched]').textContent=`${s.unmatchedTransactions}건`;$('[data-snap-evidence]').textContent=`${s.missingEvidence}건`;$('[data-snap-overbudget]').textContent=`${s.overBudgetItems}건`;$('[data-snap-budget]').textContent=`${s.pendingBudgetChanges}건`;$('[data-snap-integrity]').textContent=`${s.attachmentIntegrityIssues}건`;$('[data-snap-procurement]').textContent=`${s.procurementRisks}건`;$('[data-snap-incident]').textContent=`${s.openIncidents}건`;};
      const previewCheck=async()=>{const f=$('[data-check-form]');const data=await api('/api/accounting-compliance/query',{action:'compliance-preview',year:state.year,periodType:f.elements.periodType.value,periodKey:f.elements.periodKey.value});showSnapshot(data.snapshot);return data.snapshot};
      $('[data-preview-check]').addEventListener('click',()=>previewCheck().catch((e)=>notice(e.message,'error')));const loadChecks=async()=>{const data=await api('/api/accounting-compliance/query',{action:'checks',year:state.year});$('[data-check-rows]').innerHTML=(data.rows||[]).length?data.rows.map((r)=>{const s=r.snapshot||{};const issue=Number(s.unmatchedTransactions||0)+Number(s.missingEvidence||0)+Number(s.overBudgetItems||0)+Number(s.procurementRisks||0)+Number(s.attachmentIntegrityIssues||0)+Number(s.revenueBusinessTaxProfileRisk||0);const reports=[r.reported_chairman?'이사장':'',r.reported_auditor?'감사':''].filter(Boolean).join('·')||'-';return `<tr><td>${esc(r.check_no)}</td><td>${r.period_type==='quarter'?'분기':'월'} ${esc(r.period_key)}</td><td>${issue}건</td><td>${reports}</td><td>${r.status==='completed'?'완료':'보완중'}</td><td>${attachButton('compliance_check',r.id,r.check_no,'report')}</td></tr>`}).join(''):empty(6);};$('[data-load-checks]').addEventListener('click',()=>loadChecks().catch((e)=>notice(e.message,'error')));$('[data-check-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'save-check',year:state.year,...body(e.currentTarget)});showSnapshot(data.snapshot);notice(data.message);await Promise.all([loadChecks(),initSummaryOnly()])}catch(err){notice(err.message,'error')}});
      const loadIncidents=async()=>{const data=await api('/api/accounting-compliance/query',{action:'incidents',year:state.year});$('[data-incident-rows]').innerHTML=(data.rows||[]).length?data.rows.map((r)=>{const reports=[r.chairman_notified?'이사장':'',r.auditor_notified?'감사':''].filter(Boolean).join('·')||'-';return `<tr><td>${esc(r.report_no)}</td><td>${esc(String(r.occurred_at||'').replace('T',' ').slice(0,16))}</td><td>${esc(r.category)}</td><td>${esc(r.title)}</td><td>${reports}</td><td>${r.status==='resolved'?'종결':'조치중'}</td><td>${attachButton('finance_incident',r.id,r.report_no,'report')}</td></tr>`}).join(''):empty(7);};$('[data-incident-form]').addEventListener('submit',async(e)=>{e.preventDefault();try{const data=await api('/api/accounting-compliance/action',{action:'save-incident',year:state.year,...body(e.currentTarget)});notice(data.message);e.currentTarget.reset();e.currentTarget.elements.occurredAt.value=nowDateTimeDisplay();syncSmartDateTimes(e.currentTarget);await Promise.all([loadIncidents(),initSummaryOnly()])}catch(err){notice(err.message,'error')}});

      const loadVehicles=async()=>{const data=await api('/api/accounting-compliance/query',{action:'vehicles'});state.vehicles=data.rows||[];$('[data-vehicle-rows]').innerHTML=state.vehicles.length?state.vehicles.map((r)=>`<tr><td>${esc(r.vehicle_no)}</td><td>${esc(r.model_name)}${r.plate_no?`<br><small>${esc(r.plate_no)}</small>`:''}</td><td>${esc(typeLabel(r.management_type))}</td><td>${esc(r.primary_user||'-')}</td><td>${esc(r.contract_start||'-')} ~ ${esc(r.contract_end||'-')}</td><td>${esc(r.insurance_end||'-')}</td><td>${Number(r.log_count||0)}건${r.last_log_date?`<br><small>최근 ${esc(r.last_log_date)}</small>`:''}</td><td>${esc(statusLabel(r.status))}</td><td><a class="btn btn-mini" href="/vehicle-register/?vehicleId=${encodeURIComponent(r.id)}">관리</a></td></tr>`).join(''):empty(9);const successionSelect=$('[data-succession-vehicle-select]');if(successionSelect){const eligible=state.vehicles.filter((r)=>['lease','rental'].includes(r.management_type)&&r.status==='active');successionSelect.innerHTML='<option value="">승계 대상 차량 선택</option>'+eligible.map((r)=>`<option value="${esc(r.id)}">${esc(r.vehicle_no)} · ${esc(r.model_name)}${r.plate_no?' · '+esc(r.plate_no):''}</option>`).join('')}};$('[data-load-vehicles]').addEventListener('click',()=>loadVehicles().catch((e)=>notice(e.message,'error')));$('[data-open-succession-doc]')?.addEventListener('click',()=>{const id=$('[data-succession-vehicle-select]')?.value;if(!id){notice('승계 검토서를 작성할 차량을 선택해 주세요.','error');return}location.href=`/?compose=1&template=TPL-FIN-VEHICLE-SUCCESSION&vehicleId=${encodeURIComponent(id)}`});


      const initSummaryOnly=async()=>{const data=await api('/api/accounting-compliance/query',{action:'init',year:state.year});state.summary=data.summary||{};updateSummary();$('[data-prior-income]').textContent=won(data.priorYearIncome);$('[data-procurement-limit]').textContent=won(data.annualProcurementLimit);$('[data-procurement-total]').textContent=won(data.annualProcurementTotal);};
      $('[data-reserve-form]').elements.setDate.value=today();$('[data-reserve-tx-form]').elements.transactionDate.value=today();$('[data-incident-form]').elements.occurredAt.value=nowDateTimeDisplay();syncComplianceDates();syncSmartDateTimes();document.addEventListener('reset',(event)=>setTimeout(()=>{syncComplianceDates(event.target);syncSmartDateTimes(event.target)},0),true);
      init().then(()=>{setTab(tabFromUrl(),{historyMode:'replace',scroll:false});syncComplianceDates();syncSmartDateTimes()}).catch((e)=>{alert(e.message);location.replace('/accounting/')});
    })();
  </script>
  <script src="/accounting-generic-attachments.js" defer></script>

  <style is:global>
    [hidden]{display:none!important}
    .compliance-app{min-height:100vh;background:#eef2f7;color:#20252c;font-family:"Pretendard","Malgun Gothic",-apple-system,BlinkMacSystemFont,sans-serif}
    .topbar{min-height:58px;background:linear-gradient(180deg,#315f9f,#244d7c);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:.55rem 1rem;gap:14px;position:sticky;top:0;z-index:30}
    .brand,.brand span{display:flex;align-items:center;gap:.55rem;color:#fff;text-decoration:none;min-width:0}.brand>img{width:28px;height:28px;object-fit:contain}.brand span img{width:158px;max-height:25px;object-fit:contain;filter:brightness(0) invert(1)}.brand b{font-family:"Noto Serif KR",Batang,serif;font-size:.96rem;white-space:nowrap}
