      };
      const labels={register_no:'원부 관리번호',monastic_no:'승적번호',dharma_name_ko:'법명(한글)',dharma_name_hanja:'법명(한자)',lay_name:'성명(속명)',organization:'종단명',birth_date:'생년월일',status:'승적 상태',temple:'재적 사찰',acquired_date:'승적 취득일',mentor_name:'은사 법명',position_title:'현재 소임',contact:'연락처',managing_office:'관리부서',first_registered_date:'최초 등록일',last_verified_date:'최근 확인일',access_scope:'접근 허가 범위',processing_basis:'개인정보 처리근거',sensitive_basis:'민감정보 처리근거',retention_period:'보유기간',storage_location:'내부 보관장소',prepared_by:'작성자',reviewed_by:'검토자',approved_by:'승인자'};
      const accountFields=new Set(['prepared_by','reviewed_by','approved_by']);
