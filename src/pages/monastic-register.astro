      const printCss=`@page{size:A4 portrait;margin:11mm 12mm}*{box-sizing:border-box}html,body{margin:0;padding:0}body{font-family:"Malgun Gothic","Noto Sans KR",sans-serif;background:#e9edf2;color:#233349;font-size:10px;line-height:1.38}
