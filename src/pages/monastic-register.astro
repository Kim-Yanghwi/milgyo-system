---
import ManagementLayout from '../layouts/ManagementLayout.astro';
---
<ManagementLayout title="승적원부 대장" active="monasticRegistry">
  <div class="page-heading">
    <div><p class="page-heading__kicker">MONASTIC REGISTRY · INTERNAL ONLY</p><h1>승적원부 대장</h1><p>종단 승적기록을 등록·검증하고 증빙 및 변경이력을 비공개로 관리합니다.</p></div>
    <button type="button" class="btn btn-primary" data-new hidden>+ 승적원부 등록</button>
  </div>


  <section class="surface monastic-editor" data-editor hidden>
    <div class="section-title"><div><h2 data-editor-title>승적원부 등록</h2><p>기본 신원·재적·수계·소임·보존관리 항목을 기록합니다.</p></div><button type="button" class="btn btn-outline" data-editor-close>닫기</button></div>
    <form data-form>
      <h3>기본 신원 및 재적 사항</h3>
      <div class="form-grid monastic-grid">
        <div class="form-field"><label>승적번호 *</label><input data-field="monasticNo" maxlength="60" required autocomplete="off" /></div>
        <div class="form-field"><label>법명(한글) *</label><input data-field="dharmaNameKo" maxlength="80" required /></div>
        <div class="form-field"><label>법명(한자)</label><input data-field="dharmaNameHanja" maxlength="80" /></div>
        <div class="form-field"><label>성명(속명)</label><input data-field="layName" maxlength="80" /></div>
        <div class="form-field"><label>생년월일</label><span class="monastic-date-control" data-monastic-date-control><input type="text" data-monastic-date data-field="birthDate" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" spellcheck="false" /><button type="button" class="monastic-calendar-button" data-monastic-calendar aria-label="생년월일 달력 선택" title="달력에서 선택">▦</button><input type="date" data-no-weekday data-no-date8 class="monastic-calendar-native" tabindex="-1" aria-hidden="true" /></span></div>
        <div class="form-field"><label>승적 상태 *</label><select data-field="status"><option>재적</option><option>제적</option><option>기타</option></select></div>
        <div class="form-field"><label>종단명</label><input value="대한불교밀교종" readonly /></div>
        <div class="form-field"><label>재적 사찰</label><input data-field="temple" maxlength="120" /></div>
        <div class="form-field"><label>승적 취득일 *</label><span class="monastic-date-control" data-monastic-date-control><input type="text" data-monastic-date data-field="acquiredDate" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" spellcheck="false" required /><button type="button" class="monastic-calendar-button" data-monastic-calendar aria-label="승적 취득일 달력 선택" title="달력에서 선택">▦</button><input type="date" data-no-weekday data-no-date8 class="monastic-calendar-native" tabindex="-1" aria-hidden="true" /></span></div>
        <div class="form-field"><label>은사 법명</label><input data-field="mentorName" maxlength="100" /></div>
        <div class="form-field"><label>현재 소임</label><input data-field="positionTitle" maxlength="100" /></div>
        <div class="form-field"><label>연락처 (내부 관리)</label><input data-field="contact" maxlength="80" autocomplete="off" /></div>
        <div class="form-field"><label>관리부서</label><input data-field="managingOffice" maxlength="120" /></div>
        <div class="form-field"><label>최초 등록일</label><span class="monastic-date-control" data-monastic-date-control><input type="text" data-monastic-date data-field="firstRegisteredDate" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" spellcheck="false" /><button type="button" class="monastic-calendar-button" data-monastic-calendar aria-label="최초 등록일 달력 선택" title="달력에서 선택">▦</button><input type="date" data-no-weekday data-no-date8 class="monastic-calendar-native" tabindex="-1" aria-hidden="true" /></span></div>
        <div class="form-field"><label>최근 확인일</label><span class="monastic-date-control" data-monastic-date-control><input type="text" data-monastic-date data-field="lastVerifiedDate" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" spellcheck="false" /><button type="button" class="monastic-calendar-button" data-monastic-calendar aria-label="최근 확인일 달력 선택" title="달력에서 선택">▦</button><input type="date" data-no-weekday data-no-date8 class="monastic-calendar-native" tabindex="-1" aria-hidden="true" /></span></div>
      </div>
      <div class="section-title monastic-part-title"><div><h3>수계 및 법계 기록</h3><p>관련 증빙을 대조해 확인된 사실만 기록합니다.</p></div><button type="button" class="btn btn-outline btn-sm" data-add-ordination>+ 기록 추가</button></div>
      <div class="data-wrap"><table class="data-table monastic-input-table monastic-ordination-table"><colgroup><col style="width:14%"><col style="width:18%"><col style="width:23%"><col style="width:18%"><col style="width:20%"><col style="width:7%"></colgroup><thead><tr><th>구분 / 계종</th><th>수계·품수일</th><th>장소 / 시행기관</th><th>계사·확인자</th><th>근거 문서</th><th>관리</th></tr></thead><tbody data-ordination></tbody></table></div>
      <div class="section-title monastic-part-title"><div><h3>소임 및 주요 종무 경력</h3><p>선택 기록</p></div><button type="button" class="btn btn-outline btn-sm" data-add-career>+ 경력 추가</button></div>
      <div class="data-wrap"><table class="data-table monastic-input-table monastic-career-table"><thead><tr><th>활동 기간 (시작일 ~ 종료일)</th><th>소속 사찰·기관</th><th>소임 / 직책</th><th>확인 자료</th><th>관리</th></tr></thead><tbody data-career></tbody></table></div>
      <div class="monastic-section-divider monastic-editor-divider" aria-hidden="true"></div>
      <h3>접근권한 및 보존관리 확인</h3>
      <div class="form-grid monastic-grid">
        <div class="form-field"><label>접근 허가 범위</label><input data-field="accessScope" maxlength="200" value="승적관리 담당자" /></div>
        <div class="form-field"><label>개인정보 처리근거 *</label><select data-field="processingBasis" required><option value="">선택해 주세요</option><option value="동의">동의</option><option value="비동의">비동의</option></select></div>
        <div class="form-field"><label>민감정보 처리근거 *</label><select data-field="sensitiveBasis" required><option value="">선택해 주세요</option><option value="동의">동의</option><option value="비동의">비동의</option></select></div>
        <div class="form-field"><label>보유기간</label><select data-field="retentionPeriod"><option value="">선택해 주세요</option><option>1년</option><option>2년</option><option>3년</option><option>4년</option><option>5년</option><option>10년</option><option>준영구</option><option>영구</option></select></div>
        <div class="form-field"><label>내부 보관장소</label><input data-field="storageLocation" maxlength="200" /></div>
      </div>
      <p class="privacy-note monastic-consent-note">'비동의'는 동의하지 않았다는 사실을 기록합니다. 개인정보 처리의 별도 법적 근거가 없으면 관련 정보의 수집·이용과 대외증명서 발급을 진행하지 마세요.</p>
      <h3>작성·검토·승인</h3>
      <div class="form-grid monastic-grid">
        <div class="form-field"><label>작성자</label><select data-field="preparedBy"><option value="">계정 목록 불러오는 중</option></select></div>
        <div class="form-field"><label>검토자</label><select data-field="reviewedBy"><option value="">계정 목록 불러오는 중</option></select></div>
        <div class="form-field"><label>승인자</label><select data-field="approvedBy"><option value="">계정 목록 불러오는 중</option></select></div>
      </div>
      <div class="form-grid monastic-grid" data-change-fields hidden>
        <div class="form-field"><label>처리 구분 *</label><select data-change-type><option value="">선택</option><option>재적 변경</option><option>법명 변경</option><option>수계 정정</option><option>법계 변경</option><option>제적</option><option>복적</option><option>입적(入寂)</option><option>기타 정정</option></select></div>
        <div class="form-field form-field--full"><label>정정 근거·증빙·승인 *</label><textarea data-change-evidence rows="2" maxlength="500" placeholder="정정 사유 및 근거자료·승인 내용을 구체적으로 기록"></textarea></div>
      </div>
      <div class="status-message" data-form-status aria-live="polite"></div>
      <div class="form-actions"><button type="button" class="btn btn-outline" data-editor-close>취소</button><button type="submit" class="btn btn-primary" data-save>승적원부 등록</button></div>
    </form>
  </section>
  <section class="surface monastic-surface" data-list-section>
    <div class="section-title"><div><h2>승적원부 목록</h2><p>승적번호·법명·재적 사찰 검색 및 변경이력 조회</p></div>
      <div class="toolbar monastic-filters"><select data-status><option value="">전체 상태</option><option>재적</option><option>제적</option><option>기타</option></select>
        <input type="search" data-query placeholder="승적번호·법명·사찰 검색" aria-label="승적 검색" />
        <select data-page-size><option value="10">10개</option><option value="20" selected>20개</option><option value="50">50개</option></select>
        <button type="button" class="btn btn-outline" data-search>조회</button></div></div>
    <div class="status-message" data-status-message aria-live="polite">승적원부를 불러오는 중입니다.</div>
    <div class="data-wrap"><table class="data-table"><thead><tr><th>원부 관리번호</th><th>승적번호</th><th>법명(한글)</th><th>승적 상태</th><th>재적 사찰</th><th>최근 확인일</th><th>증빙</th><th>관리</th></tr></thead><tbody data-body><tr><td colspan="8">불러오는 중입니다.</td></tr></tbody></table></div>
    <div class="pagination" data-pagination></div>
  </section>


  <section class="surface monastic-detail" data-detail hidden>
    <div class="section-title"><div><h2>승적원부 상세</h2><p data-detail-heading></p></div><div class="toolbar"><button type="button" class="btn btn-outline" data-detail-print>원부 인쇄</button><button type="button" class="btn btn-outline" data-detail-edit>기재사항 정정</button><button type="button" class="btn btn-outline" data-detail-close>닫기</button></div></div>
    <div data-detail-summary class="data-wrap monastic-summary"></div>
    <div class="section-title monastic-part-title"><div><h3>수계 및 법계 기록</h3></div></div><div data-detail-ordination></div>
    <div class="section-title monastic-part-title"><div><h3>소임 및 주요 종무 경력</h3></div></div><div data-detail-career></div>
    <div class="section-title monastic-part-title"><div><h3>승적 기재사항 변경·정정 이력</h3></div></div><div class="data-wrap"><table class="data-table monastic-changes-table"><thead><tr><th>처리일자</th><th>처리 구분</th><th>변경 항목</th><th>변경 전</th><th>변경 후</th><th>증빙·승인·담당자</th></tr></thead><tbody data-detail-changes></tbody></table></div>
    <div class="section-title monastic-part-title"><div><h3>확인한 증빙자료 목록 (비공개)</h3><p>파일당 4MB 이하, 최대 10개. R2(FILES) 우선 저장</p></div></div>
    <div class="form-grid monastic-grid monastic-attachments">
      <div class="form-field"><label>증빙 종류</label><input data-evidence-type maxlength="100" placeholder="예: 수계증빙, 사찰재적확인" /></div>
      <div class="form-field"><label>발급기관</label><input data-evidence-issuer maxlength="160" /></div>
      <div class="form-field"><label>확인일</label><span class="monastic-date-control" data-monastic-date-control><input type="text" data-monastic-date data-evidence-date inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" spellcheck="false" /><button type="button" class="monastic-calendar-button" data-monastic-calendar aria-label="증빙 확인일 달력 선택" title="달력에서 선택">▦</button><input type="date" data-no-weekday data-no-date8 class="monastic-calendar-native" tabindex="-1" aria-hidden="true" /></span></div>
      <div class="form-field"><label>증빙파일</label><input type="file" data-evidence-file accept=".pdf,.hwp,.hwpx,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png" /></div>
    </div>
    <div class="form-actions"><button type="button" class="btn btn-primary" data-upload>첨부파일 등록</button></div>
    <div class="status-message" data-attachment-status aria-live="polite"></div>
    <div class="data-wrap"><table class="data-table"><thead><tr><th>증빙 종류</th><th>파일명</th><th>발급기관</th><th>확인일</th><th>크기</th><th>관리</th></tr></thead><tbody data-attachments></tbody></table></div>
    <p class="privacy-note">승적원부는 대외 배포용 문서가 아닙니다. 외부 제출용은 별도의 승적증명서 발급 화면을 사용하세요.</p>
  </section>
  <script is:inline>
    (async () => {
      const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
      const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const session=await window.MilgyoSession.ready(); if(!session?.token)return;
      const api=async(url,p)=>{const r=await window.MilgyoSession.fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});const d=await r.json();if(!d.ok&&r.status===401&&window.MilgyoSession.isAuthFailure(d))throw new Error(d.message);return d;};
      const today=()=>new Date(Date.now()+9*3600000).toISOString().slice(0,10);
      const status=(selector,message,kind='')=>{const el=$(selector);el.textContent=message||'';el.className=`status-message ${kind}`;};
      let current=null, page=1, pages=1, selectedId='', selectedVersion=0;
      const fields=['monasticNo','dharmaNameKo','dharmaNameHanja','layName','birthDate','status','temple','acquiredDate','mentorName','positionTitle','contact','managingOffice','firstRegisteredDate','lastVerifiedDate','accessScope','processingBasis','sensitiveBasis','retentionPeriod','storageLocation','preparedBy','reviewedBy','approvedBy'];
      const ordTypes=['사미·사미니계','구족계','기타 수계','법계 / 품수'];
      const isIsoDate=value=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value||''));if(!m)return false;const d=new Date(Date.UTC(+m[1],+m[2]-1,+m[3]));return +m[1]>=1900&&+m[1]<=2200&&d.getUTCFullYear()===+m[1]&&d.getUTCMonth()===+m[2]-1&&d.getUTCDate()===+m[3]};
      const normalizeDate=value=>{const raw=String(value||'').trim();if(!raw)return '';const digits=raw.replace(/[-./\s]/g,'');if(!/^\d{8}$/.test(digits)||!/^(?:\d{8}|\d{4}[-./]\d{1,2}[-./]\d{1,2})$/.test(raw))return null;const match=/^(\d{4})(\d{2})(\d{2})$/.exec(digits),d=`${match[1]}-${match[2]}-${match[3]}`;return isIsoDate(d)?d:null;};
      const dateControl=(key,value='',label='날짜')=>`<span class="monastic-date-control" data-monastic-date-control><input type="text" data-monastic-date data-key="${esc(key)}" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" spellcheck="false" aria-label="${esc(label)}" value="${esc(value)}" /><button type="button" class="monastic-calendar-button" data-monastic-calendar aria-label="${esc(label)} 달력 선택" title="달력에서 선택">▦</button><input type="date" data-no-weekday data-no-date8 class="monastic-calendar-native" tabindex="-1" aria-hidden="true" /></span>`;
      // 수기 입력의 자리이동 문제를 피하기 위해 실제 입력은 text, 달력은 별도 native picker 사용
      document.addEventListener('input',e=>{if(e.target.matches?.('[data-monastic-date]'))e.target.setCustomValidity('')});
      document.addEventListener('blur',e=>{if(!e.target.matches?.('[data-monastic-date]'))return;const valid=normalizeDate(e.target.value);if(valid!==null)e.target.value=valid;else e.target.setCustomValidity('날짜를 YYYY-MM-DD 또는 숫자 8자리로 입력해 주세요.')},true);
      document.addEventListener('click',e=>{const b=e.target.closest?.('[data-monastic-calendar]');if(!b)return;const wrap=b.closest('[data-monastic-date-control]'),input=wrap.querySelector('[data-monastic-date]'),picker=wrap.querySelector('.monastic-calendar-native');const date=normalizeDate(input.value);picker.value=date||'';try{picker.showPicker()}catch{picker.focus();picker.click()}});
      document.addEventListener('change',e=>{if(!e.target.matches?.('.monastic-calendar-native'))return;const input=e.target.closest('[data-monastic-date-control]').querySelector('[data-monastic-date]');input.value=e.target.value;input.setCustomValidity('');input.dispatchEvent(new Event('input',{bubbles:true}))});
      const ordRow=(v={})=>`<tr data-repeat="ordination"><td><select data-key="kind"><option value="">선택</option>${ordTypes.map(x=>`<option ${v.kind===x?'selected':''}>${esc(x)}</option>`).join('')}</select></td><td>${dateControl('date',v.date,'수계·품수일')}</td><td><input data-key="place" maxlength="120" aria-label="장소·시행기관" value="${esc(v.place||'')}" /></td><td><input data-key="teacher" maxlength="120" aria-label="계사·확인자" value="${esc(v.teacher||'')}" /></td><td><input data-key="evidence" maxlength="200" aria-label="근거 문서" value="${esc(v.evidence||'')}" /></td><td class="monastic-action-cell"><button type="button" class="btn btn-outline btn-sm monastic-delete-row" data-remove-row>삭제</button></td></tr>`;
      const parsePeriod=v=>{const from=v.fromDate||'',to=v.toDate||'';if(from||to)return{from,to,legacy:''};const m=/^(\d{4}[-.]\d{2}[-.]\d{2})\.?\s*[~～]\s*(\d{4}[-.]\d{2}[-.]\d{2})\.?$/.exec(String(v.period||'').trim());if(m){const a=normalizeDate(m[1]),b=normalizeDate(m[2]);if(a&&b)return{from:a,to:b,legacy:''}}return{from:'',to:'',legacy:String(v.period||'')}};
      const careerRow=(v={})=>{const range=parsePeriod(v);return `<tr data-repeat="career" data-legacy-period="${esc(range.legacy)}"><td><div class="monastic-period"><span class="monastic-period-label">시작</span>${dateControl('fromDate',range.from,'활동 시작일')}<span class="monastic-period-label">종료</span>${dateControl('toDate',range.to,'활동 종료일')}</div>${range.legacy?`<small class="monastic-legacy-period">이전 기록: ${esc(range.legacy)}</small>`:''}</td><td><input data-key="institution" maxlength="120" aria-label="소속 사찰·기관" value="${esc(v.institution||'')}" /></td><td><input data-key="position" maxlength="120" aria-label="소임·직책" value="${esc(v.position||'')}" /></td><td><input data-key="evidence" maxlength="200" aria-label="확인 자료" value="${esc(v.evidence||'')}" /></td><td class="monastic-action-cell"><button type="button" class="btn btn-outline btn-sm monastic-delete-row" data-remove-row>삭제</button></td></tr>`};
      const addRepeat=(type,v)=>{const box=$(`[data-${type}]`),max=type==='ordination'?12:20;if(box.children.length>=max){alert('허용된 최대 항목 수입니다.');return;}box.insertAdjacentHTML('beforeend',type==='ordination'?ordRow(v):careerRow(v));};
      $('[data-add-ordination]').addEventListener('click',()=>addRepeat('ordination'));
      $('[data-add-career]').addEventListener('click',()=>addRepeat('career'));
      $('[data-form]').addEventListener('click',e=>{const b=e.target.closest('[data-remove-row]');if(b)b.closest('tr')?.remove()});
      const getRepeat=type=>$$( `[data-repeat="${type}"]`).map(row=>{const v=Object.fromEntries($$('[data-key]',row).map(el=>[el.dataset.key,el.value.trim()]));if(type==='career'){const from=v.fromDate||'',to=v.toDate||'';v.period=from&&to?`${from} ~ ${to}`:row.dataset.legacyPeriod||'';}return v}).filter(row=>Object.values(row).some(Boolean));
