          <h2>승적 기재사항 변경·정정 이력</h2><div class="data-wrap"><table class="data-table monastic-changes-table"><thead><tr><th>처리일자</th><th>처리구분</th><th>변경항목</th><th>변경 전</th><th>변경 후</th><th>증빙·담당자</th></tr></thead><tbody>${history}</tbody></table></div>
          <h2>확인한 증빙자료 목록</h2>${evidenceTable}
          <h2>접근권한 및 보존관리 확인</h2>${grid(['접근 범위','개인정보 동의','민감정보 동의','보유기간','보관장소'],[[r.access_scope,r.processing_basis,r.sensitive_basis,r.retention_period,r.storage_location]])}
          <h2>작성·검토·승인</h2>${grid(['작성자','검토자','승인자'],[[accountName(r.prepared_by),accountName(r.reviewed_by),accountName(r.approved_by)]])}</section></body></html>`;
        const w=window.open('','_blank','width=1100,height=900');if(!w){alert('팝업을 허용해 주세요.');return;}
        w.document.write(html);w.document.close();
        w.document.querySelector('[data-print-trigger]')?.addEventListener('click',()=>w.print());
      });
      const options=await api('/api/monastic-registry/query',{operation:'options'});
      if(!options.ok){status('[data-status-message]',options.message,'error');$('[data-body]').innerHTML='<tr><td colspan="8">승적원부 관리 권한이 없습니다.</td></tr>';return;}
      accountUsers=Array.isArray(options.users)?options.users:[];setAccountOptions();
      $('[data-new]').hidden=false;loadList();
    })();
  </script>
