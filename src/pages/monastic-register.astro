      const setLegacyOption=(el,value)=>{if(!el||!value||$$('option',el).some(o=>o.value===value))return;const option=document.createElement('option');option.value=value;option.textContent=`기존 기록 · ${String(value).startsWith('user:')?accountName(value):value} (선택값 확인 필요)`;el.append(option)};
