---
import GovLayout from '../layouts/GovLayout.astro';
---
<GovLayout>
  <!-- 로그인 -->
  <div class="login-screen" data-login-screen>
    <div class="login-card">
      <p class="login-card__kicker">사단법인 대한불교밀교종</p>
      <h1>종단관리시스템</h1>
      <p class="login-card__desc">문서등록대장 · 전자결재 · 접수발송대장</p>
      <form data-login-form>
        <label for="login-username">아이디</label>
        <input id="login-username" name="username" type="text" autocomplete="username" required />
        <label for="login-password">비밀번호</label>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required />
        <button type="submit" class="btn btn-primary btn-block">로그인</button>
        <p class="login-card__error" data-login-error hidden></p>
      </form>
      <button type="button" class="login-card__toggle" data-toggle-bootstrap>최초 관리자 계정이 아직 없으신가요?</button>

      <form class="login-card__bootstrap" data-bootstrap-form hidden>
        <p class="hint">Cloudflare Pages 환경변수에 등록한 ADMIN_TOKEN(마스터 키)을 아는 분만 최초 관리자 계정을 만들 수 있습니다.</p>
        <label for="bs-admin-token">마스터 키(ADMIN_TOKEN)</label>
        <input id="bs-admin-token" name="adminToken" type="password" required />
        <label for="bs-name">성명</label>
        <input id="bs-name" name="name" type="text" maxlength="40" required />
        <label for="bs-username">로그인 아이디</label>
        <input id="bs-username" name="username" type="text" maxlength="60" required />
        <label for="bs-password">비밀번호(8자 이상)</label>
        <input id="bs-password" name="password" type="password" minlength="8" required />
        <label for="bs-position">직책(선택)</label>
        <input id="bs-position" name="position" type="text" maxlength="40" placeholder="예: 이사장" />
        <button type="submit" class="btn btn-primary btn-block">관리자 계정 만들기</button>
        <p class="login-card__error" data-bootstrap-error hidden></p>
        <p class="login-card__error login-card__error--ok" data-bootstrap-ok hidden></p>
      </form>
      <p class="login-card__help">브라우저를 닫으면 로그인 상태는 사라집니다.</p>
    </div>
  </div>

  <!-- 앱 셸 -->
  <div class="app-shell" data-app-shell hidden>
    <header class="app-topbar">
      <div class="app-topbar__brand">
        <span class="app-topbar__badge">문서</span>
        종단관리시스템
      </div>
      <nav class="app-topbar__menu">
        <button type="button" class="app-topbar__link active" data-nav="home">홈</button>
        <button type="button" class="app-topbar__link" data-nav="approval">결재</button>
        <button type="button" class="app-topbar__link" data-nav="registry">문서대장</button>
        <button type="button" class="app-topbar__link" data-nav="received">접수·발송</button>
      </nav>
      <div class="app-topbar__right">
        <span class="app-topbar__me" data-me-label></span>
        <button type="button" class="btn btn-ghost" data-open-users hidden>계정관리</button>
        <button type="button" class="btn btn-ghost" data-open-orgchart>조직도</button>
        <button type="button" class="btn btn-ghost" data-logout>로그아웃</button>
      </div>
    </header>

    <div class="app-body">
      <aside class="app-sidebar">
        <button type="button" class="btn btn-primary btn-block sidebar-compose" data-open-compose>+ 문서작성</button>

        <div class="sidebar-group">
          <p class="sidebar-group__title">전자문서</p>
          <button type="button" class="sidebar-link active" data-view="결재대기">
            결재대기함 <span class="sidebar-link__count" data-count="결재대기">0</span>
          </button>
          <button type="button" class="sidebar-link" data-view="발송대기">
            발송대기함 <span class="sidebar-link__count" data-count="발송대기">0</span>
          </button>
          <button type="button" class="sidebar-link" data-view="전체">문서등록대장</button>
        </div>

        <div class="sidebar-group">
          <p class="sidebar-group__title">처리한문서</p>
          <button type="button" class="sidebar-link" data-view="완료">완료문서함</button>
          <button type="button" class="sidebar-link" data-view="반려">반려문서함</button>
        </div>

        <div class="sidebar-group">
          <p class="sidebar-group__title">접수·외부발송(문서24 등)</p>
          <button type="button" class="sidebar-link" data-received-view="전체">접수·발송대장</button>
          <button type="button" class="btn btn-outline btn-block" data-open-received>+ 접수·발송 등록</button>
        </div>
      </aside>

      <main class="app-main">
        <!-- 문서 목록 화면 -->
        <section data-panel="documents">
          <div class="panel-header">
            <h2 data-panel-title>결재대기함</h2>
            <div class="panel-header__tools">
              <input type="search" data-query placeholder="문서번호, 제목, 기안자 검색" />
              <button type="button" class="btn btn-outline" data-refresh>조회</button>
            </div>
          </div>
          <div class="panel-status" data-status aria-live="polite"></div>
          <div class="list-toolbar" data-list-toolbar hidden>
            <label class="list-toolbar__select-all">
              <input type="checkbox" data-select-all />
              전체선택
            </label>
            <span class="list-toolbar__count"><span data-selected-count>0</span>건 선택됨</span>
            <button type="button" class="btn btn-primary" data-open-batch-approve>일괄결재</button>
          </div>
          <div class="doc-table" data-doc-table></div>
        </section>

        <!-- 접수·발송대장 화면 -->
        <section data-panel="received" hidden>
          <div class="panel-header">
            <h2>접수·발송대장</h2>
            <div class="panel-header__tools">
              <select data-received-filter>
                <option value="전체">전체</option>
                <option value="접수">접수</option>
                <option value="외부발송">외부발송</option>
              </select>
              <input type="search" data-received-query placeholder="제목, 상대방 검색" />
              <button type="button" class="btn btn-outline" data-received-refresh>조회</button>
            </div>
          </div>
          <div class="panel-status" data-received-status aria-live="polite"></div>
          <div class="doc-table" data-received-table></div>
        </section>
      </main>
    </div>
  </div>

  <!-- 문서작성(기안/발송) — 좌: 입력폼 / 우: 공문서 실시간 미리보기 -->
  <div class="modal-overlay" data-compose-modal hidden>
    <div class="modal modal--wide">
      <div class="modal__header">
        <h2>문서작성</h2>
        <button type="button" class="modal__close" data-close-compose aria-label="닫기">×</button>
      </div>
      <div class="compose-layout">
        <form class="compose-form" data-compose-form>
          <fieldset class="compose-fieldset">
            <legend>① 문서 종류</legend>
            <label>문서구분</label>
            <div class="radio-row">
              <label><input type="radio" name="docType" value="기안" checked /> 기안(내부)</label>
              <label><input type="radio" name="docType" value="발송" /> 발송(대외)</label>
            </div>

            <label for="c-category">문서분류(과제카드명) · 제13조③</label>
            <select id="c-category" name="category"></select>
            <p class="hint" data-track-hint></p>
            <div class="radio-row" data-track-choice hidden>
              <label><input type="radio" name="approvalTrackChoice" value="이사장결재" checked /> 이사장 결재</label>
              <label><input type="radio" name="approvalTrackChoice" value="이사회의결" /> 이사회 의결</label>
            </div>
          </fieldset>

          <fieldset class="compose-fieldset">
            <legend>② 결재라인 지정</legend>
            <label for="c-summary">문서요지(선택)</label>
            <input id="c-summary" name="summary" type="text" maxlength="200" placeholder="보고내용을 한 줄로 요약해 주세요." />

            <div data-reviewer-approver-fields>
              <label for="c-reviewer">검토자(선택)</label>
              <select id="c-reviewer" name="reviewerUserId" data-reviewer-select></select>

              <label for="c-approver" data-approver-label>결재자 · 제13조②</label>
              <select id="c-approver" name="approverUserId" data-approver-select></select>
            </div>

            <label for="c-department">담당부서(선택)</label>
            <select id="c-department" name="department" data-department-select></select>
          </fieldset>

          <fieldset class="compose-fieldset">
            <legend>③ 수신·본문</legend>
            <div data-recipient-field hidden>
              <label for="c-recipient">수신</label>
              <input id="c-recipient" name="recipient" type="text" maxlength="100" placeholder="예: OO시청 / OOO 귀하" />
            </div>

            <label for="c-via">경유(선택)</label>
            <input id="c-via" name="via" type="text" maxlength="100" placeholder="경유기관이 있는 경우에만 입력" />

            <label for="c-title">제목</label>
            <input id="c-title" name="title" type="text" maxlength="200" required />

            <label for="c-body">본문</label>
            <textarea id="c-body" name="body" rows="7" required></textarea>
          </fieldset>

          <fieldset class="compose-fieldset">
            <legend>④ 붙임파일</legend>
            <label for="c-attachments-note">붙임 설명(선택)</label>
            <input id="c-attachments-note" name="attachmentsNote" type="text" maxlength="400" placeholder="예: 사업계획서 1부." />

            <label for="c-attachments-file" class="file-drop-label">붙임파일(선택, 파일당 4MB 이하)</label>
            <input id="c-attachments-file" name="attachmentsFile" type="file" multiple />
            <ul class="attachment-pending-list" data-attachment-pending-list></ul>
          </fieldset>

          <div class="compose-form__actions">
            <button type="button" class="btn btn-outline" data-close-compose>취소</button>
            <button type="submit" class="btn btn-primary">등록</button>
          </div>
        </form>

        <div class="compose-preview">
          <div class="compose-preview__toolbar">
            <span class="compose-preview__label">공문서 미리보기</span>
            <button type="button" class="btn btn-outline btn-sm" data-open-branding>관인·로고 관리</button>
          </div>
          <div class="official-doc" data-official-doc="preview">
            <div class="official-doc__masthead">
              <div class="official-doc__emblem" data-emblem="preview">卍</div>
              <h3 class="official-doc__orgname">사단법인 대한불교밀교종</h3>
            </div>
            <p class="official-doc__number" data-preview-number>문서번호 · 밀교종-2026-000</p>
            <div class="official-doc__meta">
              <div class="official-doc__meta-row"><span>수신</span><strong data-preview-recipient>(내부결재)</strong></div>
              <div class="official-doc__meta-row" data-preview-via-row hidden><span>(경유)</span><strong data-preview-via>-</strong></div>
              <div class="official-doc__meta-row"><span>제목</span><strong data-preview-title>제목을 입력해 주세요</strong></div>
            </div>
            <div class="official-doc__body" data-preview-body>본문을 입력해 주세요.</div>
            <div class="official-doc__meta-row official-doc__attach"><span>붙임</span><strong data-preview-attachments>—</strong></div>

            <table class="official-doc__routing">
              <thead><tr><th>구분</th><th>직위</th><th>성명</th><th>결재</th></tr></thead>
              <tbody>
                <tr><td>기안</td><td data-preview-drafter-position>-</td><td data-preview-drafter-name>-</td><td class="official-doc__routing-seal">〇</td></tr>
                <tr data-preview-reviewer-row><td>검토</td><td data-preview-reviewer-position>-</td><td data-preview-reviewer-name>-</td><td class="official-doc__routing-seal">　</td></tr>
                <tr data-preview-approver-row><td>결재</td><td data-preview-approver-position>-</td><td data-preview-approver-name>-</td><td class="official-doc__routing-seal">　</td></tr>
              </tbody>
            </table>

            <div class="official-doc__issue">
              <p data-preview-track class="official-doc__issue-track">결재: 전결</p>
              <div class="official-doc__issue-name">
                사단법인 대한불교밀교종
                <span data-preview-signer>이사장</span>
                <span class="stamp-mark" data-stamp="preview">밀교종印</span>
              </div>
            </div>
            <p class="official-doc__footer">사단법인 대한불교밀교종 · milgyo.org</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 접수·발송 등록 모달 -->
  <div class="modal-overlay" data-received-modal hidden>
    <div class="modal">
      <div class="modal__header">
        <h2>접수·발송 등록</h2>
        <button type="button" class="modal__close" data-close-received aria-label="닫기">×</button>
      </div>
      <form class="compose-form" data-received-form>
        <label>구분</label>
        <div class="radio-row">
          <label><input type="radio" name="direction" value="접수" checked /> 접수(들어온 문서)</label>
          <label><input type="radio" name="direction" value="외부발송" /> 외부발송(문서24 등으로 내보낸 문서)</label>
        </div>
        <label for="r-title">제목</label>
        <input id="r-title" name="title" type="text" maxlength="200" required />
        <label for="r-counterparty" data-counterparty-label>발신자</label>
        <input id="r-counterparty" name="counterparty" type="text" maxlength="100" required />
        <label for="r-source">전달 경로</label>
        <input id="r-source" name="sourceSystem" type="text" maxlength="40" placeholder="문서24 / 우편 / 이메일 / 방문 등" />
        <label for="r-external-number">상대기관 문서번호(선택)</label>
        <input id="r-external-number" name="externalDocNumber" type="text" maxlength="100" />
        <label for="r-date">접수·발송 일자</label>
        <input id="r-date" name="receivedAt" type="date" required />
        <label for="r-memo">메모(선택)</label>
        <textarea id="r-memo" name="memo" rows="3" maxlength="2000"></textarea>
        <div class="compose-form__actions">
          <button type="button" class="btn btn-outline" data-close-received>취소</button>
          <button type="submit" class="btn btn-primary">등록</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 일괄결재 모달 -->
  <div class="modal-overlay" data-batch-modal hidden>
    <div class="modal">
      <div class="modal__header">
        <h2>일괄결재</h2>
        <button type="button" class="modal__close" data-close-batch aria-label="닫기">×</button>
      </div>
      <form class="compose-form" data-batch-form>
        <p class="hint" data-batch-hint>선택한 문서를 일괄 처리합니다.</p>
        <p class="hint">본인이 결재자로 지정된 결재대기 문서만 처리됩니다(전결·타인 지정 문서는 자동 제외).</p>
        <label for="b-memo">결재 의견(선택)</label>
        <textarea id="b-memo" name="memo" rows="3" maxlength="2000"></textarea>
        <div class="compose-form__actions">
          <button type="submit" class="btn btn-outline" data-batch-action="반려">일괄 반려</button>
          <button type="submit" class="btn btn-primary" data-batch-action="승인">일괄 승인</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 계정관리(관리자 전용) -->
  <div class="modal-overlay" data-users-modal hidden>
    <div class="modal modal--wide">
      <div class="modal__header">
        <h2>계정관리</h2>
        <button type="button" class="modal__close" data-close-users aria-label="닫기">×</button>
      </div>
      <div class="users-layout">
        <div>
          <p class="detail-section-title">계정 목록</p>
          <div class="doc-table" data-users-table></div>
        </div>
        <form class="compose-form" data-user-form>
          <p class="detail-section-title" data-user-form-title>계정 추가</p>
          <input type="hidden" name="id" />
          <label for="u-name">성명</label>
          <input id="u-name" name="name" type="text" maxlength="40" required />
          <label for="u-username">아이디</label>
          <input id="u-username" name="username" type="text" maxlength="60" required />
          <label for="u-password" data-user-password-label>비밀번호(8자 이상)</label>
          <input id="u-password" name="password" type="password" minlength="8" />
          <label for="u-position">직책</label>
          <input id="u-position" name="position" type="text" maxlength="40" placeholder="예: 사무국장" />
          <label for="u-grade">직급(선택)</label>
          <input id="u-grade" name="grade" type="text" maxlength="20" placeholder="예: 3급" />
          <label for="u-department">담당부서(선택) · 조직도에 표시됩니다</label>
          <select id="u-department" name="department" data-user-department-select></select>
          <label for="u-role">역할</label>
          <select id="u-role" name="role">
            <option value="user">일반 계정</option>
            <option value="admin">관리자(계정관리 가능)</option>
          </select>
          <label class="checkbox-row"><input type="checkbox" name="canApprove" /> 결재자로 지정 가능(결재권 부여)</label>
          <label class="checkbox-row" data-user-active-row><input type="checkbox" name="active" checked /> 활성 계정</label>
          <div class="compose-form__actions">
            <button type="button" class="btn btn-outline" data-user-form-reset>새 계정 입력으로</button>
            <button type="submit" class="btn btn-primary" data-user-form-submit>계정 추가</button>
          </div>
          <p class="hint" data-user-form-status></p>
        </form>
      </div>
    </div>
  </div>

  <!-- 관인·로고 관리 -->
  <div class="modal-overlay" data-branding-modal hidden>
    <div class="modal">
      <div class="modal__header">
        <h2>관인·로고 관리</h2>
        <button type="button" class="modal__close" data-close-branding aria-label="닫기">×</button>
      </div>
      <p class="hint">한 번 등록하면 이후 모든 공문서 미리보기에 자동으로 표시됩니다. 배경이 투명한 PNG 이미지를 권장합니다(각 1MB 이하).</p>
      <form class="compose-form" data-branding-form>
        <label for="brand-logo">로고(상단 문양, 선택)</label>
        <input id="brand-logo" name="logoFile" type="file" accept="image/*" />
        <div class="branding-preview" data-branding-logo-preview><span class="muted">등록된 로고 없음</span></div>

        <label for="brand-seal">관인(직인, 선택)</label>
        <input id="brand-seal" name="sealFile" type="file" accept="image/*" />
        <div class="branding-preview" data-branding-seal-preview><span class="muted">등록된 관인 없음</span></div>

        <div class="compose-form__actions">
          <button type="button" class="btn btn-outline" data-close-branding>닫기</button>
          <button type="submit" class="btn btn-primary" data-branding-submit>저장</button>
        </div>
        <p class="hint" data-branding-status></p>
      </form>
    </div>
  </div>

  <!-- 조직도 -->
  <div class="modal-overlay" data-orgchart-modal hidden>
    <div class="modal modal--wide">
      <div class="modal__header">
        <h2>조직도</h2>
        <button type="button" class="modal__close" data-close-orgchart aria-label="닫기">×</button>
      </div>
      <div class="orgchart-layout">
        <nav class="orgchart-tree" data-orgchart-tree></nav>
        <div class="orgchart-members">
          <p class="detail-section-title" data-orgchart-title>부서를 선택해 주세요</p>
          <ul class="orgchart-member-list" data-orgchart-members></ul>
        </div>
      </div>
    </div>
  </div>

  <!-- 문서 상세 / 결재 처리 -->
  <div class="modal-overlay" data-detail-modal hidden>
    <div class="modal modal--wide">
      <div class="modal__header">
        <h2 data-detail-title>제목</h2>
        <button type="button" class="modal__close" data-close-detail aria-label="닫기">×</button>
      </div>
      <div class="compose-layout">
        <div>
          <p class="detail-meta" data-detail-meta></p>
          <p class="detail-section-title">첨부파일</p>
          <ul class="attachment-list" data-detail-attachments></ul>
          <p class="detail-section-title">결재 이력</p>
          <div class="doc-approval-history" data-detail-history></div>

          <p class="hint" data-decide-blocked hidden></p>
          <form class="compose-form" data-decide-form hidden>
            <label for="d-memo">결재 의견(선택)</label>
            <textarea id="d-memo" name="memo" rows="3" maxlength="2000"></textarea>
            <div class="compose-form__actions">
              <button type="submit" class="btn btn-outline" data-action="반려">반려</button>
              <button type="submit" class="btn btn-primary" data-action="승인">승인</button>
            </div>
          </form>

          <form class="compose-form" data-send-form hidden>
            <p class="hint">규정 제16조: 발송문서는 발송방법을 기록해 보관합니다.</p>
            <label for="s-method">발송방법</label>
            <input id="s-method" name="sentMethod" type="text" maxlength="40" placeholder="우편 / 전자우편 / 방문제출 등" />
            <div class="compose-form__actions">
              <button type="submit" class="btn btn-primary">발송완료 처리</button>
            </div>
          </form>
        </div>

        <div class="compose-preview">
          <div class="official-doc" data-official-doc="detail">
            <div class="official-doc__masthead">
              <div class="official-doc__emblem" data-emblem="detail">卍</div>
              <h3 class="official-doc__orgname">사단법인 대한불교밀교종</h3>
            </div>
            <p class="official-doc__number" data-detail-preview-number></p>
            <div class="official-doc__meta">
              <div class="official-doc__meta-row"><span>수신</span><strong data-detail-preview-recipient></strong></div>
              <div class="official-doc__meta-row" data-detail-preview-via-row hidden><span>(경유)</span><strong data-detail-preview-via></strong></div>
              <div class="official-doc__meta-row"><span>제목</span><strong data-detail-preview-title></strong></div>
            </div>
            <div class="official-doc__body" data-detail-preview-body></div>
            <div class="official-doc__meta-row official-doc__attach"><span>붙임</span><strong data-detail-preview-attachments></strong></div>

            <table class="official-doc__routing">
              <thead><tr><th>구분</th><th>직위</th><th>성명</th><th>결재</th></tr></thead>
              <tbody>
                <tr><td>기안</td><td data-detail-preview-drafter-position>-</td><td data-detail-preview-drafter-name>-</td><td class="official-doc__routing-seal">〇</td></tr>
                <tr data-detail-preview-reviewer-row><td>검토</td><td data-detail-preview-reviewer-position>-</td><td data-detail-preview-reviewer-name>-</td><td class="official-doc__routing-seal" data-detail-preview-reviewer-seal>　</td></tr>
                <tr data-detail-preview-approver-row><td>결재</td><td data-detail-preview-approver-position>-</td><td data-detail-preview-approver-name>-</td><td class="official-doc__routing-seal" data-detail-preview-approver-seal>　</td></tr>
              </tbody>
            </table>

            <div class="official-doc__issue">
              <p data-detail-preview-track class="official-doc__issue-track"></p>
              <div class="official-doc__issue-name">
                사단법인 대한불교밀교종
                <span data-detail-preview-signer></span>
                <span class="stamp-mark" data-detail-preview-stamp data-stamp="detail">밀교종印</span>
              </div>
            </div>
            <p class="official-doc__footer">사단법인 대한불교밀교종 · milgyo.org</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{
    importantCategories: [
      '주무관청 제출자료',
      '법인 설립·변경·등기·허가·신고 관련 문서',
      '정관·내부규정 제·개정 자료',
      '총회·이사회 안건 및 의사록',
      '예산·결산·사업계획·사업실적 관련 문서',
      '계약서·협약서·양해각서 및 재산 관련 문서',
      '인사·보수·위촉·해촉·징계 관련 문서',
      '후원금·보시금·목적지정 기부금 관련 중요 문서',
      '법인의 공식 입장 또는 대외 발표자료',
      '그 밖에 법인의 권리·의무에 중요한 영향을 미치는 문서',
    ],
    routineCategory: '일반(경미한 내부보고·단순사무 — 전결대상)',
  }}>
    (function () {
      const STORAGE_KEY = 'milgyo-system-session';
      const allCategories = importantCategories.concat([routineCategory]);
      let allUsers = [];

      // ---------- 세션 ----------
      const getSession = () => {
        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (error) {
          return null;
        }
      };
      const setSession = (session) => sessionStorage.setItem(STORAGE_KEY, JSON.stringify(session));
      const clearSession = () => sessionStorage.removeItem(STORAGE_KEY);
      const getToken = () => (getSession() || {}).token || '';
      const getMe = () => (getSession() || {}).user || null;

      // 네이버웍스 조직도를 그대로 반영한 담당부서 트리 (사무국/소속기관·교구/위원회·신도단체만 하위 조직 보유)
      const departmentTree = [
        { name: '이사장' },
        { name: '이사회' },
        { name: '감사' },
        { name: '종정' },
        { name: '사무국', children: ['재정·회계', '준법·윤리', '대외협력·사회공헌', '문화·홍보'] },
        { name: '총무원' },
        { name: '교육·포교원' },
        {
          name: '소속기관·교구',
          children: [
            '람림불교교육원', '서울·인천·경기교구', '강원교구', '대전·세종·충남교구',
            '충북교구', '전남광주·전북교구', '대구·경북교구', '부산·울산·경남교구', '제주교구',
          ],
        },
        { name: '위원회·신도단체', children: ['신도회', '사찰운영위원회'] },
      ];

      const renderDepartmentOptions = () => '<option value="">담당부서 선택(선택)</option>' + departmentTree.map((dep) => {
        if (!dep.children) return `<option value="${dep.name}">${dep.name}</option>`;
        const parentOption = `<option value="${dep.name}">${dep.name}(전체)</option>`;
        const childOptions = dep.children
          .map((child) => `<option value="${dep.name} - ${child}">　ㄴ ${child}</option>`)
          .join('');
        return `<optgroup label="${dep.name}">${parentOption}${childOptions}</optgroup>`;
      }).join('');

      const loginScreen = document.querySelector('[data-login-screen]');
      const appShell = document.querySelector('[data-app-shell]');
      const loginForm = document.querySelector('[data-login-form]');
      const loginError = document.querySelector('[data-login-error]');
      const logoutBtn = document.querySelector('[data-logout]');
      const meLabel = document.querySelector('[data-me-label]');
      const openUsersBtn = document.querySelector('[data-open-users]');

      const toggleBootstrapBtn = document.querySelector('[data-toggle-bootstrap]');
      const bootstrapForm = document.querySelector('[data-bootstrap-form]');
      const bootstrapError = document.querySelector('[data-bootstrap-error]');
      const bootstrapOk = document.querySelector('[data-bootstrap-ok]');

      toggleBootstrapBtn.addEventListener('click', () => {
        bootstrapForm.hidden = !bootstrapForm.hidden;
      });

      const panelDocuments = document.querySelector('[data-panel="documents"]');
      const panelReceived = document.querySelector('[data-panel="received"]');
      const panelTitle = document.querySelector('[data-panel-title]');
      const docTable = document.querySelector('[data-doc-table]');
      const statusEl = document.querySelector('[data-status]');
      const queryInput = document.querySelector('[data-query]');
      const refreshBtn = document.querySelector('[data-refresh]');

      const receivedTable = document.querySelector('[data-received-table]');
      const receivedStatus = document.querySelector('[data-received-status]');
      const receivedFilter = document.querySelector('[data-received-filter]');
      const receivedQuery = document.querySelector('[data-received-query]');
      const receivedRefreshBtn = document.querySelector('[data-received-refresh]');

      const sidebarLinks = document.querySelectorAll('[data-view]');
      const receivedSidebarLink = document.querySelector('[data-received-view]');
      const topbarNavLinks = document.querySelectorAll('[data-nav]');

      let currentView = '결재대기';

      const callApi = async (path, body) => {
        const response = await fetch(path, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await response.json().catch(() => ({ ok: false, message: '응답 처리 중 오류가 발생했습니다.' }));
        if (response.status === 401) {
          clearSession();
          showLogin();
        }
        return data;
      };

      const showLogin = () => {
        loginScreen.hidden = false;
        appShell.hidden = true;
      };
      const showApp = () => {
        loginScreen.hidden = true;
        appShell.hidden = false;
        const me = getMe();
        if (me) {
          meLabel.textContent = `${me.name}${me.position ? ' · ' + me.position : ''}`;
          openUsersBtn.hidden = me.role !== 'admin';
          const brandBtn = document.querySelector('[data-open-branding]');
          if (brandBtn) brandBtn.hidden = me.role !== 'admin';
        }
      };

      const showDocumentsPanel = () => {
        panelDocuments.hidden = false;
        panelReceived.hidden = true;
      };
      const showReceivedPanel = () => {
        panelDocuments.hidden = true;
        panelReceived.hidden = false;
      };

      // ---------- 문서 목록 ----------
      const viewLabels = {
        결재대기: '결재대기함',
        발송대기: '발송대기함',
        전체: '문서등록대장',
        완료: '완료문서함',
        반려: '반려문서함',
      };

      const QUEUE_VIEWS = ['결재대기', '발송대기', '완료', '반려'];
      const listToolbar = document.querySelector('[data-list-toolbar]');
      const selectAllCheckbox = document.querySelector('[data-select-all]');
      const selectedCountEl = document.querySelector('[data-selected-count]');
      const openBatchApproveBtn = document.querySelector('[data-open-batch-approve]');
      let selectedIds = new Set();

      const formatDate = (isoLike) => (isoLike ? String(isoLike).slice(0, 10) : '-');

      const updateSelectionUi = () => {
        selectedCountEl.textContent = String(selectedIds.size);
        const boxes = docTable.querySelectorAll('[data-row-select]');
        const allChecked = boxes.length > 0 && Array.from(boxes).every((box) => box.checked);
        selectAllCheckbox.checked = allChecked;
      };

      const renderQueueTable = (rows) => {
        listToolbar.hidden = false;
        selectedIds = new Set();
        selectAllCheckbox.checked = false;

        const bodyRows = rows.map((row) => `
          <tr class="doc-table__row" data-doc-id="${row.id}">
            <td class="doc-table__select" data-no-open>
              <input type="checkbox" data-row-select value="${row.id}" ${row.status === '결재대기' && row.approval_track !== '전결' ? '' : 'disabled'} />
            </td>
            <td class="center">${row.doc_type}</td>
            <td class="center">${formatDate(row.created_at)}</td>
            <td class="doc-table__title">${row.title}</td>
            <td class="center">${row.department || '-'}</td>
            <td class="center">${row.drafter}</td>
            <td class="center">${row.recipient || '-'}</td>
            <td class="center"><span class="badge badge--${row.status}">${row.status}</span></td>
          </tr>
        `).join('');

        docTable.innerHTML = `
          <table class="doc-table__frame">
            <colgroup>
              <col style="width:44px" /><col style="width:80px" /><col style="width:110px" />
              <col /><col style="width:160px" /><col style="width:100px" /><col style="width:150px" /><col style="width:90px" />
            </colgroup>
            <thead>
              <tr>
                <th class="doc-table__select"></th>
                <th class="center">구분</th><th class="center">보고일자</th><th>제목</th><th class="center">부서</th>
                <th class="center">보고자</th><th class="center">보낸기관</th><th class="center">상태</th>
              </tr>
            </thead>
            <tbody>
              ${bodyRows || `<tr class="doc-table__empty-row"><td colspan="8" class="empty">조건에 맞는 문서가 없습니다.</td></tr>`}
            </tbody>
          </table>
        `;

        docTable.querySelectorAll('tr[data-doc-id]').forEach((tr) => {
          tr.addEventListener('click', (event) => {
            if (event.target.closest('[data-no-open]')) return;
            openDetail(tr.getAttribute('data-doc-id'));
          });
        });
        docTable.querySelectorAll('[data-row-select]').forEach((box) => {
          box.addEventListener('change', () => {
            if (box.checked) selectedIds.add(box.value); else selectedIds.delete(box.value);
            updateSelectionUi();
          });
        });
        updateSelectionUi();
      };

      // 문서등록대장(전체) — 번호/보고일자/제목/수(발)신자/보고자/검토자/검토자직위/상태
      const renderRegistryTable = (rows) => {
        listToolbar.hidden = true;

        const bodyRows = rows.map((row) => `
          <tr class="doc-table__row" data-doc-id="${row.id}">
            <td class="mono center">${row.id}</td>
            <td class="center">${formatDate(row.created_at)}</td>
            <td class="doc-table__title">${row.title}</td>
            <td class="center">${row.recipient || row.department || '-'}</td>
            <td class="center">${row.drafter}</td>
            <td class="center">${row.reviewer_name || row.approver_name || '-'}</td>
            <td class="center">${row.reviewer_position || row.approver_position || '-'}</td>
            <td class="center"><span class="badge badge--${row.status}">${row.status}</span></td>
          </tr>
        `).join('');

        docTable.innerHTML = `
          <table class="doc-table__frame">
            <colgroup>
              <col style="width:150px" /><col style="width:110px" /><col />
              <col style="width:150px" /><col style="width:100px" /><col style="width:100px" /><col style="width:110px" /><col style="width:90px" />
            </colgroup>
            <thead>
              <tr>
                <th class="center">번호</th><th class="center">보고일자</th><th>제목</th><th class="center">수(발)신자</th>
                <th class="center">보고자</th><th class="center">검토자</th><th class="center">검토자직위</th><th class="center">상태</th>
              </tr>
            </thead>
            <tbody>
              ${bodyRows || `<tr class="doc-table__empty-row"><td colspan="8" class="empty">등록된 문서가 없습니다.</td></tr>`}
            </tbody>
          </table>
        `;

        docTable.querySelectorAll('tr[data-doc-id]').forEach((tr) => {
          tr.addEventListener('click', () => openDetail(tr.getAttribute('data-doc-id')));
        });
      };

      const renderDocRows = (rows) => {
        if (currentView === '전체') renderRegistryTable(rows);
        else renderQueueTable(rows);
      };

      const refreshDocuments = async () => {
        const token = getToken();
        if (!token) return;
        statusEl.textContent = '조회 중입니다...';
        const data = await callApi('/api/documents/list', {
          token, view: currentView, query: queryInput.value.trim(),
        });
        if (!data.ok) { statusEl.textContent = data.message || '조회에 실패했습니다.'; return; }
        statusEl.textContent = `총 ${data.rows.length}건`;
        renderDocRows(data.rows);
        refreshSidebarCounts();
      };

      const refreshSidebarCounts = async () => {
        const token = getToken();
        if (!token) return;
        for (const view of ['결재대기', '발송대기']) {
          const data = await callApi('/api/documents/list', { token, view });
          const el = document.querySelector(`[data-count="${view}"]`);
          if (el && data.ok) el.textContent = String(data.rows.length);
        }
      };

      selectAllCheckbox.addEventListener('change', () => {
        const boxes = docTable.querySelectorAll('[data-row-select]:not(:disabled)');
        boxes.forEach((box) => {
          box.checked = selectAllCheckbox.checked;
          if (box.checked) selectedIds.add(box.value); else selectedIds.delete(box.value);
        });
        updateSelectionUi();
      });

      // 사이드바/상단 메뉴 어디를 눌러도 같은 문서 목록 화면으로 전환되도록 하나의 함수로 통일한다.
      const activateDocumentsView = (view) => {
        currentView = view;
        sidebarLinks.forEach((b) => b.classList.toggle('active', b.getAttribute('data-view') === view));
        panelTitle.textContent = viewLabels[currentView] || '문서목록';
        listToolbar.hidden = !QUEUE_VIEWS.includes(currentView);
        showDocumentsPanel();
        refreshDocuments();
      };

      const activateReceivedView = () => {
        sidebarLinks.forEach((b) => b.classList.remove('active'));
        showReceivedPanel();
        refreshReceived();
      };

      sidebarLinks.forEach((btn) => {
        btn.addEventListener('click', () => {
          topbarNavLinks.forEach((b) => b.classList.toggle('active', b.getAttribute('data-nav') === (btn.getAttribute('data-view') === '전체' ? 'registry' : 'approval')));
          activateDocumentsView(btn.getAttribute('data-view'));
        });
      });

      receivedSidebarLink.addEventListener('click', () => {
        topbarNavLinks.forEach((b) => b.classList.toggle('active', b.getAttribute('data-nav') === 'received'));
        activateReceivedView();
      });

      topbarNavLinks.forEach((btn) => {
        btn.addEventListener('click', () => {
          topbarNavLinks.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const nav = btn.getAttribute('data-nav');
          if (nav === 'received') { activateReceivedView(); return; }
          if (nav === 'registry') { activateDocumentsView('전체'); return; }
          activateDocumentsView('결재대기'); // 홈 / 결재
        });
      });

      refreshBtn.addEventListener('click', refreshDocuments);

      // ---------- 접수·발송대장 ----------
      const renderReceivedRows = (rows) => {
        const bodyRows = rows.map((row) => `
          <tr>
            <td class="mono center">${row.id}</td>
            <td class="center">${row.direction}</td>
            <td class="doc-table__title">${row.title}</td>
            <td class="center">${row.counterparty}</td>
            <td class="center">${row.source_system || '-'}</td>
            <td class="center">${row.received_at}</td>
          </tr>
        `).join('');

        receivedTable.innerHTML = `
          <table class="doc-table__frame">
            <colgroup>
              <col style="width:170px" /><col style="width:90px" /><col />
              <col style="width:160px" /><col style="width:120px" /><col style="width:110px" />
            </colgroup>
            <thead>
              <tr>
                <th class="center">번호</th><th class="center">구분</th><th>제목</th>
                <th class="center">상대방</th><th class="center">경로</th><th class="center">일자</th>
              </tr>
            </thead>
            <tbody>
              ${bodyRows || `<tr class="doc-table__empty-row"><td colspan="6" class="empty">등록된 기록이 없습니다.</td></tr>`}
            </tbody>
          </table>
        `;
      };

      const refreshReceived = async () => {
        const token = getToken();
        if (!token) return;
        receivedStatus.textContent = '조회 중입니다...';
        const data = await callApi('/api/received/list', {
          token, direction: receivedFilter.value, query: receivedQuery.value.trim(),
        });
        if (!data.ok) { receivedStatus.textContent = data.message || '조회에 실패했습니다.'; return; }
        receivedStatus.textContent = `총 ${data.rows.length}건`;
        renderReceivedRows(data.rows);
      };

      receivedRefreshBtn.addEventListener('click', refreshReceived);

      // ---------- 계정 목록(검토자/결재자 지정용) ----------
      const reviewerSelect = document.querySelector('[data-reviewer-select]');
      const approverSelect = document.querySelector('[data-approver-select]');

      const refreshUserOptions = async () => {
        const token = getToken();
        if (!token) return;
        const data = await callApi('/api/users/list', { token });
        if (!data.ok) return;
        allUsers = data.rows || [];
        reviewerSelect.innerHTML = '<option value="">(선택 안 함)</option>' + allUsers
          .map((u) => `<option value="${u.id}">${u.name}${u.position ? ' · ' + u.position : ''}</option>`).join('');
        approverSelect.innerHTML = '<option value="">결재자를 선택해 주세요</option>' + allUsers
          .filter((u) => u.can_approve)
          .map((u) => `<option value="${u.id}">${u.name}${u.position ? ' · ' + u.position : ''}</option>`).join('');
      };

      // ---------- 문서작성(기안/발송) ----------
      const composeModal = document.querySelector('[data-compose-modal]');
      const openComposeBtn = document.querySelector('[data-open-compose]');
      const composeForm = document.querySelector('[data-compose-form]');
      const categorySelect = document.getElementById('c-category');
      const trackHint = document.querySelector('[data-track-hint]');
      const trackChoice = document.querySelector('[data-track-choice]');
      const recipientField = document.querySelector('[data-recipient-field]');
      const reviewerApproverFields = document.querySelector('[data-reviewer-approver-fields]');
      const approverLabel = document.querySelector('[data-approver-label]');

      categorySelect.innerHTML = allCategories.map((c) => `<option value="${c}">${c}</option>`).join('');
      const departmentSelect = document.querySelector('[data-department-select]');
      departmentSelect.innerHTML = renderDepartmentOptions();
      const userDepartmentSelect = document.querySelector('[data-user-department-select]');
      userDepartmentSelect.innerHTML = renderDepartmentOptions();

      document.querySelectorAll('[data-close-compose]').forEach((btn) =>
        btn.addEventListener('click', () => { composeModal.hidden = true; }));
      openComposeBtn.addEventListener('click', async () => {
        await refreshUserOptions();
        composeModal.hidden = false;
        updatePreview();
      });

      const updateTrackHint = () => {
        const category = categorySelect.value;
        const isImportant = importantCategories.includes(category);
        trackChoice.hidden = !isImportant;
        approverSelect.required = isImportant;
        approverLabel.textContent = isImportant ? '결재자 · 제13조②' : '결재자(전결 — 지정 불필요)';
        trackHint.textContent = isImportant
          ? '중요문서 — 제13조③에 따라 이사장결재 또는 이사회의결이 필요하며, 결재자 지정이 필요합니다.'
          : '경미한 문서 — 제13조④에 따라 등록과 동시에 담당자 전결로 처리됩니다(결재자 지정 불필요).';
      };
      categorySelect.addEventListener('change', () => { updateTrackHint(); updatePreview(); });

      const docTypeRadios = composeForm.querySelectorAll('input[name="docType"]');
      docTypeRadios.forEach((r) => r.addEventListener('change', () => {
        recipientField.hidden = r.form.docType.value !== '발송';
        updatePreview();
      }));

      const findUser = (id) => allUsers.find((u) => u.id === id);

      const updatePreview = () => {
        const formData = new FormData(composeForm);
        const category = formData.get('category');
        const isImportant = importantCategories.includes(category);
        const track = !isImportant ? '전결' : (formData.get('approvalTrackChoice') || '이사장결재');
        const me = getMe() || {};

        document.querySelector('[data-preview-recipient]').textContent =
          formData.get('docType') === '발송' ? (formData.get('recipient') || '(수신처 미입력)') : '(내부결재)';
        const via = formData.get('via') || '';
        document.querySelector('[data-preview-via-row]').hidden = !via;
        document.querySelector('[data-preview-via]').textContent = via || '-';
        document.querySelector('[data-preview-title]').textContent = formData.get('title') || '제목을 입력해 주세요';
        document.querySelector('[data-preview-body]').textContent = formData.get('body') || '본문을 입력해 주세요.';
        document.querySelector('[data-preview-attachments]').textContent = formData.get('attachmentsNote') || '—';
        document.querySelector('[data-preview-track]').textContent = `결재: ${track}`;

        document.querySelector('[data-preview-drafter-name]').textContent = me.name || '-';
        document.querySelector('[data-preview-drafter-position]').textContent = me.position || '-';

        const reviewer = findUser(formData.get('reviewerUserId'));
        document.querySelector('[data-preview-reviewer-row]').hidden = !reviewer;
        document.querySelector('[data-preview-reviewer-name]').textContent = reviewer ? reviewer.name : '-';
        document.querySelector('[data-preview-reviewer-position]').textContent = reviewer ? (reviewer.position || '-') : '-';

        const approver = findUser(formData.get('approverUserId'));
        const showApproverRow = isImportant;
        document.querySelector('[data-preview-approver-row]').hidden = !showApproverRow;
        document.querySelector('[data-preview-approver-name]').textContent = isImportant ? (approver ? approver.name : '-') : me.name || '-';
        document.querySelector('[data-preview-approver-position]').textContent = isImportant ? (approver ? approver.position || '-' : '-') : (me.position || '-');
        document.querySelector('[data-preview-signer]').textContent = isImportant
          ? (approver ? `${approver.position || ''} ${approver.name}`.trim() : '결재자 미지정')
          : `${me.position || '담당자'} ${me.name || ''}`.trim();
      };
      composeForm.addEventListener('input', updatePreview);
      composeForm.addEventListener('change', updatePreview);
      updateTrackHint();

      // ---------- 붙임파일(실제 업로드) ----------
      let pendingAttachmentFiles = [];
      const attachmentFileInput = document.getElementById('c-attachments-file');
      const attachmentPendingList = document.querySelector('[data-attachment-pending-list]');
      const MAX_ATTACHMENT_BYTES = 4 * 1024 * 1024;

      const renderPendingAttachments = () => {
        if (!pendingAttachmentFiles.length) {
          attachmentPendingList.innerHTML = '';
          return;
        }
        attachmentPendingList.innerHTML = pendingAttachmentFiles.map((file, index) => `
          <li class="attachment-pending-list__item">
            <span>${file.name} <span class="muted">(${Math.max(1, Math.round(file.size / 1024))}KB)</span></span>
            <button type="button" data-remove-pending="${index}" aria-label="삭제">×</button>
          </li>
        `).join('');
        attachmentPendingList.querySelectorAll('[data-remove-pending]').forEach((btn) => {
          btn.addEventListener('click', () => {
            pendingAttachmentFiles.splice(Number(btn.getAttribute('data-remove-pending')), 1);
            renderPendingAttachments();
          });
        });
      };

      attachmentFileInput.addEventListener('change', () => {
        const incoming = Array.from(attachmentFileInput.files || []);
        const oversized = incoming.filter((file) => file.size > MAX_ATTACHMENT_BYTES);
        const accepted = incoming.filter((file) => file.size <= MAX_ATTACHMENT_BYTES);
        accepted.forEach((file) => {
          const exists = pendingAttachmentFiles.some((existing) =>
            existing.name === file.name && existing.size === file.size && existing.lastModified === file.lastModified);
          if (!exists) pendingAttachmentFiles.push(file);
        });
        attachmentFileInput.value = '';
        if (oversized.length) {
          statusEl.textContent = `${oversized.map((file) => file.name).join(', ')} 파일은 4MB를 초과해 제외되었습니다.`;
        }
        renderPendingAttachments();
      });

      const readFileAsBase64 = (file) => new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const result = String(reader.result || '');
          const commaIndex = result.indexOf(',');
          resolve(commaIndex >= 0 ? result.slice(commaIndex + 1) : result);
        };
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });

      const uploadPendingAttachments = async (documentId) => {
        const token = getToken();
        for (const file of pendingAttachmentFiles) {
          try {
            const dataBase64 = await readFileAsBase64(file);
            await callApi('/api/documents/upload-attachment', {
              token, documentId, fileName: file.name, mimeType: file.type || 'application/octet-stream', dataBase64,
            });
          } catch (error) {
            statusEl.textContent = `${file.name} 첨부파일 업로드에 실패했습니다.`;
          }
        }
      };

      composeForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();
        const formData = new FormData(composeForm);
        const payload = Object.fromEntries(formData.entries());
        delete payload.attachmentsFile;
        payload.token = token;
        const data = await callApi('/api/documents/create', payload);
        if (!data.ok) { statusEl.textContent = data.message || '등록에 실패했습니다.'; return; }
        if (pendingAttachmentFiles.length) {
          statusEl.textContent = `${data.id} 문서를 등록했습니다. 첨부파일 업로드 중...`;
          await uploadPendingAttachments(data.id);
        }
        composeModal.hidden = true;
        composeForm.reset();
        updateTrackHint();
        recipientField.hidden = true;
        pendingAttachmentFiles = [];
        renderPendingAttachments();
        statusEl.textContent = `${data.id} 문서가 등록되었습니다(${data.status}).`;
        refreshDocuments();
      });

      // ---------- 접수·발송 등록 ----------
      const receivedModal = document.querySelector('[data-received-modal]');
      const openReceivedBtn = document.querySelector('[data-open-received]');
      const receivedForm = document.querySelector('[data-received-form]');
      const counterpartyLabel = document.querySelector('[data-counterparty-label]');

      openReceivedBtn.addEventListener('click', () => { receivedModal.hidden = false; });
      document.querySelectorAll('[data-close-received]').forEach((btn) =>
        btn.addEventListener('click', () => { receivedModal.hidden = true; }));

      receivedForm.querySelectorAll('input[name="direction"]').forEach((r) => r.addEventListener('change', () => {
        counterpartyLabel.textContent = r.form.direction.value === '접수' ? '발신자' : '수신자';
      }));

      receivedForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();
        const formData = new FormData(receivedForm);
        const payload = Object.fromEntries(formData.entries());
        payload.token = token;
        const data = await callApi('/api/received/create', payload);
        if (!data.ok) { receivedStatus.textContent = data.message || '등록에 실패했습니다.'; return; }
        receivedModal.hidden = true;
        receivedForm.reset();
        receivedStatus.textContent = `${data.id} 등록되었습니다.`;
        refreshReceived();
      });

      // ---------- 문서 상세 / 결재 ----------
      const detailModal = document.querySelector('[data-detail-modal]');
      const decideForm = document.querySelector('[data-decide-form]');
      const decideBlocked = document.querySelector('[data-decide-blocked]');
      const sendForm = document.querySelector('[data-send-form]');
      let currentDetailId = null;

      document.querySelectorAll('[data-close-detail]').forEach((btn) =>
        btn.addEventListener('click', () => { detailModal.hidden = true; currentDetailId = null; }));

      const openDetail = async (id) => {
        const token = getToken();
        const data = await callApi('/api/documents/detail', { token, id });
        if (!data.ok) { statusEl.textContent = data.message || '문서를 불러오지 못했습니다.'; return; }
        currentDetailId = id;
        const doc = data.document;
        const me = getMe() || {};

        document.querySelector('[data-detail-title]').textContent = doc.title;
        document.querySelector('[data-detail-meta]').textContent =
          `${doc.id} · ${doc.doc_type} · ${doc.category} · ${doc.approval_track} · 기안자 ${doc.drafter} · 현재 상태: ${doc.status}`;

        const history = data.approvals.map((a) =>
          `<div class="doc-approval-history__item">${a.created_at} · ${a.approver_role || ''} ${a.approver_name} · ${a.action}${a.memo ? ' · ' + a.memo : ''}</div>`
        ).join('') || '<p class="muted">결재 이력이 없습니다.</p>';
        document.querySelector('[data-detail-history]').innerHTML = history;

        const attachmentsEl = document.querySelector('[data-detail-attachments]');
        const attachments = data.attachments || [];
        attachmentsEl.innerHTML = attachments.length
          ? attachments.map((att) => `
              <li class="attachment-list__item">
                <span>${att.file_name} <span class="muted">(${Math.max(1, Math.round((att.size_bytes || 0) / 1024))}KB)</span></span>
                <button type="button" class="btn btn-outline" data-download-attachment="${att.id}">다운로드</button>
              </li>
            `).join('')
          : '<li class="muted">등록된 첨부파일이 없습니다.</li>';
        attachmentsEl.querySelectorAll('[data-download-attachment]').forEach((btn) => {
          btn.addEventListener('click', () => downloadAttachment(btn.getAttribute('data-download-attachment')));
        });

        document.querySelector('[data-detail-preview-number]').textContent = `문서번호 · ${doc.id}`;
        document.querySelector('[data-detail-preview-recipient]').textContent = doc.recipient || '(내부결재)';
        document.querySelector('[data-detail-preview-via-row]').hidden = !doc.via;
        document.querySelector('[data-detail-preview-via]').textContent = doc.via || '-';
        document.querySelector('[data-detail-preview-title]').textContent = doc.title;
        document.querySelector('[data-detail-preview-body]').textContent = doc.body;
        document.querySelector('[data-detail-preview-attachments]').textContent = doc.attachments_note || '—';
        document.querySelector('[data-detail-preview-track]').textContent = `결재: ${doc.approval_track}`;

        document.querySelector('[data-detail-preview-drafter-name]').textContent = doc.drafter || '-';
        document.querySelector('[data-detail-preview-drafter-position]').textContent = doc.drafter_position || '-';

        const hasReviewer = !!doc.reviewer_name;
        document.querySelector('[data-detail-preview-reviewer-row]').hidden = !hasReviewer;
        document.querySelector('[data-detail-preview-reviewer-name]').textContent = doc.reviewer_name || '-';
        document.querySelector('[data-detail-preview-reviewer-position]').textContent = doc.reviewer_position || '-';
        document.querySelector('[data-detail-preview-reviewer-seal]').textContent = doc.status !== '결재대기' && hasReviewer ? '〇' : '　';

        const isRoutine = doc.approval_track === '전결';
        document.querySelector('[data-detail-preview-approver-row]').hidden = false;
        document.querySelector('[data-detail-preview-approver-name]').textContent = doc.approver_name || '-';
        document.querySelector('[data-detail-preview-approver-position]').textContent = doc.approver_position || '-';
        document.querySelector('[data-detail-preview-approver-seal]').textContent = (doc.status === '승인' || doc.status === '발송완료') ? '〇' : '　';
        document.querySelector('[data-detail-preview-signer]').textContent = isRoutine
          ? `${doc.drafter_position || '담당자'} ${doc.drafter}`.trim()
          : `${doc.approver_position || ''} ${doc.approver_name || ''}`.trim();
        document.querySelector('[data-detail-preview-stamp]').style.opacity =
          (doc.status === '승인' || doc.status === '발송완료') ? '1' : '0.25';

        const canDecide = doc.approval_track !== '전결' && doc.status === '결재대기';
        const isMyApproval = me.role === 'admin' || doc.approver_user_id === me.id;
        decideForm.hidden = !(canDecide && isMyApproval);
        decideBlocked.hidden = !(canDecide && !isMyApproval);
        if (canDecide && !isMyApproval) {
          decideBlocked.textContent = `이 문서는 결재자로 지정된 "${doc.approver_name || '지정된 결재자'}(${doc.approver_position || ''})"님만 결재 처리할 수 있습니다.`;
        }
        sendForm.hidden = !(doc.doc_type === '발송' && doc.status === '승인');

        detailModal.hidden = false;
      };

      const downloadAttachment = async (attachmentId) => {
        const token = getToken();
        const data = await callApi('/api/documents/attachment-data', { token, attachmentId });
        if (!data.ok) { statusEl.textContent = data.message || '첨부파일을 불러오지 못했습니다.'; return; }
        try {
          const binary = atob(data.dataBase64);
          const bytes = new Uint8Array(binary.length);
          for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
          const blob = new Blob([bytes], { type: data.mimeType || 'application/octet-stream' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = data.fileName || 'attachment';
          document.body.appendChild(link);
          link.click();
          link.remove();
          setTimeout(() => URL.revokeObjectURL(url), 5000);
        } catch (error) {
          statusEl.textContent = '첨부파일 다운로드 중 오류가 발생했습니다.';
        }
      };

      decideForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const action = event.submitter ? event.submitter.getAttribute('data-action') : '승인';
        const token = getToken();
        const formData = new FormData(decideForm);
        const payload = Object.fromEntries(formData.entries());
        payload.token = token;
        payload.id = currentDetailId;
        payload.action = action;
        const data = await callApi('/api/documents/decide', payload);
        if (!data.ok) { statusEl.textContent = data.message || '결재 처리에 실패했습니다.'; return; }
        detailModal.hidden = true;
        statusEl.textContent = data.message;
        refreshDocuments();
      });

      sendForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();
        const formData = new FormData(sendForm);
        const payload = Object.fromEntries(formData.entries());
        payload.token = token;
        payload.id = currentDetailId;
        const data = await callApi('/api/documents/mark-sent', payload);
        if (!data.ok) { statusEl.textContent = data.message || '발송 처리에 실패했습니다.'; return; }
        detailModal.hidden = true;
        statusEl.textContent = data.message;
        refreshDocuments();
      });

      // ---------- 일괄결재 ----------
      const batchModal = document.querySelector('[data-batch-modal]');
      const batchForm = document.querySelector('[data-batch-form]');
      const batchHint = document.querySelector('[data-batch-hint]');

      openBatchApproveBtn.addEventListener('click', () => {
        if (!selectedIds.size) { statusEl.textContent = '일괄결재할 문서를 먼저 선택해 주세요.'; return; }
        batchHint.textContent = `선택한 ${selectedIds.size}건을 일괄 처리합니다.`;
        batchModal.hidden = false;
      });
      document.querySelectorAll('[data-close-batch]').forEach((btn) =>
        btn.addEventListener('click', () => { batchModal.hidden = true; }));

      batchForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const action = event.submitter ? event.submitter.getAttribute('data-batch-action') : '승인';
        const token = getToken();
        const formData = new FormData(batchForm);
        const payload = Object.fromEntries(formData.entries());
        payload.token = token;
        payload.action = action;
        payload.ids = Array.from(selectedIds);
        const data = await callApi('/api/documents/decide-batch', payload);
        if (!data.ok) { statusEl.textContent = data.message || '일괄 결재 처리에 실패했습니다.'; return; }
        batchModal.hidden = true;
        batchForm.reset();
        statusEl.textContent = data.message;
        refreshDocuments();
      });

      // ---------- 계정관리(관리자) ----------
      const usersModal = document.querySelector('[data-users-modal]');
      const usersTable = document.querySelector('[data-users-table]');
      const userForm = document.querySelector('[data-user-form]');
      const userFormTitle = document.querySelector('[data-user-form-title]');
      const userFormStatus = document.querySelector('[data-user-form-status]');
      const userPasswordLabel = document.querySelector('[data-user-password-label]');
      const userActiveRow = document.querySelector('[data-user-active-row]');
      const userFormSubmit = document.querySelector('[data-user-form-submit]');
      const userFormResetBtn = document.querySelector('[data-user-form-reset]');

      const resetUserForm = () => {
        userForm.reset();
        userForm.elements.id.value = '';
        userFormTitle.textContent = '계정 추가';
        userPasswordLabel.textContent = '비밀번호(8자 이상)';
        userForm.elements.password.required = true;
        userActiveRow.hidden = true;
        userFormSubmit.textContent = '계정 추가';
        userFormStatus.textContent = '';
      };
      userFormResetBtn.addEventListener('click', resetUserForm);

      const renderUsersTable = (rows) => {
        usersTable.innerHTML = `
          <table class="doc-table__frame">
            <thead>
              <tr><th>성명</th><th>아이디</th><th>직책</th><th>직급</th><th>담당부서</th><th class="center">역할</th><th class="center">결재권</th><th class="center">상태</th><th></th></tr>
            </thead>
            <tbody>
              ${rows.map((u) => `
                <tr>
                  <td>${u.name}</td>
                  <td class="mono">${u.username}</td>
                  <td>${u.position || '-'}</td>
                  <td>${u.grade || '-'}</td>
                  <td>${u.department || '-'}</td>
                  <td class="center">${u.role === 'admin' ? '관리자' : '일반'}</td>
                  <td class="center">${u.can_approve ? 'O' : '-'}</td>
                  <td class="center">${u.active ? '활성' : '비활성'}</td>
                  <td class="center"><button type="button" class="btn btn-outline" data-edit-user="${u.id}">수정</button></td>
                </tr>
              `).join('') || '<tr><td colspan="9" class="empty">등록된 계정이 없습니다.</td></tr>'}
            </tbody>
          </table>
        `;
        usersTable.querySelectorAll('[data-edit-user]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const user = rows.find((u) => u.id === btn.getAttribute('data-edit-user'));
            if (!user) return;
            userForm.elements.id.value = user.id;
            userForm.elements.name.value = user.name;
            userForm.elements.username.value = user.username;
            userForm.elements.username.disabled = true;
            userForm.elements.password.value = '';
            userForm.elements.password.required = false;
            userForm.elements.position.value = user.position || '';
            userForm.elements.grade.value = user.grade || '';
            userForm.elements.department.value = user.department || '';
            userForm.elements.role.value = user.role;
            userForm.elements.canApprove.checked = !!user.can_approve;
            userForm.elements.active.checked = !!user.active;
            userActiveRow.hidden = false;
            userFormTitle.textContent = `계정 수정 — ${user.name}`;
            userPasswordLabel.textContent = '새 비밀번호(변경 시에만 입력, 8자 이상)';
            userFormSubmit.textContent = '수정 저장';
            userFormStatus.textContent = '';
          });
        });
      };

      const refreshUsersTable = async () => {
        const token = getToken();
        const data = await callApi('/api/users/list', { token, includeInactive: true });
        if (!data.ok) { userFormStatus.textContent = data.message || '계정 목록을 불러오지 못했습니다.'; return; }
        renderUsersTable(data.rows || []);
      };

      openUsersBtn.addEventListener('click', () => {
        resetUserForm();
        userForm.elements.username.disabled = false;
        usersModal.hidden = false;
        refreshUsersTable();
      });
      document.querySelectorAll('[data-close-users]').forEach((btn) =>
        btn.addEventListener('click', () => { usersModal.hidden = true; }));

      userForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();
        const formData = new FormData(userForm);
        const id = formData.get('id');
        const payload = {
          token,
          name: formData.get('name'),
          username: formData.get('username'),
          password: formData.get('password') || undefined,
          position: formData.get('position'),
          grade: formData.get('grade'),
          department: formData.get('department'),
          role: formData.get('role'),
          canApprove: formData.get('canApprove') === 'on',
        };
        let data;
        if (id) {
          payload.id = id;
          payload.active = formData.get('active') === 'on';
          payload.newPassword = formData.get('password') || undefined;
          data = await callApi('/api/users/update', payload);
        } else {
          data = await callApi('/api/users/create', payload);
        }
        if (!data.ok) { userFormStatus.textContent = data.message || '처리에 실패했습니다.'; return; }
        userFormStatus.textContent = data.message;
        resetUserForm();
        userForm.elements.username.disabled = false;
        refreshUsersTable();
        refreshUserOptions();
      });

      // ---------- 관인·로고(공문서 서식 고정 이미지) ----------
      let orgSealImage = '';
      let orgLogoImage = '';

      const applyBranding = () => {
        document.querySelectorAll('[data-emblem]').forEach((el) => {
          el.innerHTML = orgLogoImage
            ? `<img src="${orgLogoImage}" alt="로고" />`
            : '卍';
        });
        document.querySelectorAll('[data-stamp]').forEach((el) => {
          el.innerHTML = orgSealImage
            ? `<img src="${orgSealImage}" alt="관인" />`
            : '밀교종印';
          el.classList.toggle('stamp-mark--image', !!orgSealImage);
        });
      };

      const loadOrgSettings = async () => {
        const token = getToken();
        if (!token) return;
        const data = await callApi('/api/settings/get', { token });
        if (!data.ok) return;
        orgSealImage = data.sealImage || '';
        orgLogoImage = data.logoImage || '';
        applyBranding();
      };

      const brandingModal = document.querySelector('[data-branding-modal]');
      const openBrandingBtn = document.querySelector('[data-open-branding]');
      const brandingForm = document.querySelector('[data-branding-form]');
      const brandingStatus = document.querySelector('[data-branding-status]');
      const brandingLogoInput = document.getElementById('brand-logo');
      const brandingSealInput = document.getElementById('brand-seal');
      const brandingLogoPreview = document.querySelector('[data-branding-logo-preview]');
      const brandingSealPreview = document.querySelector('[data-branding-seal-preview]');
      let pendingLogoDataUrl = '';
      let pendingSealDataUrl = '';

      const readImageAsDataUrl = (file) => new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });

      const renderBrandingPreviews = () => {
        brandingLogoPreview.innerHTML = (pendingLogoDataUrl || orgLogoImage)
          ? `<img src="${pendingLogoDataUrl || orgLogoImage}" alt="로고 미리보기" />`
          : '<span class="muted">등록된 로고 없음</span>';
        brandingSealPreview.innerHTML = (pendingSealDataUrl || orgSealImage)
          ? `<img src="${pendingSealDataUrl || orgSealImage}" alt="관인 미리보기" />`
          : '<span class="muted">등록된 관인 없음</span>';
      };

      openBrandingBtn.addEventListener('click', () => {
        pendingLogoDataUrl = '';
        pendingSealDataUrl = '';
        brandingStatus.textContent = '';
        renderBrandingPreviews();
        brandingModal.hidden = false;
      });
      document.querySelectorAll('[data-close-branding]').forEach((btn) =>
        btn.addEventListener('click', () => { brandingModal.hidden = true; }));

      brandingLogoInput.addEventListener('change', async () => {
        const file = brandingLogoInput.files && brandingLogoInput.files[0];
        if (!file) return;
        pendingLogoDataUrl = await readImageAsDataUrl(file);
        renderBrandingPreviews();
      });
      brandingSealInput.addEventListener('change', async () => {
        const file = brandingSealInput.files && brandingSealInput.files[0];
        if (!file) return;
        pendingSealDataUrl = await readImageAsDataUrl(file);
        renderBrandingPreviews();
      });

      brandingForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();
        const data = await callApi('/api/settings/save', {
          token, logoImage: pendingLogoDataUrl, sealImage: pendingSealDataUrl,
        });
        if (!data.ok) { brandingStatus.textContent = data.message || '저장에 실패했습니다.'; return; }
        brandingStatus.textContent = data.message;
        await loadOrgSettings();
        renderBrandingPreviews();
        updatePreview();
      });

      // ---------- 조직도 ----------
      const orgchartModal = document.querySelector('[data-orgchart-modal]');
      const openOrgchartBtn = document.querySelector('[data-open-orgchart]');
      const orgchartTree = document.querySelector('[data-orgchart-tree]');
      const orgchartTitle = document.querySelector('[data-orgchart-title]');
      const orgchartMembers = document.querySelector('[data-orgchart-members]');

      const membersOfDepartment = (deptValue) => allUsers.filter((u) => {
        if (!u.department) return false;
        if (u.department === deptValue) return true;
        // 상위 부서를 선택한 경우 하위(소속) 부서 인원까지 함께 보여준다.
        return u.department.startsWith(`${deptValue} - `);
      });

      const showOrgchartMembers = (label, deptValue) => {
        orgchartTitle.textContent = `${label} (${membersOfDepartment(deptValue).length}명)`;
        const members = membersOfDepartment(deptValue);
        orgchartMembers.innerHTML = members.length
          ? members.map((u) => `
              <li class="orgchart-member-list__item">
                <span class="orgchart-member-list__name">${u.name}</span>
                <span class="muted">${u.position || ''}${u.grade ? ' · ' + u.grade : ''}</span>
                <span class="muted">${u.department}</span>
              </li>
            `).join('')
          : '<li class="muted">이 부서에 지정된 인원이 없습니다.</li>';
      };

      const renderOrgchartTree = () => {
        const rows = [];
        departmentTree.forEach((dep) => {
          const count = membersOfDepartment(dep.name).length;
          rows.push(`<button type="button" class="orgchart-tree__dept" data-dept="${dep.name}" data-label="${dep.name}">${dep.name} <span class="sidebar-link__count">${count}</span></button>`);
          (dep.children || []).forEach((child) => {
            const childValue = `${dep.name} - ${child}`;
            const childCount = membersOfDepartment(childValue).length;
            rows.push(`<button type="button" class="orgchart-tree__child" data-dept="${childValue}" data-label="${childValue}">ㄴ ${child} <span class="sidebar-link__count">${childCount}</span></button>`);
          });
        });
        orgchartTree.innerHTML = rows.join('');
        orgchartTree.querySelectorAll('[data-dept]').forEach((btn) => {
          btn.addEventListener('click', () => {
            orgchartTree.querySelectorAll('[data-dept]').forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            showOrgchartMembers(btn.getAttribute('data-label'), btn.getAttribute('data-dept'));
          });
        });
      };

      openOrgchartBtn.addEventListener('click', async () => {
        await refreshUserOptions();
        renderOrgchartTree();
        orgchartTitle.textContent = '부서를 선택해 주세요';
        orgchartMembers.innerHTML = '';
        orgchartModal.hidden = false;
      });
      document.querySelectorAll('[data-close-orgchart]').forEach((btn) =>
        btn.addEventListener('click', () => { orgchartModal.hidden = true; }));

      // ---------- 로그인/로그아웃/최초 관리자 ----------
      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        loginError.hidden = true;
        const formData = new FormData(loginForm);
        const data = await callApi('/api/auth/login', {
          username: formData.get('username'), password: formData.get('password'),
        });
        if (!data.ok) {
          loginError.hidden = false;
          loginError.textContent = data.message || '로그인에 실패했습니다.';
          return;
        }
        setSession({ token: data.token, user: data.user });
        showApp();
        await refreshUserOptions();
        await loadOrgSettings();
        activateDocumentsView('결재대기');
      });

      bootstrapForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        bootstrapError.hidden = true;
        bootstrapOk.hidden = true;
        const formData = new FormData(bootstrapForm);
        const data = await callApi('/api/auth/bootstrap', {
          adminToken: formData.get('adminToken'),
          name: formData.get('name'),
          username: formData.get('username'),
          password: formData.get('password'),
          position: formData.get('position'),
        });
        if (!data.ok) {
          bootstrapError.hidden = false;
          bootstrapError.textContent = data.message || '계정 생성에 실패했습니다.';
          return;
        }
        bootstrapOk.hidden = false;
        bootstrapOk.textContent = data.message;
        document.getElementById('login-username').value = formData.get('username');
      });

      logoutBtn.addEventListener('click', async () => {
        const token = getToken();
        clearSession();
        showLogin();
        if (token) callApi('/api/auth/logout', { token });
      });

      if (getToken()) {
        showApp();
        refreshUserOptions().then(() => activateDocumentsView('결재대기'));
        loadOrgSettings();
      } else {
        showLogin();
      }
    })();
  </script>

  <style>
    /* hidden 속성을 가진 요소는 아래의 display 규칙들보다 항상 우선해서 안 보여야 합니다.
       이 규칙이 없으면 로그인 화면·모달창들이 hidden 상태여도 계속 화면에 나타납니다. */
