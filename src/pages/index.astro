---
import GovLayout from '../layouts/GovLayout.astro';
---
<GovLayout>
  <!-- 로그인 -->
  <div class="login-screen" data-login-screen>
    <div class="login-card">
      <img class="login-card__logo" src="/logo.png" alt="대한불교밀교종 로고" />
      <p class="login-card__kicker">사단법인 대한불교밀교종</p>
      <h1>대한불교밀교종 종단관리시스템</h1>
      <p class="login-card__desc">문서등록대장 · 전자결재 · 접수발송대장</p>
      <form data-login-form>
        <label for="login-username">아이디</label>
        <input id="login-username" name="username" type="text" autocomplete="username" required />
        <label for="login-password">비밀번호</label>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required />
        <button type="submit" class="btn btn-primary btn-block">로그인</button>
        <p class="login-card__error" data-login-error hidden></p>
      </form>
      <button type="button" class="login-card__toggle" data-toggle-bootstrap>최초 관리자 계정이 아직 없으신가요?</button>

      <form class="login-card__bootstrap" data-bootstrap-form hidden>
        <p class="hint">Cloudflare Pages 환경변수에 등록한 ADMIN_TOKEN(마스터 키)을 아는 분만 최초 관리자 계정을 만들 수 있습니다.</p>
        <label for="bs-admin-token">마스터 키(ADMIN_TOKEN)</label>
        <input id="bs-admin-token" name="adminToken" type="password" required />
        <label for="bs-name">성명</label>
        <input id="bs-name" name="name" type="text" maxlength="40" required />
        <label for="bs-username">로그인 아이디</label>
        <input id="bs-username" name="username" type="text" maxlength="60" required />
        <label for="bs-password">비밀번호(8자 이상)</label>
        <input id="bs-password" name="password" type="password" minlength="8" required />
        <label for="bs-position">직책(선택)</label>
        <input id="bs-position" name="position" type="text" maxlength="40" placeholder="예: 이사장" />
        <button type="submit" class="btn btn-primary btn-block">관리자 계정 만들기</button>
        <p class="login-card__error" data-bootstrap-error hidden></p>
        <p class="login-card__error login-card__error--ok" data-bootstrap-ok hidden></p>
      </form>
      <p class="login-card__help">권한이 필요한 경우 사무국으로 문의하시기 바랍니다.</p>
    </div>
  </div>

  <!-- 앱 셸 -->
  <div class="app-shell" data-app-shell>
    <header class="app-topbar">
      <button type="button" class="app-topbar__menu-toggle" data-toggle-sidebar aria-label="메뉴 접기">☰</button>
      <button type="button" class="app-topbar__brand" data-go-home aria-label="대한불교밀교종 종단관리시스템 홈으로 이동">
        <img class="app-topbar__logo" src="/logo.png" alt="대한불교밀교종 로고" data-topbar-logo />
        <span class="app-topbar__brand-title">
          <img class="app-topbar__wordmark" src="/brand-wordmark.png" alt="대한불교밀교종" />
          <span class="app-topbar__system-name">종단관리시스템</span>
        </span>
      </button>
      <nav class="app-topbar__menu">
        <button type="button" class="app-topbar__link active" data-nav="home">홈</button>
        <button type="button" class="app-topbar__link" data-nav="approval">결재</button>
        <button type="button" class="app-topbar__link" data-nav="registry">문서대장</button>
        <button type="button" class="app-topbar__link" data-nav="received">접수·발송</button>
        <a class="app-topbar__link app-topbar__link--anchor" href="/accounting">회계관리</a>
      </nav>
      <div class="app-topbar__right">
        <span class="app-topbar__me" data-me-label hidden></span>
        <button type="button" class="btn btn-ghost" data-open-templates hidden>서식관리</button>
        <button type="button" class="btn btn-ghost" data-open-users hidden>계정관리</button>
        <button type="button" class="btn btn-ghost" data-open-orgchart>조직도</button>
        <button type="button" class="btn btn-ghost" data-logout>로그아웃</button>
      </div>
    </header>

    <div class="app-body">
      <aside class="app-sidebar">
        <section class="sidebar-profile" aria-label="로그인 계정 정보">
          <div class="sidebar-profile__row"><span>이름</span><strong data-me-name>-</strong></div>
          <div class="sidebar-profile__row"><span>직책</span><strong data-me-position>-</strong></div>
          <div class="sidebar-profile__row"><span>1차부서</span><strong data-me-department-primary>-</strong></div>
          <div class="sidebar-profile__row sidebar-profile__row--secondary" data-me-department-secondary-row hidden><span>2차부서</span><strong data-me-department-secondary>-</strong></div>
        </section>
        <button type="button" class="btn btn-primary btn-block sidebar-compose" data-open-compose>+ 문서작성</button>

        <div class="sidebar-group">
          <p class="sidebar-group__title">회계</p>
          <a class="sidebar-link sidebar-external-link" href="/accounting">예산·결의·장부·결산</a>
        </div>

        <div class="sidebar-group">
          <p class="sidebar-group__title">전자문서</p>
          <button type="button" class="sidebar-link" data-view="임시저장">
            임시저장함 <span class="sidebar-link__count" data-count="임시저장">0</span>
          </button>
          <button type="button" class="sidebar-link" data-view="진행">
            진행문서함 <span class="sidebar-link__count" data-count="진행">0</span>
          </button>
          <button type="button" class="sidebar-link active" data-view="결재대기">
            결재대기함 <span class="sidebar-link__count" data-count="결재대기">0</span>
          </button>
          <button type="button" class="sidebar-link" data-view="발송대기">
            발송대기함 <span class="sidebar-link__count" data-count="발송대기">0</span>
          </button>
          <button type="button" class="sidebar-link" data-view="전체">문서등록대장</button>
        </div>

        <div class="sidebar-group">
          <p class="sidebar-group__title">처리한문서</p>
          <button type="button" class="sidebar-link" data-view="완료">완료문서함</button>
          <button type="button" class="sidebar-link" data-view="반려">반려문서함</button>
        </div>

        <div class="sidebar-group">
          <p class="sidebar-group__title">접수·외부발송(문서24 등)</p>
          <button type="button" class="sidebar-link" data-received-view="전체">접수·발송대장</button>
          <a class="sidebar-link sidebar-external-link" href="https://docu.gdoc.go.kr/" target="_blank" rel="noopener noreferrer">문서24 바로가기</a>
          <button type="button" class="btn btn-outline btn-block" data-open-received>+ 접수·발송 등록</button>
        </div>
      </aside>

      <main class="app-main">
        <!-- 홈 대시보드 -->
        <section data-panel="home" class="home-panel">
          <div class="home-heading">
            <div><p class="home-kicker">ELECTRONIC DOCUMENT</p><h2>종단 전자문서 업무현황</h2><p>내부결재와 문서등록 현황을 한 화면에서 확인합니다.</p></div>
            <div class="home-quick-actions">
              <button type="button" class="btn btn-primary" data-home-compose>문서작성</button>
              <button type="button" class="btn btn-outline" data-home-received>접수·발송 등록</button>
            </div>
          </div>
          <div class="system-warning" data-r2-warning hidden><strong>첨부파일 저장소 확인 필요</strong><span>R2 버킷이 연결되지 않아 1.2MB를 넘는 첨부파일을 저장할 수 없습니다. Pages 프로젝트에 <b>FILES</b> 이름으로 R2 버킷을 바인딩해 주세요.</span></div>
          <div class="home-stats" data-home-stats>
            <button type="button" class="home-stat" data-home-view="결재대기"><span>결재대기</span><strong data-home-count="pending">0</strong><small>내가 처리할 문서</small></button>
            <button type="button" class="home-stat" data-home-view="진행"><span>진행문서</span><strong data-home-count="progress">0</strong><small>상신 후 진행 중</small></button>
            <button type="button" class="home-stat" data-home-view="임시저장"><span>임시저장</span><strong data-home-count="draft">0</strong><small>작성 중 문서</small></button>
            <button type="button" class="home-stat" data-home-view="발송대기"><span>발송대기</span><strong data-home-count="send">0</strong><small>승인 후 발송할 문서</small></button>
            <button type="button" class="home-stat" data-home-view="완료"><span>완료문서</span><strong data-home-count="complete">0</strong><small>승인·완료 문서</small></button>
            <button type="button" class="home-stat" data-home-registry><span>접수·발송</span><strong data-home-count="received">0</strong><small>수동 등록 대장</small></button>
          </div>
          <div class="home-grid">
            <section class="home-card"><div class="home-card__header"><h3>최근 처리 문서</h3><button type="button" class="text-button" data-home-all-docs>문서등록대장 보기</button></div><div class="home-list" data-home-recent-docs><p class="muted">불러오는 중입니다...</p></div></section>
            <section class="home-card"><div class="home-card__header"><h3>최근 접수·발송 등록</h3><button type="button" class="text-button" data-home-all-received>접수·발송대장 보기</button></div><div class="home-list" data-home-recent-received><p class="muted">불러오는 중입니다...</p></div></section>
          </div>
        </section>

        <!-- 문서 목록 화면 -->
        <section data-panel="documents" class="content-section" hidden>
          <div class="panel-header">
            <h2 data-panel-title>결재대기함</h2>
            <div class="panel-header__tools panel-filter-grid">
              <select data-doc-type-filter><option value="">전체 문서구분</option><option value="기안">기안</option><option value="발송">발송</option></select>
              <select data-category-filter><option value="">전체 분류</option></select>
              <input type="date" data-date-from aria-label="시작일" />
              <span class="filter-separator">~</span>
              <input type="date" data-date-to aria-label="종료일" />
              <input type="search" data-query placeholder="문서번호, 제목, 기안자, 부서 검색" />
              <select data-sort><option value="newest">최신순</option><option value="oldest">과거순</option><option value="updated">최근처리순</option><option value="title">제목순</option></select>
              <select data-page-size><option value="10">10개</option><option value="20" selected>20개</option><option value="50">50개</option><option value="100">100개</option></select>
              <button type="button" class="btn btn-outline" data-refresh>조회</button>
              <button type="button" class="btn btn-outline" data-export-docs>CSV</button>
            </div>
          </div>
          <div class="panel-status" data-status aria-live="polite"></div>
          <div class="list-toolbar" data-list-toolbar hidden>
            <label class="list-toolbar__select-all">
              <input type="checkbox" data-select-all />
              전체선택
            </label>
            <span class="list-toolbar__count"><span data-selected-count>0</span>건 선택됨</span>
            <button type="button" class="btn btn-primary" data-open-batch-approve>일괄결재</button>
          </div>
          <div class="doc-table" data-doc-table></div>
          <div class="pagination" data-doc-pagination></div>
        </section>

        <!-- 접수·발송대장 화면 -->
        <section data-panel="received" class="content-section" hidden>
          <div class="panel-header">
            <h2>접수·발송대장</h2>
            <div class="panel-header__tools panel-filter-grid">
              <select data-received-filter><option value="전체">전체</option><option value="접수">접수</option><option value="외부발송">외부발송</option></select>
              <input type="date" data-received-date-from aria-label="시작일" />
              <span class="filter-separator">~</span>
              <input type="date" data-received-date-to aria-label="종료일" />
              <input type="search" data-received-query placeholder="번호, 제목, 상대기관, 경로 검색" />
              <select data-received-sort><option value="newest">최신순</option><option value="oldest">과거순</option><option value="title">제목순</option></select>
              <select data-received-page-size><option value="10">10개</option><option value="20" selected>20개</option><option value="50">50개</option><option value="100">100개</option></select>
              <button type="button" class="btn btn-outline" data-received-refresh>조회</button>
              <button type="button" class="btn btn-outline" data-export-received>CSV</button>
            </div>
          </div>
          <div class="panel-status" data-received-status aria-live="polite"></div>
          <div class="doc-table" data-received-table></div>
          <div class="pagination" data-received-pagination></div>
        </section>
      </main>
    </div>
  </div>

  <!-- 문서작성(기안/발송) — 좌: 입력폼 / 우: 공문서 실시간 미리보기 -->
  <div class="modal-overlay" data-compose-modal hidden>
    <div class="modal modal--wide">
      <div class="modal__header">
        <h2>문서작성</h2>
        <button type="button" class="modal__close" data-close-compose aria-label="닫기">×</button>
      </div>
      <div class="compose-layout">
        <form class="compose-form" data-compose-form>
          <input type="hidden" name="documentId" data-compose-document-id />
          <input type="hidden" name="clientRequestId" data-compose-request-id />
          <fieldset class="compose-fieldset compose-fieldset--template">
            <legend>문서 서식</legend>
            <label for="c-template">서식 선택</label>
            <div class="template-select-row"><select id="c-template" name="templateId" data-template-select><option value="">서식 없이 작성</option></select><button type="button" class="btn btn-outline btn-sm" data-open-templates-from-compose hidden>서식 추가·관리</button></div>
            <p class="hint" data-template-description>서식을 선택하면 항목과 본문 구조가 자동으로 적용됩니다.</p>
          </fieldset>
          <fieldset class="compose-fieldset">
            <legend>① 문서 종류</legend>
            <label>문서구분</label>
            <div class="radio-row">
              <label><input type="radio" name="docType" value="기안" checked /> 기안(내부)</label>
              <label><input type="radio" name="docType" value="발송" /> 발송(대외)</label>
            </div>

            <label for="c-category">문서분류(과제카드명) · 제13조③</label>
            <select id="c-category" name="category"></select>
            <p class="hint" data-track-hint></p>
            <div class="radio-row" data-track-choice hidden>
              <label><input type="radio" name="approvalTrackChoice" value="이사장결재" checked /> 이사장 결재</label>
              <label><input type="radio" name="approvalTrackChoice" value="이사회의결" /> 이사회 의결</label>
            </div>
          </fieldset>

          <fieldset class="compose-fieldset">
            <legend>② 결재라인 지정</legend>
            <label for="c-summary">문서요지(선택)</label>
            <input id="c-summary" name="summary" type="text" maxlength="200" placeholder="보고내용을 한 줄로 요약해 주세요." />

            <div data-reviewer-approver-fields>
              <div class="approval-picker">
                <div class="approval-picker__heading"><label for="c-cooperator">협조자(선택 · 복수 지정 가능)</label><small>지정 순서대로 먼저 협조합니다.</small></div>
                <div class="approval-picker__controls"><select id="c-cooperator" data-cooperator-select></select><button type="button" class="btn btn-outline btn-sm" data-add-cooperator>추가</button></div>
                <div class="approval-picker__list" data-cooperator-list><span class="muted">지정된 협조자가 없습니다.</span></div>
              </div>

              <div class="approval-picker">
                <div class="approval-picker__heading"><label for="c-reviewer">검토자(선택 · 복수 지정 가능)</label><small>협조 완료 후 지정 순서대로 검토합니다.</small></div>
                <div class="approval-picker__controls"><select id="c-reviewer" data-reviewer-select></select><button type="button" class="btn btn-outline btn-sm" data-add-reviewer>추가</button></div>
                <div class="approval-picker__list" data-reviewer-list><span class="muted">지정된 검토자가 없습니다.</span></div>
              </div>

              <label>최종 처리방식</label>
              <div class="radio-row approval-mode-row">
                <label><input type="radio" name="approvalMode" value="결재" checked /> 결재</label>
                <label><input type="radio" name="approvalMode" value="전결" /> 전결</label>
              </div>

              <label for="c-approver" data-approver-label>결재자 · 제13조②</label>
              <select id="c-approver" name="approverUserId" data-approver-select></select>
            </div>

            <label for="c-department">담당부서(선택)</label>
            <select id="c-department" name="department" data-department-select></select>

            <label for="c-access-scope">열람범위</label>
            <select id="c-access-scope" name="accessScope"><option value="전체">전체 구성원</option><option value="관련자">기안자·검토자·협조자·결재자·관리자만</option></select>

            <label>발신명의 표시(선택)</label>
            <div class="signer-option-row">
              <label class="inline-check"><input type="checkbox" name="issueSignerEnabled" data-issue-signer-enabled /> 직함·성명 표시</label>
              <div class="signer-option-fields" data-issue-signer-fields hidden>
                <input name="issueSignerPosition" type="text" maxlength="40" placeholder="직함(예: 이사장)" />
                <input name="issueSignerName" type="text" maxlength="40" placeholder="성명" />
              </div>
            </div>
          </fieldset>

          <fieldset class="compose-fieldset" data-template-fields-section hidden>
            <legend>③ 서식 입력항목</legend>
            <div class="template-fields-grid" data-template-fields></div>
          </fieldset>

          <fieldset class="compose-fieldset">
            <legend>④ 수신·본문</legend>
            <div data-recipient-field hidden>
              <label for="c-recipient">수신</label>
              <input id="c-recipient" name="recipient" type="text" maxlength="100" placeholder="예: OO시청 / OOO 귀하" />
            </div>

            <label for="c-via">경유(선택)</label>
            <input id="c-via" name="via" type="text" maxlength="100" placeholder="경유기관이 있는 경우에만 입력" />

            <label for="c-title">제목</label>
            <input id="c-title" name="title" type="text" maxlength="200" required />

            <label for="c-body">본문</label>
            <textarea id="c-body" name="body" rows="7" required></textarea>
          </fieldset>

          <fieldset class="compose-fieldset">
            <legend>⑤ 붙임파일</legend>
            <label for="c-attachments-note">붙임 설명(선택)</label>
            <input id="c-attachments-note" name="attachmentsNote" type="text" maxlength="400" placeholder="예: 사업계획서 1부." />

            <label for="c-attachments-file" class="file-drop-label">붙임파일(선택, 파일당 4MB 이하)</label>
            <input id="c-attachments-file" name="attachmentsFile" type="file" multiple />
            <ul class="attachment-pending-list" data-attachment-pending-list></ul>
          </fieldset>

          <div class="compose-form__actions compose-form__actions--sticky">
            <button type="button" class="btn btn-outline" data-close-compose>취소</button>
            <button type="submit" class="btn btn-outline" data-save-mode="draft">임시저장</button>
            <button type="submit" class="btn btn-primary" data-save-mode="submit">상신</button>
          </div>
        </form>

        <div class="compose-preview">
          <div class="compose-preview__toolbar">
            <span class="compose-preview__label">공문서 미리보기</span>
            <button type="button" class="btn btn-outline btn-sm" data-open-branding>관인·로고 관리</button>
          </div>
          <div class="official-doc" data-official-doc="preview">
            <div class="official-doc__masthead">
              <div class="official-doc__brand">
