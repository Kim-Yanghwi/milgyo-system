  <script is:inline define:vars={{
    importantCategories: [
      '주무관청 제출자료',
      '법인 설립·변경·등기·허가·신고 관련 문서',
      '정관·내부규정 제·개정 자료',
      '총회·이사회 안건 및 의사록',
      '예산·결산·사업계획·사업실적 관련 문서',
      '계약서·협약서·양해각서 및 재산 관련 문서',
      '인사·보수·위촉·해촉·징계 관련 문서',
      '후원금·보시금·목적지정 기부금 관련 중요 문서',
      '법인의 공식 입장 또는 대외 발표자료',
      '그 밖에 법인의 권리·의무에 중요한 영향을 미치는 문서',
    ],
    routineCategory: '일반(경미한 내부보고·단순사무 — 전결대상)',
  }}>
    (function () {
      'use strict';
      const STORAGE_KEY = 'milgyo-system-session';
      const CLIENT_SESSION_TTL_MS = 12 * 60 * 60 * 1000;
      const allCategories = importantCategories.concat([routineCategory]);
      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
      const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
      const getSession = () => {
        try {
          let raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) {
            const legacyRaw = sessionStorage.getItem(STORAGE_KEY);
            if (legacyRaw) {
              const legacy = JSON.parse(legacyRaw);
              raw = JSON.stringify({ ...legacy, savedAt: Date.now() });
              localStorage.setItem(STORAGE_KEY, raw);
              sessionStorage.removeItem(STORAGE_KEY);
            }
          }
          const session = JSON.parse(raw || 'null');
          if (!session?.token || !session?.user) return null;
          const savedAt = Number(session.savedAt || 0);
          if (!savedAt || Date.now() - savedAt > CLIENT_SESSION_TTL_MS) {
            localStorage.removeItem(STORAGE_KEY);
            sessionStorage.removeItem(STORAGE_KEY);
            return null;
          }
          return session;
        } catch {
          return null;
        }
      };
      const setSession = (session) => {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...session, savedAt: Date.now() }));
        sessionStorage.removeItem(STORAGE_KEY);
      };
      const clearSession = () => {
        localStorage.removeItem(STORAGE_KEY);
        sessionStorage.removeItem(STORAGE_KEY);
      };
      const getToken = () => getSession()?.token || '';
      const getMe = () => getSession()?.user || null;
      const randomRequestId = () => `REQ-${Date.now()}-${crypto.getRandomValues(new Uint32Array(2)).join('-')}`;
      const formatDate = (value) => value ? String(value).slice(0, 10) : '-';
      const formatDateTime = (value) => value ? new Date(value).toLocaleString('ko-KR') : '-';
      const formatNumber = (value) => Number(value || 0).toLocaleString('ko-KR');
      const todayKst = () => new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
      const currentKstYear = () => Number(todayKst().slice(0, 4));

      const callApi = async (path, body) => {
        try {
          const response = await fetch(path, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(body),
          });
          const raw = await response.text();
          let data;
          try {
            data = raw ? JSON.parse(raw) : { ok: response.ok };
          } catch {
            data = { ok: false, message: `서버 응답 형식이 올바르지 않습니다. (HTTP ${response.status})` };
          }
          if (!response.ok && data.ok !== false) {
            data = { ok: false, message: data.message || `서버 요청에 실패했습니다. (HTTP ${response.status})` };
          }
          if (response.status === 401) { clearSession(); showLogin(); }
          return data;
        } catch (error) {
          console.error('API request failed', path, error);
          return { ok: false, message: '네트워크 연결 또는 서버 상태를 확인해 주세요.' };
        }
      };

      const departmentTree = [
        { name: '이사장' }, { name: '이사회' }, { name: '감사' }, { name: '종정' },
        { name: '사무국', children: ['재정·회계', '준법·윤리', '대외협력·사회공헌', '문화·홍보'] },
        { name: '총무원' }, { name: '교육·포교원' },
        { name: '소속기관·교구', children: ['람림불교교육원', '서울·인천·경기교구', '강원교구', '대전·세종·충남교구', '충북교구', '전남광주·전북교구', '대구·경북교구', '부산·울산·경남교구', '제주교구'] },
        { name: '위원회·신도단체', children: ['신도회', '사찰운영위원회'] },
      ];
      const renderDepartmentOptions = () => '<option value="">담당부서 선택(선택)</option>' + departmentTree.map((dep) => {
        if (!dep.children) return `<option value="${esc(dep.name)}">${esc(dep.name)}</option>`;
        return `<optgroup label="${esc(dep.name)}"><option value="${esc(dep.name)}">${esc(dep.name)}(전체)</option>${dep.children.map((child) => `<option value="${esc(dep.name)} - ${esc(child)}">　ㄴ ${esc(child)}</option>`).join('')}</optgroup>`;
      }).join('');
      const resolveDepartmentPath = (value) => {
        const text = String(value || '').trim();
        if (!text) return { primary: '-', secondary: '' };
        const parts = text.split(/\s+-\s+/).map((part) => part.trim()).filter(Boolean);
        if (parts.length > 1) return { primary: parts[0], secondary: parts.slice(1).join(' - ') };
        const parent = departmentTree.find((dep) => Array.isArray(dep.children) && dep.children.includes(text));
        return parent ? { primary: parent.name, secondary: text } : { primary: text, secondary: '' };
      };

      const loginScreen = $('[data-login-screen]');
      const appShell = $('[data-app-shell]');
      const loginForm = $('[data-login-form]');
      const loginError = $('[data-login-error]');
      const bootstrapForm = $('[data-bootstrap-form]');
      const bootstrapError = $('[data-bootstrap-error]');
      const bootstrapOk = $('[data-bootstrap-ok]');
      const meLabel = $('[data-me-label]');
      const meName = $('[data-me-name]');
      const mePosition = $('[data-me-position]');
      const meDepartmentPrimary = $('[data-me-department-primary]');
      const meDepartmentSecondary = $('[data-me-department-secondary]');
      const meDepartmentSecondaryRow = $('[data-me-department-secondary-row]');
      const openUsersBtn = $('[data-open-users]');
      const openTemplatesBtn = $('[data-open-templates]');
      const openTemplatesFromComposeBtn = $('[data-open-templates-from-compose]');

      const markAuthReady = () => {
        document.documentElement.classList.remove('auth-boot');
        document.documentElement.classList.add('auth-ready');
      };
      const showLogin = () => {
        loginScreen.hidden = false;
        appShell.hidden = true;
        document.documentElement.dataset.authHint = 'login';
        markAuthReady();
      };
      const showApp = () => {
        loginScreen.hidden = true; appShell.hidden = false;
        document.documentElement.dataset.authHint = 'session';
        markAuthReady();
        const me = getMe();
        if (me) {
          meLabel.textContent = `${me.name}${me.position ? ' · ' + me.position : ''}`;
          meName.textContent = me.name || '-';
          mePosition.textContent = me.position || '-';
          const departmentPath = resolveDepartmentPath(me.department);
          meDepartmentPrimary.textContent = departmentPath.primary;
          meDepartmentSecondary.textContent = departmentPath.secondary || '-';
          meDepartmentSecondaryRow.hidden = !departmentPath.secondary;
          const admin = me.role === 'admin';
          openUsersBtn.hidden = !admin;
          openTemplatesBtn.hidden = !admin;
          openTemplatesFromComposeBtn.hidden = !admin;
          const brandingButton = $('[data-open-branding]'); if (brandingButton) brandingButton.hidden = !admin;
        }
      };
      $('[data-toggle-bootstrap]').addEventListener('click', () => { bootstrapForm.hidden = !bootstrapForm.hidden; });
      window.addEventListener('storage', (event) => {
        if (event.key !== STORAGE_KEY) return;
        if (getToken()) {
          showApp();
          activateHome();
          Promise.all([refreshUserOptions(), refreshTemplates(), loadOrgSettings()]).catch((error) => console.error('탭 동기화 데이터 로드 실패', error));
        } else {
          showLogin();
        }
      });

      let allUsers = [];
      let allTemplates = [];
      let currentRows = [];
      let currentReceivedRows = [];
      let sendQueueDocuments = [];
      let currentView = '결재대기';
      let docPage = 1;
      let receivedPage = 1;
      let selectedIds = new Set();
      let currentDetailId = null;
      let currentDetailDoc = null;
      let currentDetailApprovalLines = [];
      let currentReceivedDetailId = null;
      let currentReceivedDetailDoc = null;
      let selectedReviewerIds = [];
      let selectedCooperatorIds = [];

      const userOptionLabel = (u) => `${u.name}${u.position ? ' · ' + u.position : ''}${u.department ? ' · ' + u.department : ''}`;
      const refreshUserOptions = async () => {
        const data = await callApi('/api/users/list', { token: getToken() });
        if (!data.ok) return;
        allUsers = data.rows || [];
        const reviewer = $('[data-reviewer-select]');
        const cooperator = $('[data-cooperator-select]');
        const approver = $('[data-approver-select]');
        const personOptions = allUsers.map((u) => `<option value="${esc(u.id)}">${esc(userOptionLabel(u))}</option>`).join('');
        reviewer.innerHTML = '<option value="">검토자를 선택해 주세요</option>' + personOptions;
        cooperator.innerHTML = '<option value="">협조자를 선택해 주세요</option>' + personOptions;
        const me = getMe() || {};
        const finalUsers = allUsers.filter((u) => u.can_approve || u.id === me.id);
        approver.innerHTML = '<option value="">최종 처리자를 선택해 주세요</option>' + finalUsers.map((u) => `<option value="${esc(u.id)}">${esc(userOptionLabel(u))}</option>`).join('');
        renderApprovalPickers();
        updateApprovalMode();
      };

      const templateGroupName = (template) => {
        if (!template?.is_system) return '사용자 서식';
        const id = String(template.id || '');
        if (id === 'TPL-GENERAL') return '일반·업무';
        if (id.startsWith('TPL-EXPENSE-') || id.startsWith('TPL-FIN-')) return '재무·회계';
        if (id.startsWith('TPL-DONATION-')) return '후원·기부금';
        if (id.startsWith('TPL-FACILITY-') || id.startsWith('TPL-CONTRACT-')) return '시설·계약';
        if (id.startsWith('TPL-SAFETY-') || id.startsWith('TPL-INSURANCE-') || id.startsWith('TPL-ACCIDENT-') || id.startsWith('TPL-RECURRENCE-')) return '안전·보험';
        if (id.startsWith('TPL-EDUCATION-') || id.startsWith('TPL-APPOINTMENT-') || id.startsWith('TPL-DISMISSAL-') || id.startsWith('TPL-LEAVE-')) return '교육·인사';
        if (id.startsWith('TPL-EVENT-')) return '법회·의례·수행';
        if (id.startsWith('TPL-SEAL-') || id.startsWith('TPL-DOCUMENT-') || id.startsWith('TPL-HANDOVER')) return '문서·인장';
        if (id.startsWith('TPL-MEETING-')) return '회의';
        if (id.startsWith('TPL-ETHICS-') || id.startsWith('TPL-DISCIPLINE-')) return '윤리·징계';
        return '기타 기본서식';
      };
      const templateGroupOrder = ['일반·업무', '재무·회계', '후원·기부금', '시설·계약', '안전·보험', '교육·인사', '법회·의례·수행', '문서·인장', '회의', '윤리·징계', '기타 기본서식', '사용자 서식'];
      const renderTemplateSelectOptions = (templates) => {
        const grouped = new Map();
        for (const template of templates.filter((item) => item.active)) {
          const group = templateGroupName(template);
          if (!grouped.has(group)) grouped.set(group, []);
          grouped.get(group).push(template);
        }
        return templateGroupOrder.filter((group) => grouped.has(group)).map((group) => `<optgroup label="${esc(group)}">${grouped.get(group).map((template) => `<option value="${esc(template.id)}">${esc(template.name)}${template.is_system ? ' · 기본' : ''}</option>`).join('')}</optgroup>`).join('');
      };
      const refreshTemplates = async (includeInactive = false) => {
        const data = await callApi('/api/templates/list', { token: getToken(), includeInactive });
        if (!data.ok) return data;
        allTemplates = data.rows || [];
        const select = $('[data-template-select]');
        const previous = select.value;
        select.innerHTML = '<option value="">서식 없이 작성</option>' + renderTemplateSelectOptions(allTemplates);
        if (allTemplates.some((t) => t.id === previous && t.active)) select.value = previous;
        renderTemplateList();
        return data;
      };

      const categoryFilter = $('[data-category-filter]');
      const templateCategory = $('[data-template-category]');
      categoryFilter.innerHTML = '<option value="">전체 분류</option>' + allCategories.map((c) => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
      templateCategory.innerHTML = allCategories.map((c) => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
      $('[data-department-select]').innerHTML = renderDepartmentOptions();
      $('[data-user-department-select]').innerHTML = renderDepartmentOptions();
      $('[data-received-department-select]').innerHTML = renderDepartmentOptions();

      // 문서 목록
      const viewLabels = { 임시저장: '임시저장함', 진행: '진행문서함', 결재대기: '결재대기함', 발송대기: '발송대기함', 전체: '문서등록대장', 완료: '완료문서함', 반려: '반려문서함' };
      const panelHome = $('[data-panel="home"]');
      const panelDocuments = $('[data-panel="documents"]');
      const panelReceived = $('[data-panel="received"]');
      const docTable = $('[data-doc-table]');
      const statusEl = $('[data-status]');
      const listToolbar = $('[data-list-toolbar]');
      const selectAll = $('[data-select-all]');
      const selectedCount = $('[data-selected-count]');

      const updateSelection = () => {
        selectedCount.textContent = String(selectedIds.size);
        const enabled = $$('[data-row-select]:not(:disabled)', docTable);
        selectAll.checked = enabled.length > 0 && enabled.every((box) => box.checked);
      };
      const canSelectRow = (row) => {
        if (currentView !== '결재대기' || !['검토대기', '협조대기', '결재대기', '전결대기'].includes(row.status)) return false;
        const me = getMe() || {};
        if (me.role === 'admin') return true;
        if (row.current_actor_user_id) return row.current_actor_user_id === me.id;
        return row.status === '검토대기' ? row.reviewer_user_id === me.id : row.approver_user_id === me.id;
      };
      const renderDocumentRows = (rows) => {
        currentRows = rows;
        const queueMode = currentView === '결재대기';
        listToolbar.hidden = !queueMode;
        selectedIds = new Set();
        const body = rows.map((row) => `
          <tr data-doc-id="${esc(row.id)}">
            ${queueMode ? `<td class="doc-table__select" data-no-open><input type="checkbox" data-row-select value="${esc(row.id)}" ${canSelectRow(row) ? '' : 'disabled'} /></td>` : ''}
            <td class="mono center">${esc(row.id)}</td>
            <td class="center">${esc(row.doc_type)}</td>
            <td class="center">${esc(formatDate(row.created_at))}</td>
            <td class="doc-table__title">${esc(row.title)}</td>
            <td class="center">${esc(row.department || '-')}</td>
            <td class="center">${esc(row.drafter || '-')}</td>
            <td class="center">${esc(row.reviewer_names || row.reviewer_name || '-')}</td>
            <td class="center">${esc(row.cooperator_names || '-')}</td>
            <td class="center">${esc(row.approver_name || '-')}</td>
            <td class="center"><span class="badge badge--${esc(row.status)}">${esc(row.status)}</span></td>
          </tr>`).join('');
        const colspan = queueMode ? 11 : 10;
        const docCols = `${queueMode ? '<col class="col-check" />' : ''}<col class="col-number" /><col class="col-type" /><col class="col-date" /><col class="col-title" /><col class="col-department" /><col class="col-person" /><col class="col-person" /><col class="col-person" /><col class="col-person" /><col class="col-status" />`;
        docTable.innerHTML = `<table class="doc-table__frame doc-table__frame--documents"><colgroup>${docCols}</colgroup><thead><tr>${queueMode ? '<th class="doc-table__select" aria-label="선택"></th>' : ''}<th>문서번호</th><th>구분</th><th>등록일</th><th>제목</th><th>담당부서</th><th>기안자</th><th>검토자</th><th>협조자</th><th>결재·전결자</th><th>상태</th></tr></thead><tbody>${body || `<tr class="doc-table__empty-row"><td colspan="${colspan}" class="empty"><strong>조건에 맞는 문서가 없습니다.</strong><span>검색조건을 변경하거나 새 문서를 작성해 주세요.</span></td></tr>`}</tbody></table>`;
        $$('tr[data-doc-id]', docTable).forEach((tr) => tr.addEventListener('click', (event) => { if (!event.target.closest('[data-no-open]')) openDetail(tr.dataset.docId); }));
        $$('[data-row-select]', docTable).forEach((box) => box.addEventListener('change', () => { box.checked ? selectedIds.add(box.value) : selectedIds.delete(box.value); updateSelection(); }));
        updateSelection();
      };

      const renderPagination = (container, page, pages, onPage) => {
        if (pages <= 1) { container.innerHTML = ''; return; }
        const start = Math.max(1, page - 4), end = Math.min(pages, start + 8);
        const buttons = [];
        buttons.push(`<button type="button" ${page === 1 ? 'disabled' : ''} data-page="${page - 1}">‹</button>`);
        for (let i = start; i <= end; i += 1) buttons.push(`<button type="button" class="${i === page ? 'active' : ''}" data-page="${i}">${i}</button>`);
        buttons.push(`<button type="button" ${page === pages ? 'disabled' : ''} data-page="${page + 1}">›</button>`);
        container.innerHTML = buttons.join('');
        $$('[data-page]', container).forEach((btn) => btn.addEventListener('click', () => onPage(Number(btn.dataset.page))));
      };

      let documentRequestSerial=0;
      const refreshDocuments = async (forceDashboard = false) => {
        const requestSerial=++documentRequestSerial;
        const requestView=currentView;
        statusEl.textContent = '조회 중입니다...';
        const data = await callApi('/api/documents/list', {
          token: getToken(), view: currentView, query: $('[data-query]').value.trim(), page: docPage,
          pageSize: Number($('[data-page-size]').value), dateFrom: $('[data-date-from]').value,
          dateTo: $('[data-date-to]').value, docType: $('[data-doc-type-filter]').value,
          category: categoryFilter.value, sort: $('[data-sort]').value,
        });
        if(requestSerial!==documentRequestSerial||requestView!==currentView)return;
        if (!data.ok) { statusEl.textContent = data.message || '조회에 실패했습니다.'; return; }
        statusEl.textContent = `총 ${formatNumber(data.total)}건 · ${data.page}/${data.pages}쪽`;
        renderDocumentRows(data.rows || []);
        renderPagination($('[data-doc-pagination]'), data.page, data.pages, (page) => { docPage = page; refreshDocuments(); });
        const countEl=$(`[data-count="${requestView}"]`);if(countEl)countEl.textContent=String(data.total||0);
        await refreshSidebarCounts(forceDashboard).catch((error)=>console.error('대시보드 수량 갱신 실패',error));
      };
      const applyDashboardCounts = (counts = {}) => {
        const sidebarMap = { 임시저장: 'draft', 진행: 'progress', 결재대기: 'pending', 발송대기: 'send' };
        Object.entries(sidebarMap).forEach(([view, key]) => { const el = $(`[data-count="${view}"]`); if (el) el.textContent = String(counts[key] || 0); });
        $$('[data-home-count]').forEach((el) => { el.textContent = formatNumber(counts[el.dataset.homeCount] || 0); });
      };
      let dashboardLoadedAt=0;
      let dashboardRequest=null;
      const refreshDashboard = async (force=false) => {
        if(!force && dashboardRequest) return dashboardRequest;
        if(!force && Date.now()-dashboardLoadedAt<15000) return {ok:true,cached:true};
        dashboardRequest=(async()=>{
        const data = await callApi('/api/dashboard/summary', { token: getToken() });
        if (!data.ok) return data;
        dashboardLoadedAt=Date.now();
        applyDashboardCounts(data.counts || {});
        const r2Warning = $('[data-r2-warning]'); if (r2Warning) r2Warning.hidden = !!data.storage?.r2Connected;
        const recentDocs = $('[data-home-recent-docs]');
        recentDocs.innerHTML = (data.recentDocuments || []).map((row) => `<button type="button" class="home-list-row" data-home-doc="${esc(row.id)}"><span class="home-list-row__main"><strong>${esc(row.title)}</strong><small>${esc(row.id)} · ${esc(row.drafter || '-')} · ${esc(row.department || '-')}</small></span><span class="badge badge--${esc(row.status)}">${esc(row.status)}</span></button>`).join('') || '<p class="muted">최근 문서가 없습니다.</p>';
        $$('[data-home-doc]', recentDocs).forEach((button) => button.addEventListener('click', () => openDetail(button.dataset.homeDoc)));
        const recentRegistry = $('[data-home-recent-received]');
        recentRegistry.innerHTML = (data.recentRegistry || []).map((row) => `<button type="button" class="home-list-row" data-home-received-id="${esc(row.id)}"><span class="home-list-row__main"><strong>${esc(row.title)}</strong><small>${esc(row.id)} · ${esc(row.counterparty || '-')} · ${esc(row.received_at || '-')}</small></span><span class="registry-direction">${esc(row.direction)}</span></button>`).join('') || '<p class="muted">최근 등록 문서가 없습니다.</p>';
        $$('[data-home-received-id]', recentRegistry).forEach((button) => button.addEventListener('click', () => openReceivedDetail(button.dataset.homeReceivedId)));
        return data;
        })();
        try{return await dashboardRequest;}finally{dashboardRequest=null;}
      };
      const refreshSidebarCounts = async (force=false) => refreshDashboard(force);
      const setTopNav = (name) => $$('[data-nav]').forEach((button) => button.classList.toggle('active', button.dataset.nav === name));
      const activateHome = () => {
        panelHome.hidden = false; panelDocuments.hidden = true; panelReceived.hidden = true;
        $$('[data-view]').forEach((b) => b.classList.remove('active'));
        setTopNav('home');
        refreshDashboard();
      };
      const activateDocumentsView = (view) => {
        currentView = view; docPage = 1;
        panelHome.hidden = true; panelDocuments.hidden = false; panelReceived.hidden = true;
        $$('[data-view]').forEach((b) => b.classList.toggle('active', b.dataset.view === view));
        $('[data-panel-title]').textContent = viewLabels[view] || '문서목록';
        setTopNav(view === '전체' ? 'registry' : 'approval');
        return refreshDocuments();
      };
      const activateReceivedView = () => {
        panelHome.hidden = true; panelDocuments.hidden = true; panelReceived.hidden = false;
        $$('[data-view]').forEach((b) => b.classList.remove('active'));
        setTopNav('received'); receivedPage = 1; renderReceivedRows([]); return refreshReceived();
      };
      $$('[data-view]').forEach((button) => button.addEventListener('click', () => activateDocumentsView(button.dataset.view)));
      $('[data-received-view]').addEventListener('click', activateReceivedView);
      $('[data-go-home]').addEventListener('click', activateHome);
      $$('[data-nav]').forEach((button) => button.addEventListener('click', () => {
        if (button.dataset.nav === 'home') activateHome();
        else if (button.dataset.nav === 'received') activateReceivedView();
        else if (button.dataset.nav === 'registry') activateDocumentsView('전체');
        else activateDocumentsView('결재대기');
      }));
      $$('[data-home-view]').forEach((button) => button.addEventListener('click', () => activateDocumentsView(button.dataset.homeView)));
      $('[data-home-registry]').addEventListener('click', activateReceivedView);
      $('[data-home-all-docs]').addEventListener('click', () => activateDocumentsView('전체'));
      $('[data-home-all-received]').addEventListener('click', activateReceivedView);
      $('[data-home-compose]').addEventListener('click', () => $('[data-open-compose]').click());
      $('[data-home-received]').addEventListener('click', () => $('[data-open-received]').click());
      $('[data-toggle-sidebar]').addEventListener('click', () => appShell.classList.toggle('sidebar-collapsed'));
      $('[data-refresh]').addEventListener('click', () => { docPage = 1; refreshDocuments(); });
