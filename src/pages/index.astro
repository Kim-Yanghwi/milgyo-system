      const refreshUsersTable=async()=>{const d=await callApi('/api/users/list',{token:getToken(),includeInactive:true});if(d.ok)renderUsersTable(d.rows||[]);else $('[data-user-form-status]').textContent=d.message;};
      openUsersBtn.addEventListener('click',()=>{resetUserForm();renderUsersTable([]);usersModal.hidden=false;refreshUsersTable();});$$('[data-close-users]').forEach((b)=>b.addEventListener('click',()=>usersModal.hidden=true));
      userForm.addEventListener('submit',async(e)=>{
        e.preventDefault();
        const submitButton=$('[data-user-form-submit]');
        if(submitButton.disabled)return;
        const fd=new FormData(userForm),id=fd.get('id');
        const originalText=submitButton.textContent;
        submitButton.disabled=true;submitButton.textContent=id?'저장 중...':'생성 중...';
        $('[data-user-form-status]').textContent=id?'계정 정보를 저장하고 있습니다.':'비밀번호 암호화 및 계정 생성을 진행하고 있습니다.';
        try{
          const payload={token:getToken(),id,name:fd.get('name'),username:fd.get('username'),password:fd.get('password')||undefined,newPassword:fd.get('password')||undefined,position:fd.get('position'),grade:fd.get('grade'),department:fd.get('department'),role:fd.get('role'),canApprove:fd.get('canApprove')==='on',active:fd.get('active')==='on'};
          const result=await callApi(id?'/api/users/update':'/api/users/create',payload);
          $('[data-user-form-status]').textContent=result.message||'';
          if(result.ok){resetUserForm();await Promise.all([refreshUsersTable(),refreshUserOptions()]);$('[data-user-form-status]').textContent=result.message||'계정 정보가 저장되었습니다.';}
        }finally{
          submitButton.disabled=false;
          submitButton.textContent=userForm.elements.id.value?'수정 저장':'계정 추가';
          if(!submitButton.textContent)submitButton.textContent=originalText;
        }
      });

      // 관인·로고
      let orgSealImage='',orgLogoImage='';
      const trimTransparentImage=(dataUrl)=>new Promise((resolve)=>{
        if(!dataUrl){resolve('');return;}
        const image=new Image();
        image.onload=()=>{
          try{
            const canvas=document.createElement('canvas');canvas.width=image.naturalWidth||image.width;canvas.height=image.naturalHeight||image.height;
            const context=canvas.getContext('2d',{willReadFrequently:true});if(!context){resolve(dataUrl);return;}
            context.drawImage(image,0,0);const pixels=context.getImageData(0,0,canvas.width,canvas.height).data;
            let left=canvas.width,top=canvas.height,right=-1,bottom=-1;
            for(let y=0;y<canvas.height;y+=1){for(let x=0;x<canvas.width;x+=1){if(pixels[(y*canvas.width+x)*4+3]>12){if(x<left)left=x;if(x>right)right=x;if(y<top)top=y;if(y>bottom)bottom=y;}}}
            if(right<left||bottom<top||(left===0&&top===0&&right===canvas.width-1&&bottom===canvas.height-1)){resolve(dataUrl);return;}
            const padding=Math.max(2,Math.round(Math.max(right-left+1,bottom-top+1)*0.015));
            left=Math.max(0,left-padding);top=Math.max(0,top-padding);right=Math.min(canvas.width-1,right+padding);bottom=Math.min(canvas.height-1,bottom+padding);
            const output=document.createElement('canvas');output.width=right-left+1;output.height=bottom-top+1;
            const outputContext=output.getContext('2d');if(!outputContext){resolve(dataUrl);return;}
            outputContext.drawImage(canvas,left,top,output.width,output.height,0,0,output.width,output.height);
            resolve(output.toDataURL('image/png'));
          }catch(error){resolve(dataUrl);}
        };
        image.onerror=()=>resolve(dataUrl);image.src=dataUrl;
      });
      const applyBranding=()=>{const logoSource=orgLogoImage||'/logo.png';$$('[data-emblem]').forEach((el)=>{el.innerHTML=`<img src="${logoSource}" alt="대한불교밀교종 로고" />`;});$$('[data-stamp]').forEach((el)=>{el.innerHTML=orgSealImage?`<img src="${orgSealImage}" alt="관인" />`:'밀교종印';el.classList.toggle('stamp-mark--image',!!orgSealImage);});$$('[data-topbar-logo]').forEach((el)=>{el.src=logoSource;});};
      const loadOrgSettings=async()=>{const d=await callApi('/api/settings/get',{token:getToken()});if(d.ok){orgSealImage=await trimTransparentImage(d.sealImage||'');orgLogoImage=d.logoImage||'';applyBranding();}};
      const brandingModal=$('[data-branding-modal]'),brandingForm=$('[data-branding-form]');let pendingLogo='',pendingSeal='';
      const readImage=(file)=>new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result||''));r.onerror=()=>reject(r.error);r.readAsDataURL(file);});
      const renderBranding=()=>{$('[data-branding-logo-preview]').innerHTML=`<img src="${pendingLogo||orgLogoImage||'/logo.png'}" alt="로고" />`;$('[data-branding-seal-preview]').innerHTML=(pendingSeal||orgSealImage)?`<img src="${pendingSeal||orgSealImage}" alt="관인" />`:'<span class="muted">등록된 관인 없음</span>';};
      $('[data-open-branding]').addEventListener('click',()=>{pendingLogo='';pendingSeal='';renderBranding();brandingModal.hidden=false;});$$('[data-close-branding]').forEach((b)=>b.addEventListener('click',()=>brandingModal.hidden=true));$('#brand-logo').addEventListener('change',async(e)=>{if(e.target.files[0])pendingLogo=await readImage(e.target.files[0]);renderBranding();});$('#brand-seal').addEventListener('change',async(e)=>{if(e.target.files[0])pendingSeal=await trimTransparentImage(await readImage(e.target.files[0]));renderBranding();});brandingForm.addEventListener('submit',async(e)=>{e.preventDefault();const d=await callApi('/api/settings/save',{token:getToken(),logoImage:pendingLogo,sealImage:pendingSeal});$('[data-branding-status]').textContent=d.message||'';if(d.ok){await loadOrgSettings();renderBranding();}});

      // 조직도
      const orgchartModal=$('[data-orgchart-modal]');
      const membersOf=(dept)=>allUsers.filter((u)=>u.department===dept||u.department?.startsWith(`${dept} - `));
      const renderOrgchart=()=>{
        const tree=$('[data-orgchart-tree]');
        tree.innerHTML=departmentTree.map((dep)=>`<section class="orgchart-group"><button type="button" class="orgchart-tree__dept" data-dept="${esc(dep.name)}"><span class="orgchart-tree__icon">${esc(dep.name.slice(0,1))}</span><span class="orgchart-tree__label">${esc(dep.name)}</span><span class="orgchart-tree__count">${membersOf(dep.name).length}</span></button>${(dep.children||[]).map((c)=>`<button type="button" class="orgchart-tree__child" data-dept="${esc(dep.name+' - '+c)}"><span>${esc(c)}</span><span class="orgchart-tree__count">${membersOf(dep.name+' - '+c).length}</span></button>`).join('')}</section>`).join('');
        const selectDepartment=(button)=>{
          $$('[data-dept]',tree).forEach((item)=>item.classList.toggle('active',item===button));
          const dept=button.dataset.dept,members=membersOf(dept);
          $('[data-orgchart-title]').textContent=`${dept} · ${members.length}명`;
          $('[data-orgchart-members]').innerHTML=`<table class="orgchart-members-table"><colgroup><col class="org-name" /><col class="org-id" /><col class="org-position" /><col class="org-grade" /><col class="org-department" /><col class="org-role" /></colgroup><thead><tr><th>성명</th><th>아이디</th><th>직책</th><th>직급</th><th>소속</th><th>구분</th></tr></thead><tbody>${members.map((u)=>`<tr><td><strong>${esc(u.name)}</strong></td><td class="mono">${esc(u.username)}</td><td class="org-position-cell">${esc(u.position||'-')}</td><td class="org-grade-cell">${esc(u.grade||'-')}</td><td>${renderDepartmentCell(u.department)}</td><td>${u.role==='admin'?'관리자':u.role==='audit'?'감사':'일반'}</td></tr>`).join('')||'<tr><td colspan="6" class="empty"><strong>이 부서에 지정된 인원이 없습니다.</strong><span>계정관리에서 담당부서를 지정하면 여기에 표시됩니다.</span></td></tr>'}</tbody></table>`;
        };
        $$('[data-dept]',tree).forEach((b)=>b.addEventListener('click',()=>selectDepartment(b)));
        const first=$('[data-dept]',tree);if(first)selectDepartment(first);
      };
      $('[data-open-orgchart]').addEventListener('click',async()=>{await refreshUserOptions();renderOrgchart();orgchartModal.hidden=false;});$$('[data-close-orgchart]').forEach((b)=>b.addEventListener('click',()=>orgchartModal.hidden=true));

      // 로그인
      loginForm.addEventListener('submit',async(e)=>{
        e.preventDefault();
        loginError.hidden=true;
        const button=$('button[type="submit"]',loginForm);const original=button.textContent;button.disabled=true;button.textContent='로그인 중...';
        try {
          const fd=new FormData(loginForm),d=await callApi('/api/auth/login',{username:fd.get('username'),password:fd.get('password')});
          if(!d.ok){loginError.hidden=false;loginError.textContent=d.message;return;}
          setSession({token:d.token,user:d.user});showApp();activateHome();
          Promise.all([refreshUserOptions(),refreshTemplates(),loadOrgSettings()]).catch((error)=>console.error('초기 데이터 로드 실패',error));
        } finally { button.disabled=false;button.textContent=original; }
      });
      bootstrapForm.addEventListener('submit',async(e)=>{e.preventDefault();bootstrapError.hidden=true;bootstrapOk.hidden=true;const fd=new FormData(bootstrapForm),d=await callApi('/api/auth/bootstrap',{adminToken:fd.get('adminToken'),name:fd.get('name'),username:fd.get('username'),password:fd.get('password'),position:fd.get('position')});if(!d.ok){bootstrapError.hidden=false;bootstrapError.textContent=d.message;return;}bootstrapOk.hidden=false;bootstrapOk.textContent=d.message;$('#login-username').value=fd.get('username');});
      $('[data-logout]').addEventListener('click',async()=>{const token=getToken();clearSession();showLogin();if(token)callApi('/api/auth/logout',{token});});
      if(getToken()){
        showApp();activateHome();
        Promise.all([refreshUserOptions(),refreshTemplates(),loadOrgSettings()]).catch((error)=>console.error('초기 데이터 로드 실패',error));
      } else showLogin();
    })();
  </script>


