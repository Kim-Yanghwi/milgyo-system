---
import ManagementLayout from '../layouts/ManagementLayout.astro';
---
<ManagementLayout title="승려증 발급 관리대장" active="monkCards">
 <div class="page-heading"><div><p class="page-heading__kicker">MONK ID CARD REGISTER</p><h1>승려증 발급 관리대장</h1><p>승려증의 발급·교부·무효·반납·폐기 내역을 기록합니다.</p></div>
  <div class="toolbar"><a class="btn btn-outline" href="/?compose=1&amp;template=TPL-MONK-CARD-APPLICATION" data-application-link>발급 신청서 작성</a><button class="btn btn-primary" type="button" data-new hidden>+ 발급대장 등록</button></div>
 </div>
 <p class="status-message" data-message aria-live="polite"></p>
 <section class="surface mc-panel" data-editor hidden>
  <div class="section-title"><div><h2 data-editor-title>발급대장 등록</h2><p>실제 발급 내역을 기록하며, 카드 자체를 제작하는 기능은 아닙니다.</p></div><button type="button" class="btn btn-outline" data-close-editor>닫기</button></div>
  <form data-form>
   <div data-create-only>
    <h3>승적원부 선택</h3>
    <div class="form-grid mc-two"><div class="form-field"><label for="mc-registry">승적원부 대상자 *</label><select id="mc-registry" data-registry><option value="">대상자를 검색해 주세요.</option></select></div>
    <div class="form-field"><label for="mc-registry-search">법명·승적번호·사찰 검색</label><div class="mc-search"><input id="mc-registry-search" type="search" data-reg-query maxlength="100"/><button type="button" class="btn btn-outline" data-reg-search>검색</button></div><small data-reg-hint></small></div></div>
   </div>
   <h3 class="mc-heading">발급 및 인적 기재사항</h3>
   <div class="form-grid mc-grid">
<div class="form-field "><label for="mc-round">계단 회차 *</label><select data-field="round" id="mc-round" required ><option value="">선택해 주세요</option><option value="01">01</option><option value="02">02</option><option value="03">03</option><option value="04">04</option><option value="05">05</option><option value="06">06</option><option value="07">07</option><option value="08">08</option><option value="09">09</option><option value="10">10</option><option value="11">11</option><option value="12">12</option><option value="13">13</option><option value="14">14</option><option value="15">15</option><option value="16">16</option><option value="17">17</option><option value="18">18</option><option value="19">19</option><option value="20">20</option><option value="21">21</option><option value="22">22</option><option value="23">23</option><option value="24">24</option><option value="25">25</option><option value="26">26</option><option value="27">27</option><option value="28">28</option><option value="29">29</option><option value="30">30</option></select></div><div class="form-field "><label for="mc-estimate">예상 발급번호</label><input id="mc-estimate" data-field="estimate" type="text" maxlength="120" readonly /></div><div class="form-field "><label for="mc-issueKind">발급 구분 *</label><select data-field="issueKind" id="mc-issueKind" required ><option value="">선택해 주세요</option><option value="신규">신규</option><option value="재발급">재발급</option><option value="갱신">갱신</option></select></div><div class="form-field "><label for="mc-issueDate">발급일 *</label><span class="mc-date"><input id="mc-issueDate" data-field="issueDate" data-date type="text" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" required /><button type="button" data-calendar aria-label="발급일 달력">▦</button><input class="mc-native" type="date" tabindex="-1" aria-hidden="true" data-no-weekday data-no-date8 /></span></div><div class="form-field "><label for="mc-validUntil">유효기간 만료일 (자동)</label><input id="mc-validUntil" data-field="validUntil" type="text" maxlength="120" readonly /></div><div class="form-field "><label for="mc-monasticNo">승적번호</label><input id="mc-monasticNo" data-field="monasticNo" type="text" maxlength="120" readonly /></div><div class="form-field "><label for="mc-applicationDate">신청일 *</label><span class="mc-date"><input id="mc-applicationDate" data-field="applicationDate" data-date type="text" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" required /><button type="button" data-calendar aria-label="신청일 달력">▦</button><input class="mc-native" type="date" tabindex="-1" aria-hidden="true" data-no-weekday data-no-date8 /></span></div><div class="form-field "><label for="mc-receiptDate">접수일 *</label><span class="mc-date"><input id="mc-receiptDate" data-field="receiptDate" data-date type="text" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" required /><button type="button" data-calendar aria-label="접수일 달력">▦</button><input class="mc-native" type="date" tabindex="-1" aria-hidden="true" data-no-weekday data-no-date8 /></span></div><div class="form-field "><label for="mc-supplementDays">보완 소요일</label><input id="mc-supplementDays" data-field="supplementDays" type="number" maxlength="120" min="0" max="3660" step="1" /></div><div class="form-field "><label for="mc-dharmaNameKo">법명(한글) *</label><input id="mc-dharmaNameKo" data-field="dharmaNameKo" type="text" maxlength="120" required /></div><div class="form-field "><label for="mc-dharmaNameHanja">법명(한자)</label><input id="mc-dharmaNameHanja" data-field="dharmaNameHanja" type="text" maxlength="120" /></div><div class="form-field "><label for="mc-dharmaRank">법계 *</label><input id="mc-dharmaRank" data-field="dharmaRank" type="text" maxlength="120" required /></div><div class="form-field "><label for="mc-temple">소속사찰 *</label><input id="mc-temple" data-field="temple" type="text" maxlength="120" required /></div><div class="form-field "><label for="mc-birthDate">생년월일 *</label><span class="mc-date"><input id="mc-birthDate" data-field="birthDate" data-date type="text" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" required /><button type="button" data-calendar aria-label="생년월일 달력">▦</button><input class="mc-native" type="date" tabindex="-1" aria-hidden="true" data-no-weekday data-no-date8 /></span></div><div class="form-field "><label for="mc-ordinationDate">수계일 *</label><span class="mc-date"><input id="mc-ordinationDate" data-field="ordinationDate" data-date type="text" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="off" required /><button type="button" data-calendar aria-label="수계일 달력">▦</button><input class="mc-native" type="date" tabindex="-1" aria-hidden="true" data-no-weekday data-no-date8 /></span></div></div><p class="mc-note">발급번호는 승적번호와 별도입니다. 계단 2자리 + 발급연도 2자리 - 연도별 순번 (저장 시 확정). 유효기간은 발급일부터 5년이 되는 날의 전날까지입니다.</p>
<div data-create-only><h3 class="mc-heading">신청서류 확인 및 종전 승려증</h3><div class="form-grid mc-grid"><div class="form-field "><label for="mc-previousId">종전 승려증</label><select data-field="previousId" id="mc-previousId" ><option value="">선택해 주세요</option></select></div><div class="form-field "><label for="mc-issueReason">재발급 사유</label><select data-field="issueReason" id="mc-issueReason" ><option value="">선택해 주세요</option><option value="분실">분실</option><option value="훼손">훼손</option><option value="기재사항 변경">기재사항 변경</option></select></div><div class="form-field "><label for="mc-previousHandling">종전 승려증 처리</label><select data-field="previousHandling" id="mc-previousHandling" ><option value="">선택해 주세요</option><option value="해당 없음">해당 없음</option><option value="함께 반납">함께 반납</option><option value="분실 신고함">분실 신고함</option></select></div><div class="form-field "><label for="mc-generalConsent">일반 개인정보 동의 *</label><select data-field="generalConsent" id="mc-generalConsent" required ><option value="">선택해 주세요</option><option value="동의">동의</option><option value="비동의">비동의</option></select></div><div class="form-field "><label for="mc-sensitiveConsent">민감정보 별도 동의 *</label><select data-field="sensitiveConsent" id="mc-sensitiveConsent" required ><option value="">선택해 주세요</option><option value="동의">동의</option><option value="비동의">비동의</option></select></div><div class="form-field "><label for="mc-abbotConfirmation">주지 확인 *</label><select data-field="abbotConfirmation" id="mc-abbotConfirmation" required ><option value="">선택해 주세요</option><option value="주지 확인">주지 확인</option><option value="신청인이 주지">신청인이 주지</option><option value="변동 없는 갱신">변동 없는 갱신</option></select></div></div><label class="mc-check"><input type="checkbox" data-field="documentsConfirmed"/>신청서, 개인별 동의서, 사진 요건 및 주지 확인을 점검했습니다.</label>
<label class="mc-check"><input type="checkbox" data-field="eligibilityConfirmed"/>승적부를 대조했으며, 정지·제적·멸빈·환속 등 발급 제한 사유 및 진행 절차가 없음을 확인했습니다.</label></div>
<h3 class="mc-heading">내부문서 연계</h3><div class="form-grid mc-two"><div class="form-field "><label for="mc-internalDocumentNo">내부문서번호 (직접 기입)</label><input id="mc-internalDocumentNo" data-field="internalDocumentNo" type="text" maxlength="120" /></div><div class="form-field "><label for="mc-linkedDocumentId">시스템 내 결재 완료 문서 연계</label><select data-field="linkedDocumentId" id="mc-linkedDocumentId" ><option value="">선택해 주세요</option></select></div></div><div class="mc-search"><input type="search" data-doc-query aria-label="내부문서 검색" placeholder="내부문서번호 또는 제목" maxlength="100"/><button type="button" class="btn btn-outline" data-doc-search>결재 완료 문서 검색</button><a class="btn btn-outline" href="/?compose=1&amp;template=TPL-MONK-CARD-CONSENT">동의서 작성</a></div>
<small class="mc-document-hint">시스템 문서를 선택하면 실제 문서번호가 저장됩니다. 종이문서 등은 번호를 직접 기입하세요.</small>
<div class="form-field mc-remarks"><label for="mc-remarks">비고</label><textarea id="mc-remarks" data-field="remarks" rows="2" maxlength="1000"></textarea></div>
<div data-edit-only hidden><label class="mc-check"><input type="checkbox" data-field="clericalCorrection"/>실제 법명·법계·사찰 변경이 아닌 단순 기재오류 정정입니다. 실제 변경은 재발급하세요.</label><div class="form-field"><label for="mc-correction">정정 사유 *</label><textarea id="mc-correction" data-correction maxlength="500"></textarea></div></div>
<p class="status-message" data-form-message aria-live="polite"></p><div class="form-actions"><button type="button" class="btn btn-outline" data-close-editor>취소</button><button type="submit" class="btn btn-primary" data-save>등록·저장</button></div>
</form></section>
<section class="surface mc-panel" data-list>
 <div class="section-title"><div><h2>승려증 발급 목록</h2><p>발급번호·법명·승적번호·사찰·문서번호 검색</p></div><div class="toolbar">
 <select data-status aria-label="상태"><option value="">전체 상태</option><option>유효</option><option>만료</option><option>무효</option><option>갱신대상</option></select>
 <input type="search" data-query maxlength="100" aria-label="발급대장 검색" placeholder="발급번호·법명·사찰"/><select data-size aria-label="페이지 크기"><option>10</option><option selected>20</option><option>50</option></select><button type="button" class="btn btn-outline" data-search>조회</button><button type="button" class="btn btn-outline" data-csv>CSV (현재 페이지)</button></div></div>
 <p class="status-message" data-list-message aria-live="polite"></p><div class="data-wrap"><table class="data-table mc-list-table"><thead><tr><th>발급번호</th><th>구분</th><th>법명</th><th>승적번호</th><th>법계</th><th>소속사찰</th><th>생년월일</th><th>수계일</th><th>발급일</th><th>유효기간</th><th>상태</th><th>내부문서번호</th><th>관리</th></tr></thead><tbody data-list-body><tr><td colspan="13">불러오는 중입니다.</td></tr></tbody></table></div><div class="pagination" data-pages></div>
</section>
<section class="surface mc-panel mc-detail" data-detail hidden>
 <div class="section-title"><div><h2>발급대장 상세</h2><p data-detail-title></p></div><div class="toolbar"><button type="button" class="btn btn-outline" data-print>대장 인쇄</button><button type="button" class="btn btn-outline" data-edit>기재 정정</button><button type="button" class="btn btn-outline" data-reissue>재발급·갱신 등록</button><button type="button" class="btn btn-outline" data-close-detail>닫기</button></div></div>
 <div class="data-wrap" data-detail-summary></div><p data-doc-link></p>
 <h3 class="mc-heading">수령·분실·반납·폐기 처리</h3><form data-life-form><div class="form-grid mc-grid">
 <div class="form-field"><label for="mc-action">처리 구분</label><select id="mc-action" data-life-action><option value="receive">수령</option><option value="invalidate">분실·무효</option><option value="return">반납</option><option value="destroy">폐기</option></select></div>
 <div class="form-field"><label for="mc-life-date">처리일 *</label><span class="mc-date"><input id="mc-life-date" type="text" data-life-date data-date inputmode="numeric" placeholder="YYYY-MM-DD" maxlength="10" required/><button type="button" data-calendar aria-label="처리일 달력">▦</button><input type="date" class="mc-native" tabindex="-1" aria-hidden="true" data-no-weekday data-no-date8/></span></div>
 <div class="form-field"><label for="mc-life-reason">처리 사유 *</label><input id="mc-life-reason" data-life-reason maxlength="500" required/></div>
 <div class="form-field" data-life-group="receive"><label for="mc-receipt">수령 확인</label><input id="mc-receipt" data-receipt-confirm maxlength="200" /></div><div class="form-field" data-life-group="receive"><label for="mc-mail">등기번호</label><input id="mc-mail" data-mail maxlength="80"/></div>
 <div class="form-field" data-life-group="invalidate" hidden><label for="mc-invalid">무효 사유</label><select id="mc-invalid" data-invalid-reason><option>분실</option><option>승적 소멸</option><option>승적·권리 정지</option><option>위조·변조·양도·대여</option><option>기타</option></select></div>
 <div class="form-field" data-life-group="destroy" hidden><label for="mc-destroy-method">폐기 방법</label><select id="mc-destroy-method" data-destroy-method><option>천공</option><option>재단</option></select></div>
 </div><p class="mc-note">분실 신고는 즉시 무효 처리합니다. 분실한 카드를 다시 찾아도 유효 상태로 복원하지 않습니다.</p><div class="form-actions"><button type="submit" class="btn btn-primary">처리 저장</button></div></form>
 <h3 class="mc-heading">변경·처리 이력</h3><div class="data-wrap" data-history></div>
 <h3 class="mc-heading">사본·증빙 첨부 (비공개 R2)</h3><p class="mc-note">파일당 4MB, 대장별 10개. 신청서·사진의 보유기한을 확인하여 기한 경과 시 담당자가 파기해 주세요. 자동 파기는 실행하지 않습니다.</p>
 <form data-upload-form><div class="form-grid mc-two"><div class="form-field"><label for="mc-file-kind">증빙 종류</label><select id="mc-file-kind" data-file-kind></select></div><div class="form-field"><label for="mc-file">파일</label><input id="mc-file" type="file" data-file accept=".pdf,.jpg,.jpeg,.png,.hwp,.hwpx,.docx" required/></div></div><div class="form-actions"><button type="submit" class="btn btn-primary">첨부파일 등록</button></div></form><p class="status-message" data-upload-message aria-live="polite"></p><div class="data-wrap" data-files></div>
</section>

  <script is:inline>
(async()=>{
 const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>Array.from(r.querySelectorAll(s));
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const L={"title":"승려증 발급 관리대장","new":"발급대장 등록","edit":"대장 기재 정정","detail":"발급대장 상세","list":"승려증 발급 목록","lookup":"조회","close":"닫기","search":"검색","save":"등록·저장","select":"선택해 주세요","history":"변경·처리 이력","copy":"사본·증빙 첨부","print":"대장 인쇄","loading":"불러오는 중입니다.","empty":"등록된 기록이 없습니다.","error":"처리 중 오류가 발생했습니다.","app":"승려증 발급 신청서 작성","consent":"발급용 동의서 작성","total":"총","item":"건","download":"다운로드","delete":"삭제","retry":"삭제 다시 시도","registryId":"승적원부 대상자","round":"계단 회차","estimate":"예상 발급번호","issueKind":"발급 구분","issueDate":"발급일","validUntil":"유효기간 만료일 (자동)","applicationDate":"신청일","receiptDate":"접수일","supplementDays":"보완 소요일","dharmaNameKo":"법명(한글)","dharmaNameHanja":"법명(한자)","monasticNo":"승적번호","dharmaRank":"법계","temple":"소속사찰","birthDate":"생년월일","ordinationDate":"수계일","previousId":"종전 승려증","issueReason":"재발급 사유","previousHandling":"종전 승려증 처리","generalConsent":"일반 개인정보 동의","sensitiveConsent":"민감정보 별도 동의","abbotConfirmation":"주지 확인","internalDocumentNo":"내부문서번호 (직접 기입)","linkedDocumentId":"시스템 내 결재 완료 문서 연계","remarks":"비고","reason":"처리·정정 사유","validity":"상태","card_no":"발급번호","previous_card_no":"종전 발급번호","renewalFrom":"갱신 신청 시작일","applicationRetentionDue":"신청서·사진 보유기한","issuerTitle":"발급명의","receivedDate":"수령일","receiptConfirmation":"수령 확인","registeredMailNo":"등기번호","invalidReason":"무효 사유","destructionMethod":"폐기 방법","lifecycle":"수령·분실·반납·폐기 처리","action":"처리 구분","date":"처리일","apply":"처리 저장","filename":"파일명","kind":"증빙 종류","size":"크기","manage":"관리","upload":"첨부파일 등록","created":"처리일시","before":"변경 전","after":"변경 후","field":"변경 항목","actor":"담당자"};
 const session=await window.MilgyoSession.ready();if(!session?.token)return;
 const api=async(op,p={},endpoint='query')=>{const response=await window.MilgyoSession.fetch('/api/monk-cards/'+endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({operation:op,...p})});const d=await response.json();if(!response.ok||!d.ok)throw new Error(d.message||L.error);return d;};
 const msg=(s,t,error=false)=>{const e=$(s);e.textContent=t||'';e.className='status-message'+(error?' error':'');};
 const today=()=>new Date(Date.now()+9*3600000).toISOString().slice(0,10);
 const normalizeDate=value=>{const m=/^(\d{4})[-./]?(\d{2})[-./]?(\d{2})$/.exec(String(value||'').trim());if(!m)return '';const d=new Date(Date.UTC(+m[1],+m[2]-1,+m[3]));return +m[1]>=1900&&d.getUTCFullYear()===+m[1]&&d.getUTCMonth()===+m[2]-1&&d.getUTCDate()===+m[3]?`${m[1]}-${m[2]}-${m[3]}`:'';};
