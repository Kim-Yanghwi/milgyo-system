 const fillEditor=async(row=null)=>{form.reset();editId=row?.id||'';editVersion=row?.version||0;requestId=crypto.randomUUID();estimateSeq++;msg('[data-form-message]','');$('[data-correction]').value='';$('[data-editor-title]').textContent=row?L.edit:L.new;$$('[data-create-only]',form).forEach(e=>{e.hidden=!!row;$$('input,select',e).forEach(x=>{x.disabled=!!row;});});$$('[data-edit-only]',form).forEach(e=>e.hidden=!row);
