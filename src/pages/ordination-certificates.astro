    @media(max-width:760px){.ordination-form-grid{grid-template-columns:1fr}.ordination-form-grid .form-field--wide{grid-column:auto}.section-title{align-items:flex-start;flex-direction:column}.privacy-note{white-space:normal}.ledger-filters>*{max-width:100%}.ledger-filters input[type="search"]{min-width:0;width:100%}.ordination-preview-modal [data-preview-container]{padding:.5rem}.ordination-preview-modal [data-preview-container] .ordination-certificate-root{transform:scale(.68);transform-origin:top left;margin-bottom:-359px}.detail-grid-table th,.detail-grid-table td{padding:.55rem .4rem;font-size:.8rem}}
