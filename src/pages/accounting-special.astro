      const rows4=(selector,rows,nameKey='name')=>{$(selector).innerHTML=rows.length?rows.map((r)=>`<tr><td>${esc(r[nameKey]||'-')}</td><td class="num">${won(r.income)}</td><td class="num">${won(r.expense)}</td><td class="num">${won(Number(r.income)-Number(r.expense))}</td></tr>`).join(''):'<tr><td colspan="4" class="empty">자료가 없습니다.</td></tr>'};
