      $('[data-form="donation"]').onsubmit=async(e)=>{e.preventDefault();const f=e.currentTarget;try{syncDonationDonor();if(!f.anonymousDonation.checked&&!f.donorName.value.trim())throw new Error('후원자명을 입력하거나 익명 기부를 선택해 주세요.');const d=await api('/api/accounting-special/action',{action:'save-donation',donationDate:f.donationDate.value,donorId:f.donorId.value,donorName:f.donorName.value,anonymousDonation:f.anonymousDonation.checked,donationCategory:f.donationCategory.value,amount:f.amount.value,paymentMethod:f.paymentMethod.value,bookTypeCode:f.bookTypeCode.value,entityId:f.entityId.value,fundId:f.fundId.value,accountCode:f.accountCode.value,settlementAccountCode:f.settlementAccountCode.value,purpose:f.purpose.value,memo:f.memo.value,receiptRequested:f.receiptRequested.checked,postNow:f.postNow?.checked});notice(d.message);f.reset();f.donationDate.value=today();syncDonationDonor();await loadInit()}catch(err){notice(err.message,'error')}};
      $('[data-form="asset"]').onsubmit=async(e)=>{e.preventDefault();const f=e.currentTarget;try{await api('/api/accounting-special/action',{action:'save-asset',id:f.id.value,name:f.name.value,category:f.category.value,acquisitionDate:f.acquisitionDate.value,acquisitionCost:f.acquisitionCost.value,usefulLifeMonths:f.usefulLifeMonths.value,depreciationMethod:f.depreciationMethod.value,residualValue:f.residualValue.value,assetAccountCode:f.assetAccountCode.value,bookTypeCode:f.bookTypeCode.value,entityId:f.entityId.value,fundId:f.fundId.value,department:f.department.value,location:f.location.value,custodian:f.custodian.value,memo:f.memo.value});notice('자산을 저장했습니다.');f.reset();f.acquisitionDate.value=today();f.usefulLifeMonths.value='60';f.residualValue.value='0';await loadInit()}catch(err){notice(err.message,'error')}};
      $('[data-form="card"]').onsubmit=async(e)=>{e.preventDefault();const f=e.currentTarget;try{await api('/api/accounting-special/action',{action:'save-card',id:f.id.value,cardLabel:f.cardLabel.value,issuer:f.issuer.value,maskedNumber:f.maskedNumber.value,holder:f.holder.value,bookTypeCode:f.bookTypeCode.value,entityId:f.entityId.value,department:f.department.value,settlementAccountCode:f.settlementAccountCode.value});notice('카드를 저장했습니다.');f.reset();await loadInit()}catch(err){notice(err.message,'error')}};
      $('[data-form="card-tx"]').onsubmit=async(e)=>{e.preventDefault();const f=e.currentTarget;const submit=f.querySelector('button[type="submit"]');submit.disabled=true;try{const d=await api('/api/accounting-special/action',{action:'save-card-transaction',cardId:f.cardId.value,transactionDate:f.transactionDate.value,merchant:f.merchant.value,amount:f.amount.value,taxAmount:f.taxAmount.value,accountCode:f.accountCode.value,bookTypeCode:f.bookTypeCode.value,entityId:f.entityId.value,fundId:f.fundId.value,department:f.department.value,project:f.project.value,memo:f.memo.value});const files=[...cardTxFiles];const failures=files.length?await uploadCardAttachmentFiles(d.id,files):[];f.reset();f.transactionDate.value=today();f.taxAmount.value='0';cardTxFiles=[];syncCardAttachmentQueues();await loadInit();if(failures.length)notice(`사용내역은 저장했지만 일부 첨부파일 등록에 실패했습니다. 첨부관리에서 다시 등록해 주세요. ${failures.join(' / ')}`,'error');else notice(files.length?'카드 사용내역과 첨부파일을 저장했습니다.':'카드 사용내역을 저장했습니다.');}catch(err){notice(err.message,'error')}finally{submit.disabled=!!state.permissions.audit}};
      $('[data-form="branch"]').onsubmit=async(e)=>{e.preventDefault();const f=e.currentTarget;try{await api('/api/accounting-special/action',{action:'save-branch-report',id:f.id.value,year:state.year,periodType:f.periodType.value,periodKey:f.periodKey.value,entityId:f.entityId.value,bookTypeCode:f.bookTypeCode.value,incomeTotal:f.incomeTotal.value,expenseTotal:f.expenseTotal.value,assetTotal:f.assetTotal.value,liabilityTotal:f.liabilityTotal.value,cashBalance:f.cashBalance.value,donationTotal:f.donationTotal.value,memo:f.memo.value,submit:f.submit.checked});notice('취합자료를 저장했습니다.');f.reset();await loadInit()}catch(err){notice(err.message,'error')}};

      const bindDonationActions=()=>{$$('[data-post-donation]').forEach((b)=>b.onclick=async()=>{try{const d=await api('/api/accounting-special/action',{action:'post-donation',id:b.dataset.postDonation});notice(d.message);await loadInit()}catch(e){notice(e.message,'error')}});$$('[data-issue]').forEach((b)=>b.onclick=async()=>{try{const d=await api('/api/accounting-special/action',{action:'issue-receipt',id:b.dataset.issue});notice(`${d.receiptNo} 발급내역을 등록했습니다.`);await loadInit()}catch(e){notice(e.message,'error')}});$$('[data-cancel-receipt]').forEach((b)=>b.onclick=async()=>{if(!confirm('영수증 발급을 취소하시겠습니까?'))return;try{await api('/api/accounting-special/action',{action:'cancel-receipt',id:b.dataset.cancelReceipt});notice('영수증 발급을 취소했습니다.');await loadInit()}catch(e){notice(e.message,'error')}});$$('[data-print]').forEach((b)=>b.onclick=()=>printReceipt(b.dataset.print))};
      const printReceipt=async(id)=>{try{const d=await api('/api/accounting-special/query',{action:'receipt-detail',id});const r=d.row;const w=window.open('','_blank','width=860,height=900');w.document.write(`<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>${esc(r.receipt_no||'기부금영수증')}</title><style>body{font-family:Batang,serif;padding:50px;color:#111}h1{text-align:center;font-size:30px;margin:20px}table{width:100%;border-collapse:collapse;margin:24px 0}th,td{border:1px solid #333;padding:12px}th{width:22%;background:#f5f5f5}.amount{font-size:22px;font-weight:700;text-align:right}.foot{text-align:center;margin-top:50px;font-size:18px}.note{font-size:12px;color:#666;margin-top:30px}@media print{button{display:none}}  </style></head><body><h1>기부금영수증</h1><table><tr><th>영수증번호</th><td>${esc(r.receipt_no||'-')}</td></tr><tr><th>기부자</th><td>${esc(r.donor_name)}</td></tr><tr><th>기부일자</th><td>${esc(r.donation_date)}</td></tr><tr><th>기부금액</th><td class="amount">${won(r.amount)}</td></tr><tr><th>사용목적</th><td>${esc(r.purpose||r.fund_name||'-')}</td></tr><tr><th>수령기관</th><td>${esc(r.entity_name||'사단법인 대한불교밀교종')}</td></tr><tr><th>대표자</th><td>${esc(r.representative||'-')}</td></tr><tr><th>주소</th><td>${esc(r.entity_address||'-')}</td></tr></table><p class="foot">위와 같이 기부금을 수령하였음을 확인합니다.<br><br>${esc((r.receipt_issued_at||'').slice(0,10))}<br><br><b>${esc(r.entity_name||'사단법인 대한불교밀교종')}</b></p><p class="note">이 출력물은 종단 내부 발급·관리용입니다. 세액공제 및 국세청 전자기부금영수증 신고에 사용할 때에는 세무담당자의 확인이 필요합니다.</p><button onclick="print()">인쇄</button></body></html>`);w.document.close()}catch(e){notice(e.message,'error')}};
      const disposeAsset=async(id)=>{const date=prompt('처분일자를 입력해 주세요.',today());if(!date)return;const amount=prompt('처분금액을 입력해 주세요.','0');try{await api('/api/accounting-special/action',{action:'dispose-asset',id,disposalDate:date,disposalAmount:amount});notice('자산을 처분 처리했습니다.');await loadInit()}catch(e){notice(e.message,'error')}};
      const postCard=async(id)=>{try{const d=await api('/api/accounting-special/action',{action:'post-card-transaction',id});notice(d.message);await loadInit()}catch(e){notice(e.message,'error')}};
      const reviewBranch=async(id,decision)=>{const memo=prompt(decision==='confirmed'?'확정 메모(선택)':'반려사유를 입력해 주세요.','')||'';try{await api('/api/accounting-special/action',{action:'review-branch-report',id,decision,memo});notice(decision==='confirmed'?'취합자료를 확정했습니다.':'취합자료를 반려했습니다.');await loadInit()}catch(e){notice(e.message,'error')}};

