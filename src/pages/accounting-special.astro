      $('[data-load-donations]').onclick=async()=>{try{const d=await api('/api/accounting-special/query',{action:'donations',year:state.year,query:$('[data-donation-search]').value,receiptStatus:$('[data-donation-receipt]').value});state.donations=d.rows||[];renderDonations()}catch(e){notice(e.message,'error')}};
