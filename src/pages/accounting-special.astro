---
import GovLayout from '../layouts/GovLayout.astro';
---
<GovLayout title="종단 특화회계 | 대한불교밀교종">
  <div class="special-app" data-app data-accounting-special-ui-version="2026-07-30-receipt-certificate-ui-v40" hidden>
    <header class="topbar">
      <a href="/accounting-special/" class="brand" aria-label="종단 특화회계 홈">
        <img src="/logo.png" alt="대한불교밀교종 로고" class="brand-logo" />
        <span class="brand-title"><img src="/brand-wordmark.png" alt="대한불교밀교종" class="brand-wordmark" /><b>종단 특화회계</b></span>
      </a>
      <div class="top-actions"><span data-user-label></span><a href="/accounting/" class="btn btn-outline">기본 회계</a><a href="/accounting-files/" class="btn btn-outline attachment-ops-only">점검·정책</a><a href="/" class="btn btn-outline">전자문서</a><button class="btn btn-outline" data-logout>로그아웃</button></div>
    </header>

    <div class="shell">
      <aside class="sidebar">
        <div class="year-box"><label>회계연도<select data-year></select></label></div>
        <nav>
          <button class="nav active" data-tab="overview">특화회계 현황</button>
          <button class="nav" data-tab="master">회계구분·조직·재원</button>
          <button class="nav" data-tab="donation">기부·후원</button>
          <button class="nav" data-tab="asset">자산·비품</button>
          <button class="nav" data-tab="card">법인카드</button>
          <button class="nav" data-tab="branch">사찰·교구 취합</button>
          <button class="nav" data-tab="report">특화 결산자료</button>
        </nav>
        <p class="sidebar-note">주민등록번호 등 민감한 식별정보는 이 화면에 직접 저장하지 않습니다. 영수증 발급내역은 내부 관리·출력용입니다.</p>
      </aside>

      <main class="main">
        <div class="notice" data-notice hidden></div>

        <section class="panel active" data-panel="overview">
          <div class="heading"><div><p>SPECIAL ACCOUNTING</p><h1>종단 특화회계 현황</h1><span>회계구분·조직·재원·기부·자산·법인카드·사찰 취합을 관리합니다.</span></div></div>
          <div class="summary-grid">
            <button type="button" class="summary-card" data-jump-tab="master" data-jump-target="master-entity-list"><span>회계조직</span><strong data-summary-entities>0</strong><small>회계조직 관리로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="donation" data-jump-target="donor-list"><span>후원자</span><strong data-summary-donors>0</strong><small>후원자 목록으로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="donation" data-jump-target="donation-list"><span>연간 기부금</span><strong data-summary-donations>0원</strong><small>기부금 목록으로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="donation" data-jump-target="donation-list" data-jump-receipt="requested"><span>영수증 대기</span><strong data-summary-receipts>0</strong><small>발급대기 내역으로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="asset" data-jump-target="asset-list"><span>사용 중 자산</span><strong data-summary-assets>0</strong><small>자산대장으로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="asset" data-jump-target="asset-list"><span>자산 취득가액</span><strong data-summary-asset-cost>0원</strong><small>자산대장으로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="card" data-jump-target="card-transaction-list"><span>미처리 카드내역</span><strong data-summary-cards>0</strong><small>카드 사용내역으로 이동</small></button>
            <button type="button" class="summary-card" data-jump-tab="branch" data-jump-target="branch-list"><span>제출 대기 취합자료</span><strong data-summary-reports>0</strong><small>사찰·교구 취합으로 이동</small></button>
          </div>
          <div class="card"><div class="card-head"><h2>기능 구성</h2></div><div class="feature-grid">
            <button type="button" data-jump-tab="master" data-jump-target="master-book-list"><b>회계구분</b><span>일반회계·목적사업회계·수익사업회계 구분</span></button>
            <button type="button" data-jump-tab="master" data-jump-target="master-entity-list"><b>조직별 회계</b><span>본부·교구·사찰·소속기관별 독립 관리</span></button>
            <button type="button" data-jump-tab="master" data-jump-target="master-fund-list"><b>재원 관리</b><span>일반재원·지정기부금·보조금·적립금 구분</span></button>
            <button type="button" data-jump-tab="donation" data-jump-target="donation-list"><b>기부·후원</b><span>후원자·기부내역·영수증·전표 연계</span></button>
            <button type="button" data-jump-tab="asset" data-jump-target="asset-list"><b>자산·비품</b><span>취득·감가상각 추정·보관·처분 관리</span></button>
            <button type="button" data-jump-tab="card" data-jump-target="card-transaction-list"><b>법인카드</b><span>카드·사용내역·미처리내역·전표 연계</span></button>
            <button type="button" data-jump-tab="branch" data-jump-target="branch-list"><b>사찰 취합</b><span>월·분기·연간 회계자료 제출·확정</span></button>
            <button type="button" data-jump-tab="report" data-jump-target="special-report"><b>특화 결산</b><span>회계구분·조직·재원별 수입·지출 분석</span></button>
          </div></div>
        </section>

        <section class="panel" data-panel="master">
          <div class="heading"><div><p>MASTER DATA</p><h1>회계구분·조직·재원</h1><span>모든 특화회계 자료에서 공통으로 사용하는 관리기준입니다.</span></div></div>
          <div class="three-cards">
            <div class="card manager-only jump-anchor" id="master-book"><div class="card-head"><h2>회계구분 추가</h2></div><form data-form="book" class="master-side-form"><label>코드<input name="code" placeholder="예: mission" required /></label><label>명칭<input name="name" required /></label><label>설명<textarea name="description" rows="3"></textarea></label><div class="form-submit-row"><button class="btn btn-primary" type="submit">저장</button></div></form></div>
            <div class="card manager-only jump-anchor" id="master-entity"><div class="card-head"><h2>회계조직 추가·수정</h2></div><form data-form="entity"><input type="hidden" name="id" /><label>조직코드<input name="entityCode" required /></label><label>조직명<input name="name" required /></label><label>유형<select name="entityType"><option value="headquarters">본부</option><option value="diocese">교구</option><option value="temple">사찰</option><option value="affiliate">소속기관</option></select></label><label>상위조직<select name="parentId" data-entity-parent></select></label><label>조직도 소속경로<select name="departmentPath" data-department-path><option value="">조직도 소속경로 선택</option></select></label><label>대표자<input name="representative" /></label><label>등록번호(선택)<input name="registrationNo" /></label><label>등록년월일<input name="affiliationRegisteredAt" type="date" /></label><label>주소<textarea name="address" rows="2"></textarea></label><div class="entity-consolidation-row"><label class="check"><input type="checkbox" name="consolidationEnabled" checked /> 종단 취합 대상</label></div><div class="form-submit-row"><button class="btn btn-outline" type="button" data-reset-entity>새로 입력</button><button class="btn btn-primary" type="submit">저장</button></div></form></div>
            <div class="card manager-only jump-anchor" id="master-fund"><div class="card-head"><h2>재원 추가</h2></div><form data-form="fund" class="master-side-form"><input type="hidden" name="id" /><input type="hidden" name="fundCode" /><input type="hidden" name="name" /><input type="hidden" name="purpose" /><label>재원코드<select data-fund-code-template required><option value="">재원코드 선택</option></select></label><label>재원명<select data-fund-name-template required><option value="">재원명 선택</option></select></label><label>유형<select name="fundType"><option value="unrestricted">일반재원</option><option value="designated_donation">목적지정 기부금</option><option value="grant">보조금·지원금</option><option value="project">사업별 재원</option><option value="reserve">적립금·준비금</option></select></label><label>용도<select data-fund-purpose-template required><option value="">용도 선택</option></select></label><div class="fund-custom-fields" data-fund-custom hidden><label>직접 입력 재원코드<input name="customFundCode" placeholder="예: FUND-PROJECT" /></label><label>직접 입력 재원명<input name="customFundName" /></label><label>직접 입력 용도<textarea name="customFundPurpose" rows="2"></textarea></label></div><label>사용제한·조건<textarea name="restrictionNote" rows="2"></textarea></label><div class="form-submit-row"><button class="btn btn-primary" type="submit">저장</button></div></form></div>
          </div>
          <div class="card jump-anchor" id="master-book-list"><div class="card-head"><h2>회계구분</h2></div><div class="table-wrap"><table class="special-centered-table"><thead><tr><th>코드</th><th>명칭</th><th>설명</th><th>구분</th></tr></thead><tbody data-book-rows></tbody></table></div></div>
          <div class="card jump-anchor" id="master-entity-list"><div class="card-head"><h2>회계조직</h2><span class="card-delete-note">등록 조직은 수정하거나 소속증명원을 발급할 수 있습니다.</span></div><div class="table-wrap"><table class="special-centered-table"><thead><tr><th>코드</th><th>조직명</th><th>유형</th><th>상위조직</th><th>대표자</th><th>등록일</th><th>취합</th><th>관리</th></tr></thead><tbody data-entity-rows></tbody></table></div></div>
          <div class="card jump-anchor" id="master-fund-list"><div class="card-head"><h2>재원</h2></div><div class="table-wrap"><table class="special-centered-table"><thead><tr><th>코드</th><th>재원명</th><th>유형</th><th>용도</th><th>사용제한</th></tr></thead><tbody data-fund-rows></tbody></table></div></div>
        </section>

        <section class="panel" data-panel="donation">
          <div class="heading"><div><p>DONATION</p><h1>기부·후원 관리</h1><span>후원자와 기부내역을 관리하고 전표·영수증 발급내역을 연결합니다.</span></div></div>
          <div class="two-cards">
            <div class="card"><div class="card-head"><h2>후원자 등록</h2></div><form data-form="donor" class="donor-form"><input type="hidden" name="id" /><div class="form-grid two"><label>후원자 유형<select name="donorType"><option value="individual">개인</option><option value="corporate">법인·단체</option><option value="temple">사찰</option><option value="anonymous">익명</option></select></label><label>성명·단체명<input name="name" required /></label><label>식별번호(영수증용)<input name="identifierMasked" placeholder="주민등록번호·사업자등록번호(마스킹 권장)" /></label><label>연락처<input name="phone" /></label><label>전자우편<input name="email" type="email" /></label><label>주소<input name="address" /></label></div><label>메모<textarea name="memo" rows="2"></textarea></label><div class="form-submit-stack"><label class="check"><input type="checkbox" name="receiptConsent" /> 영수증 발급정보 이용 동의 확인</label><button class="btn btn-primary" type="submit">후원자 저장</button></div></form></div>
            <div class="card"><div class="card-head"><h2>기부금 등록</h2></div><form data-form="donation"><div class="form-grid three"><label>기부일자<input name="donationDate" type="date" required /></label><label>후원자명<input name="donorName" list="donor-name-options" placeholder="성명 또는 단체명을 입력" autocomplete="off" /><datalist id="donor-name-options" data-donor-datalist></datalist><input type="hidden" name="donorId" /></label><label class="check check-field"><input type="checkbox" name="anonymousDonation" data-anonymous-donation /> 익명 기부</label><label>기부유형<select name="donationCategory"><option value="general">일반후원금</option><option value="designated">목적지정 기부금</option><option value="offering">보시금</option><option value="membership">회비</option><option value="education">교육비</option><option value="ceremony">법회·의례비</option></select></label><label>금액<input name="amount" class="money" required /></label><label>수납방법<select name="paymentMethod"><option>계좌이체</option><option>현금</option><option>카드</option><option>기타</option></select></label><label>회계구분<select name="bookTypeCode" data-book-select></select></label><label>회계조직<select name="entityId" data-entity-select></select></label><label>재원<select name="fundId" data-fund-select></select></label><label>수입계정<select name="accountCode" data-revenue-account></select></label><label>입금계정<select name="settlementAccountCode" data-asset-account></select></label><label class="span-3">사용목적<input name="purpose" /></label></div><label>메모<textarea name="memo" rows="2"></textarea></label><details class="receipt-input-box" open><summary>기부금영수증 발급정보</summary><p class="receipt-input-help">기부내용을 항목별로 입력하면 영수증의 년월일·적요·금액으로 출력됩니다. 날짜 입력행에는 별도 요일표시를 붙이지 않습니다. 각 항목 금액의 합계는 위 기부금액과 일치해야 합니다.</p><div class="form-grid three"><label class="span-2">기부유형<input name="receiptDonationType" value="소득세법 제34조 제1항 기부금중 종교단체 기부금" /></label><label>코드<input name="receiptDonationCode" value="41" /></label><div class="receipt-items-editor span-3"><div class="receipt-items-title"><strong>기부내용</strong><span>부처님 오신 날, 백중, 정기후원 등 항목을 최대 5건까지 입력할 수 있습니다.</span></div><div class="receipt-items-table-wrap"><table class="receipt-items-table"><colgroup><col class="receipt-col-date"><col class="receipt-col-description"><col class="receipt-col-amount"><col class="receipt-col-action"></colgroup><thead><tr><th scope="col">년 월 일</th><th scope="col">적 요</th><th scope="col">금 액</th><th scope="col">관리</th></tr></thead><tbody data-receipt-item-rows></tbody></table></div><div class="receipt-items-footer"><button type="button" class="btn btn-outline" data-add-receipt-item>+ 기부내용 추가</button><strong data-receipt-item-total>기부내용 합계 0원 / 등록금액 0원</strong></div><p class="receipt-items-message" data-receipt-item-message hidden></p></div><div class="receipt-fixed-org span-3"><span>기부금 단체명</span><strong>대한불교밀교종</strong><small>선택한 회계조직은 아래 소속기관으로 구분하여 영수증에 출력됩니다.</small></div><label>소속기관<input name="receiptOrgName" /></label><label>고유번호<input name="receiptOrgRegistrationNo" /></label><label class="span-3">기부금 단체 소재지<input name="receiptOrgAddress" /></label><label>기부금 모집처 단체명<input name="receiptCollectorName" /></label><label>모집처 사업자등록번호<input name="receiptCollectorRegistrationNo" /></label><label class="span-3">기부금 모집처 소재지<input name="receiptCollectorAddress" /></label><label>발급자 직함<input name="receiptIssuerTitle" value="주지" /></label><label>발급자 성명<input name="receiptIssuerName" /></label><label>발급자 연락처<input name="receiptIssuerPhone" /></label></div></details><div class="form-submit-stack"><div class="inline form-submit-checks"><label class="check manager-only"><input type="checkbox" name="postNow" /> 등록과 동시에 전표처리</label></div><button class="btn btn-primary" type="submit">기부금 등록</button></div></form></div>
          </div>
          <div class="card jump-anchor" id="donor-list"><div class="card-head list-card-head"><h2>후원자 목록</h2><div class="filter"><input data-donor-search placeholder="번호·성명·연락처 검색" /><button class="btn btn-outline" data-load-donors>조회</button></div></div><div class="table-wrap"><table class="special-centered-table"><thead><tr><th>후원자번호</th><th>유형</th><th>성명·단체명</th><th>연락처</th><th>영수증동의</th></tr></thead><tbody data-donor-rows></tbody></table></div></div>
          <div class="card jump-anchor" id="donation-list"><div class="card-head list-card-head"><h2>기부금 목록</h2><div class="filter"><input data-donation-search placeholder="번호·후원자·목적 검색" /><select data-donation-receipt><option value="">영수증 전체</option><option value="requested">발급대기</option><option value="issued">발급완료</option><option value="cancelled">발급취소</option></select><button class="btn btn-outline" data-load-donations>조회</button><button class="btn btn-outline" data-export-donations>CSV</button></div></div><div class="table-wrap"><table class="special-centered-table"><thead><tr><th>기부번호</th><th>일자</th><th>후원자</th><th>구분</th><th>회계조직</th><th>재원</th><th>금액</th><th>전표</th><th>영수증</th><th>첨부</th><th>관리</th></tr></thead><tbody data-donation-rows></tbody></table></div></div>
        </section>

        <section class="panel" data-panel="asset">
          <div class="heading"><div><p>ASSET</p><h1>자산·비품 관리</h1><span>취득·보관·감가상각 추정·처분 이력을 관리합니다.</span></div></div>
