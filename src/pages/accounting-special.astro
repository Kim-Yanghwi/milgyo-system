  <script is:inline>
    (()=>{
      'use strict';
      const STORAGE_KEY='milgyo-system-session';
      const session=(()=>{try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||'null')}catch{return null}})();
      if(!session?.token||!session?.user){location.replace('/');return;}
      const token=session.token,me=session.user;
      const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>Array.from(r.querySelectorAll(s));
      const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const won=(v)=>`${Number(v||0).toLocaleString('ko-KR')}원`;
      const money=(v)=>{const n=Number(String(v??'').replace(/[^0-9.-]/g,''));return Number.isFinite(n)?Math.round(n):0};
      const today=()=>new Date(Date.now()+9*60*60*1000).toISOString().slice(0,10);
      const currentYear=Number(today().slice(0,4));
      let state={year:currentYear,books:[],entities:[],funds:[],accounts:[],donors:[],donations:[],assets:[],cards:[],cardTransactions:[],branchReports:[],permissions:{},summary:{}};
      let cardTxFiles=[];
      let cardTxModalFiles=[];
      let activeCardTxAttachment={id:'',title:''};
      const departmentTree=[
        {name:'이사장'},{name:'이사회'},{name:'감사'},{name:'종정'},
        {name:'사무국',children:['재정·회계','준법·윤리','대외협력·사회공헌','문화·홍보']},
        {name:'총무원'},{name:'교육·포교원'},
        {name:'소속기관·교구',children:['람림불교교육원','서울·인천·경기교구','강원교구','대전·세종·충남교구','충북교구','전남광주·전북교구','대구·경북교구','부산·울산·경남교구','제주교구']},
        {name:'위원회·신도단체',children:['신도회','사찰운영위원회']},
      ];
      const responsiblePositions=[
        '종정','회장','총무원장','교육·포교원장','사무총장','재정국장','준법윤리국장','국제교류국장','문화홍보국장','사회공헌국장','교구장','사무국','총무원','교육·포교원','활동거점 운영책임자','사무장','직원','간사','사무보조자','사무담당','인사·노무담당','법무담당','기획담당','재무담당','회계담당','재정관리담당','종무담당','종무담당자','법회담당자','의례담당자','시설관리담당','안전관리담당','교육담당','교육담당자','포교담당','포교담당자','홍보담당','신도회담당자','지역활동담당자','온라인포교담당자','교재담당자','교육운영담당자','통역·번역담당','국내외 불교교류담당','외국인 수행지도자 지원담당','국제교류 행정담당','콘텐츠담당','홈페이지·사회관계망서비스담당','불교문화행사담당','봉사활동담당','자비나눔담당','마음치유사업담당','사회공헌행사담당','강사','수행지도자','외부전문가','승려','법사','명상지도자','운영책임자'
      ];
      const cardIssuers=[
        {group:'전업 카드사',items:['BC카드','KB국민카드','신한카드','삼성카드','현대카드','롯데카드','우리카드','하나카드']},
        {group:'은행·상호금융계 카드',items:['NH농협카드','IBK기업은행카드','SC제일은행카드','수협카드','광주은행 KJ카드','전북은행 JB카드','BNK부산은행카드','BNK경남은행카드','iM뱅크카드','제주은행카드','우체국 체크카드','새마을금고 MG체크카드','신협 체크카드']},
        {group:'기타',items:['기타 카드사']},
      ];
      const fundPresets=[
        {code:'FUND-DESIGNATED',name:'목적지정 기부금',type:'designated_donation',purpose:'기부자가 사용 목적을 지정한 기부금'},
        {code:'FUND-GENERAL',name:'일반재원',type:'unrestricted',purpose:'사용 목적이 별도로 제한되지 않은 일반재원'},
        {code:'FUND-GRANT',name:'보조금·지원금',type:'grant',purpose:'국가·지자체·기관의 보조금 및 지원금'},
        {code:'FUND-RESERVE',name:'적립금·준비금',type:'reserve',purpose:'장래 사업과 시설을 위한 적립 재원'},
      ];
      const api=async(path,body)=>{const res=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...body,token})});const text=await res.text();let data;try{data=JSON.parse(text)}catch{data={ok:false,message:`서버 응답 오류(HTTP ${res.status})`}}if(!data.ok)throw new Error(data.message||'처리 중 오류가 발생했습니다.');return data};
      const notice=(message,type='ok')=>{const el=$('[data-notice]');el.textContent=message;el.className=`notice ${type}`;el.hidden=false;clearTimeout(notice.timer);notice.timer=setTimeout(()=>el.hidden=true,5000)};
      const labels={individual:'개인',corporate:'법인·단체',temple:'사찰',anonymous:'익명',headquarters:'본부',diocese:'교구',affiliate:'소속기관',unrestricted:'일반재원',designated_donation:'목적지정 기부금',grant:'보조금·지원금',project:'사업별 재원',reserve:'적립금·준비금',general:'일반후원금',designated:'목적지정 기부금',offering:'보시금',membership:'회비',education:'교육비',ceremony:'법회·의례비',registered:'등록',posted:'전표처리',requested:'발급대기',issued:'발급완료',cancelled:'취소',not_requested:'미요청',in_use:'사용 중',disposed:'처분',unmatched:'미처리',draft:'임시저장',submitted:'제출',confirmed:'확정',rejected:'반려',month:'월',quarter:'분기',annual:'연간'};
      const label=(v)=>labels[v]||v||'-';
      const csv=(name,headers,rows)=>{const q=(v)=>`"${String(v??'').replace(/"/g,'""')}"`;const blob=new Blob(['\ufeff'+[headers,...rows].map((r)=>r.map(q).join(',')).join('\n')],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();URL.revokeObjectURL(a.href)};
      const bytesLabel=(value)=>{const bytes=Number(value||0);if(bytes<1024)return `${bytes} B`;if(bytes<1024*1024)return `${(bytes/1024).toFixed(1)} KB`;return `${(bytes/(1024*1024)).toFixed(1)} MB`;};
      const fileToBase64=(file)=>new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result||'').split(',').pop()||'');reader.onerror=()=>reject(new Error('첨부파일을 읽지 못했습니다.'));reader.readAsDataURL(file);});
      const validateQueuedFiles=(current,incoming)=>{const combined=[...current,...incoming];if(combined.length>10)throw new Error('첨부파일은 사용내역별 최대 10개까지 등록할 수 있습니다.');for(const file of incoming){if(file.size>4*1024*1024)throw new Error(`${file.name}: 4MB 이하 파일만 등록할 수 있습니다.`);}return combined;};
      const renderFileQueue=(selector,files)=>{const list=$(selector);if(!list)return;list.innerHTML=files.length?files.map((file,index)=>`<li><span class="attachment-file-name">${esc(file.name)}</span><span class="attachment-file-meta">${bytesLabel(file.size)}</span><button type="button" class="mini" data-card-file-remove="${index}" data-card-file-list="${selector.includes('modal')?'modal':'form'}">제거</button></li>`).join(''):'<li class="attachment-empty">선택된 첨부파일이 없습니다.</li>';};
      const syncCardAttachmentQueues=()=>{renderFileQueue('[data-card-tx-file-queue]',cardTxFiles);renderFileQueue('[data-card-tx-modal-file-queue]',cardTxModalFiles);};
      const uploadAccountingAttachment=async(referenceId,file)=>{const dataBase64=await fileToBase64(file);return api('/api/accounting/upload-attachment',{referenceType:'card_transaction',referenceId,fileCategory:'receipt',fileName:file.name,mimeType:file.type||'application/octet-stream',dataBase64});};
      const uploadCardAttachmentFiles=async(referenceId,files)=>{const failures=[];for(const file of files){try{await uploadAccountingAttachment(referenceId,file);}catch(error){failures.push(`${file.name}: ${error.message}`);}}return failures;};
      const downloadBase64File=(fileName,mimeType,dataBase64)=>{const binary=atob(String(dataBase64||''));const bytes=new Uint8Array(binary.length);for(let i=0;i<binary.length;i+=1)bytes[i]=binary.charCodeAt(i);const blob=new Blob([bytes],{type:mimeType||'application/octet-stream'});const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=fileName||'attachment';document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);};
      const renderCardTxAttachmentRows=(rows=[])=>{const body=$('[data-card-tx-attachment-rows]');body.innerHTML=rows.length?rows.map((row)=>{const mine=String(row.uploaded_by||'')===String(me.id||'')||String(row.uploaded_by||'')===String(me.name||'');const canDelete=!state.permissions.audit&&(state.permissions.manager||mine);return `<tr><td>${esc(row.original_filename)}</td><td>${esc(row.file_category||'-')}</td><td>${bytesLabel(row.size_bytes)}</td><td>${mine?'본인':esc(row.uploaded_by||'-')}</td><td>${esc(row.uploaded_at||'-')}</td><td><div class="actions"><button type="button" class="mini" data-card-attachment-download="${esc(row.id)}">다운로드</button>${canDelete?`<button type="button" class="mini danger" data-card-attachment-delete="${esc(row.id)}">삭제</button>`:''}</div></td></tr>`}).join(''):'<tr><td colspan="6" class="empty">등록된 첨부파일이 없습니다.</td></tr>';};
