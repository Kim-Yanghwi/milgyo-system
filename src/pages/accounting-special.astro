      const printReceipt=async(id)=>{try{const d=await api('/api/accounting-special/query',{action:'receipt-detail',id});const r=d.row;const w=window.open('','_blank','width=980,height=1100');if(!w)throw new Error('영수증 출력창을 열 수 없습니다. 브라우저 팝업 차단을 확인해 주세요.');const blank='&#160;';const display=(value,fallback='')=>{const raw=String(value??'').trim()||String(fallback||'');return raw===blank?blank:esc(raw);};const formatKoreanDate=(value)=>{const match=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(value||''));return match?`${match[1]}. ${Number(match[2])}. ${Number(match[3])}.`:'';};const receiptSerial=String(r.receipt_no||'').replace(/^기부금영수증-/,'');const issueDate=String(r.receipt_issued_at||r.donation_date||'').slice(0,10);const issueParts=/^(\d{4})-(\d{2})-(\d{2})$/.exec(issueDate);const issueDateText=issueParts?`${issueParts[1]}년 ${Number(issueParts[2])}월 ${Number(issueParts[3])}일`:display(issueDate);let items=[];try{const parsed=JSON.parse(r.receipt_items_json||'[]');if(Array.isArray(parsed))items=parsed;}catch{}if(!items.length)items=[{date:r.donation_date,description:r.receipt_description||r.purpose||r.fund_name||'',amount:Number(r.amount||0)}];items=items.slice(0,5);const rows=[...items,...Array.from({length:Math.max(0,5-items.length)},()=>({date:'',description:'',amount:0}))];const total=items.reduce((sum,item)=>sum+Number(item.amount||0),0);const donationRows=rows.map((item,index)=>`<tr>${index===0?`<td rowspan="7">${display(r.receipt_donation_type,'소득세법 제34조 제1항 기부금중 종교단체 기부금')}</td><td rowspan="7">${display(r.receipt_donation_code,'41')}</td>`:''}<td>${display(formatKoreanDate(item.date),blank)}</td><td>${display(item.description,blank)}</td><td>${item.amount?display(Number(item.amount).toLocaleString('ko-KR'),blank):blank}</td></tr>`).join('')+`<tr><td colspan="2" class="total-label">계</td><td>${display(total.toLocaleString('ko-KR'),blank)}</td></tr><tr><td colspan="3" class="blank-label">이하여백</td></tr>`;w.document.write(`<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>${display(r.receipt_no,'기부금영수증')}</title><style>*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111}body{font-family:"Batang","바탕",serif;padding:20px}.print-sheet{width:190mm;min-height:270mm;margin:0 auto;border:2px solid #111}.receipt-header{display:grid;grid-template-columns:31% 38% 31%;align-items:center;min-height:76px;border-bottom:1px solid #111}.serial-wrap{padding:12px}.serial-box{display:inline-grid;grid-template-columns:auto auto;border:1px solid #111;font-size:14px;font-weight:700}.serial-box span{padding:7px 8px;border-right:1px solid #111}.serial-box b{padding:7px 10px;font:inherit}.receipt-title{text-align:center;font-size:30px;font-weight:700;letter-spacing:.18em;white-space:nowrap}.receipt-table{width:100%;border-collapse:collapse;table-layout:fixed}.receipt-table th,.receipt-table td{border:1px solid #111;text-align:center;vertical-align:middle;padding:7px 6px;font-size:14px;line-height:1.35;font-family:inherit;font-weight:400;word-break:keep-all}.receipt-table th{font-weight:700}.receipt-table tr>*:first-child{border-left:0}.receipt-table tr>*:last-child{border-right:0}.section-title{text-align:left!important;font-size:16px!important;font-weight:700!important;padding:6px 12px!important}.donation-table td{height:35px}.donation-table td[rowspan]{padding:10px;line-height:1.65}.total-label,.blank-label{font-weight:700!important}.statement{min-height:180px;border-top:1px solid #111;padding:26px 28px;text-align:center;font-size:15px;line-height:1.9}.statement.certification{min-height:180px}.statement-date{margin-top:18px;font-size:16px}.signature{margin-top:10px;text-align:right;padding-right:70px;font-size:16px}.issuer-lines{display:inline-block;text-align:right;min-width:300px}.print-actions{width:190mm;margin:12px auto}.print-actions button{padding:7px 13px}@page{size:A4 portrait;margin:10mm}@media print{body{padding:0}.print-sheet{width:100%;min-height:auto}.print-actions{display:none}}</style></head><body><div class="print-sheet"><div class="receipt-header"><div class="serial-wrap"><div class="serial-box"><span>일련번호</span><b>${display(receiptSerial||r.receipt_no,'-')}</b></div></div><div class="receipt-title">기부금 영수증</div><div></div></div><table class="receipt-table"><colgroup><col style="width:20%"><col style="width:20%"><col style="width:20%"><col style="width:40%"></colgroup><tr><th colspan="4" class="section-title">1. 기부자</th></tr><tr><th>성명</th><td>${display(r.donor_name,blank)}</td><th>주민등록번호</th><td>${display(r.identifier_masked,blank)}</td></tr><tr><th>주소</th><td colspan="3">${display(r.donor_address,blank)}</td></tr><tr><th colspan="4" class="section-title">2. 기부금 단체</th></tr><tr><th>단체명</th><td>대한불교밀교종</td><th>고유번호</th><td>${display(r.resolved_receipt_org_registration_no,blank)}</td></tr><tr><th>소속기관</th><td colspan="3">${display(r.resolved_receipt_org_name,blank)}</td></tr><tr><th>소재지</th><td colspan="3">${display(r.resolved_receipt_org_address,blank)}</td></tr><tr><th colspan="4" class="section-title">3. 기부금 모집처</th></tr><tr><th>단체명</th><td>${display(r.receipt_collector_name,blank)}</td><th>사업자등록번호</th><td>${display(r.receipt_collector_registration_no,blank)}</td></tr><tr><th>소재지</th><td colspan="3">${display(r.receipt_collector_address,blank)}</td></tr></table><table class="receipt-table donation-table"><colgroup><col style="width:20%"><col style="width:18%"><col style="width:20%"><col style="width:25%"><col style="width:17%"></colgroup><tr><th colspan="5" class="section-title">4. 기부내용</th></tr><tr><th>유형</th><th>코드</th><th>년 월 일</th><th>적요</th><th>금액</th></tr>${donationRows}</table><div class="statement"><div>소득세법 제34조, 조세특례제한법 제73조 및 동법 제88조의 4의 규정에 의한<br>기부금을 위와 같이 기부하였음을 증명하여 주시기 바랍니다.</div><div class="statement-date">${display(issueDateText,blank)}</div><div class="signature">신청인: ${display(r.donor_name,blank)} (인)</div></div><div class="statement certification"><div>위와 같이 기부금을 기부하였음을 증명합니다.</div><div class="statement-date">${display(issueDateText,blank)}</div><div class="signature"><span class="issuer-lines">${display(r.receipt_issuer_title,'주지')}: ${display(r.resolved_receipt_issuer_name,blank)} (인)<br>손전화: ${display(r.receipt_issuer_phone,blank)}</span></div></div></div><div class="print-actions"><button onclick="print()">인쇄</button></div></body></html>`);w.document.close();}catch(e){notice(e.message,'error')}};
      const disposeAsset=async(id)=>{const date=prompt('처분일자를 입력해 주세요.',today());if(!date)return;const amount=prompt('처분금액을 입력해 주세요.','0');try{await api('/api/accounting-special/action',{action:'dispose-asset',id,disposalDate:date,disposalAmount:amount});notice('자산을 처분 처리했습니다.');await Promise.all([refreshAssets(),refreshSummary()]);loadedTabs.add('asset')}catch(e){notice(e.message,'error')}};
