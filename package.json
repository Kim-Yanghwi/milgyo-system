{
  "name": "milgyo-system",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check:organization && npm run typecheck && npm test && npm run build",
    "test:security": "node --import tsx --test tests/v97-*.test.ts",
    "security:release-check": "node scripts/security/check-release.mjs",
    "security:upgrade": "node scripts/security/upgrade-dependencies.mjs --apply",
    "verify:release": "npm run config:check && npm run security:release-check && npm run audit:release && npm run check:organization && npm run typecheck && npm test && npm run build",
    "config:check": "node scripts/operations/check-config.mjs",
    "audit:full": "npm audit --omit=dev --audit-level=high",
    "audit:release": "node scripts/security/audit-release.mjs",
    "check:organization": "node scripts/check-v109-secretariat.mjs"
  },
  "dependencies": {
    "astro": "7.3.5",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "tsx": "^4.23.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "uuid": "11.1.1",
    "sharp": "0.35.5"
  }
}
